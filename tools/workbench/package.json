{
  "name": "@pagespeed/workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -C packages/web-shell dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write 'packages/*/src/**/*.{ts,svelte,css}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,svelte,css}'"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@sveltejs/kit": "2.70.2",
      "vite": "6.4.3",
      "rollup": "4.59.0",
      "undici": "7.29.0",
      "picomatch": "4.0.4",
      "devalue": "5.8.1",
      "postcss": "8.5.25",
      "cookie": "0.7.2",
      "nanoid@<3.3.18": "3.3.18"
    }
  }
}
