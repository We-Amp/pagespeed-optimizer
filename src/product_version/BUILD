load("@rules_cc//cc:defs.bzl", "cc_library")

# Generate the product version string header DETERMINISTICALLY from the in-tree
# //:VERSION.txt source file. Unlike gen_build_commit (which stamps a volatile
# git SHA and can fall back to `git rev-parse`), the product version is in-tree
# source, so a genrule that reads the file is fully reproducible — no git, no
# --workspace_status_command stamp. The build fails loudly if VERSION.txt is
# missing, empty, or has no X.Y.Z core. A SemVer -prerelease suffix is allowed
# (e.g. "2.0.21-preview.1") so 2.0 can ship prereleases; +build-metadata is
# rejected (the "+rN" form is mod_pagespeed 1.1's scheme).
genrule(
    name = "gen_product_version",
    srcs = ["//:VERSION.txt"],
    outs = ["product_version_string.h"],
    cmd = """
        VERSION=$$(cat $(location //:VERSION.txt) | tr -d '[:space:]')
        if [ -z "$$VERSION" ]; then
            echo "VERSION.txt is empty" >&2
            exit 1
        fi
        case "$$VERSION" in
            *.*.*) : ;;
            *) echo "VERSION.txt='$$VERSION' is not plain SemVer X.Y.Z" >&2; exit 1 ;;
        esac
        case "$$VERSION" in
            *+*) echo "VERSION.txt='$$VERSION' has build metadata; 2.0 uses plain SemVer" >&2; exit 1 ;;
        esac
        cat > $@ <<HEADER_EOF
// Generated by gen_product_version from //:VERSION.txt — do not edit.
#ifndef PAGESPEED_PRODUCT_VERSION_STRING_H_
#define PAGESPEED_PRODUCT_VERSION_STRING_H_

namespace pagespeed {

// Plain SemVer product version, generated from the workspace VERSION.txt at
// build time. Bumped by editing VERSION.txt (the orchestrator / release
// pipeline), never by hand-editing a source constant.
inline constexpr char kProductVersion[] = "$$VERSION";

}  // namespace pagespeed

#endif  // PAGESPEED_PRODUCT_VERSION_STRING_H_
HEADER_EOF
    """,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "version",
    hdrs = [
        "product_version_string.h",
        "version.h",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "gen_build_commit",
    srcs = ["//:GIT_COMMIT"],
    outs = ["build_commit.h"],
    cmd = """
        COMMIT=$$(cat $(location //:GIT_COMMIT) | tr -d '[:space:]')
        if [ "$$COMMIT" = "dev" ] || [ -z "$$COMMIT" ]; then
            COMMIT=$$(git rev-parse HEAD 2>/dev/null || echo "dev")
        fi
        SHORT=$${COMMIT:0:7}
        cat > $@ <<HEADER_EOF
// Generated by gen_build_commit — do not edit.
#ifndef PAGESPEED_BUILD_COMMIT_H_
#define PAGESPEED_BUILD_COMMIT_H_

namespace pagespeed {

inline constexpr char kBuildCommit[] = "$$COMMIT";
inline constexpr char kBuildCommitShort[] = "$$SHORT";

}  // namespace pagespeed

#endif  // PAGESPEED_BUILD_COMMIT_H_
HEADER_EOF
    """,
    local = True,
    # Never cache this action's result.  The cmd is non-hermetic: when
    # GIT_COMMIT is "dev" it falls back to `git rev-parse HEAD`, an undeclared
    # input.  Without no-cache, the shared bazel cache keys the result on the
    # declared inputs only (the GIT_COMMIT file content), so a result baked from
    # one git HEAD can be served for a later build with a different HEAD —
    # silently stamping the binary with a stale commit (verify-artifacts.sh
    # catches this as a STALE ARTIFACT).  Always re-run so the stamp tracks the
    # current commit; the regenerated header is tiny and only triggers a
    # downstream rebuild when the commit actually changes.
    tags = ["no-cache"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "build_commit",
    hdrs = ["build_commit.h"],
    visibility = ["//visibility:public"],
)
