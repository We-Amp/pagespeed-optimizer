<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <Title>WeAmp.PageSpeed Native Binaries — macOS (arm64)</Title>
    <Description>Native macOS binaries for WeAmp.PageSpeed (libpagespeed.dylib, factory_worker). Pulled transitively when you install WeAmp.PageSpeed.AspNetCore.</Description>
    <PackageTags>pagespeed mod-pagespeed mod_pagespeed weamp native macos osx arm64</PackageTags>
  </PropertyGroup>

  <!-- Exclude console/** — see WeAmp.PageSpeed.NativeAssets.Linux.csproj for context. -->
  <ItemGroup>
    <None Include="runtimes/osx-arm64/native/**" Exclude="runtimes/osx-arm64/native/console/**" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
