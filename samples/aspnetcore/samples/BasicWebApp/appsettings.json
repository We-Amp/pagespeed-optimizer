{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PageSpeed": {
    "Enabled": true,
    "Cache": {
      "VolumePath": "/tmp/pagespeed-demo/volume.dat",
      "VolumeSizeBytes": 268435456,
      "EnableChecksum": true,
      "RamCacheSizeBytes": 67108864,
      "MaxMetadataSizeBytes": 8192
    },
    "Html": {
      "EnableCriticalCss": true,
      "EnableLazyLoad": true,
      "EnableImageDimensions": true,
      "EnableLcpPreload": true,
      "EnablePreconnect": true,
      "EnableSpeculationRules": false,
      "Viewport": "Desktop",
      "MaxHtmlSizeBytes": 5242880,
      "MaxCssSizeBytes": 2097152
    },
    "ExcludePaths": [
      "/api/",
      "/signalr/",
      "/_blazor/",
      "/_framework/"
    ],
    "MaxResponseBufferBytes": 5242880
  }
}
