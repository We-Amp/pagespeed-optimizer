<Project>

  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- NuGet package metadata (only applies to packable projects) -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <Version>2.1.0</Version>
    <Authors>We-Amp</Authors>
    <Company>We-Amp B.V.</Company>
    <Copyright>Copyright (c) 2024-2026 We-Amp B.V.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://modpagespeed.com/features/#aspnet-core</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>2.1.0: mod_pagespeed 2.1 general availability — the converged module + optimizer line, relicensed Apache-2.0, hardened by default. Full release notes: https://modpagespeed.com/docs/release-notes-2-1/
See CHANGELOG.md in the repository for earlier releases.</PackageReleaseNotes>
    <!-- Source repo is private — strip ALL git-detected repository metadata.
         Belt-and-braces: kill SourceLink auto-detection, then null the fields
         in a late-binding target before GenerateNuspec emits them. -->
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The authoritative kill-switch (1.15-sidecar learning): stop the SDK's
         _InitializeSourceControlInformation from populating SourceRevisionId /
         RepositoryCommit at the SOURCE. Without it, that target can run AFTER the
         BeforeTargets="GenerateNuspec" blanking below and re-inject the private-repo
         HEAD SHA into <repository commit> — exactly what leaked in the sidecar's
         1.15.0-preview.1 despite the identical ClearPrivateRepositoryMetadata target.
         release.yml's leak-guard would still CATCH a regression; this PREVENTS at source. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeRepositoryUrlInNuspec>false</IncludeRepositoryUrlInNuspec>
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
    <SourceRevisionId></SourceRevisionId>
    <RepositoryUrl></RepositoryUrl>
    <RepositoryType></RepositoryType>
    <RepositoryCommit></RepositoryCommit>
    <RepositoryBranch></RepositoryBranch>
  </PropertyGroup>

  <Target Name="ClearPrivateRepositoryMetadata"
          BeforeTargets="GenerateNuspec;_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false'">
    <PropertyGroup>
      <RepositoryUrl></RepositoryUrl>
      <RepositoryType></RepositoryType>
      <RepositoryCommit></RepositoryCommit>
      <RepositoryBranch></RepositoryBranch>
      <SourceRevisionId></SourceRevisionId>
      <PrivateRepositoryUrl></PrivateRepositoryUrl>
    </PropertyGroup>
  </Target>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)../../NOTICE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
