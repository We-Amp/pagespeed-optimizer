const currentPath = Astro.url.pathname;

// --- BreadcrumbList JSON-LD ---
const segmentNames: Record<string, string> = {
  features: 'Features',
  analyze: 'Analyze',
  pricing: 'Pricing',
  docs: 'Docs',
  blog: 'Blog',
  demo: 'Demo',
  examples: 'Filter examples',
  calculator: 'Savings calculator',
  contact: 'Contact',
  license: 'License',
  terms: 'Terms',
  privacy: 'Privacy',
  security: 'Security',
  alternatives: 'Alternatives',
  vs: 'Comparisons',
  'pagespeed-markers': 'PageSpeed markers',
  'how-it-works': 'How it works',
  'core-web-vitals': 'Core Web Vitals',
  download: 'Download',
  'aspnet-getting-started': 'ASP.NET getting started',
  'aspnet-configuration': 'ASP.NET configuration',
};

// Fallback for a segment with no entry above: sentence case, with the
// acronyms the site's slugs use kept upper case ("ai-readability" becomes
// "AI readability", not "Ai Readability").
const segmentAcronyms = new Set(['ai', 'api', 'cls', 'css', 'iis', 'inp', 'js', 'lcp', 'ttfb']);
function formatSegment(segment: string): string {
  if (segmentNames[segment]) return segmentNames[segment];
  return segment
    .split('-')
    .map((word, index) =>
      segmentAcronyms.has(word)
        ? word.toUpperCase()
        : index === 0
          ? word.charAt(0).toUpperCase() + word.slice(1)
          : word,
    )
    .join(' ');
}

// The page's own title, minus a trailing " — product" or " | site" suffix,
// names the last breadcrumb when the page does not pass breadcrumbLeafName.
const titleLeafName = title.replace(/\s+[—|]\s+[^—|]*$/, '').trim();

const pathSegments = currentPath
  .replace(/^\/|\/$/g, '')
  .split('/')
  .filter(Boolean);

// Build each item's URL from the FULL, real path (cumulative up to its own
// index) before filtering — an omitted segment must not shift a later
// segment's URL, only remove its own ListItem from the visible list.
const breadcrumbItems = [
  { name: 'Home', url: 'https://modpagespeed.com/' },
  ...pathSegments
    .map((segment, index) => ({
      segment,
      name: formatSegment(segment),
      url: 'https://modpagespeed.com/' + pathSegments.slice(0, index + 1).join('/') + '/',
    }))
    .filter(({ segment }) => !breadcrumbSkipSegments.includes(segment))
    .map(({ name, url }) => ({ name, url })),
];

// Align the emitted BreadcrumbList leaf with the page's visible breadcrumb
// leaf: slug pages render their human title, but formatSegment(slug) diverges.
// When breadcrumbLeafName is provided, override the final ListItem.name.
if (breadcrumbItems.length >= 2)
  breadcrumbItems[breadcrumbItems.length - 1].name = breadcrumbLeafName ?? titleLeafName;

const breadcrumbJsonLd =
  breadcrumbItems.length >= 2
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.url,
        })),
      }
    : null;

const jsonLdEntries: Array<Record<string, unknown> | undefined> = Array.isArray(jsonLd)
  ? jsonLd
  : [jsonLd];
const jsonLdScripts = [...jsonLdEntries, breadcrumbJsonLd].filter(
  (s): s is Record<string, unknown> => Boolean(s),
);

// Mobile-only sticky CTA (CONV): a fixed bottom pill that surfaces the primary
// "Install" funnel after the user scrolls past the hero. Scoped to the four
// conversion routes only — content/docs/tool pages don't get it. Normalize the
// inbound path to a trailing slash so a non-trailing URL still matches. It's a
// fixed overlay (no layout shift / no CLS) and is hidden (opacity-0 +
// pointer-events-none) until the scroll script flips it on, so it's never a
// hidden tap target.
const stickyCtaPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const showStickyCta = ['/', '/pricing/', '/features/', '/demo/'].includes(stickyCtaPath);

// Site search (Pagefind; see SearchDialog.astro and scripts/build-search-index.mjs).
// The index is built from exactly the pages whose <main> carries
// `data-pagefind-body`, so this flag is the whole inclusion rule: noindex
// pages and the utility routes stay out, and so does the static /1.0/
// archive, which never carries the attribute. The section meta is shown on
// every result as a tag ("Section: Docs").
const searchExcluded =
  (noindex && !searchable) ||
  /^\/(api|go|buy|error|1\.0)(\/|$)/.test(rawPath) ||
  /^\/(404|500)\/?$/.test(rawPath);

// Telemetry strip exclusion: the archived product sections, utility and error
// routes, and any noindex page that is not kept in site search.
const telemetryExcluded =
  (noindex && !searchable) ||
  /^\/(1\.1|1\.0|api|go|error)(\/|$)/.test(rawPath) ||
  /^\/(404|500)(\/|$)/.test(rawPath);
const sectionNames: Record<string, string> = {
  docs: 'Docs',
  blog: 'Blog',
  'how-it-works': 'How it works',
  examples: 'Examples',
  vs: 'Compare',
  alternatives: 'Compare',
  'core-web-vitals': 'Compare',
};
const searchSection = sectionNames[pathSegments[0] ?? ''] ?? 'Site';
---

<!doctype html>
<html lang="en" class="scroll-smooth dark" id="html-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <!-- Unscoped fallback first: browsers that ignore the media attribute still
         get a theme color. Media-scoped overrides follow. -->
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="preload"
      href="/fonts/inter-variable-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/plex-mono-600.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The analytics script further down is the one cross-origin request: open
         its connection early. It is fetched without CORS, hence no crossorigin. -->
    <link rel="preconnect" href="https://umami.we-amp.com" />
    <style is:inline>
      /* Critical-CSS flash guard: the production module inlines critical CSS
         extracted without the .dark class, so token-based utilities on
         above-the-fold elements would resolve to the light :root values until
         the full sheet loads. This block repeats the complete dark token list
         (copied value for value from .dark in global.css; guarded against
         drift by test/sync/dark-tokens-inline.test.ts) at specificity (0,1,1),
         which beats :root. */
      html.dark {
        --color-bg-primary: #0b0c0e;
        --color-bg-secondary: #121417;
        --color-bg-elevated: #191c20;
        --color-bg-recessed: #070809;
        --color-text-body: #e8eaed;
        --color-text-muted: #a7aeb6;
        --color-text-annotation: #8a9099;
        --color-interactive: #5eb1c9;
        --color-interactive-hover: #84c7db;
        --color-on-accent: #07080a;
        --color-success: #6fbf8f;
        --color-accent: #e0a24a;
        --color-promo: #5eb1c9;
        --color-border: #2a2e34;
        --color-border-strong: #3a3f47;
        --color-control-border: #646b73;
        --color-tick: rgba(255, 255, 255, 0.12);
        --color-specular: rgba(255, 255, 255, 0.05);
        --color-grid-line: rgba(255, 255, 255, 0.045);
        --color-success-wash: #202929;
        --color-accent-wash: #292723;
        --color-interactive-wash: #1f282e;
        --color-bit-clear: #20242a;
        --color-bit-lit: #5eb1c9;
        --color-disabled-bg: #1a1d21;
        --color-disabled-text: #6a7077;
        --color-disabled-border: #2f343a;
        --color-focus-ring: #5eb1c9;
      }
      /* Override critical CSS that includes bg-white but not dark:bg-stone-950.
         mod_pagespeed's critical CSS extractor does not capture dark-variant
         rules, so without !important the white background wins during the
         critical-CSS-only rendering phase. */
      html.dark,
      html.dark body,
      html.dark header {
        background-color: #0b0c0e !important;
        color: #e8eaed !important;
      }
      html.dark header {
        border-color: #2a2e34 !important;
      }
      /* Dropdown panel: prevent white flash before dark variant loads */
      html.dark .group .nav-panel-box {
        background-color: #191c20 !important;
        border-color: #2a2e34 !important;
      }
      /* Card backgrounds: bg-white is captured in critical CSS but dark:bg-stone-900 is not,
         so every bg-bg-elevated card flashes white until async CSS loads. */
      html.dark .bg-white {
        background-color: #191c20 !important;
      }
      /* Header logo dark-mode swap: the two <img> tags use `dark:hidden` and
         `hidden dark:block` to switch between light/dark wordmarks. The base
         `hidden` rule (display: none) IS captured in critical CSS but the
         `dark:block` override is NOT, so on second-load (after PageSpeed has
         inlined critical CSS) the dark logo stays display:none until async
         CSS arrives and the user briefly sees no logo at all. Force the
         correct visibility inline using the literal class-attribute
         substrings — selector specificity (0,2,1) beats any later utility. */
      html.dark img[class*='dark:hidden'] {
        display: none !important;
      }
      html.dark img[class*='dark:block'] {
        display: block !important;
      }
    </style>
    <script is:inline define:vars={{ bannerDismissKey }}>
      /* Set dark class before first paint to avoid FOUC on iOS. Must run
         synchronously in <head> before any rendering occurs. */
      (function () {
        /* Dark-only identity (CALIBER): the `.dark` class is ALWAYS applied so
           every existing `dark:` utility resolves to the instrument-black system.
           No toggle, no light theme. */
        document.documentElement.classList.add('dark');
        /* Set platform preference for the docs platform selector. Storage
           access can throw (Safari private mode, strict cookie/storage
           settings) — never let that leave data-active-platform unset, since
           global.css hides every [data-platform] block until this attribute
           is set. Fall back to the same 'nginx' default the page scripts use. */
        var p = 'nginx';
        try {
          p = localStorage.getItem('docs-platform') || 'nginx';
        } catch (e) {
          /* storage blocked — p stays 'nginx' */
        }
        document.documentElement.setAttribute('data-active-platform', p);
        /* Hide launch banner if previously dismissed — prevents FOUC.
           INVARIANT: the localStorage key is versioned (passed in as
           bannerDismissKey). When the banner copy or link changes, bump the
           key's version suffix in BaseLayout so previously-dismissed users see
           the new banner. Do not revert to an unversioned key.
           Wrapped for the same reason as above: a throwing storage backend
           must not abort this script before the platform attribute is set. */
        try {
          if (localStorage.getItem(bannerDismissKey) === '1') {
            document.documentElement.dataset.bannerDismissed = '1';
          }
        } catch (e) {
          /* storage blocked — banner just shows, same as "never dismissed" */
        }
      })();
    </script>
    <noscript
      ><style>
        html:not([data-active-platform]) [data-platform] {
          display: block !important;
        }
      </style></noscript
    >
