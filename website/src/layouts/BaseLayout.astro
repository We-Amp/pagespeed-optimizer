          href="/download/"
          data-umami-event="cta_sticky_mobile"
          data-sticky-cta="hidden"
          class="btn-primary md:hidden fixed bottom-0 left-1/2 z-40 -translate-x-1/2 whitespace-nowrap rounded-full opacity-0 shadow-lg transition-opacity duration-300 ease-out pointer-events-none data-[sticky-cta=visible]:opacity-100 data-[sticky-cta=visible]:pointer-events-auto"
          style="margin-bottom: calc(1rem + env(safe-area-inset-bottom));"
        >
          Download &amp; run
        </a>
      )
    }

    {
      showStickyCta && (
        <script is:inline>
          {`
          /* Reveal the mobile sticky CTA once the user scrolls past the hero
             (~90% of the first viewport). Toggles a data attribute; the fade/
             slide is pure CSS so reduced-motion users still get an instant flip
             via the global motion reset. */
          (function () {
            var cta = document.getElementById('sticky-cta');
            if (!cta) return;
            function update() {
              var past = window.scrollY > window.innerHeight * 0.9;
              cta.setAttribute('data-sticky-cta', past ? 'visible' : 'hidden');
            }
            update();
            window.addEventListener('scroll', update, { passive: true });
            window.addEventListener('resize', update, { passive: true });
          })();
          `}
        </script>
      )
    }

    <!-- Dark class is now set in <head> to prevent FOUC on iOS -->

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      function setMobileMenuOpen(open: boolean) {
        if (!btn || !menu) return;
        btn.setAttribute('aria-expanded', String(open));
        menu.classList.toggle('hidden', !open);
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      }

      function closeMobileMenu(returnFocus: boolean) {
        if (!menu || menu.classList.contains('hidden')) return;
        setMobileMenuOpen(false);
        if (returnFocus) btn?.focus();
      }

      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        setMobileMenuOpen(btn.getAttribute('aria-expanded') !== 'true');
      });

      // Keep clicks inside the open menu from bubbling to the outside-click handler.
      menu?.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // Outside tap/click closes the menu (no focus return — the user is acting elsewhere).
      document.addEventListener('click', () => closeMobileMenu(false));

      // Escape closes the menu and returns focus to the toggle. (WCAG 2.1.2)
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMobileMenu(true);
      });

      // Desktop nav dropdowns (Tools, Docs) — click + keyboard support.
      // Each group is independent; aria-expanded is the single source of truth
      // and visual state mirrors it. Opening one closes the others.
      const dropdownGroups = Array.from(
        document.querySelectorAll<HTMLElement>('.nav-dropdown-group'),
      )
        .map((group) => ({
          btn: group.querySelector<HTMLButtonElement>('.nav-dropdown-btn'),
          panel: group.querySelector<HTMLElement>('.nav-dropdown-panel'),
        }))
        .filter((g): g is { btn: HTMLButtonElement; panel: HTMLElement } =>
          Boolean(g.btn && g.panel),
        );

      function setGroupOpen(group: { btn: HTMLButtonElement; panel: HTMLElement }, open: boolean) {
        group.panel.classList.toggle('hidden', !open);
        group.btn.setAttribute('aria-expanded', String(open));
      }

      function closeAllDropdowns() {
        dropdownGroups.forEach((g) => setGroupOpen(g, false));
      }

      dropdownGroups.forEach((group) => {
        group.btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = !group.panel.classList.contains('hidden');
          closeAllDropdowns();
          setGroupOpen(group, !isOpen);
        });

        group.btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            closeAllDropdowns();
            setGroupOpen(group, true);
            const firstLink = group.panel.querySelector<HTMLAnchorElement>('a');
            firstLink?.focus();
          }
        });

        group.panel.addEventListener('click', (e) => {
          e.stopPropagation();
        });

        // Close a stale-open menu when focus leaves the group entirely (Tab-out).
        // relatedTarget is the element gaining focus; if it's outside this
        // group's wrapper, collapse the disclosure.
        const wrapper = group.btn.closest<HTMLElement>('.nav-dropdown-group');
        wrapper?.addEventListener('focusout', (e) => {
          const next = e.relatedTarget as Node | null;
          if (!next || !wrapper.contains(next)) {
            setGroupOpen(group, false);
          }
        });
      });

      if (dropdownGroups.length > 0) {
        document.addEventListener('click', closeAllDropdowns);

        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const openGroup = dropdownGroups.find((g) => !g.panel.classList.contains('hidden'));
          if (openGroup) {
            closeAllDropdowns();
            openGroup.btn.focus();
          }
        });
      }
    </script>

    <script is:inline define:vars={{ bannerDismissKey }}>
      /* Banner dismissal is versioned (and section-scoped) so copy changes
         reach previously-dismissed users. The key is passed in from BaseLayout
         (bannerDismissKey); bump its version suffix there when copy changes. */
      (function () {
        var BANNER_KEY = bannerDismissKey;
        var banner = document.getElementById('coming-soon-banner');
        var dismissBtn = document.getElementById('dismiss-banner');
        if (!banner) return;
        if (localStorage.getItem(BANNER_KEY) === '1') {
          banner.style.display = 'none';
          return;
        }
        if (dismissBtn) {
          dismissBtn.addEventListener('click', function () {
            banner.style.display = 'none';
            localStorage.setItem(BANNER_KEY, '1');
          });
        }
      })();
    </script>

    <script is:inline>
      /* Copy-to-clipboard buttons on every <pre><code>...</code></pre>.
         Initialization gate: only flip <html data-clip-ready> if the
         clipboard API is actually usable. CSS keeps buttons opacity:0 +
         visibility:hidden until that flag is set, so we never flash empty
         buttons on browsers that lack support (older Safari, non-HTTPS dev
         preview). Inline <code> (not inside <pre>) is skipped by selector. */
      (function () {
        if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
          return;
        }
        var COPY_SVG =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
        var CHECK_SVG =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';

        function attach(pre) {
          if (!pre || pre.dataset.copyAttached === '1') return;
          var code = pre.querySelector('code');
          if (!code) return;
          pre.dataset.copyAttached = '1';
          /* Ensure absolute child positions against the <pre>. CSS already
             does this via `pre:has(code)` in browsers that support :has,
             but set inline for older browsers as a defensive belt. */
          var computed = window.getComputedStyle(pre);
          if (computed.position === 'static') {
            pre.style.position = 'relative';
          }
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy-btn';
          btn.setAttribute('aria-label', 'Copy code to clipboard');
          btn.setAttribute('title', 'Copy');
          btn.innerHTML = COPY_SVG;
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var text = code.textContent || '';
            navigator.clipboard.writeText(text).then(
              function () {
                btn.dataset.copied = 'true';
                btn.setAttribute('aria-label', 'Copied');
                btn.setAttribute('title', 'Copied');
                btn.innerHTML = CHECK_SVG;
                setTimeout(function () {
                  delete btn.dataset.copied;
                  btn.setAttribute('aria-label', 'Copy code to clipboard');
                  btn.setAttribute('title', 'Copy');
                  btn.innerHTML = COPY_SVG;
                }, 1500);
              },
              function () {
                /* Permission denied or other failure — leave button visible,
                   no error UI; the user can still select+copy manually. */
              },
            );
          });
          pre.appendChild(btn);
        }

        function attachAll(root) {
          var scope = root && root.querySelectorAll ? root : document;
          var codes = scope.querySelectorAll('pre > code');
          /* No code blocks on this page (most marketing pages) — no-op.
             Skip the data-clip-ready flag and the per-node getComputedStyle
             work entirely. */
          if (codes.length === 0) return;
          document.documentElement.setAttribute('data-clip-ready', '');
          for (var i = 0; i < codes.length; i++) {
            attach(codes[i].parentElement);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            attachAll(document);
          });
        } else {
          attachAll(document);
        }
      })();
    </script>
