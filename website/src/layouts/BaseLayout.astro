---
import NewsletterSignup from '../components/NewsletterSignup.astro';
import QuickMessage from '../components/QuickMessage.astro';
import ShareFloat from '../components/ShareFloat.astro';
import Icon from '../components/Icon.astro';
import EolNotice from '../components/EolNotice.astro';
import {
  PRODUCT_DISPLAY_NAME,
  PRODUCT_NAME,
  CURRENT_LINE,
  V1_LINE,
  LICENSE_CLAUSE_CAP,
} from '../data/product-facts.mjs';

// Derived chrome labels (ruling O11: lowercase everywhere). The 1.1 section
// keeps its own line identity; everything else speaks the converged line.
const currentLabel = `${PRODUCT_DISPLAY_NAME} ${CURRENT_LINE}`;
const legacyLabel = `${PRODUCT_NAME} ${V1_LINE}`;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  // Single schema object, or an array when a page needs to emit multiple
  // top-level JSON-LD nodes (e.g. /1.1/ emits Product + FAQPage as separate
  // <script> tags so each is a first-class schema for Google's parsers and
  // so seo.spec.ts can assert against the first script's @type directly,
  // rather than drilling into a wrapping @graph).
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  // Emit <meta name="robots" content="noindex,follow"> — for error pages and
  // any utility route that should not be indexed.
  noindex?: boolean;
  // Override the auto BreadcrumbList's final ListItem.name so the emitted
  // JSON-LD leaf matches the page's visible breadcrumb leaf (the human title)
  // rather than formatSegment(slug). Slug pages pass their human title here.
  breadcrumbLeafName?: string;
}

const {
  title,
  description = `${PRODUCT_DISPLAY_NAME} ${CURRENT_LINE} — automatic web performance optimization for Apache and nginx. ${LICENSE_CLAUSE_CAP}. Your servers, your rules.`,
  ogImage,
  jsonLd,
  noindex = false,
  breadcrumbLeafName,
} = Astro.props;

const is11Section = Astro.url.pathname.startsWith('/1.1/');

// Sitewide banner, section-aware: the /1.1/ section carries the non-dismissible
// EolNotice instead (a second, dismissible banner there would double up), so
// the dismissible banner is suppressed on /1.1/*. Dismissal is versioned — bump
// the key suffix whenever the copy or link changes so previously-dismissed
// users see the new banner.
const bannerText = is11Section
  ? ''
  : `${PRODUCT_DISPLAY_NAME} ${CURRENT_LINE} is here — open source (Apache-2.0): the module you know, plus the optimizer worker`;
const bannerHref = '/docs/getting-started/';
const bannerDismissKey = 'banner-dismissed:mps21-ga-2026a';

// Per-product OG image (BRAND-10): 1.1 pages should not carry the 2.0-branded
// card. If the page passed an explicit ogImage, honor it. Otherwise pick a
// product-appropriate default.
// TODO(BRAND-10): no og-1.1.* exists in public/ yet — when a 1.1-specific OG
// card is added (e.g. public/og-1.1.png), switch the 1.1 branch below to it.
// Until then 1.1 pages fall back to the shared default rather than referencing
// a missing file.
const resolvedOgImage = ogImage ?? '/og-default.png?v=2';

const siteUrl = Astro.site ?? new URL('https://modpagespeed.com');
const absoluteOgImage = new URL(resolvedOgImage, siteUrl).href;
// og:image:type + dimensions (F140): every OG card on the site is a 1200×630
// PNG (the shared default and the per-post /og-cards/*.png). Declaring the MIME
// type and pixel dimensions helps social scrapers render the preview without a
// HEAD round-trip, and is the meta-side half of the OG fix; the deploy-side
// half (excluding the card paths from in-place image rewriting so the .png URL
// returns image/png, not WebP) is handled in nginx — see handoff note.
const ogImageType = /\.webp(\?|$)/i.test(resolvedOgImage)
  ? 'image/webp'
  : /\.avif(\?|$)/i.test(resolvedOgImage)
    ? 'image/avif'
    : /\.jpe?g(\?|$)/i.test(resolvedOgImage)
      ? 'image/jpeg'
      : 'image/png';
// Normalize to a trailing slash so a non-trailing inbound URL still emits the
// canonical (trailing-slash) form the whole site links with — keeps duplicate
// signals from splitting. File-like paths (with an extension) are left as-is.
const rawPath = Astro.url.pathname;
const canonicalPath =
  rawPath.endsWith('/') || /\.[a-z0-9]+$/i.test(rawPath) ? rawPath : `${rawPath}/`;
const canonicalUrl = new URL(canonicalPath, 'https://modpagespeed.com').href;

const logoLight = is11Section ? '/logo-1.1.svg' : '/logo.svg';
const logoDark = is11Section ? '/logo-1.1-dark.svg' : '/logo-dark.svg';

// Nav is consolidated (UX-5, converged): one product, so Features, Pricing and
// Blog stay flat; the five tools collapse into "Tools", docs under "Docs",
// comparisons under "Compare". The previous lines (/1.1/, /1.1/docs/) moved to
// the footer's "Previous versions" group — every destination stays reachable.
// At most one "New" badge anywhere (UX-15) — it lives on RenderPeek in Tools.
const navLinks: Array<{
  href?: string;
  label: string;
  badge?: string;
  umamiEvent?: string;
  desktopOnlyFromLg?: boolean;
  children?: Array<{
    href: string;
    label: string;
    subtitle: string;
    badge?: string;
    umamiEvent?: string;
  }>;
}> = [
  { href: '/features/', label: 'Features' },
  { href: '/pricing/', label: 'Pricing' },
  {
    label: 'Tools',
    children: [
      {
        href: '/analyze/',
        label: 'Analyze',
        subtitle: 'Score any URL with PageSpeed Insights',
        umamiEvent: 'nav-analyze',
      },
      {
        href: '/ai-readability/',
        label: 'RenderPeek',
        subtitle: 'Check what AI crawlers actually see',
        badge: 'New',
        umamiEvent: 'nav-ai-readability',
      },
      {
        href: '/demo/',
        label: 'Demo',
        subtitle: 'Before and after, on a live site',
      },
      {
        href: '/examples/',
        label: 'Filter examples',
        subtitle: 'Each filter, before and after',
      },
      {
        href: '/calculator/',
        label: 'Calculator',
        subtitle: 'Estimate your bandwidth savings',
      },
    ],
  },
  {
    label: 'Docs',
    children: [
      {
        href: '/docs/',
        label: 'Documentation',
        subtitle: 'Install, configure, operate',
      },
      {
        href: '/how-it-works/',
        label: 'How it works',
        subtitle: 'How the optimizer works, under the hood',
      },
    ],
  },
  {
    label: 'Compare',
    children: [
      {
        href: '/vs/',
        label: 'Comparisons',
        subtitle: 'Head-to-head against alternatives',
      },
      {
        href: '/alternatives/',
        label: 'Alternatives',
        subtitle: 'How we stack up across the field',
      },
      {
        href: '/core-web-vitals/',
        label: 'Core Web Vitals',
        subtitle: 'What the metrics mean, and how we move them',
      },
    ],
  },
  { href: '/blog/', label: 'Blog' },
];

const currentPath = Astro.url.pathname;

// --- BreadcrumbList JSON-LD ---
const segmentNames: Record<string, string> = {
  features: 'Features',
  analyze: 'Analyze',
  '1.1': 'mod_pagespeed 1.15',
  pricing: 'Pricing',
  docs: 'Docs',
  blog: 'Blog',
  demo: 'Demo',
  examples: 'Filter examples',
  calculator: 'Savings Calculator',
  contact: 'Contact',
  license: 'License',
  terms: 'Terms',
  privacy: 'Privacy',
  security: 'Security',
  alternatives: 'Alternatives',
  vs: 'Comparisons',
  'pagespeed-markers': 'PageSpeed markers',
  'how-it-works': 'How it works',
  'aspnet-getting-started': 'ASP.NET Getting Started',
  'aspnet-configuration': 'ASP.NET Configuration',
};

function formatSegment(segment: string): string {
  if (segmentNames[segment]) return segmentNames[segment];
  return segment
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

const pathSegments = currentPath
  .replace(/^\/|\/$/g, '')
  .split('/')
  .filter(Boolean);

const breadcrumbItems = [
  { name: 'Home', url: 'https://modpagespeed.com/' },
  ...pathSegments.map((segment, index) => ({
    name: formatSegment(segment),
    url: 'https://modpagespeed.com/' + pathSegments.slice(0, index + 1).join('/') + '/',
  })),
];

// Align the emitted BreadcrumbList leaf with the page's visible breadcrumb
// leaf: slug pages render their human title, but formatSegment(slug) diverges.
// When breadcrumbLeafName is provided, override the final ListItem.name.
if (breadcrumbLeafName && breadcrumbItems.length)
  breadcrumbItems[breadcrumbItems.length - 1].name = breadcrumbLeafName;

const breadcrumbJsonLd =
  breadcrumbItems.length >= 2
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.url,
        })),
      }
    : null;

const jsonLdEntries: Array<Record<string, unknown> | undefined> = Array.isArray(jsonLd)
  ? jsonLd
  : [jsonLd];
const jsonLdScripts = [...jsonLdEntries, breadcrumbJsonLd].filter(
  (s): s is Record<string, unknown> => Boolean(s),
);

// Mobile-only sticky CTA (CONV): a fixed bottom pill that surfaces the primary
// "Install" funnel after the user scrolls past the hero. Scoped to the four
// conversion routes only — content/docs/tool pages don't get it. Normalize the
// inbound path to a trailing slash so a non-trailing URL still matches. It's a
// fixed overlay (no layout shift / no CLS) and is hidden (opacity-0 +
// pointer-events-none) until the scroll script flips it on, so it's never a
// hidden tap target.
const stickyCtaPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const showStickyCta = ['/', '/pricing/', '/features/', '/demo/'].includes(stickyCtaPath);
---

<!doctype html>
<html lang="en" class="scroll-smooth dark" id="html-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <!-- Unscoped fallback first: browsers that ignore the media attribute still
         get a theme color. Media-scoped overrides follow. -->
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="preload"
      href="/fonts/inter-variable-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/plex-mono-600.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      /* Override critical CSS that includes bg-white but not dark:bg-stone-950.
         ModPageSpeed's critical CSS extractor does not capture dark-variant
         rules, so without !important the white background wins during the
         critical-CSS-only rendering phase. */
      html.dark,
      html.dark body,
      html.dark header {
        background-color: #0b0c0e !important;
        color: #e8eaed !important;
      }
      html.dark header {
        border-color: #2a2e34 !important;
      }
      /* Dropdown panel: prevent white flash before dark variant loads */
      html.dark .group .rounded-lg {
        background-color: #191c20 !important;
        border-color: #2a2e34 !important;
      }
      /* Card backgrounds: bg-white is captured in critical CSS but dark:bg-stone-900 is not,
         so every bg-bg-elevated card flashes white until async CSS loads. */
      html.dark .bg-white {
        background-color: #191c20 !important;
      }
      /* Header logo dark-mode swap: the two <img> tags use `dark:hidden` and
         `hidden dark:block` to switch between light/dark wordmarks. The base
         `hidden` rule (display: none) IS captured in critical CSS but the
         `dark:block` override is NOT, so on second-load (after PageSpeed has
         inlined critical CSS) the dark logo stays display:none until async
         CSS arrives and the user briefly sees no logo at all. Force the
         correct visibility inline using the literal class-attribute
         substrings — selector specificity (0,2,1) beats any later utility. */
      html.dark img[class*='dark:hidden'] {
        display: none !important;
      }
      html.dark img[class*='dark:block'] {
        display: block !important;
      }
    </style>
    <script is:inline define:vars={{ bannerDismissKey }}>
      /* Set dark class before first paint to avoid FOUC on iOS. Must run
         synchronously in <head> before any rendering occurs. */
      (function () {
        /* Dark-only identity (CALIBER): the `.dark` class is ALWAYS applied so
           every existing `dark:` utility resolves to the instrument-black system.
           No toggle, no light theme. */
        document.documentElement.classList.add('dark');
        /* Set platform preference for 1.1 docs platform selector */
        var p = localStorage.getItem('docs-platform') || 'nginx';
        document.documentElement.setAttribute('data-active-platform', p);
        /* Hide launch banner if previously dismissed — prevents FOUC.
           INVARIANT: the localStorage key is versioned (passed in as
           bannerDismissKey). When the banner copy or link changes, bump the
           key's version suffix in BaseLayout so previously-dismissed users see
           the new banner. Do not revert to an unversioned key. */
        if (localStorage.getItem(bannerDismissKey) === '1') {
          document.documentElement.dataset.bannerDismissed = '1';
        }
      })();
    </script>
    <noscript
      ><style>
        html:not([data-active-platform]) [data-platform] {
          display: block !important;
        }
      </style></noscript
    >
    <style is:inline>
      [data-banner-dismissed='1'] #coming-soon-banner {
        display: none;
      }
    </style>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={is11Section ? legacyLabel : PRODUCT_DISPLAY_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@modpagespeed" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${PRODUCT_DISPLAY_NAME} Blog`}
      href="/blog/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- No generator meta tag — we don't advertise the Astro version to avoid
         framework-version disclosure. -->
    <!-- Umami analytics (self-hosted, privacy-first, no cookies) -->
    <script
      is:inline
      defer
      src="https://umami.we-amp.com/script.js"
      data-website-id="d32585a5-6610-4a11-8e5b-ef093fabbd20"
      data-host-url="https://modpagespeed.com"></script>
    <title>{title}</title>
    {
      jsonLdScripts.map((script) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(script)} />
      ))
    }
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-bg-primary text-text-body antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-interactive focus:px-4 focus:py-2 focus:text-on-accent"
    >
      Skip to main content
    </a>
    {
      bannerText && (
        <div
          id="coming-soon-banner"
          class="bg-bg-secondary text-text-body text-sm text-center py-2 px-4 relative border-b border-border"
        >
          <span
            aria-hidden="true"
            class="inline-block w-2 h-2 rounded-[1px] bg-interactive mr-2 align-middle"
          />
          {bannerHref ? (
            <a
              href={bannerHref}
              class="underline underline-offset-2 hover:text-interactive transition-colors"
            >
              {bannerText} <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span>{bannerText}</span>
          )}
          <button
            id="dismiss-banner"
            type="button"
            class="absolute right-2 top-1/2 -translate-y-1/2 p-2.5 text-text-muted hover:text-text-body transition-colors"
            aria-label="Dismiss banner"
            aria-controls="coming-soon-banner"
            title="Dismiss banner"
          >
            <Icon name="x" class="h-4 w-4" />
          </button>
        </div>
      )
    }
    <header class="border-b border-border bg-bg-primary sticky top-0 z-50">
      <nav class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
        <div class="flex h-16 items-center justify-between">
          <a
            href="/"
            class="flex items-center"
            aria-label={`${is11Section ? legacyLabel : currentLabel} — Home`}
          >
            <img
              src={logoLight}
              alt={is11Section ? legacyLabel : currentLabel}
              width="216"
              height="32"
              class="h-8 w-auto dark:hidden"
            />
            <img
              src={logoDark}
              alt={is11Section ? legacyLabel : currentLabel}
              width="216"
              height="32"
              class="h-8 w-auto hidden dark:block"
            />
          </a>

          {/* Desktop nav */}
          <div class="hidden md:flex items-center gap-5 lg:gap-6">
            {
              navLinks.map((link, index) =>
                link.children ? (
                  <div class="relative group nav-dropdown-group">
                    <button
                      type="button"
                      class:list={[
                        'nav-dropdown-btn text-sm font-medium tracking-wide transition-colors flex items-center gap-1',
                        link.children.some((c) => currentPath.startsWith(c.href))
                          ? 'text-interactive'
                          : 'text-text-muted hover:text-text-body',
                      ]}
                      aria-controls={`nav-panel-${index}`}
                      aria-expanded="false"
                    >
                      {link.label}
                      <Icon name="chevron-down" class="h-4 w-4 opacity-50" />
                    </button>
                    <div
                      id={`nav-panel-${index}`}
                      class="nav-dropdown-panel absolute left-0 pt-4 hidden z-50"
                    >
                      <div class="w-64 rounded-lg border border-border bg-bg-elevated shadow-lg dark:shadow-stone-900/50 py-2">
                        {link.children.map((child) => (
                          <a
                            href={child.href}
                            data-umami-event={child.umamiEvent}
                            class:list={[
                              'block px-4 py-3 hover:bg-bg-secondary transition-colors',
                              currentPath.startsWith(child.href) ? 'bg-bg-secondary' : '',
                            ]}
                          >
                            <span class="flex items-center gap-1.5">
                              <span
                                class:list={[
                                  'text-sm font-medium',
                                  currentPath.startsWith(child.href)
                                    ? 'text-interactive'
                                    : 'text-text-body',
                                ]}
                              >
                                {child.label}
                              </span>
                              {child.badge && (
                                <span class="rounded-full bg-interactive/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-interactive">
                                  {child.badge}
                                </span>
                              )}
                            </span>
                            <span class="block text-xs text-text-annotation mt-0.5">
                              {child.subtitle}
                            </span>
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                ) : (
                  <a
                    href={link.href}
                    data-umami-event={link.umamiEvent}
                    aria-current={currentPath.startsWith(link.href!) ? 'page' : undefined}
                    class:list={[
                      'text-sm font-medium tracking-wide transition-colors inline-flex items-center gap-1.5',
                      link.desktopOnlyFromLg ? 'hidden lg:inline-flex' : '',
                      currentPath.startsWith(link.href!)
                        ? 'text-interactive'
                        : 'text-text-muted hover:text-text-body',
                    ]}
                  >
                    {link.label}
                    {link.badge && (
                      <span class="rounded-full bg-interactive/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-interactive">
                        {link.badge}
                      </span>
                    )}
                  </a>
                ),
              )
            }
            <button
              type="button"
              data-qm-open
              data-umami-event="nav_message_open"
              aria-haspopup="dialog"
              class="text-sm font-medium tracking-wide transition-colors inline-flex items-center gap-1.5 text-text-muted hover:text-interactive"
            >
              <Icon name="message-square" class="h-4 w-4" />
              Message
            </button>
            <a
              href="/download/"
              data-umami-event="cta_nav_download"
              class="btn-primary ml-2 whitespace-nowrap"
            >
              Download &amp; run
            </a>
          </div>

          {
            /* Dark-only identity (CALIBER) — theme toggle removed; the site is
              rendered exclusively on the instrument-black canvas. */
          }

          {/* Mobile menu button */}
          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 text-text-muted hover:text-text-body"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                id="menu-icon-open"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
              <path
                id="menu-icon-close"
                class="hidden"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        {/* Mobile nav */}
        <div
          id="mobile-menu"
          class="hidden md:hidden pb-4 max-h-[calc(100dvh-121px)] overflow-y-auto"
        >
          {
            navLinks.map((link) =>
              link.children ? (
                <div>
                  <p class="py-2 text-xs font-semibold uppercase tracking-wider text-text-annotation">
                    {link.label}
                  </p>
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      data-umami-event={child.umamiEvent ? `${child.umamiEvent}-mobile` : undefined}
                      class:list={[
                        'block py-3 pl-4 text-sm font-medium',
                        currentPath.startsWith(child.href)
                          ? 'text-interactive'
                          : 'text-text-muted hover:text-text-body',
                      ]}
                    >
                      <span class="inline-flex items-center gap-1.5">
                        {child.label}
                        {child.badge && (
                          <span class="rounded-full bg-interactive/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-interactive">
                            {child.badge}
                          </span>
                        )}
                      </span>
                      <span class="block text-xs text-text-annotation font-normal">
                        {child.subtitle}
                      </span>
                    </a>
                  ))}
                </div>
              ) : (
                <a
                  href={link.href}
                  data-umami-event={link.umamiEvent ? `${link.umamiEvent}-mobile` : undefined}
                  aria-current={currentPath.startsWith(link.href!) ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-2 py-3 text-sm font-medium',
                    currentPath.startsWith(link.href!)
                      ? 'text-interactive'
                      : 'text-text-muted hover:text-text-body',
                  ]}
                >
                  <span>{link.label}</span>
                  {link.badge && (
                    <span class="rounded-full bg-interactive/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-interactive">
                      {link.badge}
                    </span>
                  )}
                </a>
              ),
            )
          }
          <button
            type="button"
            data-qm-open
            data-umami-event="nav_message_open_mobile"
            aria-haspopup="dialog"
