---
// The document metadata inside <head>: description, social cards, canonical
// link, icons, analytics, title and JSON-LD. The default slot sits between the
// resource hints and the Open Graph tags; the layout fills it with its inline
// critical styles and the pre-paint script, which must stay in the layout file.
//
// Markup here keeps the layout's indentation: the build does not compress
// HTML, so whitespace in this file is whitespace in every page. For the same
// reason the slot shares a line with its neighbours: the layout's slot
// content brings its own line breaks.
import { OG_DEFAULT_IMAGE } from '../../data/og-image';
import { PRODUCT_DISPLAY_NAME } from '../../data/product-facts.mjs';
import { safeJsonLd } from '../../lib/jsonld';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  csp?: string;
  breadcrumbLeafName?: string;
  breadcrumbSkipSegments?: string[];
  alternateMarkdown?: string;
  ogType?: 'website' | 'article';
  articlePublished?: Date;
  articleModified?: Date;
  canonical?: string;
}

const {
  title,
  description,
  ogImage,
  jsonLd,
  noindex = false,
  csp,
  breadcrumbLeafName,
  breadcrumbSkipSegments = [],
  alternateMarkdown,
  ogType = 'website',
  articlePublished,
  articleModified,
  canonical,
} = Astro.props;

// Per-product OG image (BRAND-10): 1.1 pages should not carry the 2.0-branded
// card. If the page passed an explicit ogImage, honor it. Otherwise pick a
// product-appropriate default.
// TODO(BRAND-10): no og-1.1.* exists in public/ yet — when a 1.1-specific OG
// card is added (e.g. public/og-1.1.png), switch the 1.1 branch below to it.
// Until then 1.1 pages fall back to the shared default rather than referencing
// a missing file.
const resolvedOgImage = ogImage ?? OG_DEFAULT_IMAGE;

const siteUrl = Astro.site ?? new URL('https://modpagespeed.com');
const absoluteOgImage = new URL(resolvedOgImage, siteUrl).href;
// og:image:type + dimensions (F140): every OG card on the site is a 1200×630
// PNG (the shared default and the per-post /og-cards/*.png). Declaring the MIME
// type and pixel dimensions helps social scrapers render the preview without a
// HEAD round-trip, and is the meta-side half of the OG fix; the deploy-side
// half (excluding the card paths from in-place image rewriting so the .png URL
// returns image/png, not WebP) is handled in nginx — see handoff note.
const ogImageType = /\.webp(\?|$)/i.test(resolvedOgImage)
  ? 'image/webp'
  : /\.avif(\?|$)/i.test(resolvedOgImage)
    ? 'image/avif'
    : /\.jpe?g(\?|$)/i.test(resolvedOgImage)
      ? 'image/jpeg'
      : 'image/png';
// Normalize to a trailing slash so a non-trailing inbound URL still emits the
// canonical (trailing-slash) form the whole site links with — keeps duplicate
// signals from splitting. File-like paths (with an extension) are left as-is.
const rawPath = Astro.url.pathname;
const canonicalPath =
  rawPath.endsWith('/') || /\.[a-z0-9]+$/i.test(rawPath) ? rawPath : `${rawPath}/`;
const canonicalUrl = canonical ?? new URL(canonicalPath, 'https://modpagespeed.com').href;

const currentPath = rawPath;

// --- BreadcrumbList JSON-LD ---
const segmentNames: Record<string, string> = {
  features: 'Features',
  analyze: 'Analyze',
  pricing: 'Pricing',
  docs: 'Docs',
  blog: 'Blog',
  demo: 'Demo',
  examples: 'Filter examples',
  calculator: 'Savings calculator',
  contact: 'Contact',
  license: 'License',
  terms: 'Terms',
  privacy: 'Privacy',
  security: 'Security',
  alternatives: 'Alternatives',
  'pagespeed-markers': 'PageSpeed markers',
  'how-it-works': 'How it works',
  'core-web-vitals': 'Core Web Vitals',
  download: 'Download',
  'aspnet-getting-started': 'ASP.NET getting started',
  'aspnet-configuration': 'ASP.NET configuration',
  platform: 'Transform packs',
  packs: 'Rule packs',
  consent: 'Consent enforcement at the origin',
  'edge-seo': 'Edge SEO at the origin',
};

// Fallback for a segment with no entry above: sentence case, with the
// acronyms the site's slugs use kept upper case ("ai-readability" becomes
// "AI readability", not "Ai Readability").
const segmentAcronyms = new Set(['ai', 'api', 'cls', 'css', 'iis', 'inp', 'js', 'lcp', 'ttfb']);
function formatSegment(segment: string): string {
  if (segmentNames[segment]) return segmentNames[segment];
  return segment
    .split('-')
    .map((word, index) =>
      segmentAcronyms.has(word)
        ? word.toUpperCase()
        : index === 0
          ? word.charAt(0).toUpperCase() + word.slice(1)
          : word,
    )
    .join(' ');
}

// The page's own title, minus a trailing " — product" or " | site" suffix,
// names the last breadcrumb when the page does not pass breadcrumbLeafName.
const titleLeafName = title.replace(/\s+[—|]\s+[^—|]*$/, '').trim();

const pathSegments = currentPath
  .replace(/^\/|\/$/g, '')
  .split('/')
  .filter(Boolean);

// Build each item's URL from the FULL, real path (cumulative up to its own
// index) before filtering — an omitted segment must not shift a later
// segment's URL, only remove its own ListItem from the visible list.
const breadcrumbItems = [
  { name: 'Home', url: 'https://modpagespeed.com/' },
  ...pathSegments
    .map((segment, index) => ({
      segment,
      name: formatSegment(segment),
      url: 'https://modpagespeed.com/' + pathSegments.slice(0, index + 1).join('/') + '/',
    }))
    .filter(({ segment }) => !breadcrumbSkipSegments.includes(segment))
    .map(({ name, url }) => ({ name, url })),
];

// Align the emitted BreadcrumbList leaf with the page's visible breadcrumb
// leaf: slug pages render their human title, but formatSegment(slug) diverges.
// When breadcrumbLeafName is provided, override the final ListItem.name.
if (breadcrumbItems.length >= 2)
  breadcrumbItems[breadcrumbItems.length - 1].name = breadcrumbLeafName ?? titleLeafName;

const breadcrumbJsonLd =
  breadcrumbItems.length >= 2
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.url,
        })),
      }
    : null;

const jsonLdEntries: Array<Record<string, unknown> | undefined> = Array.isArray(jsonLd)
  ? jsonLd
  : [jsonLd];
const jsonLdScripts = [...jsonLdEntries, breadcrumbJsonLd].filter(
  (s): s is Record<string, unknown> => Boolean(s),
);
---
    <meta charset="utf-8" />
    {csp && import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Test fingerprint (tests/global-setup.ts): only in the dev server, or in a
         build made with SITE_BUILD_ID set. Production builds do not carry it. */
    }
    {
      (import.meta.env.DEV || import.meta.env.SITE_BUILD_ID_SET) && (
        <meta name="build-id" content={import.meta.env.SITE_BUILD_ID} />
      )
    }
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <!-- Unscoped fallback first: browsers that ignore the media attribute still
         get a theme color. Media-scoped overrides follow. -->
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="preload"
      href="/fonts/inter-variable-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/plex-mono-600.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The analytics script further down is the one cross-origin request: open
         its connection early. It is fetched without CORS, hence no crossorigin. -->
    <link rel="preconnect" href="https://umami.we-amp.com" /><slot /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && articlePublished && (
      <meta property="article:published_time" content={articlePublished.toISOString()} />
    )}
    {ogType === 'article' && articleModified && (
      <meta property="article:modified_time" content={articleModified.toISOString()} />
    )}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={PRODUCT_DISPLAY_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@modpagespeed" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${PRODUCT_DISPLAY_NAME} Blog`}
      href="/blog/rss.xml"
    />
    {alternateMarkdown && <link rel="alternate" type="text/markdown" href={alternateMarkdown} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- No generator meta tag — we don't advertise the Astro version to avoid
         framework-version disclosure. -->
    <!-- Umami analytics (self-hosted, privacy-first, no cookies) -->
    <script
      is:inline
      defer
      src="https://umami.we-amp.com/script.js"
      data-website-id="d32585a5-6610-4a11-8e5b-ef093fabbd20"
      data-host-url="https://modpagespeed.com"
    ></script>
    <title>{title}</title>
    {jsonLdScripts.map((script) => (
      <script is:inline type="application/ld+json" set:html={safeJsonLd(script)} />
    ))}
