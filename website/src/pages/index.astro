<script>
  // Quick-start platform sub-tabs
  const qsTabs = document.querySelectorAll<HTMLButtonElement>('[data-qs-tab]');
  const qsPanels = document.querySelectorAll<HTMLElement>('[data-qs-panel]');

  qsTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const platform = tab.dataset.qsTab;
      qsTabs.forEach((t) => {
        t.setAttribute('aria-pressed', t.dataset.qsTab === platform ? 'true' : 'false');
      });
      qsPanels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.qsPanel !== platform);
      });
    });
  });
</script>
