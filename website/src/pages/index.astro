---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import Icon from '../components/Icon.astro';
import demoMetrics from '../data/demo-metrics.json';
import { getRelease } from '../lib/release';
import { offerJsonLd } from '../data/offer-jsonld';
import { stripHtml } from '../data/faq-shared';
import { LICENSE_CLAUSE, LICENSE_CLAUSE_CAP } from '../data/product-facts.mjs';

// Single source of truth: corp/releases/1.1.yaml synced into
// src/content/releases-1.1/release.yaml. The X-Mod-Pagespeed
// header that 1.1 emits keeps a four-segment legacy version suffix (".0") for
// monitoring built against the open-source module.
const rel11 = await getRelease('1.1');
const xModPagespeedHeader = `X-Mod-Pagespeed: ${rel11.display.header_version}.0`;

// Best AVIF savings across all demo sites — surfaced lower in the social-proof
// caption as a measured range detail. The canonical hero savings figure is the
// curl artifact's −68% (single number, used consistently above the fold per
// MKT-16); this computed value backs the honest "measured across our own demo
// sites" caption rather than the headline.
const bestSavings = Math.max(
  ...demoMetrics.sites.map((site) => {
    const before =
      site.resources.html.before +
      site.resources.css.before +
      site.resources.js.before +
      site.resources.images.totalJpeg;
    const after =
      site.resources.html.before +
      (site.resources.css.minified ?? site.resources.css.before) +
      (site.resources.js.minified ?? site.resources.js.before) +
      site.resources.images.totalAvif;
    return Math.round(((before - after) / before) * 100);
  }),
);

// Organization JSON-LD — enriched per audit B4 (2026-05-16).
// Cross-property `@id` matches iispeed.com so Google can reconcile the same
// legal entity across modpagespeed.com / iispeed.com / we-amp.com. The
// canonical URL is we-amp.com (the legal entity site), not modpagespeed.com.
// `brand` is preserved so this page still asserts the mod_pagespeed brand
// owned by We-Amp B.V.
// Home emits three top-level nodes (BaseLayout renders an array as separate
// <script> tags): the cross-property Organization, a WebSite node anchoring
// the modpagespeed.com site identity, and a SoftwareApplication + Offer so the
// highest-authority page carries the product/price entity (was Organization
// only — the product Offer previously lived only on /1.1/ and /download/).
// Lineage citations — verified third-party primary sources that name We-Amp as
// an ngx_pagespeed contributor (Google) and a founding committer of the Apache
// incubation. Used as schema.org `subjectOf` on the Organization and `citation`
// on the product node so the lineage claim is sourced, not self-asserted. These
// are credits, not endorsements (see brand provenance guardrail).
const lineageCitations = [
  {
    '@type': 'CreativeWork',
    name: 'Speed up your sites with PageSpeed for nginx (Google Developers Blog, 2013)',
    url: 'https://developers.googleblog.com/en/speed-up-your-sites-with-pagespeed-for-nginx/',
  },
  {
    '@type': 'CreativeWork',
    name: 'Apache Incubator PageSpeed Proposal',
    url: 'https://cwiki.apache.org/confluence/display/INCUBATOR/PageSpeedProposal',
  },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://we-amp.com/#organization',
  name: 'We-Amp B.V.',
  url: 'https://we-amp.com',
  logo: 'https://we-amp.com/images/weamp.svg',
  description:
    'Dutch software company building server-side web optimization technology. Maintainer of mod_pagespeed.',
  foundingDate: '2012',
  founder: {
    '@type': 'Person',
    name: 'Otto van der Schaaf',
    sameAs: ['https://www.linkedin.com/in/oschaaf', 'https://github.com/oschaaf'],
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Castricum',
    addressCountry: 'NL',
  },
  identifier: [{ '@type': 'PropertyValue', propertyID: 'KvK', value: '57898138' }],
  sameAs: [
    'https://we-amp.com',
    'https://iispeed.com',
    'https://github.com/We-Amp',
    'https://github.com/oschaaf',
  ],
  brand: {
    '@type': 'Brand',
    name: 'mod_pagespeed',
  },
  subjectOf: lineageCitations,
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://modpagespeed.com/#website',
  name: 'mod_pagespeed',
  url: 'https://modpagespeed.com/',
  publisher: { '@id': 'https://we-amp.com/#organization' },
};

const product = {
  '@context': 'https://schema.org',
  '@type': ['Product', 'SoftwareApplication'],
  name: 'mod_pagespeed 2.1',
  applicationCategory: 'WebApplication',
  operatingSystem: ['Linux'],
  description:
    `Self-hosted web performance optimization: image transcoding, critical CSS extraction, and variant-aware caching. A native module for Apache and nginx with a separate optimizer worker. ${LICENSE_CLAUSE_CAP}.`,
  image: 'https://modpagespeed.com/og-default.png?v=2',
  brand: { '@type': 'Brand', name: 'mod_pagespeed' },
  offers: offerJsonLd(),
  citation: lineageCitations,
};

// FAQPage JSON-LD — mainEntity mirrors the 6 visible Q&A pairs in the FAQ <dl>
// below. The "Why should I pay?" answer uses ONLY its prose <dd>; the
// comparison <table> in the second <dd> is excluded. Answer text is stripped of
// HTML and faithful to the rendered prose.
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'mod_pagespeed is free. What does We-Amp sell?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'Support — and hardened builds. The original mod_pagespeed and ngx_pagespeed are no longer actively developed; mod_pagespeed 2.1 is the maintained, open-source (Apache-2.0) continuation — the same directives and filters, with security fixes and a current toolchain, plus a separate optimizer worker with variant-aware caching that serves optimized variants straight from cache and optimizes off the request path. The software is free; what We-Amp sells is support plans and hardened, attested builds from the people who build it.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Does it add latency?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'No. On cache hit, serving is a hash lookup and an mmap pointer. On cache miss, the original content gets served while the worker optimizes in the background.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Can it break my site?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'Transforms are deliberately conservative — JS minification strips whitespace and comments, no variable renaming — and the design falls back to your original content when an optimization step fails. Edge cases exist: test on staging, then disable any path, URL pattern, or transform type with one line of config.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Why not just use Cloudflare?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'CDN-based optimization routes your traffic through a third-party proxy. mod_pagespeed runs on your servers — visitor data never leaves your origin, and nothing third-party sits in your request path.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'How is this different from a CDN optimizer (Cloudflare Mirage, Bunny Optimizer, Fastly IO)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          "Those rewrite assets at the edge, on infrastructure you don't control, with cache state you can't inspect. mod_pagespeed runs on your origin, so your rewrites carry your URLs, your headers, your cache policy. Use both — we optimize the origin, the CDN accelerates the delivery.",
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'How is this different from a build-time optimizer (Astro, Next.js Image, Vite plugins)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          "Those require a modern build pipeline you own end-to-end. We win when your build is owned by your CMS (WordPress, Magento, ASP.NET Framework) or your content is dynamic. If you already ship through a modern JS framework's asset pipeline, you may not need us.",
        ),
      },
    },
  ],
};

const jsonLd = [organization, website, product, faqPage];
---

<BaseLayout
  title="mod_pagespeed, maintained again: PageSpeed module for nginx & Apache"
  description={`The PageSpeed module, maintained again — ${LICENSE_CLAUSE}. mod_pagespeed 2.1 optimizes images, CSS, and JS on your own nginx or Apache. Not a CDN.`}
  jsonLd={jsonLd}
>
  {/* Hero */}
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h1 class="h1-hero text-text-body">
      Lighthouse 56 to 90.<br />
      <span class="relative inline-block text-text-body border-b-[3px] border-interactive pb-1"
        >On your own servers.</span
      >
    </h1>
    <p class="lede mt-8 max-w-xl mx-auto">
      mod_pagespeed transcodes images to AVIF, minifies CSS and JS, and injects critical CSS &mdash;
      optimized off the request path, served from cache by your own nginx or Apache. {LICENSE_CLAUSE_CAP}. No proxy, no CDN, nothing third-party in your request
      path.
    </p>
    <p class="mt-4 text-sm text-text-muted">
      Running IIS or ASP.NET Core? <a
        href="/download/"
        data-umami-event="cta_home_hero_11"
        class="font-medium text-interactive hover:underline">see mod_pagespeed 1.15 &rarr;</a
      >
    </p>
    <p class="mt-4 text-sm text-text-annotation">
      The optimization core behind <span class="font-semibold text-text-body"
        >230,000+ live sites</span
      > (<a
        href="https://trends.builtwith.com/Server/mod_pagespeed"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-stone-300 dark:decoration-stone-600 underline-offset-2 hover:text-text-body"
        >BuiltWith, May 2026</a
      >) &mdash; maintained by We-Amp, <a
        href="https://developers.googleblog.com/en/speed-up-your-sites-with-pagespeed-for-nginx/"
        target="_blank"
        rel="nofollow noopener"
        class="underline decoration-stone-300 dark:decoration-stone-600 underline-offset-2 hover:text-text-body"
        >credited by Google as an ngx_pagespeed contributor</a
      >.
    </p>

    {
      /* Proof points — measured customer outcomes, not engine internals.
        All four are byte-exact from the e-commerce case in
        src/data/demo-metrics.json (shown live on /demo/): Lighthouse 56→90,
        load 1.8s→0.8s, product image 99.7KB→23.7KB (−76%). The 4th card is the
        sovereignty anchor. Lead with the result a buyer already tracks (brand
        §2.2: the 194/32-bit-mask is the guide's own "too technical for the
        hero" counter-example; §6.1: measured benchmarks are the #1 trust
        signal). display-num treatment per §4.6; whitespace-nowrap keeps the
        before→after on one line in the 4-up grid. */
    }
    <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4 max-w-3xl mx-auto text-left">
      <div class="readout-plate px-4 py-3">
        <p
          class="display-num text-xl font-bold whitespace-nowrap text-emerald-700 dark:text-emerald-400"
        >
          56 &rarr; 90
        </p>
        <p class="mt-1 text-xs text-text-muted">Lighthouse performance score</p>
      </div>
      <div class="readout-plate px-4 py-3">
        <p
          class="display-num text-xl font-bold whitespace-nowrap text-emerald-700 dark:text-emerald-400"
        >
          1.8s &rarr; 0.8s
        </p>
        <p class="mt-1 text-xs text-text-muted">page load, cut in half</p>
      </div>
      <div class="readout-plate px-4 py-3">
        <p
          class="display-num text-xl font-bold whitespace-nowrap text-emerald-700 dark:text-emerald-400"
        >
          &minus;76%
        </p>
        <p class="mt-1 text-xs text-text-muted">product image, JPEG &rarr; AVIF</p>
      </div>
      <div class="readout-plate px-4 py-3">
        <p class="display-num text-xl font-bold text-text-body">0</p>
        <p class="mt-1 text-xs text-text-muted">third parties in the request path</p>
      </div>
    </div>
      <p class="mt-2 text-xs text-text-annotation">
        Measured on our own demo stack &mdash; <a href="/demo/" class="underline underline-offset-2 hover:text-text-body">see it live</a>.
      </p>

    <div class="mt-8 flex flex-col items-center gap-3">
      <a href="/download/" class="btn-primary" data-umami-event="cta_primary_home_hero">
        Download &amp; run
      </a>
      <p class="text-xs text-text-annotation">
        {LICENSE_CLAUSE_CAP} &mdash; install and run it freely, in development and in production.
      </p>
      <p class="text-xs text-text-annotation">
        No per-image or per-request metering like a CDN. Support &mdash; and hardened builds &mdash; are
        what&rsquo;s for sale. <a
          href="/pricing/"
          data-umami-event="cta_home_hero_pricing"
          class="font-medium text-interactive hover:underline">See support plans &rarr;</a
        >
      </p>
      <div class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-sm">
        <a
          href="/demo/"
          class="text-text-muted hover:text-interactive transition-colors underline-offset-4 hover:underline"
          >See the demo</a
        >
        <a
          href="/examples/"
          class="text-text-muted hover:text-interactive transition-colors underline-offset-4 hover:underline"
          >Browse the examples</a
        >
        <a
          href="/docs/"
          class="text-text-muted hover:text-interactive transition-colors underline-offset-4 hover:underline"
          >Read the docs</a
        >
        <a
          href="https://github.com/We-Amp/mod_pagespeed"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-interactive transition-colors underline-offset-4 hover:underline"
          >Source on GitHub</a
        >
      </div>
    </div>

    {
      /* Founder authority (MKT-2) — surfaced as a distinct credibility line,
        not buried in the 12px disclaimer. Brand-compliant phrasing: never
        names the founder in marketing prose. */
    }
    <p
      class="mt-8 inline-flex items-center gap-2 rounded-chip border border-border bg-bg-elevated px-4 py-1.5 text-sm text-text-body"
    >
      <Icon name="badge-check" class="h-4 w-4 text-interactive shrink-0" />
      Built by We-Amp — the team that helped build ngx_pagespeed and maintains mod_pagespeed
      today.
    </p>

    <p class="mt-6 text-xs text-text-annotation max-w-lg mx-auto">
      mod_pagespeed 2.1 is developed by <a
        href="https://www.we-amp.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-text-muted transition-colors">We-Amp B.V.</a
      > and is not affiliated with or endorsed by Google. mod_pagespeed is an open-source project originally
      developed at Google.
    </p>

    {
      /* Hero proof artifact — two side-by-side `curl -I` panels. The "after"
        panel highlights the X-PageSpeed: HIT header and a smaller
        Content-Length. This is the single most credible thing a developer
        can verify themselves after `dotnet run`, so we show it above the
        fold. Terminal chrome (rounded ring) is applied globally by
        `pre:has(code)` in global.css. Color highlights use Tailwind text
        utilities so dark mode flips automatically. */
    }
    <figure
      class="mt-12 max-w-4xl mx-auto"
      aria-label="curl -I output comparing response headers before and after mod_pagespeed. After shows X-PageSpeed: HIT and Content-Length reduced from 167824 to 53120 bytes."
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
        {/* Before */}
        <div>
          <div
            class="flex items-center justify-between text-xs font-semibold mb-2 text-text-annotation"
          >
            <span class="uppercase tracking-wider">Before</span>
            <span class="display-num text-text-muted">167,824 B</span>
          </div>
          <pre
            class="bg-stone-900 text-stone-100 text-xs sm:text-sm leading-relaxed p-4 overflow-x-auto"><code><span class="text-text-annotation">$ curl -I https://example.com/</span>
HTTP/2 200
content-type: text/html
<span class="text-stone-300">content-length: 167824</span>
cache-control: max-age=600
server: nginx
date: Sun, 17 May 2026 09:14:02 GMT
<span class="text-text-annotation">(no X-PageSpeed header)</span></code></pre>
        </div>
        {/* After */}
        <div>
          <div
            class="flex items-center justify-between text-xs font-semibold mb-2 text-text-annotation"
          >
            <span class="uppercase tracking-wider">After</span>
            <span
              class="inline-flex items-center gap-1.5 rounded-md bg-emerald-100 dark:bg-emerald-950 px-2 py-0.5 text-emerald-700 dark:text-emerald-300 ring-1 ring-inset ring-emerald-200 dark:ring-emerald-900"
            >
              <span class="display-num">53,120 B</span>
              <span aria-hidden="true">&middot;</span>
              <span class="display-num">&minus;68%</span>
            </span>
          </div>
          <pre
            class="bg-stone-900 text-stone-100 text-xs sm:text-sm leading-relaxed p-4 overflow-x-auto"><code><span class="text-text-annotation">$ curl -I https://example.com/</span>
HTTP/2 200
content-type: text/html
<span class="text-emerald-300">content-length: 53120</span>
cache-control: max-age=600
server: nginx
date: Sun, 17 May 2026 09:14:08 GMT
<span class="text-emerald-400 font-semibold">x-pagespeed: HIT</span> <span class="text-text-annotation">(mmap, &lt;1ms)</span></code></pre>
        </div>
      </div>
      <figcaption class="mt-3 text-xs text-text-annotation text-center">
        Illustrative &mdash; run it against your own origin. The <code class="font-mono"
          >X-PageSpeed: HIT</code
        > header confirms the response was served from the variant cache &mdash; not regenerated.
      </figcaption>
    </figure>

    {
      /* AI-traffic hook (MKT-14) — brief, links to the RenderPeek scanner.
        The ~40% stat is the wedge; keep it to one line above the fold-adjacent
        zone, not a full section. */
    }
    <a
      href="/ai-readability/"
      data-umami-event="cta_home_hero_ai_readability"
      class="group mt-10 inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-lg border border-border bg-bg-secondary px-4 py-2.5 text-sm text-text-body hover:border-interactive/40 transition-colors"
    >
      <span class="display-num font-semibold text-text-body">≈40%</span>
      <span
        >of the top 1,000 sites render almost nothing for AI assistants. Check yours with RenderPeek</span
      >
      <span class="font-medium text-interactive group-hover:underline" aria-hidden="true"
        >&rarr;</span
      >
    </a>
    <p class="mt-2 text-xs text-text-annotation">
      <a
        href="/blog/can-ai-read-your-website/"
        class="underline decoration-stone-300 dark:decoration-stone-600 underline-offset-2 hover:text-text-body"
        >(our scan, May 2026 &rarr;)</a
      >
    </p>
  </section>

  <div class="rule-ticked" role="presentation" aria-hidden="true"></div>

  {/* One product — the converged line, with availability signposted by stack */}
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="h2-section text-center text-text-body">
        One product again. The module you know, plus the worker.
      </h2>
      <p class="mt-4 text-center text-text-muted max-w-2xl mx-auto">
        mod_pagespeed 2.1 converges the two lines We-Amp shipped through 2026: the native in-process
        module that stays compatible with your existing pagespeed.conf, and the optimizer worker
        that does the heavy optimization work outside the web server. {LICENSE_CLAUSE_CAP}.
      </p>
      {
        /* disambiguator — surfaces the stack mapping so visitors on a platform the
          converged line doesn't cover yet find their line without reading cards. */
      }
      <div
        class="mt-8 mx-auto max-w-2xl rounded-lg border border-border bg-bg-secondary px-5 py-4 text-sm text-text-body"
      >
        <p class="font-semibold text-text-body">Pick by your stack</p>
        <ul class="mt-2 space-y-1">
          <li>
            <span class="font-mono text-xs text-text-annotation">nginx · Apache</span>
            &nbsp;native module + worker &rarr; <span class="font-semibold text-text-body"
              >mod_pagespeed 2.1</span
            > (this page)
          </li>
          <li>
            <span class="font-mono text-xs text-text-annotation">IIS / Windows Server</span>
            &nbsp;&rarr; <a
              href="/download/"
              data-umami-event="cta_home_disambiguator_11"
              class="font-semibold text-interactive hover:underline">mod_pagespeed 1.15</a
            > &mdash; the IIS package ships from the 1.15 packaging channel
          </li>
          <li>
            <span class="font-mono text-xs text-text-annotation">ASP.NET Core</span>
            &nbsp;&rarr; <a
              href="/docs/aspnet-getting-started/"
              data-umami-event="cta_home_disambiguator_aspnet"
              class="font-semibold text-interactive hover:underline"
              >the PageSpeed middleware
              <span class="font-mono text-xs">(WeAmp.PageSpeed.AspNetCore)</span></a
            >
          </li>
        </ul>
        <p class="mt-3 text-xs text-text-annotation">
          Every line shares the same optimization core; the converged module keeps the 1.14/1.15
          directives, so existing configuration carries over.
        </p>
      </div>
      <div class="mt-12 max-w-2xl mx-auto">
        <div class="card-product flex flex-col">
          {
            /* Capability register lit to 0xC9 — the same byte as the brand mark /
              logo, in the cyan accent: the converged card carries the live signal. */
          }
          <div class="bitstrip bitstrip-mark" aria-hidden="true">
            <i class="lit"></i><i class="lit"></i><i></i><i></i><i class="lit"></i><i></i><i></i><i
              class="lit"></i>
          </div>
          <p class="mt-4 text-lg font-semibold text-text-body">mod_pagespeed 2.1</p>
          <p class="mt-1 text-sm text-text-muted">
            The converged line &mdash; {LICENSE_CLAUSE}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span
              class="inline-flex items-center rounded-md bg-bg-secondary px-2.5 py-1 text-xs font-semibold text-text-body ring-1 ring-inset ring-border"
              >Apache</span
            >
            <span
              class="inline-flex items-center rounded-md bg-bg-secondary px-2.5 py-1 text-xs font-semibold text-text-body ring-1 ring-inset ring-border"
              >nginx</span
            >
            <span
              class="inline-flex items-center rounded-md bg-interactive/10 px-2.5 py-1 text-xs font-semibold text-interactive ring-1 ring-inset ring-interactive/40"
              >Open source &middot; Apache-2.0</span
            >
          </div>
          <ul class="mt-4 mb-6 space-y-2 text-sm text-text-muted">
            <li class="flex items-start gap-2">
              <span class="text-interactive mt-0.5">&#10003;</span> Native in-process module &mdash; no
              proxy hop; drop-in for your pagespeed.conf
            </li>
            <li class="flex items-start gap-2">
              <span class="text-interactive mt-0.5">&#10003;</span> Optimizer worker off the request path
              &mdash; ML quality + SSIMULACRA2 verification
            </li>
            <li class="flex items-start gap-2">
              <span class="text-interactive mt-0.5">&#10003;</span> Classic filters: combine, sprite,
              IPRO, domain mapping
            </li>
            <li class="flex items-start gap-2">
              <span class="text-interactive mt-0.5">&#10003;</span> Built-in
              <code class="text-xs">/pagespeed_admin/</code> console
            </li>
            <li class="flex items-start gap-2">
              <span class="text-interactive mt-0.5">&#10003;</span> Serving straight from the
              variant-aware cache &mdash; no re-optimization on the request path
            </li>
          </ul>
          <a href="/features/" class="btn-primary mt-auto"> See what it does &rarr; </a>
        </div>
      </div>
    </div>
  </section>

