---
import { OG_DEFAULT_IMAGE_URL } from '../data/og-image';
import BaseLayout from '../layouts/BaseLayout.astro';
import { roundDownDisplay } from '../lib/instrument';
import { offerJsonLd } from '../data/offer-jsonld';
import { stripHtml } from '../data/faq-shared';
import {
  BUILTWITH_SITES,
  LICENSE_CLAUSE,
  LICENSE_CLAUSE_CAP,
  MODULE_PACKAGE_VERSION,
} from '../data/product-facts.mjs';
import { productJsonLd } from '../data/software-jsonld';
import { ORGANIZATION } from '../data/organization';
import Hero from '../components/home/Hero.astro';
import Proof from '../components/home/Proof.astro';
import Install from '../components/home/Install.astro';
import SignalPath from '../components/home/SignalPath.astro';
import Spec from '../components/home/Spec.astro';
import AiReadability from '../components/home/AiReadability.astro';
import Evaluation from '../components/home/Evaluation.astro';
import Lineage from '../components/home/Lineage.astro';
import FurtherReading from '../components/home/FurtherReading.astro';
import Closing from '../components/home/Closing.astro';

// The page is nine sections and one band, one component each under
// src/components/home/ (the stack panel and product card, Product.astro,
// render inside the install section).
// This file keeps the page metadata, the JSON-LD and the global style block
// the sections share.
//
// Import order matters here and in the section components. The build orders
// the inline style blocks in <head> by each stylesheet's position in the
// import graph, so the section imports sit after the data imports, and
// Install is imported ahead of SignalPath. The order the sections render in
// is the order of the template below.

// The live-site count per BuiltWith (BUILTWITH_SITES), rendered as a defensible
// lower bound, rounded down to the nearest ten thousand. The hero and the
// lineage section both show it.
const builtwithLiveRounded = roundDownDisplay(Number(BUILTWITH_SITES.replace(/,/g, '')), 10000);

// Organization JSON-LD — enriched per audit B4 (2026-05-16).
// Cross-property `@id` matches iispeed.com so Google can reconcile the same
// legal entity across modpagespeed.com / iispeed.com / we-amp.com. The
// canonical URL is we-amp.com (the legal entity site), not modpagespeed.com.
// `brand` is preserved so this page still asserts the mod_pagespeed brand
// owned by We-Amp B.V.
// Home emits three top-level nodes (BaseLayout renders an array as separate
// <script> tags): the cross-property Organization, a WebSite node anchoring
// the modpagespeed.com site identity, and a SoftwareApplication + Offer so the
// highest-authority page carries the product/price entity (was Organization
// only — the product Offer previously lived only on /1.1/ and /download/).
// Lineage citations — verified third-party primary sources that name We-Amp as
// an ngx_pagespeed contributor (Google) and a founding committer of the Apache
// incubation. Used as schema.org `subjectOf` on the Organization and `citation`
// on the product node so the lineage claim is sourced, not self-asserted. These
// are credits, not endorsements (see brand provenance guardrail).
const lineageCitations = [
  {
    '@type': 'CreativeWork',
    name: 'Speed up your sites with PageSpeed for nginx (Google Developers Blog, 2013)',
    url: 'https://developers.googleblog.com/en/speed-up-your-sites-with-pagespeed-for-nginx/',
  },
  {
    '@type': 'CreativeWork',
    name: 'Apache Incubator PageSpeed Proposal',
    url: 'https://cwiki.apache.org/confluence/display/INCUBATOR/PageSpeedProposal',
  },
];

const organization = {
  '@context': 'https://schema.org',
  ...ORGANIZATION,
  subjectOf: lineageCitations,
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://modpagespeed.com/#website',
  name: 'mod_pagespeed',
  url: 'https://modpagespeed.com/',
  publisher: { '@id': 'https://we-amp.com/#organization' },
};

const product = await productJsonLd({
  description: `Self-hosted web performance optimization: image transcoding, critical CSS extraction, and variant-aware caching. A native module for Apache and nginx with a separate optimizer worker. ${LICENSE_CLAUSE_CAP}.`,
  image: OG_DEFAULT_IMAGE_URL,
  offers: offerJsonLd(),
  citation: lineageCitations,
});

// FAQPage JSON-LD — mainEntity mirrors the 6 visible Q&A pairs in the FAQ <dl>
// below. The "Why should I pay?" answer uses ONLY its prose <dd>; the
// comparison <table> in the second <dd> is excluded. Answer text is stripped of
// HTML and faithful to the rendered prose.
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'mod_pagespeed is free. What does We-Amp sell?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'Support. The original mod_pagespeed and ngx_pagespeed are no longer actively developed; the current mod_pagespeed is the maintained, open-source (Apache-2.0) continuation: the same directives and filters, with security fixes and a current toolchain, plus a separate optimizer worker with variant-aware caching that serves optimized variants straight from cache and optimizes off the request path. The software is free; what We-Amp sells is support plans from the people who build it.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Does it add latency?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'No. On cache hit, serving is a hash lookup and an mmap pointer. On cache miss, the original content gets served while the worker optimizes in the background.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Can it break my site?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'Transforms are deliberately conservative — JS minification strips whitespace and comments, no variable renaming — and the design falls back to your original content when an optimization step fails. Edge cases exist: test on staging, then disable any path, URL pattern, or transform type with one line of config.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Why not just use Cloudflare?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'CDN-based optimization routes your traffic through a third-party proxy. mod_pagespeed runs on your servers — visitor data never leaves your origin, and nothing third-party sits in your request path.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'How is this different from a CDN optimizer (Cloudflare Mirage, Bunny Optimizer, Fastly IO)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          "Those rewrite assets at the edge, on infrastructure you don't control, with cache state you can't inspect. mod_pagespeed runs on your origin, so your rewrites carry your URLs, your headers, your cache policy. Use both — we optimize the origin, the CDN accelerates the delivery.",
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'How is this different from a build-time optimizer (Astro, Next.js Image, Vite plugins)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          "Those require a modern build pipeline you own end-to-end. We win when your build is owned by your CMS (WordPress, Magento, ASP.NET Framework) or your content is dynamic. If you already ship through a modern JS framework's asset pipeline, you may not need us.",
        ),
      },
    },
  ],
};

const jsonLd = [organization, website, product, faqPage];
---

<BaseLayout
  title="PageSpeed module for nginx and Apache: mod_pagespeed"
  description={`The PageSpeed module, maintained again and ${LICENSE_CLAUSE}. Install mod_pagespeed on nginx or Apache with apt or yum.`}
  jsonLd={jsonLd}
>
  {/* Hero — instrument layout: message left, the measured readout panel on
      the right at >=1024px; stacked with the panel right after the CTA block
      on narrow screens. The proof strip and the affiliation notice follow. */}
  <Hero liveSites={builtwithLiveRounded} />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* Global, not scoped: a scoped block stamps every element on this page with
      a per-component id attribute, which adds ~9 kB to the HTML. These class
      names are used only here. */}
  <style is:global>
    /* Hero instrument layout: two columns at >=1024px, stacked below. */
    .hero-grid {
      display: grid;
      gap: 2.5rem;
    }
    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: 3.5rem;
        align-items: start;
      }
    }
    .hero-lede {
      max-width: 34em;
    }
    /* Desktop: a 56px headline and a one-line mono subhead, so the hero and
       the proof strip fit the first screen. */
    @media (min-width: 1024px) {
      .hero-grid .h1-hero {
        font-size: 3.5rem;
        line-height: 1.08;
      }
      .hero-grid .hero-sub {
        font-size: 0.4em;
      }
      .hero-lede {
        font-size: 1.125rem;
      }
    }
    /* Two buttons, then the docs text link. On phones the two buttons share
       the first row and the text link takes its own line. */
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
    }
    .hero-docs {
      margin-left: 0.5rem;
      font-size: 0.875rem;
      /* Same 44px target height as the buttons beside it. */
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
    @media (max-width: 639px) {
      .hero-actions > .btn-primary,
      .hero-actions > .btn-secondary {
        flex: 1 1 auto;
        white-space: nowrap;
      }
      .hero-docs {
        margin-left: 0;
        min-height: 1.5rem;
      }
    }
    /* Proof strip: a short label over one sentence, four columns on desktop,
       two by two from 640px. */
    .proof-strip {
      display: grid;
      gap: 1rem 1.5rem;
      padding-block: 1.125rem;
    }
    @media (min-width: 640px) {
      .proof-strip {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (min-width: 1024px) {
      .proof-strip {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
    .proof-strip dt {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-text-body);
    }
    .proof-strip dd {
      margin: 0.125rem 0 0;
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--color-text-muted);
    }
    .hero-sub {
      font-family: var(--font-mono);
      font-size: 0.48em;
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1.4;
    }
    /* Hero readout title: never split mid-label; on narrow screens the
       live-link chip drops to its own line instead. */
    #home-readout {
      white-space: nowrap;
    }
    div:has(> #home-readout) {
      flex-wrap: wrap;
      row-gap: 1rem;
    }
    /* Mono panel title row (instrument faceplate label). */
    .panel-title {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-text-annotation);
    }
    /* Stack picker rows: a mono label column, hairline between rows. */
    .stack-list {
      margin-top: 0.75rem;
    }
    .stack-list li {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.125rem;
      padding-block: 0.625rem;
      border-top: 1px solid var(--color-border);
    }
    .stack-list li:first-child {
      border-top: 0;
    }
    @media (min-width: 520px) {
      .stack-list li {
        grid-template-columns: 9.5rem 1fr;
        gap: 0.75rem;
      }
    }
    .stack-key {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--color-text-body);
    }
    /* Capability list: the check is a decorative [x] field mark in CSS, so the
       text nodes stay the plain item wording. */
    .check-list li {
      position: relative;
      padding-left: 1.75rem;
      padding-block: 0.5rem;
      border-top: 1px dashed var(--color-border);
    }
    .check-list li:first-child {
      border-top: 0;
    }
    .check-list li::before {
      content: '[x]';
      position: absolute;
      left: 0;
      top: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.65;
      color: var(--color-success);
    }
    /* Signal-path diagram: every colour is a design token, applied via
       these classes so the SVG geometry stays untouched. */
    .dg-fill-neutral {
      fill: var(--color-text-body);
    }
    .dg-fill-body {
      fill: var(--color-text-body);
    }
    .dg-fill-muted {
      fill: var(--color-text-muted);
    }
    .dg-fill-annot {
      fill: var(--color-text-annotation);
    }
    .dg-fill-success {
      fill: var(--color-success);
    }
    .dg-fill-accent {
      fill: var(--color-accent);
    }
    .dg-fill-interactive {
      fill: var(--color-interactive);
    }
    /* A ground-coloured outline behind a label that sits on a line. */
    .dg-halo {
      paint-order: stroke;
      stroke: var(--color-bg-primary);
      stroke-width: 4px;
      stroke-linejoin: round;
    }
    .dg-stroke-lane {
      stroke: var(--color-border);
    }
    .dg-node {
      fill: var(--color-bg-elevated);
      stroke: var(--color-border-strong);
    }
    .dg-node-interactive {
      fill: var(--color-interactive-wash);
      stroke: var(--color-interactive);
    }
    .dg-node-hit {
      fill: var(--color-success-wash);
      stroke: var(--color-success);
    }
    .dg-node-miss {
      fill: var(--color-accent-wash);
      stroke: var(--color-accent);
    }
    .dg-node-cache {
      fill: var(--color-bg-secondary);
      stroke: var(--color-border-strong);
    }
    .dg-edge-neutral {
      stroke: var(--color-text-body);
    }
    .dg-edge-hit {
      stroke: var(--color-success);
    }
    .dg-edge-miss {
      stroke: var(--color-accent);
    }
    .dg-edge-async {
      stroke: var(--color-interactive);
    }
    .dg-edge-faint {
      stroke: var(--color-text-annotation);
    }
    /* Install steps: one caption row, three columns from 768px, a hairline
       over each step. */
    .step-row {
      display: grid;
      gap: 1.25rem 2rem;
    }
    @media (min-width: 768px) {
      .step-row {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    .step-row > li {
      padding-top: 0.875rem;
      border-top: 1px solid var(--color-border);
    }
    /* Step labels: mono "STEP n". */
    .step-no {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--color-interactive);
    }
    /* Specification cards: the mono readout row over a hairline. */
    .card-ro {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.75rem;
      padding-bottom: 0.625rem;
      border-bottom: 1px solid var(--color-border);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-annotation);
    }
    .card-ro b {
      color: var(--color-interactive);
      font-weight: 600;
    }
    /* Evaluation FAQ: a --color-border hairline between Q&A pairs. */
    .faq-list > div {
      padding-block: 1.25rem;
      border-top: 1px solid var(--color-border);
    }
    .faq-list > div:first-child {
      border-top: 0;
      padding-top: 0;
    }
    .faq-list > div:last-child {
      padding-bottom: 0;
    }
    /* Two columns of questions from 1024px, filled top to bottom so a long
       answer does not leave a gap beside a short one. Every pair starts on a
       hairline there. */
    @media (min-width: 1024px) {
      .faq-list {
        column-count: 2;
        column-gap: 3rem;
      }
      .faq-list > div,
      .faq-list > div:first-child,
      .faq-list > div:last-child {
        break-inside: avoid;
        border-top: 1px solid var(--color-border);
        padding-block: 1.25rem;
      }
    }

    /* Section spacing used only on this page. Written here rather than as
       utility classes so that the stylesheet every other page loads does
       not carry them. Kept in the utilities layer so they cascade exactly
       as the utilities they replace. */
    @layer utilities {
      .home-proof-grid,
      .home-lineage-grid {
        gap: calc(var(--spacing) * 10);
      }
      .home-band-y {
        border-block-style: var(--tw-border-style);
        border-block-width: 1px;
      }
      .home-band-ai {
        padding-block: calc(var(--spacing) * 10);
      }
      .home-reading {
        padding-top: calc(var(--spacing) * 13);
      }
      @media (width >= 40rem) {
        .home-reading {
          padding-top: calc(var(--spacing) * 18);
        }
      }
      @media (width >= 64rem) {
        .home-hero-top {
          padding-top: calc(var(--spacing) * 14);
        }
        .home-proof-grid {
          gap: calc(var(--spacing) * 12);
        }
        .home-lineage-grid {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
          align-items: center;
        }
        .home-lineage-num {
          font-size: var(--text-3xl);
          line-height: var(--tw-leading, var(--text-3xl--line-height));
        }
      }
    }
  </style>

  {/* 01 — the install procedure: the three steps as a caption row, the
      install command per platform, then the stack panel and the product
      card. */}
  <Install />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* 02 — this site runs the binary it sells: the captured response headers
      of this very page, the HIT/MISS header the nginx module adds, and
      the public admin console. */}
  <Proof />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* 03 — the request path as a signal diagram: sync lane on top, async
      worker lane below. Colours are tokens via the dg-* classes above;
      geometry, <title> and the figure aria-label are unchanged. */}
  <SignalPath />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* 04 — the specification: the six capability cards as readout panels,
      each readout restating its own card text. */}
  <Spec />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* The AI-readability scan: one line plus its source. */}
  <AiReadability />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* 05 — evaluation FAQ: always-expanded <dl>, hairline between pairs, two
      columns from 1024px; mirrors the FAQPage JSON-LD. */}
  <Evaluation />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* 06 — the lineage: heritage stats as engraved readout plates. */}
  <Lineage liveSites={builtwithLiveRounded} />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* Further reading: four docs and blog cards, then the closing panel. */}
  <FurtherReading />

  {/* CTA — a featured panel on the primary ground. The full-cyan band is
      retired: the design allows one cyan fill per viewport, and the band
      plus the primary button made two. The sponsor link is its last line. */}
  <Closing />
</BaseLayout>
