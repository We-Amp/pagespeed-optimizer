---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import Icon from '../components/Icon.astro';
import Readout from '../components/instrument/Readout.astro';
import ReadoutPanel from '../components/instrument/ReadoutPanel.astro';
import SectionHeader from '../components/instrument/SectionHeader.astro';
import TermPanel from '../components/instrument/TermPanel.astro';
import HitMissBadge from '../components/instrument/HitMissBadge.astro';
import Chip from '../components/instrument/Chip.astro';
import { formatPct, monthYear, pctDelta, roundDownDisplay } from '../lib/instrument';
import demoMetrics from '../data/demo-metrics.json';
import telemetryCapture from '../data/telemetry-capture.json';
import { offerJsonLd } from '../data/offer-jsonld';
import { stripHtml } from '../data/faq-shared';
import {
  BUILTWITH_AS_OF,
  BUILTWITH_HISTORICAL,
  BUILTWITH_SITES,
  LICENSE_CLAUSE,
  LICENSE_CLAUSE_CAP,
  MAX_VARIANTS,
  MODULE_PACKAGE_VERSION,
} from '../data/product-facts.mjs';
import { PRODUCT_OPERATING_SYSTEMS, productSoftwareVersion } from '../data/software-jsonld';

const softwareVersion = await productSoftwareVersion();

// Hero readout panel: the e-commerce case from src/data/demo-metrics.json
// (measured on the demo store; the label date comes from generated_at).
const demoStore = demoMetrics.sites.find((site) => site.id === 'ecommerce');
if (!demoStore) throw new Error('demo-metrics.json: the ecommerce site entry is missing');
const demoLighthouse = demoStore.lighthouse;
const demoLoad = demoStore.loadTime;
const demoImageJpeg = demoStore.resources.images.totalJpeg;
const demoImageAvif = demoStore.resources.images.totalAvif;
const demoImageDelta = formatPct(pctDelta(demoImageJpeg, demoImageAvif));
const demoMeasured = `Measured on our demo store, ${monthYear(demoMetrics.generated_at)}.`;

// Section 01 header panel: the captured response headers of this site's
// homepage, verbatim from src/data/telemetry-capture.json (written by
// scripts/capture-telemetry.mjs against production). The status line says
// HTTP/1.1 because the capture client (node:https) speaks HTTP/1.1.
type TermLine = { text: string; tone?: 'plain' | 'strong' | 'hl' | 'ok' | 'dim' };
const homeCapture = telemetryCapture.paths['/'];
const homeCaptureHeaders = homeCapture.headers;
const capturedDate = telemetryCapture.capturedAt.slice(0, 10);
const headerPanelLines: TermLine[] = [
  { text: `HTTP/1.1 ${homeCapture.status}`, tone: 'strong' },
  { text: `content-type: ${homeCaptureHeaders['content-type']}`, tone: 'plain' },
  { text: `content-length: ${homeCaptureHeaders['content-length']}`, tone: 'strong' },
  { text: `x-mod-pagespeed: ${homeCaptureHeaders['x-mod-pagespeed']}`, tone: 'hl' },
  { text: `vary: ${homeCaptureHeaders.vary}`, tone: 'plain' },
  { text: `content-encoding: ${homeCaptureHeaders['content-encoding']}`, tone: 'plain' },
  { text: `cache-control: ${homeCaptureHeaders['cache-control']}`, tone: 'plain' },
];

// Section 04 quick-start panels: the install transcripts, one TermPanel per
// platform (moved from the signal-path section). Each transcript ends with
// the verify command and the header its module emits — X-Page-Speed for the
// nginx module, X-Mod-Pagespeed for the Apache module — with the version of
// the currently published module packages (MODULE_PACKAGE_VERSION in
// src/data/product-facts.mjs, checked against the package index), not the
// version production happens to run.
const qsNginxLines: TermLine[] = [
  { text: '# one-time: add the signed We-Amp package repo', tone: 'dim' },
  {
    text: '$ curl -fsSL https://packages.modpagespeed.com/install.sh | sudo sh',
    tone: 'strong',
  },
  { text: '$ sudo apt install nginx-module-pagespeed', tone: 'strong' },
  { text: '# Add to nginx.conf: pagespeed on;', tone: 'dim' },
  { text: '$ sudo nginx -t && sudo systemctl reload nginx', tone: 'strong' },
  { text: '$ curl -I http://localhost/ | grep X-Page-Speed', tone: 'strong' },
  { text: `X-Page-Speed: ${MODULE_PACKAGE_VERSION}`, tone: 'ok' },
];
const qsApacheLines: TermLine[] = [
  { text: '# one-time: add the signed We-Amp package repo', tone: 'dim' },
  {
    text: '$ curl -fsSL https://packages.modpagespeed.com/install.sh | sudo sh',
    tone: 'strong',
  },
  { text: '$ sudo apt install mod-pagespeed', tone: 'strong' },
  { text: '$ sudo systemctl restart apache2', tone: 'strong' },
  { text: '$ curl -I http://localhost/ | grep X-Mod-Pagespeed', tone: 'strong' },
  { text: `X-Mod-Pagespeed: ${MODULE_PACKAGE_VERSION}`, tone: 'ok' },
];

// Section 06 heritage stats: 231,341 live sites per BuiltWith, rendered as a
// defensible lower bound ("230,000+"). The historical figures derive from
// BUILTWITH_HISTORICAL ("1.9 million+").
const builtwithLiveRounded = roundDownDisplay(Number(BUILTWITH_SITES.replace(/,/g, '')), 10000);
const builtwithHistoricalShort = BUILTWITH_HISTORICAL.replace(/\+$/, '');
const builtwithHistoricalCount = `${(parseFloat(BUILTWITH_HISTORICAL) * 1_000_000).toLocaleString('en-US')}+`;

// Best AVIF savings across all demo sites — the measured range detail in the
// dogfooding paragraph ("up to N% smaller pages").
const bestSavings = Math.max(
  ...demoMetrics.sites.map((site) => {
    const before =
      site.resources.html.before +
      site.resources.css.before +
      site.resources.js.before +
      site.resources.images.totalJpeg;
    const after =
      site.resources.html.before +
      (site.resources.css.minified ?? site.resources.css.before) +
      (site.resources.js.minified ?? site.resources.js.before) +
      site.resources.images.totalAvif;
    return Math.round(((before - after) / before) * 100);
  }),
);

// Organization JSON-LD — enriched per audit B4 (2026-05-16).
// Cross-property `@id` matches iispeed.com so Google can reconcile the same
// legal entity across modpagespeed.com / iispeed.com / we-amp.com. The
// canonical URL is we-amp.com (the legal entity site), not modpagespeed.com.
// `brand` is preserved so this page still asserts the mod_pagespeed brand
// owned by We-Amp B.V.
// Home emits three top-level nodes (BaseLayout renders an array as separate
// <script> tags): the cross-property Organization, a WebSite node anchoring
// the modpagespeed.com site identity, and a SoftwareApplication + Offer so the
// highest-authority page carries the product/price entity (was Organization
// only — the product Offer previously lived only on /1.1/ and /download/).
// Lineage citations — verified third-party primary sources that name We-Amp as
// an ngx_pagespeed contributor (Google) and a founding committer of the Apache
// incubation. Used as schema.org `subjectOf` on the Organization and `citation`
// on the product node so the lineage claim is sourced, not self-asserted. These
// are credits, not endorsements (see brand provenance guardrail).
const lineageCitations = [
  {
    '@type': 'CreativeWork',
    name: 'Speed up your sites with PageSpeed for nginx (Google Developers Blog, 2013)',
    url: 'https://developers.googleblog.com/en/speed-up-your-sites-with-pagespeed-for-nginx/',
  },
  {
    '@type': 'CreativeWork',
    name: 'Apache Incubator PageSpeed Proposal',
    url: 'https://cwiki.apache.org/confluence/display/INCUBATOR/PageSpeedProposal',
  },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://we-amp.com/#organization',
  name: 'We-Amp B.V.',
  url: 'https://we-amp.com',
  logo: 'https://we-amp.com/images/weamp.svg',
  description:
    'Dutch software company building server-side web optimization technology. Maintainer of mod_pagespeed.',
  foundingDate: '2012',
  founder: {
    '@type': 'Person',
    name: 'Otto van der Schaaf',
    sameAs: ['https://www.linkedin.com/in/oschaaf', 'https://github.com/oschaaf'],
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Castricum',
    addressCountry: 'NL',
  },
  identifier: [{ '@type': 'PropertyValue', propertyID: 'KvK', value: '57898138' }],
  sameAs: [
    'https://we-amp.com',
    'https://iispeed.com',
    'https://github.com/We-Amp',
    'https://github.com/oschaaf',
  ],
  brand: {
    '@type': 'Brand',
    name: 'mod_pagespeed',
  },
  subjectOf: lineageCitations,
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://modpagespeed.com/#website',
  name: 'mod_pagespeed',
  url: 'https://modpagespeed.com/',
  publisher: { '@id': 'https://we-amp.com/#organization' },
};

const product = {
  '@context': 'https://schema.org',
  '@type': ['Product', 'SoftwareApplication'],
  name: 'mod_pagespeed 2.1',
  applicationCategory: 'WebApplication',
  operatingSystem: PRODUCT_OPERATING_SYSTEMS,
  softwareVersion,
  description:
    `Self-hosted web performance optimization: image transcoding, critical CSS extraction, and variant-aware caching. A native module for Apache and nginx with a separate optimizer worker. ${LICENSE_CLAUSE_CAP}.`,
  image: 'https://modpagespeed.com/og-default.png?v=2',
  brand: { '@type': 'Brand', name: 'mod_pagespeed' },
  offers: offerJsonLd(),
  citation: lineageCitations,
};

// FAQPage JSON-LD — mainEntity mirrors the 6 visible Q&A pairs in the FAQ <dl>
// below. The "Why should I pay?" answer uses ONLY its prose <dd>; the
// comparison <table> in the second <dd> is excluded. Answer text is stripped of
// HTML and faithful to the rendered prose.
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'mod_pagespeed is free. What does We-Amp sell?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'Support, and a private package repository (being set up). The original mod_pagespeed and ngx_pagespeed are no longer actively developed; mod_pagespeed 2.1 is the maintained, open-source (Apache-2.0) continuation: the same directives and filters, with security fixes and a current toolchain, plus a separate optimizer worker with variant-aware caching that serves optimized variants straight from cache and optimizes off the request path. The software is free; what We-Amp sells is support plans, and a private package repository (being set up), from the people who build it.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Does it add latency?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'No. On cache hit, serving is a hash lookup and an mmap pointer. On cache miss, the original content gets served while the worker optimizes in the background.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Can it break my site?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'Transforms are deliberately conservative — JS minification strips whitespace and comments, no variable renaming — and the design falls back to your original content when an optimization step fails. Edge cases exist: test on staging, then disable any path, URL pattern, or transform type with one line of config.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'Why not just use Cloudflare?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          'CDN-based optimization routes your traffic through a third-party proxy. mod_pagespeed runs on your servers — visitor data never leaves your origin, and nothing third-party sits in your request path.',
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'How is this different from a CDN optimizer (Cloudflare Mirage, Bunny Optimizer, Fastly IO)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          "Those rewrite assets at the edge, on infrastructure you don't control, with cache state you can't inspect. mod_pagespeed runs on your origin, so your rewrites carry your URLs, your headers, your cache policy. Use both — we optimize the origin, the CDN accelerates the delivery.",
        ),
      },
    },
    {
      '@type': 'Question',
      name: 'How is this different from a build-time optimizer (Astro, Next.js Image, Vite plugins)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(
          "Those require a modern build pipeline you own end-to-end. We win when your build is owned by your CMS (WordPress, Magento, ASP.NET Framework) or your content is dynamic. If you already ship through a modern JS framework's asset pipeline, you may not need us.",
        ),
      },
    },
  ],
};

const jsonLd = [organization, website, product, faqPage];
---

<BaseLayout
  title="PageSpeed module for nginx and Apache: mod_pagespeed 2.1"
  description={`The PageSpeed module, maintained again and ${LICENSE_CLAUSE}. Install mod_pagespeed 2.1 on nginx or Apache with apt or yum.`}
  jsonLd={jsonLd}
>
  {/* Hero — instrument layout: message left, the measured readout panel on
      the right at >=1024px; stacked with the panel right after the CTA block
      on narrow screens. */}
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-16 pb-14">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">open source &middot; Apache-2.0</p>
        <h1 class="h1-hero hero-title mt-4 text-text-body">
          <span class="block"
            >mod_pagespeed 2.1, the PageSpeed module for nginx and Apache</span
          >
          <span class="hero-sub mt-4 block text-interactive"
            >Lighthouse <span class="text-text-body">56</span> to <span class="text-text-body">90</span
            >. On your own servers.</span
          >
        </h1>
        <p class="lede mt-6 max-w-xl">
          mod_pagespeed transcodes images to AVIF, minifies CSS and JS, and injects critical CSS &mdash;
          optimized off the request path, served from cache by your own nginx or Apache. {LICENSE_CLAUSE_CAP}. No proxy, no CDN, nothing third-party in your request
          path.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/download/" class="btn-primary" data-umami-event="cta_primary_home_hero">
            Download &amp; run
          </a>
          <a href="/demo/" class="btn-secondary">See the demo</a>
          <a href="/docs/" class="btn-secondary">Read the docs</a>
        </div>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
          <a
            href="/examples/"
            class="text-text-muted hover:text-interactive transition-colors underline-offset-4 hover:underline"
            >Browse the examples</a
          >
          <a
            href="https://github.com/We-Amp/mod_pagespeed"
            rel="noopener noreferrer"
            class="text-text-muted hover:text-interactive transition-colors underline-offset-4 hover:underline"
            >Source on GitHub</a
          >
        </div>
        <p class="mt-4 text-sm text-text-muted">
          Running IIS or ASP.NET Core? <a
            href="/download/"
            data-umami-event="cta_home_hero_11"
            class="font-medium text-interactive hover:underline">see the IIS and ASP.NET Core packages &rarr;</a
          >
        </p>
        <p class="mt-4 text-sm text-text-annotation">
          The optimization core behind <span class="font-semibold text-text-body"
            >{builtwithLiveRounded} live sites</span
          > (<a
            href="https://trends.builtwith.com/Server/mod_pagespeed"
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-stone-300 dark:decoration-stone-600 underline-offset-2 hover:text-text-body"
            >BuiltWith, {BUILTWITH_AS_OF}</a
          >) &mdash; maintained by We-Amp.
        </p>
        <p class="mt-4 text-xs text-text-annotation">
          {LICENSE_CLAUSE_CAP} &mdash; install and run it freely, in development and in production.
        </p>
        <p class="mt-2 text-xs text-text-annotation">
          No per-image or per-request metering like a CDN. Support, and a private package repository (being set up), from the people who build it are
          what&rsquo;s for sale. <a
            href="/pricing/"
            data-umami-event="cta_home_hero_pricing"
            class="font-medium text-interactive hover:underline">See support plans &rarr;</a
          >
        </p>
      </div>

      {
        /* Measured readout panel: the e-commerce demo store numbers from
          src/data/demo-metrics.json (source + date in the caption). */
      }
      <div class="mt-10 lg:mt-0">
        <ReadoutPanel
          id="home-readout"
          title="Readout · demo store"
          source={demoMeasured}
          href="/demo/"
          hrefLabel="see it live"
        >
          <Readout
            label="Lighthouse performance score"
            before={String(demoLighthouse.before)}
            after={String(demoLighthouse.after)}
            gauge={{ min: 0, max: 100, before: demoLighthouse.before, after: demoLighthouse.after }}
          />
          <Readout
            label="page load, cut in half (simulated 3G)"
            before={`${demoLoad.before}s`}
            after={`${demoLoad.after}s`}
            gauge={{ min: 0, max: 2, before: demoLoad.before, after: demoLoad.after }}
          />
          <Readout
            label="product image, JPEG → AVIF"
            after={demoImageDelta}
            gauge={{ min: 0, max: demoImageJpeg, before: demoImageJpeg, after: demoImageAvif }}
          />
          <Readout label="third parties in the request path" after="0" tone="neutral" />
        </ReadoutPanel>
      </div>
    </div>

    {
      /* Founder authority — a distinct credibility line, not buried in the
        small print. Brand-compliant phrasing: never names the founder in
        marketing prose. */
    }
    <p
      class="mt-8 inline-flex items-center gap-2 rounded-chip border border-border bg-bg-elevated px-4 py-1.5 text-sm text-text-body"
    >
      <Icon name="badge-check" class="h-4 w-4 text-interactive shrink-0" />
      Built by We-Amp — the team that helped build ngx_pagespeed and maintains mod_pagespeed
      today.
    </p>

    <p class="mt-6 text-xs text-text-annotation max-w-lg">
      mod_pagespeed 2.1 is developed by <a
        href="https://we-amp.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-text-muted transition-colors">We-Amp B.V.</a
      > and is not affiliated with or endorsed by Google. mod_pagespeed is an open-source project originally
      developed at Google.
    </p>

    {
      /* AI-traffic hook — one line plus its source, the last hero row. */
    }
    <div class="mt-10">
      <a
        href="/ai-readability/"
        data-umami-event="cta_home_hero_ai_readability"
        class="group inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-lg border border-border bg-bg-secondary px-4 py-2.5 text-sm text-text-body hover:border-interactive/40 transition-colors"
      >
        <span class="display-num font-semibold text-text-body">≈40%</span>
        <span
          >of the top 1,000 sites render almost nothing for AI assistants. Check yours with RenderPeek</span
        >
        <span class="font-medium text-interactive group-hover:underline" aria-hidden="true"
          >&rarr;</span
        >
      </a>
      <p class="mt-2 text-xs text-text-annotation">
        <a
          href="/blog/can-ai-read-your-website/"
          class="underline decoration-stone-300 dark:decoration-stone-600 underline-offset-2 hover:text-text-body"
          >(our scan, May 2026 &rarr;)</a
        >
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="rule-ticked-scale" role="presentation" aria-hidden="true"></div>
  </div>

  {/* Global, not scoped: a scoped block stamps every element on this page with
      a per-component id attribute, which adds ~9 kB to the HTML. These class
      names are used only here. */}
  <style is:global>
    /* Hero instrument layout: two columns at >=1024px, stacked below. */
    .hero-grid {
      display: grid;
      gap: 2.5rem;
    }
    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1.1fr 0.9fr;
        align-items: start;
      }
    }
    .hero-title {
      font-weight: 800;
      letter-spacing: -0.035em;
    }
    .hero-sub {
      font-family: var(--font-mono);
      font-size: 0.48em;
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.4;
    }
    /* Hero readout title: never split mid-label; on narrow screens the
       live-link chip drops to its own line instead. */
    #home-readout {
      white-space: nowrap;
    }
    div:has(> #home-readout) {
      flex-wrap: wrap;
      row-gap: 1rem;
    }
    /* Mono panel title row (instrument faceplate label). */
    .panel-title {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-text-annotation);
    }
    /* Stack picker rows: a mono label column, hairline between rows. */
    .stack-list {
      margin-top: 0.75rem;
    }
    .stack-list li {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.125rem;
      padding-block: 0.625rem;
      border-top: 1px solid var(--color-border);
    }
    .stack-list li:first-child {
      border-top: 0;
    }
    @media (min-width: 520px) {
      .stack-list li {
        grid-template-columns: 9.5rem 1fr;
        gap: 0.75rem;
      }
    }
    .stack-key {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--color-text-body);
    }
    /* Capability list: the check is a decorative [x] field mark in CSS, so the
       text nodes stay the plain item wording. */
    .check-list li {
      position: relative;
      padding-left: 1.75rem;
      padding-block: 0.5rem;
      border-top: 1px dashed var(--color-border);
    }
    .check-list li:first-child {
      border-top: 0;
    }
    .check-list li::before {
      content: '[x]';
      position: absolute;
      left: 0;
      top: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.65;
      color: var(--color-success);
    }
    /* Signal-path diagram: every colour is a design token, applied via
       these classes so the SVG geometry stays untouched. */
    .dg-fill-neutral {
      fill: var(--color-text-body);
    }
    .dg-fill-body {
      fill: var(--color-text-body);
    }
    .dg-fill-muted {
      fill: var(--color-text-muted);
    }
    .dg-fill-annot {
      fill: var(--color-text-annotation);
    }
    .dg-fill-success {
      fill: var(--color-success);
    }
    .dg-fill-accent {
      fill: var(--color-accent);
    }
    .dg-fill-interactive {
      fill: var(--color-interactive);
    }
    .dg-stroke-lane {
      stroke: var(--color-border);
    }
    .dg-node {
      fill: var(--color-bg-elevated);
      stroke: var(--color-border-strong);
    }
    .dg-node-interactive {
      fill: var(--color-interactive-wash);
      stroke: var(--color-interactive);
    }
    .dg-node-hit {
      fill: var(--color-success-wash);
      stroke: var(--color-success);
    }
    .dg-node-miss {
      fill: var(--color-accent-wash);
      stroke: var(--color-accent);
    }
    .dg-node-cache {
      fill: var(--color-bg-secondary);
      stroke: var(--color-border-strong);
    }
    .dg-edge-neutral {
      stroke: var(--color-text-body);
    }
    .dg-edge-hit {
      stroke: var(--color-success);
    }
    .dg-edge-miss {
      stroke: var(--color-accent);
    }
    .dg-edge-async {
      stroke: var(--color-interactive);
    }
    .dg-edge-faint {
      stroke: var(--color-text-annotation);
    }
    /* Step panels: mono "STEP n" with the right-aligned mono tag. */
    .step-no {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--color-interactive);
    }
    /* Specification cards: the mono readout row over a hairline. */
    .card-ro {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.75rem;
      padding-bottom: 0.625rem;
      border-bottom: 1px solid var(--color-border);
      font-family: var(--font-mono);
