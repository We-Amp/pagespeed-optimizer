import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message received"
  description="Your message to the mod_pagespeed team has been received. An engineer replies within one business day (CET)."
  noindex
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-24 text-center">
    <h1 class="h1-hero text-text-body">Thanks, your message is in.</h1>
    <p class="mt-4 text-lg text-text-muted max-w-2xl mx-auto">
      An engineer replies within one business day (CET).
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary" data-umami-event="cta_thanks_home">
        Back to the home page
      </a>
      <a href="/contact/" class="btn-secondary" data-umami-event="cta_thanks_contact">
        Send another message
      </a>
    </div>
  </section>
</BaseLayout>
