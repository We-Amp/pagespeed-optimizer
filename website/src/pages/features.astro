---
import BaseLayout from '../layouts/BaseLayout.astro';
import BitmaskVisualizer from '../components/BitmaskVisualizer.astro';
import CTAButton from '../components/CTAButton.astro';
import Icon from '../components/Icon.astro';
import { getRelease } from '../lib/release';
import { offerJsonLd } from '../data/offer-jsonld';
import { FREE_TO_RUN_LINE } from '../data/product-facts.mjs';

// Single source of truth for the NuGet install command — corp/releases/2.0.yaml
// drives the `--prerelease` flag (display.nuget_install_flags).
const rel20 = await getRelease('2.0');
const nugetInstallCmd = `dotnet add package ${rel20.artifacts.nuget.package}${
  rel20.display.nuget_install_flags ? ` ${rel20.display.nuget_install_flags}` : ''
}`;

// The canonical 2.0 product page previously emitted only a FAQPage. Add a
// SoftwareApplication + Offer so the feature content ties to the product
// entity (and carries the price for merchant/rich results).
const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': ['Product', 'SoftwareApplication'],
  name: 'ModPageSpeed 2.0',
  applicationCategory: 'WebApplication',
  operatingSystem: 'Linux, Windows, macOS',
  description:
    'Self-hosted web performance optimization: WebP/AVIF/SVG image transcoding, CSS/JS minification, heuristic critical CSS, variant-aware caching, and zero-copy mmap serving. Deploys as an nginx interceptor + worker or ASP.NET Core middleware.',
  image: 'https://modpagespeed.com/og-default.png?v=2',
  brand: { '@type': 'Brand', name: 'ModPageSpeed' },
  featureList: [
    'WebP/AVIF/SVG image transcoding with viewport-aware resizing',
    'ML-predicted encoder quality with SSIMULACRA2 verification',
    'Heuristic critical CSS extraction (no headless browser)',
    'CSS and JavaScript minification',
    'Variant-aware caching via a 32-bit capability bitmask',
    'Zero-copy serving via mmap',
  ],
  offers: offerJsonLd({ url: 'https://modpagespeed.com/pricing/' }),
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What image formats does ModPageSpeed 2.0 support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "ModPageSpeed 2.0 automatically transcodes images to WebP and AVIF based on the client's Accept header. It also optimizes original JPEG and PNG formats. Animated GIFs are converted to animated WebP. Eligible images are auto-vectorized to SVG. Every variant is verified against the original with SSIMULACRA2 before it reaches the cache, using ML-predicted per-format quality. Up to 37 variants are generated per image across formats, viewports, pixel densities, and Save-Data preferences.",
      },
    },
    {
      '@type': 'Question',
      name: 'How does critical CSS extraction work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ModPageSpeed 2.0 uses heuristic critical CSS extraction that runs standalone — no headless browser required. The worker scans HTML and matches CSS selectors against the DOM structure, analyzing the first 25 elements, semantic patterns (header, nav, hero), and universal selectors. Critical CSS is injected as a style tag before </head>, eliminating render-blocking stylesheet requests. An optional browser analysis pipeline adds CSS coverage validation, waterfall capture, and visual comparison for advanced use cases.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is zero-copy serving?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Zero-copy serving means the Cyclone cache maps optimized resources directly into server output buffers using mmap. The response body is served directly from a memory-mapped cache file with no data copying and no per-request memory allocation. This achieves sub-millisecond cache hit latency.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does the variant-aware caching work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Every request is classified into a 32-bit capability bitmask encoding image format (WebP/AVIF/SVG/Original), viewport class (Mobile/Tablet/Desktop), pixel density (1x/2x+), Save-Data preference, and transfer encoding. The cache stores multiple alternates per URL, each identified by its mask. On lookup, the best-fit variant is selected by mask similarity with automatic fallback.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does ModPageSpeed 2.0 require changes to my application code?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. ModPageSpeed 2.0 operates at the reverse-proxy level. It deploys as an nginx interceptor that sits in front of any HTTP origin server. All optimization is transparent — your application serves the same responses it always has. No URL rewrites, no markup changes, no build pipeline modifications.',
      },
    },
    {
      '@type': 'Question',
      name: 'What CSS and JavaScript optimizations are performed?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'CSS optimization includes minification (whitespace, comments, redundant syntax removal, decimal optimization), critical CSS extraction, async CSS loading, and @import flattening. JavaScript minification safely removes comments and whitespace without AST transforms or variable renaming. Browser script analysis identifies scripts safe to defer, reducing parser-blocking JavaScript. Both only write optimized variants when the result is actually smaller than the original.',
      },
    },
  ],
};

const jsonLd = [softwareApplication, faqPage];
---

<BaseLayout
  title="ModPageSpeed 2.0 features: WebP/AVIF, critical CSS, minify"
  description="Self-hosted WebP/AVIF/SVG transcoding, heuristic critical CSS, CSS/JS minification, and variant-aware caching — the full ModPageSpeed 2.0 feature set. Runs as an nginx interceptor or ASP.NET Core middleware."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h1 class="h1-hero text-text-body">
      Server-side image optimization:<br />
      <span class="relative inline-block text-text-body border-b-[3px] border-interactive pb-1"
        >WebP, AVIF, and critical CSS.</span
      >
    </h1>
    <p class="lede mt-8 max-w-xl mx-auto">
      One decode pass yields up to 37 cache variants; the right one is served via mmap, in
      microseconds, with no third party in the request path.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/download/" class="btn-primary" data-umami-event="cta_features_hero_download"
        >Download &amp; run</a
      >
      <a href="/pricing/" class="btn-secondary" data-umami-event="cta_features_hero_pricing"
        >See pricing</a
      >
    </div>
    <div class="mt-4 flex justify-center">
      <a
        href="#aspnet-core"
        class="inline-flex items-center gap-2 rounded-lg border border-interactive/40 bg-interactive/10 px-4 py-3 text-sm text-interactive hover:bg-interactive/10 transition-colors"
      >
        Using .NET? Jump to the ASP.NET Core middleware section
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- Version context bar -->
  <div class="border-b border-border bg-stone-50/50 dark:bg-stone-900/50">
    <div
      class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-2 text-sm"
    >
      <p class="text-text-muted">
        Viewing <span class="font-semibold text-text-body"
          >ModPageSpeed 2.0</span
        > features
      </p>
      <a href="/1.1/" class="text-interactive hover:text-interactive-hover transition-colors font-medium">
        Looking for mod_pagespeed 1.15? →
      </a>
    </div>
  </div>

  <!-- Benefits summary -->
  <section class="bg-bg-secondary py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a
          href="#image-optimization"
          class="rounded-xl border border-border bg-bg-elevated p-6 hover:shadow-md transition-shadow"
        >
          <Icon name="image" class="h-5 w-5 text-interactive mb-3" />
          <p class="font-semibold text-text-body">Image optimization</p>
          <p class="mt-1 text-sm text-text-muted">
            WebP/AVIF transcoding, viewport-aware resizing, ML quality, up to 37 variants per image
          </p>
        </a>
        <a
          href="#css-optimization"
          class="rounded-xl border border-border bg-bg-elevated p-6 hover:shadow-md transition-shadow"
        >
          <Icon name="paintbrush" class="h-5 w-5 text-interactive mb-3" />
          <p class="font-semibold text-text-body">CSS optimization</p>
          <p class="mt-1 text-sm text-text-muted">
            Minification, critical CSS extraction, async loading, @import flattening
          </p>
        </a>
        <a
          href="#js-optimization"
          class="rounded-xl border border-border bg-bg-elevated p-6 hover:shadow-md transition-shadow"
        >
          <Icon name="braces" class="h-5 w-5 text-interactive mb-3" />
          <p class="font-semibold text-text-body">JS optimization</p>
          <p class="mt-1 text-sm text-text-muted">
            Safe minification, automatic script deferral — no AST transforms
          </p>
        </a>
        <a
          href="#html-optimization"
          class="rounded-xl border border-border bg-bg-elevated p-6 hover:shadow-md transition-shadow"
        >
          <Icon name="code-xml" class="h-5 w-5 text-interactive mb-3" />
          <p class="font-semibold text-text-body">HTML optimization</p>
          <p class="mt-1 text-sm text-text-muted">
            Critical CSS injection, async CSS, script deferral, Early Hints (103), lazy loading
          </p>
        </a>
        <a
          href="#variant-caching"
          class="rounded-xl border border-border bg-bg-elevated p-6 hover:shadow-md transition-shadow"
        >
          <Icon name="database" class="h-5 w-5 text-interactive mb-3" />
          <p class="font-semibold text-text-body">Variant-aware caching</p>
          <p class="mt-1 text-sm text-text-muted">
            32-bit capability mask, best-fit fallback, per-client variants
          </p>
        </a>
        <a
          href="#zero-copy"
          class="rounded-xl border border-border bg-bg-elevated p-6 hover:shadow-md transition-shadow"
        >
          <Icon name="gauge" class="h-5 w-5 text-interactive mb-3" />
          <p class="font-semibold text-text-body">Zero-copy serving</p>
          <p class="mt-1 text-sm text-text-muted">
            Sub-millisecond cache hits via mmap — no copies, no allocations
          </p>
        </a>
        <a
          href="#ai-readability"
          class="rounded-xl border border-border bg-bg-elevated p-6 hover:shadow-md transition-shadow lg:col-start-2"
        >
          <Icon name="bot" class="h-5 w-5 text-interactive mb-3" />
          <p class="flex items-center gap-2 font-semibold text-text-body">
            AI-readability
            <span
              class="inline-flex items-center rounded-md bg-interactive/10 px-1.5 py-0.5 text-xs font-medium text-interactive ring-1 ring-inset ring-interactive/40"
              >Licensed</span
            >
          </p>
          <p class="mt-1 text-sm text-text-muted">
            Serve fully-rendered content to AI crawlers that never run your JavaScript
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Not in scope -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="h2-section text-text-body">Not in scope</h2>
    <div
      class="mt-6 rounded-2xl border border-border p-6 bg-bg-elevated"
    >
      <p class="text-text-body">
        ModPageSpeed is an origin-side optimizer. It does not replace:
      </p>
      <ul class="mt-4 space-y-2 text-sm text-text-muted list-disc pl-6">
        <li>
          <span class="font-semibold text-text-body">Edge delivery</span>: use
          your CDN for caching, geography, and TLS termination.
        </li>
        <li>
          <span class="font-semibold text-text-body"
            >Web application firewall / bot protection</span
          >: use your WAF; we do not inspect request payloads or enforce policy.
        </li>
        <li>
          <span class="font-semibold text-text-body"
            >RUM / observability platforms</span
          >: we expose metrics; we do not replace your APM.
        </li>
        <li>
          <span class="font-semibold text-text-body">Build-time bundlers</span>:
          if your CSS/JS is already optimized, we add less &mdash; we mainly add origin-side image
          transcoding and critical CSS.
        </li>
      </ul>
      <p class="mt-4 text-sm text-text-muted">
        For how the optimizations above map to the metrics Google measures, see the <a
          href="/core-web-vitals/"
          class="text-interactive hover:text-interactive-hover underline">Core Web Vitals</a
        > hub.
      </p>
    </div>
  </section>

  <!-- Image Optimization -->
  <section id="image-optimization" class="py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <div>
          <h2 class="h2-section text-text-body">Image optimization</h2>
          <p class="mt-4 text-text-muted">
            Automatically transcode images to the best format each client supports. No manual srcset
            management, no build pipelines, no CDN configuration. If you're weighing the trade-offs,
            see <a
              href="/blog/avif-vs-webp-2026/"
              class="text-interactive hover:text-interactive-hover underline"
              >AVIF vs WebP: which to serve</a
            >, or learn how this works as <a
              href="/blog/nginx-image-optimization-module/"
              class="text-interactive hover:text-interactive-hover underline"
              >the nginx image optimization module</a
            >. For how this compares to a hosted pipeline, see <a
              href="/self-hosted-image-optimization/"
              class="text-interactive hover:text-interactive-hover underline"
              >self-hosted image optimization</a
            >.
          </p>
        </div>
        <div class="mt-8 lg:mt-0">
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">WebP/AVIF transcoding</p>
                <p class="text-sm text-text-muted">
                  Content-negotiated format selection based on the client's Accept header. Serve
                  WebP to Chrome, AVIF to supporting browsers, original to the rest.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Responsive image generation
                </p>
                <p class="text-sm text-text-muted">
                  Viewport-class and pixel-density aware resizing. Desktop, tablet, and mobile
                  variants are generated and cached automatically.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Lossless PNG reduction</p>
                <p class="text-sm text-text-muted">
                  OptiPNG-based lossless reduction strips unnecessary metadata and optimizes DEFLATE
                  parameters without any quality loss.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  GIF-to-WebP for animated GIFs
                </p>
                <p class="text-sm text-text-muted">
                  Animated GIFs are transcoded to animated WebP, often substantially smaller while
                  preserving all frames and timing.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Save-Data aware compression
                </p>
                <p class="text-sm text-text-muted">
                  Compression levels adapt to Save-Data preferences. Clients requesting reduced data
                  receive more aggressively compressed image variants. Text resources (HTML, CSS,
                  JS) are served with Identity, Gzip, or Brotli transfer encoding as appropriate.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Proactive variant generation
                </p>
                <p class="text-sm text-text-muted">
                  A single image decode produces up to 37 cache variants: 3 raster formats (WebP,
                  AVIF, original) across 3 viewports, 2 pixel densities, and 2 Save-Data states,
                  plus a resolution-independent SVG variant for eligible images. One request warms
                  the cache for all client types.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">SVG auto-vectorization</p>
                <p class="text-sm text-text-muted">
                  Logos, icons, and simple graphics are automatically <a
                    href="/blog/svg-auto-vectorization/"
                    class="text-interactive hover:text-interactive-hover underline"
                    >converted from raster to SVG</a
                  > using VTracer (Rust FFI). The resulting vector is resolution-independent — one
                  variant serves all viewports and pixel densities. A size gate stores the SVG only
                  when it is smaller than the raster original. Runs automatically for eligible images,
                  no configuration required.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Jpegli encoder with perceptual quality
                </p>
                <p class="text-sm text-text-muted">
                  Jpegli replaces libjpeg-turbo for JPEG encoding. Every variant is verified against
                  the original with SSIMULACRA2 before it reaches the cache. Content-aware quality
                  presets adjust compression based on image characteristics.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  ML-predicted encoder quality
                </p>
                <p class="text-sm text-text-muted">
                  Per-format <a
                    href="/blog/learned-quality-prediction/"
                    class="text-interactive hover:text-interactive-hover underline"
                    >ML models predict the optimal encoder quality</a
                  > for a target SSIMULACRA2 score. Trained LightGBM decision trees compiled to C run
                  in ~5 microseconds per format with zero runtime dependencies. SSIMULACRA2
                  verification catches outliers.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Content-aware quality classification
                </p>
                <p class="text-sm text-text-muted">
                  Each image is classified as photo, screenshot, illustration, or noisy before
                  compression. Photos tolerate more aggressive compression than screenshots with
                  sharp text. Noisy images are denoised with a bilateral filter before encoding,
                  preventing wasted bytes on noise that no one wants to preserve.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Quality baselining</p>
                <p class="text-sm text-text-muted">
                  JPEG source quality is detected from DQT tables. If the source was already saved
                  at quality 60, re-encoding at quality 85 would bloat the file. The encoder caps
                  output quality at the source level plus a small margin.
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CSS Optimization -->
  <section id="css-optimization" class="py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <div>
          <h2 class="h2-section text-text-body">CSS optimization</h2>
          <p class="mt-4 text-text-muted">
            Reduce render-blocking CSS to the minimum required for first paint. Heuristic critical
            CSS extraction runs standalone — no headless browser required. Optional browser analysis
            adds CSS coverage validation, waterfall capture, and visual comparison. This targets the
            render-blocking resources flagged by <a
              href="/pagespeed-insights/"
              class="text-interactive hover:text-interactive-hover underline"
              >PageSpeed Insights</a
            >.
          </p>
        </div>
        <div class="mt-8 lg:mt-0">
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Minification</p>
                <p class="text-sm text-text-muted">
                  Whitespace, comments, and redundant syntax are stripped. Trailing semicolons are
                  removed, decimal values optimized (0.5 to .5), and whitespace around CSS operators
                  eliminated.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Critical CSS extraction
                </p>
                <p class="text-sm text-text-muted">
                  Heuristic-based above-the-fold CSS extraction. Automatically includes selectors
                  for <code class="text-xs bg-bg-elevated px-1 rounded">html</code>, <code
                    class="text-xs bg-bg-elevated px-1 rounded">body</code
                  >, <code class="text-xs bg-bg-elevated px-1 rounded">:root</code>,
                  first 25 DOM elements, and header/nav/hero patterns. Optional browser pipeline
                  adds Lighthouse validation, waterfall capture, and visual comparison.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Injected into HTML</p>
                <p class="text-sm text-text-muted">
                  Critical CSS is injected as a <code
                    class="text-xs bg-bg-elevated px-1 rounded">&lt;style&gt;</code
                  > tag before <code class="text-xs bg-bg-elevated px-1 rounded"
                    >&lt;/head&gt;</code
                  >, creating a self-contained HTML variant that renders without blocking on
                  external stylesheets.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Async CSS loading</p>
                <p class="text-sm text-text-muted">
                  Render-blocking stylesheets are deprioritized using <code
                    class="text-xs bg-bg-elevated px-1 rounded"
                    >fetchpriority="low"</code
                  >, keeping them as normal stylesheets with no JavaScript dependency. Activated
                  automatically by the optimization policy when CSS coverage data indicates low
                  stylesheet utilization. Requires <code
                    class="text-xs bg-bg-elevated px-1 rounded"
                    >--enable-browser-analysis</code
                  >.
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- JavaScript Optimization -->
  <section id="js-optimization" class="bg-bg-secondary py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <div>
          <h2 class="h2-section text-text-body">JavaScript optimization</h2>
          <p class="mt-4 text-text-muted">
            Reduce JavaScript payload with automatic minification. Conservative transforms that
            remove dead weight without changing behavior.
          </p>
        </div>
        <div class="mt-8 lg:mt-0">
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Minification</p>
                <p class="text-sm text-text-muted">
                  Comments, whitespace, and unnecessary semicolons are removed. <a
                    href="/blog/safe-javascript-minification-semicolon-insertion/"
                    class="text-interactive hover:text-interactive-hover underline"
                    >Safe by construction</a
                  > — no variable renaming, no AST transforms.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Size-gated optimization
                </p>
                <p class="text-sm text-text-muted">
                  Only writes a minified variant if the result is actually smaller. No wasted cache
                  space for already-minified scripts.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Script deferral</p>
                <p class="text-sm text-text-muted">
                  Browser script analysis identifies scripts safe to defer. The worker adds <code
                    class="text-xs bg-bg-elevated px-1 rounded">defer</code
                  > to those <code class="text-xs bg-bg-elevated px-1 rounded"
                    >&lt;script src="..."&gt;</code
                  > tags, moving them off the critical path. Scripts already marked <code
                    class="text-xs bg-bg-elevated px-1 rounded">async</code
                  >, <code class="text-xs bg-bg-elevated px-1 rounded">defer</code>,
                  or <code class="text-xs bg-bg-elevated px-1 rounded"
                    >type="module"</code
                  > are left unchanged. Requires <code
                    class="text-xs bg-bg-elevated px-1 rounded"
                    >--enable-browser-analysis</code
                  >.
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HTML Optimization -->
  <section id="html-optimization" class="py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <div>
          <h2 class="h2-section text-text-body">HTML optimization</h2>
          <p class="mt-4 text-text-muted">
            The worker rewrites HTML to inject critical CSS and generate preload hints. Combined
            with the caching proxy's Early Hints support, pages render faster without any changes to
            your application.
          </p>
        </div>
        <div class="mt-8 lg:mt-0">
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Critical CSS injection</p>
                <p class="text-sm text-text-muted">
                  Heuristic-based above-the-fold CSS extraction. The worker scans HTML and linked
                  stylesheets, extracts rules matching header, nav, hero, and early DOM elements,
                  and injects them as a <code
                    class="text-xs bg-bg-elevated px-1 rounded">&lt;style&gt;</code
                  > tag before <code class="text-xs bg-bg-elevated px-1 rounded"
                    >&lt;/head&gt;</code
                  >. Optional browser analysis adds Lighthouse validation, waterfall capture, and
                  visual comparison.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Early Hints (103)</p>
                <p class="text-sm text-text-muted">
                  The worker stores stylesheet preload hints in the cache. On subsequent requests,
                  the server sends <code class="text-xs bg-bg-elevated px-1 rounded"
                    >103 Early Hints</code
                  >
                  responses with <code class="text-xs bg-bg-elevated px-1 rounded"
                    >Link: rel=preload</code
                  > headers before the origin responds, letting the browser fetch CSS while waiting.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Preconnect injection</p>
                <p class="text-sm text-text-muted">
                  Third-party origins discovered during HTML processing automatically receive <code
                    class="text-xs bg-bg-elevated px-1 rounded"
                    >Link: rel=preconnect</code
                  > headers, eliminating DNS/TLS setup time for external resources. Enabled by default.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-bg-elevated text-text-muted text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Speculation Rules
                  <span
                    class="ml-1 inline-flex items-center rounded-md bg-amber-50 dark:bg-amber-950 px-1.5 py-0.5 text-xs font-medium text-amber-700 dark:text-amber-400 ring-1 ring-inset ring-amber-600/20 dark:ring-amber-400/20"
                    >Experimental</span
                  >
                </p>
                <p class="text-sm text-text-muted">
                  Opt-in prefetching via the <a
                    href="/blog/server-injected-resource-hints-speculation-rules/"
                    class="text-interactive hover:text-interactive-hover underline"
                    >Speculation Rules API</a
                  >. When enabled with <code
                    class="text-xs bg-bg-elevated px-1 rounded"
                    >--enable-speculation-rules</code
                  >, the worker injects prefetch hints for frequently-accessed URLs detected by the
                  hot URL tracker. Off by default.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Hot URL warmup</p>
                <p class="text-sm text-text-muted">
                  Frequently-accessed URLs are detected automatically. When a URL exceeds the hit
                  threshold, the worker proactively generates all missing optimized variants so they
                  are ready before the next request.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Native lazy loading</p>
                <p class="text-sm text-text-muted">
                  The worker automatically adds <code
                    class="text-xs bg-bg-elevated px-1 rounded">loading="lazy"</code
                  > to off-screen <code class="text-xs bg-bg-elevated px-1 rounded"
                    >&lt;img&gt;</code
                  >
                  and <code class="text-xs bg-bg-elevated px-1 rounded"
                    >&lt;iframe&gt;</code
                  > elements. The LCP candidate (or first body image as fallback) receives <code
                    class="text-xs bg-bg-elevated px-1 rounded"
                    >fetchpriority="high"</code
                  > instead, ensuring above-the-fold content loads at full priority. Enabled by default.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">
                  Explicit image dimensions
                </p>
                <p class="text-sm text-text-muted">
                  Width and height attributes are injected on <code
                    class="text-xs bg-bg-elevated px-1 rounded">&lt;img&gt;</code
                  > tags that lack them, using dimensions from cached image data. This prevents Cumulative
                  Layout Shift (CLS) caused by images loading without reserved space. Enabled by default.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">LCP image preload</p>
                <p class="text-sm text-text-muted">
                  The detected LCP candidate image receives a <code
                    class="text-xs bg-bg-elevated px-1 rounded"
                    >&lt;link rel="preload" as="image"&gt;</code
                  > hint, telling the browser to fetch it before encountering the <code
                    class="text-xs bg-bg-elevated px-1 rounded">&lt;img&gt;</code
                  > tag. Reduces LCP by starting the download earlier.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-interactive/10 text-interactive text-xs font-bold"
                >&check;</span
              >
              <div>
                <p class="font-medium text-text-body">Font preloading</p>
                <p class="text-sm text-text-muted">
                  Font URLs discovered during CSS and HTML processing are injected as preload hints.
                  Fonts are among the last resources browsers discover naturally — preloading them
                  eliminates the flash of invisible text (FOIT).
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Variant-Aware Caching -->
  <section id="variant-caching" class="bg-bg-secondary py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <div>
          <h2 class="h2-section text-text-body">Variant-aware caching</h2>
          <p class="mt-4 text-text-muted">
            Every URL maps to a set of cache alternates, each identified by its 32-bit capability
            bitmask. Different clients get different optimized variants without cache pollution.
          </p>
        </div>
        <div class="mt-8 lg:mt-0">
          <div
            class="rounded-lg border border-border bg-bg-elevated p-6"
          >
            <p class="text-sm font-medium text-text-body mb-4">
              32-bit capability bitmask
            </p>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-text-muted">Bits 0-1</span>
                <span class="font-medium text-text-body"
                  >Image Format <span class="text-text-annotation">(Original / WebP / AVIF / SVG)</span
                  ></span
                >
              </div>
              <div class="border-t border-border"></div>
              <div class="flex justify-between">
                <span class="text-text-muted">Bits 2-3</span>
                <span class="font-medium text-text-body"
                  >Viewport Class <span class="text-text-annotation">(Mobile / Tablet / Desktop)</span
                  ></span
                >
              </div>
              <div class="border-t border-border"></div>
              <div class="flex justify-between">
                <span class="text-text-muted">Bit 4</span>
                <span class="font-medium text-text-body"
                  >Pixel Density <span class="text-text-annotation">(1x / 2x+)</span></span
                >
              </div>
              <div class="border-t border-border"></div>
              <div class="flex justify-between">
                <span class="text-text-muted">Bit 5</span>
                <span class="font-medium text-text-body"
                  >Save-Data <span class="text-text-annotation">(off / on)</span></span
                >
              </div>
              <div class="border-t border-border"></div>
              <div class="flex justify-between">
                <span class="text-text-muted">Bits 6-7</span>
                <span class="font-medium text-text-body"
                  >Transfer Encoding <span class="text-text-annotation"
                    >(Identity / Gzip / Brotli / Reserved)</span
                  ></span
                >
              </div>
            </div>
          </div>
          <div class="mt-4">
            <BitmaskVisualizer />
          </div>
          <p class="mt-4 text-sm text-text-muted">
            On cache miss, the best-fit fallback mechanism finds the closest cached variant rather
            than going back to the origin. A Desktop WebP request can be served from a Tablet WebP
            cache entry while the exact variant is being generated.
          </p>
          <p class="mt-3 text-sm text-text-muted">
            Pre-compressed gzip and brotli variants are generated for text resources (HTML, CSS,
            JS). On cache hits, the server serves directly with the appropriate Content-Encoding —
            no dynamic compression overhead.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Zero-Copy Serving -->
  <section id="zero-copy" class="py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 lg:items-start">
        <div>
          <h2 class="h2-section text-text-body">Zero-copy serving</h2>
          <p class="mt-4 text-text-muted">
            The Cyclone cache maps optimized resources directly into server output buffers using
            mmap. The response body is served directly from a memory-mapped cache file with no data
            copying and no per-request memory allocation for content.
          </p>
        </div>
        <div class="mt-8 lg:mt-0">
          <div
            class="rounded-lg border border-border bg-bg-elevated p-6"
          >
            <p class="text-sm font-medium text-text-body mb-4">
              Cache hit path
            </p>
            <ol class="space-y-3 text-sm">
              <li class="flex items-start gap-3">
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-interactive text-on-accent text-xs font-bold"
                  >1</span
                >
                <p class="text-text-muted">
                  Caching proxy classifies the request into a 32-bit capability mask
                </p>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-interactive text-on-accent text-xs font-bold"
                  >2</span
                >
                <p class="text-text-muted">
                  URL is looked up in cache; best-fit variant selected by capability mask
                </p>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-interactive text-on-accent text-xs font-bold"
                  >3</span
                >
                <p class="text-text-muted">
                  Cyclone lookup returns an mmap'd pointer with best-fit fallback
                </p>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-interactive text-on-accent text-xs font-bold"
                  >4</span
                >
                <p class="text-text-muted">
                  Pointer is passed directly to the server's output chain — zero copy, zero
                  allocation
                </p>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-interactive text-on-accent text-xs font-bold"
                  >5</span
                >
                <p class="text-text-muted">
                  On miss: origin is served immediately, the worker is notified via Unix socket to
                  generate the optimized variant
                </p>
              </li>
            </ol>
          </div>
          <p class="mt-4 text-sm text-text-muted">
            Sub-millisecond cache hits. The hot path is a hash lookup and a pointer assignment — no
            data copying, no content processing in the request path. This is one of several ways to <a
              href="/blog/reduce-ttfb-server-layer-2026/"
              class="text-interactive hover:text-interactive-hover underline"
              >reduce TTFB at the server layer</a
            > before you reach for a CDN.
          </p>
        </div>
      </div>
    </div>
  </section>

