---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import metricsData from '../data/demo-metrics.json';

const sites = metricsData.sites;
const generatedAt = metricsData.generated_at;

function formatBytes(bytes: number): string {
  if (bytes >= 1048576) return (bytes / 1048576).toFixed(1) + ' MB';
  if (bytes >= 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return bytes + ' B';
}

function pct(before: number, after: number): number {
  return Math.round(((before - after) / before) * 100);
}

// Pre-compute totals for each site using real measured totals
const siteData = sites.map((site) => {
  const r = site.resources;
  const imgBefore = r.images.totalJpeg;
  const imgWebp = r.images.totalWebp;
  const imgAvif = r.images.totalAvif;
  const totalBefore = r.html.before + r.css.before + r.js.before + imgBefore;
  const totalWebp = r.html.before + r.css.minified + r.js.minified + imgWebp;
  const totalAvif = r.html.before + r.css.minified + r.js.minified + imgAvif;
  return { ...site, imgBefore, imgWebp, imgAvif, totalBefore, totalWebp, totalAvif };
});
---

<BaseLayout
  title="Live demo — see mod_pagespeed 2.1 optimize real sites"
  description="Watch mod_pagespeed 2.1 cut real sites 48–69% smaller: measured CSS/JS minification and WebP/AVIF transcoding, with modeled load-time projections."
>
  {/* Demo site preview with tabs */}
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="h1-hero text-text-body">See mod_pagespeed 2.1 optimize real sites</h1>
        <p class="lede mt-4 max-w-2xl mx-auto">
          Four real sites — an e-commerce store, a blog, a news portal, and a portfolio — each built
          from original, unoptimized assets. mod_pagespeed cuts total page weight by 48&ndash;69%
          across them; on the image-heavy store,
          <a class="text-interactive underline underline-offset-2" href="/blog/avif-vs-webp-2026/"
            >AVIF transcoding</a
          > alone takes the catalog images from 99.7&nbsp;KB down to 23.7&nbsp;KB (76% smaller).
          Every number below is measured.
        </p>
        <p class="mt-4 max-w-2xl mx-auto text-sm text-text-annotation">
          This is mod_pagespeed 2.1 optimizing whole sites: the optimizer worker doing the heavy
          work behind the module. The module is the other half — in-process inside Apache, nginx or
          IIS, with granular per-filter control so you switch each optimization on or off yourself.
          See that filter-by-filter on the
          <a class="text-interactive underline underline-offset-2" href="/examples/"
            >filter examples</a
          >.
        </p>
      </div>

      {/* Tab bar */}
      <div
        class="mt-10 border-b border-border"
        id="demo-tabs"
        role="tablist"
        aria-label="Demo sites"
      >
        <div class="flex justify-center gap-1 -mb-px">
          {
            [
              { id: 'ecommerce', label: 'E-commerce', desc: 'ShopGrid' },
              { id: 'blog', label: 'Blog', desc: 'ByteWise' },
              { id: 'news', label: 'News', desc: 'The Dispatch' },
              { id: 'portfolio', label: 'Portfolio', desc: 'Lena Voss' },
            ].map((tab, i) => (
              <button
                role="tab"
                id={`tab-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`preview-${tab.id}`}
                tabindex={i === 0 ? 0 : -1}
                data-demo-tab={tab.id}
                data-demo-src={`/demos/${tab.id}/index.html`}
                class:list={[
                  'relative px-5 py-3 text-sm font-medium transition-colors rounded-t-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-interactive',
                  i === 0
                    ? 'border border-border border-b-white dark:border-b-stone-900 bg-bg-elevated text-text-body'
                    : 'text-text-annotation hover:text-text-body hover:bg-bg-secondary',
                ]}
              >
                <span class="block">{tab.label}</span>
                <span class="block text-xs font-normal text-text-annotation">
                  {tab.desc}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      {/* Info note */}
      <details
        class="mt-6 rounded-md border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950 px-4 py-3"
      >
        <summary class="text-sm font-medium text-amber-800 dark:text-amber-300 cursor-pointer">
          About this demo's optimization baseline
        </summary>
        <p class="mt-2 text-sm text-amber-800 dark:text-amber-300">
          These pages ship deliberately unoptimized assets so mod_pagespeed has real work to do:
          CSS is verbose with longhand properties, JavaScript is unminified, and images are served
          as uncompressed JPEGs.
        </p>
      </details>

      {/* Iframe preview area */}
      <div
        class="mt-6 rounded-lg border border-border bg-bg-elevated overflow-hidden shadow-sm"
      >
        <div
          class="flex items-center justify-between px-4 py-2 border-b border-border bg-bg-secondary"
        >
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <span class="block h-3 w-3 rounded-full bg-stone-300 dark:bg-stone-600"></span>
              <span class="block h-3 w-3 rounded-full bg-stone-300 dark:bg-stone-600"></span>
              <span class="block h-3 w-3 rounded-full bg-stone-300 dark:bg-stone-600"></span>
            </div>
            <span
              id="demo-url-bar"
              class="ml-2 text-xs text-text-annotation font-mono"
            >
              /demos/ecommerce/index.html
            </span>
          </div>
          <a
            id="demo-open-link"
            href="/demos/ecommerce/index.html"
            target="_blank"
            rel="noopener"
            class="text-xs text-interactive hover:underline"
          >
            Open in new tab
          </a>
        </div>
        {
          [
            { id: 'ecommerce', label: 'E-commerce', src: '/demos/ecommerce/index.html' },
            { id: 'blog', label: 'Blog', src: '/demos/blog/index.html' },
            { id: 'news', label: 'News', src: '/demos/news/index.html' },
            { id: 'portfolio', label: 'Portfolio', src: '/demos/portfolio/index.html' },
          ].map((site, i) => (
            <div
              id={`preview-${site.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${site.id}`}
              class:list={[i !== 0 && 'hidden']}
            >
              <iframe
                src={i === 0 ? site.src : undefined}
                data-src={site.src}
                class="w-full bg-white h-[min(700px,80vh)]"
                title={`${site.label} demo site preview`}
                loading="lazy"
                sandbox="allow-scripts allow-same-origin"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Optimization analysis */}
  <section class="py-16 bg-bg-secondary">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="h2-section text-text-body">Optimization analysis</h2>
        <p class="lede mt-4 max-w-2xl mx-auto">
          Real measurements from the demo sites above, produced by the actual module + optimizer
          worker + cache stack. CSS/JS sizes are measured before and after minification, image sizes
          are measured before and after transcoding to WebP and AVIF.
        </p>
      </div>

      {/* Site picker */}
      <div
        class="mt-10 flex justify-center gap-2 flex-wrap"
        id="site-picker"
        role="group"
        aria-label="Choose demo site to analyze"
      >
        {
          siteData.map((site, i) => (
            <button
              data-site={site.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="product-tab rounded-md px-4 py-2 text-sm font-medium transition-colors"
            >
              {site.name}
            </button>
          ))
        }
      </div>

      {/* Site panels */}
      {
        siteData.map((site, i) => (
          <div
            id={`panel-${site.id}`}
            class:list={['mt-10', i !== 0 && 'hidden']}
            data-panel={site.id}
          >
            {/* Top metrics row — delta-first hierarchy: the headline percentage is the
                hero number; the raw before/after values are demoted to a caption row
                of supporting evidence. */}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {/* Page weight */}
              <div class="rounded-lg border border-border bg-bg-elevated p-6 text-center">
                <p class="text-xs font-semibold uppercase tracking-wider text-text-annotation mb-3">
                  Total page weight
                </p>
                <p class="display-num text-5xl sm:text-6xl font-bold tracking-tight text-emerald-700 dark:text-emerald-400 leading-none">
                  &minus;{pct(site.totalBefore, site.totalAvif)}%
                </p>
                <p class="mt-2 text-sm font-medium text-text-body">smaller</p>
                <p class="mt-3 text-xs text-text-annotation display-num tabular-nums">
                  <span class="line-through">{formatBytes(site.totalBefore)}</span>
                  <span class="mx-1 text-text-annotation">&rarr;</span>
                  <span class="font-semibold text-text-body">
                    {formatBytes(site.totalAvif)}
                  </span>
                </p>
              </div>

              {/* Load time */}
              <div class="rounded-lg border border-border bg-bg-elevated p-6 text-center">
                <p class="text-xs font-semibold uppercase tracking-wider text-text-annotation mb-3">
                  Load time (3G)
                </p>
                <p class="display-num text-5xl sm:text-6xl font-bold tracking-tight text-emerald-700 dark:text-emerald-400 leading-none">
                  &minus;{pct(site.loadTime.before, site.loadTime.after)}%
                </p>
                <p class="mt-2 text-sm font-medium text-text-body">faster</p>
                <p class="mt-3 text-xs text-text-annotation display-num tabular-nums">
                  <span class="line-through">{site.loadTime.before}s</span>
                  <span class="mx-1 text-text-annotation">&rarr;</span>
                  <span class="font-semibold text-text-body">
                    {site.loadTime.after}s
                  </span>
                </p>
              </div>

              {/* Lighthouse */}
              <div class="rounded-lg border border-border bg-bg-elevated p-6 text-center">
                <p class="text-xs font-semibold uppercase tracking-wider text-text-annotation mb-3">
                  Lighthouse Performance
                </p>
                <p
                  class:list={[
                    'display-num text-5xl sm:text-6xl font-bold tracking-tight leading-none',
                    site.lighthouse.after >= 90
                      ? 'text-emerald-700 dark:text-emerald-400'
                      : 'text-amber-600 dark:text-amber-400',
                  ]}
                >
                  +{site.lighthouse.after - site.lighthouse.before}
                </p>
                <p class="mt-2 text-sm font-medium text-text-body">
                  points
                  <span
                    class:list={[
                      'ml-1 inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide',
                      site.lighthouse.after >= 90
                        ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300'
                        : 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
                    ]}
                  >
                    {site.lighthouse.after >= 90 ? 'Good (≥90)' : 'Needs work (<90)'}
                  </span>
                </p>
                <p class="mt-3 text-xs text-text-annotation display-num tabular-nums">
                  <span class="line-through">{site.lighthouse.before}</span>
                  <span class="mx-1 text-text-annotation">&rarr;</span>
                  <span class="font-semibold text-text-body">
                    {site.lighthouse.after}
                  </span>
                </p>
              </div>
            </div>

            {/* Resource breakdown table */}
            <div class="mt-8 rounded-lg border border-border bg-bg-elevated overflow-hidden">
              <div class="px-6 py-4 border-b border-border bg-bg-secondary">
                <h3 class="text-sm font-semibold text-text-body">
                  Resource breakdown
                </h3>
              </div>
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-border text-left text-xs font-semibold uppercase tracking-wider text-text-annotation">
                    <th class="px-6 py-3">Resource</th>
                    <th class="px-6 py-3 text-right">Original</th>
                    <th class="px-6 py-3 text-right">Optimized</th>
                    <th class="px-6 py-3 text-right">Saving</th>
                    <th class="px-6 py-3 w-40">
                      <span class="sr-only">Bar</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {/* CSS */}
                  <tr class="border-b border-border">
                    <td class="px-6 py-3 font-medium text-text-body">
                      CSS (minified)
                    </td>
                    <td class="px-6 py-3 text-right text-text-muted">
                      {formatBytes(site.resources.css.before)}
                    </td>
                    <td class="px-6 py-3 text-right font-medium text-text-body">
                      {formatBytes(site.resources.css.minified)}
                    </td>
                    <td class="px-6 py-3 text-right font-semibold text-emerald-700 dark:text-emerald-400">
                      -{pct(site.resources.css.before, site.resources.css.minified)}%
                    </td>
                    <td class="px-6 py-3">
                      <div class="flex gap-1 items-center">
                        <div
                          class="h-2 rounded-full bg-stone-300 dark:bg-stone-600"
                          style={`width: ${Math.round((site.resources.css.before / site.totalBefore) * 100)}%`}
                        />
                        <div
                          class="h-2 rounded-full bg-emerald-500"
                          style={`width: ${Math.round((site.resources.css.minified / site.totalBefore) * 100)}%`}
                        />
                      </div>
                    </td>
                  </tr>
                  {/* JS */}
                  <tr class="border-b border-border">
                    <td class="px-6 py-3 font-medium text-text-body">
                      JavaScript (minified)
                    </td>
                    <td class="px-6 py-3 text-right text-text-muted">
                      {formatBytes(site.resources.js.before)}
                    </td>
                    <td class="px-6 py-3 text-right font-medium text-text-body">
                      {formatBytes(site.resources.js.minified)}
                    </td>
                    <td class="px-6 py-3 text-right font-semibold text-emerald-700 dark:text-emerald-400">
                      -{pct(site.resources.js.before, site.resources.js.minified)}%
                    </td>
                    <td class="px-6 py-3">
                      <div class="flex gap-1 items-center">
                        <div
                          class="h-2 rounded-full bg-stone-300 dark:bg-stone-600"
                          style={`width: ${Math.round((site.resources.js.before / site.totalBefore) * 100)}%`}
                        />
                        <div
                          class="h-2 rounded-full bg-emerald-500"
                          style={`width: ${Math.round((site.resources.js.minified / site.totalBefore) * 100)}%`}
                        />
                      </div>
                    </td>
                  </tr>
                  {/* Images WebP */}
                  <tr class="border-b border-border">
                    <td class="px-6 py-3 font-medium text-text-body">
                      {site.resources.images.label} &rarr; WebP
                    </td>
                    <td class="px-6 py-3 text-right text-text-muted">
                      {formatBytes(site.imgBefore)}
                    </td>
                    <td class="px-6 py-3 text-right font-medium text-text-body">
                      {formatBytes(site.imgWebp)}
                    </td>
                    <td class="px-6 py-3 text-right font-semibold text-emerald-700 dark:text-emerald-400">
                      -{pct(site.imgBefore, site.imgWebp)}%
                    </td>
                    <td class="px-6 py-3">
                      <div class="flex gap-1 items-center">
                        <div
                          class="h-2 rounded-full bg-stone-300 dark:bg-stone-600"
                          style={`width: ${Math.min(100, Math.round((site.imgBefore / site.totalBefore) * 100))}%`}
                        />
                        <div
                          class="h-2 rounded-full bg-interactive"
                          style={`width: ${Math.min(100, Math.round((site.imgWebp / site.totalBefore) * 100))}%`}
                        />
                      </div>
                    </td>
                  </tr>
                  {/* Images AVIF */}
                  <tr class="border-b border-border">
                    <td class="px-6 py-3 font-medium text-text-body">
                      {site.resources.images.label} &rarr; AVIF
                    </td>
                    <td class="px-6 py-3 text-right text-text-muted">
                      {formatBytes(site.imgBefore)}
                    </td>
                    <td class="px-6 py-3 text-right font-medium text-text-body">
                      {formatBytes(site.imgAvif)}
                    </td>
                    <td class="px-6 py-3 text-right font-semibold text-emerald-700 dark:text-emerald-400">
                      -{pct(site.imgBefore, site.imgAvif)}%
                    </td>
                    <td class="px-6 py-3">
                      <div class="flex gap-1 items-center">
                        <div
                          class="h-2 rounded-full bg-stone-300 dark:bg-stone-600"
                          style={`width: ${Math.min(100, Math.round((site.imgBefore / site.totalBefore) * 100))}%`}
                        />
                        <div
                          class="h-2 rounded-full bg-stone-500 dark:bg-stone-400"
                          style={`width: ${Math.min(100, Math.round((site.imgAvif / site.totalBefore) * 100))}%`}
                        />
                      </div>
                    </td>
                  </tr>
                  {/* HTML (unchanged) */}
                  <tr>
                    <td class="px-6 py-3 font-medium text-text-body">
                      HTML + critical CSS
                    </td>
                    <td class="px-6 py-3 text-right text-text-muted">
                      {formatBytes(site.resources.html.before)}
                    </td>
                    <td class="px-6 py-3 text-right font-medium text-text-body">
                      {formatBytes(site.resources.html.before)}
                    </td>
                    <td class="px-6 py-3 text-right text-text-muted">0%</td>
                    <td class="px-6 py-3">
                      <div
                        class="h-2 rounded-full bg-stone-200 dark:bg-stone-700"
                        style={`width: ${Math.round((site.resources.html.before / site.totalBefore) * 100)}%`}
                      />
                    </td>
                  </tr>
                </tbody>
                <tfoot>
                  <tr class="border-t border-border bg-bg-secondary font-semibold">
                    <td class="px-6 py-3 text-text-body">Total</td>
                    <td class="px-6 py-3 text-right text-text-muted">
                      {formatBytes(site.totalBefore)}
                    </td>
                    <td class="px-6 py-3 text-right text-text-body">
                      {formatBytes(site.totalAvif)}
                    </td>
                    <td class="px-6 py-3 text-right text-emerald-700 dark:text-emerald-400">
                      -{pct(site.totalBefore, site.totalAvif)}%
                    </td>
                    <td class="px-6 py-3" />
                  </tr>
                </tfoot>
              </table>
            </div>

            {/* Waterfall comparison */}
            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
              {/* Before waterfall */}
              <div class="rounded-lg border border-border bg-bg-elevated p-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-text-annotation mb-4">
                  Before &mdash; original resources
                </p>
                <div class="space-y-2">
                  <div>
                    <div class="flex justify-between text-xs text-text-muted mb-1">
                      <>
                        <span>HTML</span>
                        <span>{formatBytes(site.resources.html.before)}</span>
                      </>
                    </div>
                    <div class="h-3 rounded-full bg-stone-200 dark:bg-stone-700 overflow-hidden">
                      <div
                        class="h-full rounded-full bg-stone-400 dark:bg-stone-600"
                        style={`width: ${Math.round((site.resources.html.before / site.totalBefore) * 100)}%`}
                      />
                    </div>
                  </div>
                  <div>
                    <div class="flex justify-between text-xs text-text-muted mb-1">
                      <>
                        <span>CSS</span>
                        <span>{formatBytes(site.resources.css.before)}</span>
                      </>
                    </div>
                    <div class="h-3 rounded-full bg-stone-200 dark:bg-stone-700 overflow-hidden">
                      <div
                        class="h-full rounded-full bg-stone-400 dark:bg-stone-600"
                        style={`width: ${Math.round((site.resources.css.before / site.totalBefore) * 100)}%`}
                      />
                    </div>
                  </div>
                  <div>
                    <div class="flex justify-between text-xs text-text-muted mb-1">
                      <>
                        <span>JavaScript</span>
                        <span>{formatBytes(site.resources.js.before)}</span>
                      </>
                    </div>
                    <div class="h-3 rounded-full bg-stone-200 dark:bg-stone-700 overflow-hidden">
                      <div
                        class="h-full rounded-full bg-stone-400 dark:bg-stone-600"
                        style={`width: ${Math.round((site.resources.js.before / site.totalBefore) * 100)}%`}
                      />
                    </div>
                  </div>
                  <div>
                    <div class="flex justify-between text-xs text-text-muted mb-1">
                      <>
                        <span>Images (JPEG)</span>
                        <span>{formatBytes(site.imgBefore)}</span>
                      </>
                    </div>
                    <div class="h-3 rounded-full bg-stone-200 dark:bg-stone-700 overflow-hidden">
                      <div
                        class="h-full rounded-full bg-stone-400 dark:bg-stone-600"
                        style={`width: ${Math.min(100, Math.round((site.imgBefore / site.totalBefore) * 100))}%`}
                      />
                    </div>
                  </div>
                </div>
                <div class="mt-4 pt-3 border-t border-border flex justify-between text-sm font-semibold">
                  <span class="text-text-body">Total</span>
                  <span class="text-text-body">
                    {formatBytes(site.totalBefore)}
                  </span>
                </div>
              </div>

              {/* After waterfall */}
              <div class="rounded-lg border border-emerald-200 dark:border-emerald-800 bg-emerald-50/30 dark:bg-emerald-950/30 p-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 mb-4">
                  After &mdash; optimized with AVIF
                </p>
                <div class="space-y-2">
                  <div>
                    <div class="flex justify-between text-xs text-text-muted mb-1">
                      <>
                        <span>HTML + critical CSS</span>
                        <span>{formatBytes(site.resources.html.before)}</span>
                      </>
                    </div>
                    <div class="h-3 rounded-full bg-stone-200 dark:bg-stone-700 overflow-hidden">
                      <div
                        class="h-full rounded-full bg-interactive"
                        style={`width: ${Math.round((site.resources.html.before / site.totalBefore) * 100)}%`}
                      />
                    </div>
                  </div>
                  <div>
                    <div class="flex justify-between text-xs text-text-muted mb-1">
                      <>
                        <span>CSS (minified)</span>
                        <span>{formatBytes(site.resources.css.minified)}</span>
                      </>
                    </div>
                    <div class="h-3 rounded-full bg-stone-200 dark:bg-stone-700 overflow-hidden">
                      <div
                        class="h-full rounded-full bg-interactive"
                        style={`width: ${Math.round((site.resources.css.minified / site.totalBefore) * 100)}%`}
                      />
                    </div>
                  </div>
                  <div>
                    <div class="flex justify-between text-xs text-text-muted mb-1">
                      <>
                        <span>JS (minified)</span>
                        <span>{formatBytes(site.resources.js.minified)}</span>
                      </>
                    </div>
                    <div class="h-3 rounded-full bg-stone-200 dark:bg-stone-700 overflow-hidden">
                      <div
                        class="h-full rounded-full bg-interactive"
                        style={`width: ${Math.round((site.resources.js.minified / site.totalBefore) * 100)}%`}
                      />
                    </div>
                  </div>
                  <div>
                    <div class="flex justify-between text-xs text-text-muted mb-1">
                      <>
                        <span>Images (AVIF)</span>
                        <span>{formatBytes(site.imgAvif)}</span>
                      </>
                    </div>
                    <div class="h-3 rounded-full bg-stone-200 dark:bg-stone-700 overflow-hidden">
                      <div
                        class="h-full rounded-full bg-interactive"
                        style={`width: ${Math.min(100, Math.round((site.imgAvif / site.totalBefore) * 100))}%`}
                      />
                    </div>
                  </div>
                </div>
