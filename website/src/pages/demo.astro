  <script>
    // Demo site tab navigation
    (function () {
      var tabContainer = document.getElementById('demo-tabs');
      var urlBar = document.getElementById('demo-url-bar');
      var openLink = document.getElementById('demo-open-link');

      // Classes that represent the active/inactive chrome-tab visual.
      // Kept as token lists so focus-visible:* utilities set declaratively on
      // the element markup are never blown away by className overwrites.
      var ACTIVE_TOKENS = [
        'border',
        'border-stone-200',
        'dark:border-stone-700',
        'border-b-white',
        'dark:border-b-stone-900',
        'bg-white',
        'dark:bg-stone-900',
        'text-stone-900',
        'dark:text-stone-100',
      ];
      var INACTIVE_TOKENS = [
        'text-stone-500',
        'dark:text-stone-400',
        'hover:text-stone-700',
        'dark:hover:text-stone-300',
        'hover:bg-stone-50',
        'dark:hover:bg-stone-800',
      ];

      function applyActive(el: Element) {
        INACTIVE_TOKENS.forEach(function (t) {
          el.classList.remove(t);
        });
        ACTIVE_TOKENS.forEach(function (t) {
          el.classList.add(t);
        });
      }
      function applyInactive(el: Element) {
        ACTIVE_TOKENS.forEach(function (t) {
          el.classList.remove(t);
        });
        INACTIVE_TOKENS.forEach(function (t) {
          el.classList.add(t);
        });
      }

      if (tabContainer) {
        var tabs = Array.prototype.slice.call(
          tabContainer.querySelectorAll('button[data-demo-tab]'),
        ) as HTMLButtonElement[];

        // Activate a tab: update visual chrome, aria-selected, roving tabindex,
        // the controlled panel (lazy-loading its iframe), and the URL bar.
        // role="tab" uses aria-selected; aria-pressed is invalid on tabs
        // (axe: aria-allowed-attr).
        function selectTab(tab: HTMLButtonElement, moveFocus: boolean) {
          var siteId = tab.getAttribute('data-demo-tab');
          var src = tab.getAttribute('data-demo-src');

          tabs.forEach(function (t) {
            applyInactive(t);
            t.setAttribute('aria-selected', 'false');
            t.setAttribute('tabindex', '-1');
          });
          applyActive(tab);
          tab.setAttribute('aria-selected', 'true');
          tab.setAttribute('tabindex', '0');
          if (moveFocus) tab.focus();

          document.querySelectorAll('[role="tabpanel"]').forEach(function (panel) {
            if (panel.id === 'preview-' + siteId) {
              panel.classList.remove('hidden');
              var iframe = panel.querySelector('iframe');
              if (iframe && !(iframe as HTMLIFrameElement).src) {
                (iframe as HTMLIFrameElement).src = iframe.getAttribute('data-src') || '';
              }
            } else {
              panel.classList.add('hidden');
            }
          });

          if (urlBar) urlBar.textContent = src;
          if (openLink && src) openLink.setAttribute('href', src);

          (window as any).umami?.track('demo_preview_tab_switch', { site: siteId });
        }

        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            selectTab(tab, false);
          });
        });

        // WAI-ARIA APG tablist keyboard: Left/Right move + activate with wrap,
        // Home/End jump to the first/last tab.
        tabContainer.addEventListener('keydown', function (e: KeyboardEvent) {
          var current = document.activeElement as HTMLButtonElement;
          var idx = tabs.indexOf(current);
          if (idx === -1) return;
          var next = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (idx + 1) % tabs.length;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp')
            next = (idx - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = tabs.length - 1;
          if (next === -1) return;
          e.preventDefault();
          selectTab(tabs[next], true);
        });
      }
    })();

    // Optimization analysis site picker
    (function () {
      var picker = document.getElementById('site-picker');
      if (picker) {
        var buttons = picker.querySelectorAll('button[data-site]');
        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var siteId = btn.getAttribute('data-site');
            // Update pressed state — .product-tab utility keys off aria-pressed
            buttons.forEach(function (b) {
              b.setAttribute('aria-pressed', 'false');
            });
            btn.setAttribute('aria-pressed', 'true');
            // Show/hide panels
            document.querySelectorAll('[data-panel]').forEach(function (panel) {
              if (panel.getAttribute('data-panel') === siteId) {
                panel.classList.remove('hidden');
              } else {
                panel.classList.add('hidden');
              }
            });

            // Analytics (Umami — umami.track(name, props) form)
            (window as any).umami?.track('demo_site_switch', { site: siteId });
          });
        });
      }
    })();
  </script>
