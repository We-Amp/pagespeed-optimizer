---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pages = (await getCollection('how-it-works')).sort((a, b) => a.data.order - b.data.order);

const title = 'How ModPageSpeed Works: CSS, Caching & Async Rewriting';
const description =
  'How ModPageSpeed optimizes pages on your server: parsing CSS, caching optimized variants, and rewriting off the request path.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'How it works',
  description,
  url: 'https://modpagespeed.com/how-it-works/',
  hasPart: pages.map((p) => ({
    '@type': 'TechArticle',
    name: p.data.title,
    url: `https://modpagespeed.com/how-it-works/${p.id}/`,
    description: p.data.description,
  })),
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} breadcrumbLeafName="How it works">
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <nav class="text-sm text-text-annotation" aria-label="Breadcrumb">
      <a href="/" class="hover:text-text-body">Home</a>
      <span class="mx-1">/</span>
      <span>How it works</span>
    </nav>

    <p class="eyebrow mt-6">How it works</p>
    <h1 class="mt-3 h1-hero text-text-body">
      How a server-side web optimizer works
    </h1>
    <p class="lede mt-6 max-w-3xl">
      The docs tell you which directives to set; the blog covers what to fix on a given stack. These
      are the explainers in between &mdash; how the optimization actually works under the hood. The
      techniques trace back to the open-source mod_pagespeed and ngx_pagespeed projects, which We-Amp
      helped build and maintain; ModPageSpeed 2.0 and mod_pagespeed 1.15 carry them forward.
    </p>

    <div class="mt-12 space-y-4">
      {
        pages.map((p) => (
          <a
            href={`/how-it-works/${p.id}/`}
            class="group block rounded-2xl border border-border bg-bg-elevated p-6 transition-colors hover:border-interactive/50"
          >
            <h2 class="text-lg font-semibold text-text-body group-hover:text-interactive">
              {p.data.title}
            </h2>
            <p class="mt-2 text-sm text-text-muted">
              {p.data.summary ?? p.data.description}
            </p>
            <span class="mt-3 inline-block text-sm font-medium text-interactive">
              Read it <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-text-muted">
      For the full list of what gets rewritten, see the <a
        href="/features/"
        class="text-interactive hover:text-interactive-hover underline">feature list</a
      >; for fixes by platform, see the <a
        href="/blog/"
        class="text-interactive hover:text-interactive-hover underline">blog</a
      >.
    </p>

    <div class="mt-10 border-t border-border pt-8">
      <p class="text-sm text-text-muted">
        Run it: <a
          href="/docs/"
          class="text-interactive hover:text-interactive-hover underline">ModPageSpeed 2.0 docs</a
        > for the out-of-process worker, or <a
          href="/1.1/docs/"
          class="text-interactive hover:text-interactive-hover underline"
          >mod_pagespeed 1.15 docs</a
        > for the in-process module on Apache, nginx, and IIS.
      </p>
      <p class="mt-3 text-sm text-text-muted">
        Measuring your own pages? <a
          href="/analyze/"
          class="text-interactive hover:text-interactive-hover underline"
          >Test a page and map every failing audit to its fix</a
        >, or read what <a
          href="/core-web-vitals/"
          class="text-interactive hover:text-interactive-hover underline">LCP, CLS, and INP</a
        > mean.
      </p>
    </div>
  </article>
</BaseLayout>
