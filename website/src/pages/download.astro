---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getRelease, artifactUrl, archiveUrl, dockerTag } from '../lib/release';
import { offerJsonLd } from '../data/offer-jsonld';
import { LICENSE_CLAUSE, LICENSE_CLAUSE_CAP } from '../data/product-facts.mjs';

// Single source of truth: corp/releases/1.1.yaml synced into
// src/content/releases-1.1/release.yaml by corp's sync-manifests-to-mps2
// workflow (§7). Edit the corp manifest, not this file.
const rel11 = await getRelease('1.1');
const rel21 = await getRelease('2.1');

// Docker/Helm image tag via the shared resolver (see
// src/components/release/ImageTag.astro for the MDX-side equivalent) — used
// directly here since the 2.1 manifest declares no native artifact templates
// and artifactUrl() would throw on this line.
const rel21DockerTag = dockerTag(rel21);

// Apache/nginx share the same deb/rpm distro support window;
// nginx adds the version hint. EL8 is intentionally absent from the stock
// channel — dropped 2026-05-21. The Apache card renders a concise
// hand-written distro summary instead of the raw manifest join (that list is
// now 11 entries long); apache_versions stays manifest-derived so the version
// floor cannot drift.

// One unified integration list. ASP.NET Core (2.0 middleware + 1.15 sidecar) is
// merged in alongside the native-server modules so the page has a single "pick
// your integration" grid, not a separate .NET section. requirements + the umami
// event live on each entry so the grid renders straight from this array.
// Row order: current-line native integrations first (Apache, nginx), then
// Docker, Helm, IIS, the ASP.NET Core middleware, and the sidecar.
const integrations = [
  {
    name: 'Apache',
    product: 'mod_pagespeed 2.1',
    badge: 'Native module',
    description:
      'Prebuilt signed package from the apt/yum repository — apt-get on Debian and Ubuntu, dnf on Enterprise Linux. Drop-in replacement for the open-source build.',
    requirements: `Debian 12/13, Ubuntu 22.04/24.04 (amd64 + arm64); RHEL/AlmaLinux/Rocky 9 (x86_64 + aarch64) & 10 (x86_64); Apache ${rel21.compat.apache.apache_versions.join('/')}.`,
    href: '/download/apt-yum/',
    cta: 'Repo setup guide',
    umamiEvent: 'cta_download_apache',
  },
  {
    name: 'nginx',
    product: 'mod_pagespeed 2.1',
    badge: 'Native module',
    description:
      "Prebuilt signed dynamic module from the apt/yum repository, pinned to each distro's stock nginx. Loads alongside your existing nginx binary — no rebuild, no traffic detour.",
    requirements:
      "Debian 12/13, Ubuntu 22.04/24.04 (amd64 + arm64); RHEL/AlmaLinux/Rocky 9 (x86_64 + aarch64) via dnf, EL10 (x86_64). Each module is pinned to its distro's exact stock nginx — running a different nginx version? Contact us for a matching build.",
    href: '/download/apt-yum/',
    cta: 'Repo setup guide',
    umamiEvent: 'cta_download_nginx',
  },
  {
    name: 'nginx (Docker)',
    product: 'mod_pagespeed 2.1',
    badge: 'Reverse proxy',
    description:
      'Run the mod_pagespeed 2.1 worker as a Docker container in front of nginx. Same optimization pipeline, zero changes to your nginx binary or config.',
    requirements: `Any host with Docker 24+ (Linux, macOS, Windows). Images: ${rel21.artifacts.docker.image}:${rel21DockerTag} and ${rel21.artifacts.docker.worker_image}:${rel21DockerTag}.`,
    href: '/docs/installation-docker/',
    cta: 'Install guide',
    umamiEvent: 'cta_download_nginx_docker',
  },
  {
    name: 'Helm',
    product: 'mod_pagespeed 2.1',
    badge: 'Kubernetes',
    description:
      'Official Helm chart deploys nginx and the worker as a two-container pod, sharing a Cyclone cache volume. Pulls the public images directly — no registry credentials required.',
    requirements: `Kubernetes ${rel21.compat.kubernetes.versions[0]}, Helm ${rel21.compat.kubernetes.helm_versions[0]}. Chart: ${rel21.artifacts.helm.chart} (${rel21.artifacts.helm.repository}).`,
    href: '/docs/helm-deployment/',
    cta: 'Helm guide',
    umamiEvent: 'cta_download_helm',
  },
  {
    name: 'IIS',
    product: 'mod_pagespeed 1.15',
    badge: 'Native module',
    description:
      'MSI installer for Windows Server. Enable in IIS Manager, iisreset, and the optimization pipeline is live.',
    note: 'Running IISpeed? Uninstall it first — both modules cannot coexist on the same host.',
    requirements: `${rel11.compat.iis.os[0]} or later, IIS ${rel11.compat.iis.iis_versions.join('/')}, x64`,
    href: '/docs/iis-configuration/',
    cta: 'Install guide',
    umamiEvent: 'cta_download_iis',
  },
  {
    name: 'ASP.NET Core',
    product: 'mod_pagespeed 2.1',
    badge: 'NuGet middleware',
    description:
      'Two lines in Program.cs add the optimization pipeline to any ASP.NET Core app. Runs in-process — no sidecar, no Docker.',
    requirements: '.NET 8 or .NET 10 on Windows, Linux, or macOS.',
    href: '/docs/aspnet-getting-started/',
    cta: 'Install guide',
    umamiEvent: 'cta_download_aspnet',
  },
  {
    name: 'ASP.NET Core Sidecar',
    product: 'mod_pagespeed 1.15',
    badge: 'NuGet · Linux',
    description:
      'WeAmp.PageSpeed.Sidecar adds the 1.15 module to your Kestrel app via middleware, with a bundled nginx optimizer on loopback behind it. One dotnet add package pulls the native binaries.',
    note: 'Now GA. Want the classic 1.x nginx-module behavior under .NET? Start here.',
    requirements: '.NET 8 or .NET 10 on Linux (linux-x64, linux-arm64).',
    href: '/docs/aspnet-getting-started/#the-115-sidecar-weamppagespeedsidecar',
    cta: 'Sidecar guide',
    umamiEvent: 'cta_download_aspnet_sidecar',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Product', 'SoftwareApplication'],
  name: 'mod_pagespeed 2.1',
  applicationCategory: 'WebApplication',
  operatingSystem: 'Linux, Windows',
  image: 'https://modpagespeed.com/og-default.png?v=2',
  brand: { '@type': 'Brand', name: 'mod_pagespeed' },
  offers: offerJsonLd({
    url: 'https://modpagespeed.com/download/',
  }),
};
---

<BaseLayout
  title="Download mod_pagespeed 2.1 — Apache, nginx, Docker & Helm"
  description={`The mod_pagespeed 2.1 download: signed apt/yum packages for Apache and nginx, Docker and Helm for Kubernetes, plus ASP.NET Core middleware and the IIS module. ${LICENSE_CLAUSE_CAP}.`}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20 text-center">
    <h1 class="h1-hero text-text-body">Pick your integration. Install in a few minutes.</h1>
    <p class="lede mt-6 max-w-2xl mx-auto">
      {LICENSE_CLAUSE_CAP} — free to install and run, in development and in production.
    </p>
    <p class="mt-3 text-sm text-text-annotation max-w-2xl mx-auto">
      After install, open the admin console at <code
        class="rounded bg-bg-elevated px-1 py-0.5 text-xs">/pagespeed_global_admin</code
      > on your server.
    </p>
  </section>

  <!-- One merged "pick your integration" section: native servers + Docker/Helm + ASP.NET Core -->
  <section id="integrations" class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-8 lg:pt-12">
    <h2 class="h2-section text-text-body">Apache, nginx, Docker, Helm, IIS &amp; ASP.NET Core</h2>
    <p class="mt-4 text-lg text-text-body">
      Every way to run it, in one place. mod_pagespeed 2.1's native module installs on Apache and
      nginx from the signed apt/yum repository, or runs as a Docker container fronting nginx —
      deploy that with Helm on Kubernetes. Windows/IIS ships from the 1.15 packaging channel, and
      ASP.NET Core apps get a NuGet middleware or a Linux sidecar. Each card shows which package it
      comes from and how it integrates.
    </p>
    <p class="mt-3 text-sm text-text-annotation inline-flex items-center gap-3">
      <span
        class="inline-flex items-center rounded-md border border-border-strong bg-bg-secondary px-2 py-0.5 font-mono text-xs text-text-body"
        >{rel21.display.badge_version}</span
      >
      <a href="/blog/" class="text-interactive hover:text-interactive-hover underline"
        >see release notes</a
      >
    </p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        integrations.map((integration, index) => (
          <a
            href={integration.href}
            data-umami-event={integration.umamiEvent}
            class:list={[
              'card flex flex-col',
              // Full-width final card: 7 cards in 2 columns orphans the last
              // one on its own half-empty row — give it the whole row instead.
              index === integrations.length - 1 && 'md:col-span-2',
            ]}
          >
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-xl font-semibold text-text-body">{integration.name}</h3>
              <span class="text-xs font-semibold text-text-body">{integration.product}</span>
            </div>
            <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-text-body">
              {integration.badge}
            </p>
            <p class="mt-4 text-sm text-text-body">{integration.description}</p>
            {integration.note && (
              <p class="mt-3 text-xs italic text-text-annotation">{integration.note}</p>
            )}
            <p class="mt-3 text-xs text-text-annotation flex-1">{integration.requirements}</p>
            <p class="mt-6 text-sm font-semibold text-text-body inline-flex items-center gap-2">
              {integration.cta}
              <span aria-hidden="true">&rarr;</span>
            </p>
          </a>
        ))
      }
    </div>
    <p class="mt-6 text-xs text-text-annotation">
      The Apache and nginx packages keep their existing 1.15-line names — your apt/dnf upgrades them
      in place, no rename needed.
    </p>

    <!-- Direct downloads -->
    <div class="mt-10 rounded-2xl border border-border bg-bg-secondary p-6">
      <div class="flex items-baseline justify-between gap-3 flex-wrap">
        <h3 class="text-base font-semibold text-text-body">Direct downloads</h3>
        <span
          class="inline-flex items-center rounded-md border border-border-strong bg-bg-elevated px-2 py-0.5 font-mono text-xs text-text-body"
          >{rel11.release.tag}</span
        >
      </div>
      <p class="mt-2 text-sm text-text-muted">
        Mirrored from our archive — no GitHub account needed. Verify with the published <a
          href={archiveUrl(rel11, 'SHA256SUMS')}
          class="text-interactive underline">SHA256SUMS</a
        > or the <a href={rel11.urls.gpg_key} class="text-interactive underline">GPG signing key</a
        >. Came from the old <code>dl-ssl.google.com</code>
        <code class="text-xs">.deb</code>? <a
          href="/blog/google-dl-ssl-mod-pagespeed-download/"
          class="text-interactive underline">That build froze at 1.13.35.2 (2018)</a
        > — these are the maintained packages.
      </p>

      <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 text-sm">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-text-annotation">Apache</p>
          <ul class="mt-2 space-y-1.5">
            <li>
              <a
                href={artifactUrl(rel11, 'deb', 'amd64')}
                data-umami-event="cta_download_apache_deb_amd64"
                class="text-interactive hover:underline"
                >Debian/Ubuntu (amd64) <code class="text-xs">.deb</code></a
              >
            </li>
            <li>
              <a
                href={artifactUrl(rel11, 'deb', 'arm64')}
                data-umami-event="cta_download_apache_deb_arm64"
                class="text-interactive hover:underline"
                >Debian/Ubuntu (arm64) <code class="text-xs">.deb</code></a
              >
            </li>
            <li>
              <a
                href={artifactUrl(rel11, 'rpm', 'x86_64')}
                data-umami-event="cta_download_apache_rpm_x64"
                class="text-interactive hover:underline"
                >RHEL family (x86_64) <code class="text-xs">.rpm</code></a
              >
            </li>
            <li>
              <a
                href={artifactUrl(rel11, 'rpm', 'aarch64')}
                data-umami-event="cta_download_apache_rpm_aarch64"
                class="text-interactive hover:underline"
                >RHEL family (aarch64) <code class="text-xs">.rpm</code></a
              >
            </li>
            <li>
              <a
                href={archiveUrl(rel11, 'libmod_pagespeed-linux-x86_64.so')}
                data-umami-event="cta_download_apache_so_x64"
                class="text-interactive hover:underline"
                >Module only (x86_64) <code class="text-xs">.so</code></a
              >
            </li>
            <li>
              <a
                href={archiveUrl(rel11, 'libmod_pagespeed-linux-aarch64.so')}
                data-umami-event="cta_download_apache_so_aarch64"
                class="text-interactive hover:underline"
                >Module only (aarch64) <code class="text-xs">.so</code></a
              >
            </li>
          </ul>
          <p class="mt-3 text-xs text-text-annotation">
            Module-only <code class="text-xs">.so</code> download: drop it in and restart —
          </p>
          <pre
            class="mt-1 overflow-x-auto rounded bg-stone-900 dark:bg-stone-950 p-3 text-xs text-stone-100"><code>{`sudo cp libmod_pagespeed-linux-x86_64.so /usr/lib/apache2/modules/mod_pagespeed.so
sudo cp libmod_pagespeed-linux-aarch64.so /usr/lib/apache2/modules/mod_pagespeed.so
sudo systemctl restart apache2`}</code></pre>
          <p class="mt-3 text-xs text-text-annotation">
            Prefer a managed repo? Use the <a
              href="/download/apt-yum/"
              data-umami-event="cta_download_apt_yum"
              class="text-interactive underline">signed apt / yum repository</a
            > for one-line install and automatic updates. On cPanel, see the <a
              href="/docs/cpanel/"
              data-umami-event="cta_download_cpanel"
              class="text-interactive underline">cPanel / EasyApache 4 guide</a
            >.
          </p>
          <p class="mt-3 text-xs text-text-annotation">
            Downloaded the <code class="text-xs">.deb</code> or <code class="text-xs">.rpm</code> directly
            instead of using a repo?
          </p>
          <pre
            class="mt-1 overflow-x-auto rounded bg-stone-900 dark:bg-stone-950 p-3 text-xs text-stone-100"><code>{`sudo dpkg -i ${artifactUrl(rel11, 'deb', 'amd64').split('/').pop()}
sudo dpkg -i ${artifactUrl(rel11, 'deb', 'arm64').split('/').pop()}
sudo dnf install -y ${artifactUrl(rel11, 'rpm', 'x86_64')}
sudo dnf install -y ${artifactUrl(rel11, 'rpm', 'aarch64')}`}</code></pre>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-text-annotation">
            IIS (Windows)
          </p>
          <ul class="mt-2 space-y-1.5">
            <li>
              <a
                href={artifactUrl(rel11, 'msi', 'win_x64')}
                data-umami-event="cta_download_iis_msi"
                class="text-interactive hover:underline"
                >Windows Server 2019/2022/2025 (x64) <code class="text-xs">.msi</code></a
              >
            </li>
          </ul>
          <p class="mt-3 text-xs text-text-annotation">
            Each binary is GPG-signed; <code>.asc</code> next to every file (e.g. <code
              >…msi.asc</code
            >). nginx is GA &mdash; install it from the <a
              href="/download/apt-yum/"
              class="text-interactive underline">signed apt / yum repository</a
            >. Need debug symbols? <a href="/contact/" class="text-interactive underline"
              >Contact us</a
            >.
          </p>
        </div>
      </div>

      <div class="mt-5 rounded-lg border border-border bg-bg-elevated p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-text-annotation">
          Verify a download
        </p>
        <p class="mt-2 text-sm text-text-muted">
          Installs through <code class="text-xs">packages.modpagespeed.com</code> verify signatures automatically
          against the repository signing key (RSA 4096, fingerprint <code class="text-xs"
            >DF00E296BE9141CEA5411346F50D6054F10712A0</code
          >).
        </p>
        <p class="mt-2 text-sm text-text-muted">
          For direct downloads, each artifact is GPG-signed and listed in <a
            href={archiveUrl(rel11, 'SHA256SUMS')}
            class="text-interactive underline">SHA256SUMS</a
          >:
        </p>
        <pre
          class="mt-1 overflow-x-auto rounded bg-stone-900 dark:bg-stone-950 p-3 text-xs text-stone-100"><code>{`curl -O ${archiveUrl(rel11, 'SHA256SUMS')}
sha256sum --check --ignore-missing SHA256SUMS
# Or with the GPG signing key:
curl -O ${rel11.urls.gpg_key}
gpg --import weamp-pkg-public.asc
gpg --verify ${artifactUrl(rel11, 'deb', 'amd64').split('/').pop()}.asc`}</code></pre>
      </div>
    </div>
  </section>

  <!-- Other integration paths: nginx walkthrough + IISpeed transfer CTA -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-16 pb-20">
    <h2 class="text-base font-semibold text-text-body">Other integration paths</h2>
    <p class="mt-3 text-sm text-text-muted">
      Running nginx specifically? <a
        href="https://ngxpagespeed.com/"
        class="text-interactive hover:text-interactive-hover underline">ngxpagespeed.com</a
      > has the nginx install walkthrough.
    </p>
    <p class="mt-3 text-sm text-text-muted">
      IISpeed customer? Contact us about moving to mod_pagespeed — IIS deployments run on the native
      Windows module from the 1.15 packaging channel. <a
        href="mailto:info@we-amp.com?subject=IISpeed%20license%20transfer&body=My%20IISpeed%20key%3A%20%0A%0AMy%20license%20transfers%20to%20mod_pagespeed%202.1.%0A"
        class="text-interactive hover:text-interactive-hover underline"
        >Arrange your no-cost transfer</a
      >.
    </p>
  </section>

  <section class="border-t border-border py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-text-body text-center">How licensing and support work</h2>
      <dl class="mt-10 space-y-6 text-sm text-text-muted">
        <div>
          <dt class="font-semibold text-text-body flex items-center gap-2">
            <Icon name="tag" class="h-4 w-4 text-interactive shrink-0" />
            Pricing
          </dt>
          <dd class="mt-1">
            Free &mdash; {LICENSE_CLAUSE}, with no usage registration. What We-Amp sells is <a
              href="/pricing/"
              class="text-interactive hover:text-interactive-hover underline"
              >support &mdash; and hardened builds</a
            >. No per-request fees, no bandwidth metering.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-text-body flex items-center gap-2">
            <Icon name="circle-play" class="h-4 w-4 text-interactive shrink-0" />
            Evaluation
          </dt>
          <dd class="mt-1">
            There is nothing to evaluate against a clock — the software is free, in full, under
            Apache-2.0. Install it, measure the results on your own pages, and add a <a
              href="/pricing/"
              class="text-interactive hover:text-interactive-hover underline">support plan</a
            > when you want support from the people who build it.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-text-body flex items-center gap-2">
            <Icon name="server" class="h-4 w-4 text-interactive shrink-0" />
            Hosting
          </dt>
          <dd class="mt-1">
            Runs on your servers. No third-party proxy, no CDN dependency, no external service in
            your request path. The software is <a
              href="/license/"
              class="text-interactive hover:text-interactive-hover underline">{LICENSE_CLAUSE}</a
            >.
          </dd>
        </div>
      </dl>
      <div class="mt-10 text-center">
        <a
          href="/pricing/"
          class="text-sm font-semibold text-interactive hover:text-interactive-hover inline-flex items-center gap-2"
        >
          See support plans
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
