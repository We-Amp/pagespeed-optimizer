---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMMERCIAL_EMAIL } from '../data/product-facts.mjs';

// Topics: one per offer, each with a one-line hint shown under the select.
// Values are what the capture endpoint logs as the lead topic. Old values that
// external links and earlier pages still carry are mapped in TOPIC_ALIASES
// (read by the prefill script below).
const TOPICS: Array<{ value: string; label: string; hint: string; commercial: boolean }> = [
  {
    value: 'setup',
    label: 'Setup help',
    hint: 'Server, OS, web server and version help us reply faster.',
    commercial: false,
  },
  {
    value: 'support',
    label: 'Support subscription',
    hint: 'Tell us roughly how many production servers and which platforms.',
    commercial: true,
  },
  {
    value: 'hardened',
    label: 'Hardened builds',
    hint: 'Which distributions and versions you run.',
    commercial: true,
  },
  {
    value: 'hosting',
    label: 'Hosting partner program',
    hint: 'Host count, control panel and distributions across your fleet.',
    commercial: true,
  },
  {
    value: 'consulting',
    label: 'Consulting',
    hint: 'The site, what is slow, and when you need it fixed.',
    commercial: true,
  },
  {
    value: 'iispeed-transfer',
    label: 'IISpeed license transfer',
    hint: 'The order number or the email address the license was bought under.',
    commercial: true,
  },
  {
    value: 'agents',
    label: 'AI readability and agents',
    hint: 'What you need agents to see, and roughly how much crawler traffic you get.',
    commercial: false,
  },
  {
    value: 'other',
    label: 'Other (not security)',
    hint: 'Security reports go to a separate channel, below.',
    commercial: false,
  },
];
const TOPIC_ALIASES: Record<string, string> = {
  enterprise: 'support',
  airead: 'agents',
  'agent-optimize': 'agents',
  iispeed: 'iispeed-transfer',
  transfer: 'iispeed-transfer',
  partner: 'hosting',
};
const COMMERCIAL_TOPICS = TOPICS.filter((t) => t.commercial).map((t) => t.value);
const topicConfig = {
  hints: Object.fromEntries(TOPICS.map((t) => [t.value, t.hint])),
  commercial: COMMERCIAL_TOPICS,
  aliases: TOPIC_ALIASES,
};

const inputClass =
  'mt-1 block w-full rounded-md border border-control-border bg-bg-elevated text-text-body px-3 py-2 focus:border-interactive focus:ring-2 focus:ring-interactive';

const nextSteps = [
  { when: 'within 1 business day', what: 'An engineer replies to every message.' },
  { when: 'within 3 business days', what: 'Commercial topics get a written quote.' },
  {
    when: 'within 5 business days of signing',
    what: 'The onboarding call opens your support channel.',
  },
];
---

<BaseLayout
  title="Contact mod_pagespeed 2.1: setup, support and partners"
  description="Setup help, support subscriptions, hardened builds, hosting partners, consulting and IISpeed transfers. One form; we reply within one business day (CET)."
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center">
      <h1 class="h1-hero text-text-body">One form for setup, support and partnerships.</h1>
      <p class="mt-4 text-lg text-text-muted max-w-2xl mx-auto">
        Setup help, support subscriptions, hardened builds, partnerships and consulting all go
        through this form. We reply within one business day (CET). Security reports have their own
        channel.
      </p>
      <p class="mt-3 text-sm text-text-annotation max-w-2xl mx-auto">
        Setup steps live in the
        <a href="/docs/" class="text-interactive hover:text-interactive-hover underline"
          >documentation</a
        >; what a subscription covers is on the
        <a href="/support/" class="text-interactive hover:text-interactive-hover underline"
          >support page</a
        >.
      </p>
    </div>

    <ol class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-3" aria-label="What happens next">
      {
        nextSteps.map((step) => (
          <li class="readout-plate px-4 py-3">
            <p class="font-mono text-xs text-interactive">{step.when}</p>
            <p class="mt-1 text-sm text-text-muted">{step.what}</p>
          </li>
        ))
      }
    </ol>

    <!-- Contact form. Behavior: JS-enabled clients POST to the capture endpoint
         (/ai-readability/api/contact → render service → Telegram + logged), with a
         mailto: fallback if that POST fails. No-JS clients post to the mailto:
         action below. Either path lands the message with us. -->
    <form
      id="contact-form"
      action={`mailto:${COMMERCIAL_EMAIL}`}
      method="post"
      enctype="text/plain"
      data-fallback-email={COMMERCIAL_EMAIL}
      data-topic-config={JSON.stringify(topicConfig)}
      class="mt-8 rounded-lg border border-border bg-bg-elevated p-6 sm:p-8 space-y-5"
    >
      <div>
        <label for="contact-name" class="eyebrow"> Name </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          aria-required="true"
          autocomplete="name"
          class="mt-1 block w-full rounded-md border border-control-border bg-bg-elevated text-text-body px-3 py-2 focus:border-interactive focus:ring-2 focus:ring-interactive"
        />
      </div>

      <div>
        <label for="contact-email" class="eyebrow"> Email </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          aria-required="true"
          autocomplete="email"
          class="mt-1 block w-full rounded-md border border-control-border bg-bg-elevated text-text-body px-3 py-2 focus:border-interactive focus:ring-2 focus:ring-interactive aria-[invalid=true]:border-accent aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-accent"
        />
      </div>

      <div>
        <label for="contact-topic" class="eyebrow"> Topic </label>
        <select
          id="contact-topic"
          name="topic"
          required
          aria-required="true"
          aria-describedby="contact-topic-hint"
          class="mt-1 block w-full rounded-md border border-control-border bg-bg-elevated text-text-body px-3 py-2 focus:border-interactive focus:ring-2 focus:ring-interactive"
        >
          {TOPICS.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
        <p id="contact-topic-hint" class="mt-1 text-sm text-text-annotation" data-topic-hint>
          {TOPICS[0].hint}
        </p>
      </div>

      <fieldset id="contact-qualifiers" class="space-y-4" data-qualifiers>
        <legend class="eyebrow">
          About your organization <span class="font-normal text-text-annotation">(optional)</span>
        </legend>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="contact-org" class="eyebrow">Company</label>
            <input
              id="contact-org"
              name="org"
              type="text"
              autocomplete="organization"
              class={inputClass}
            />
          </div>
          <div>
            <label for="contact-role" class="eyebrow">Role</label>
            <input
              id="contact-role"
              name="role"
              type="text"
              autocomplete="organization-title"
              class={inputClass}
            />
          </div>
        </div>
        <div>
          <label for="contact-servers" class="eyebrow"
            >Production servers</label
          >
          <select id="contact-servers" name="servers" class={inputClass}>
            <option value="">Choose one</option>
            <option value="Up to 5">Up to 5</option>
            <option value="Up to 25">Up to 25</option>
            <option value="More than 25">More than 25</option>
          </select>
        </div>
      </fieldset>

      <div>
        <label for="contact-message" class="eyebrow">
          Message
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="6"
          required
          aria-required="true"
          aria-describedby="contact-message-hint"
          class="mt-1 block w-full rounded-md border border-control-border bg-bg-elevated text-text-body px-3 py-2 focus:border-interactive focus:ring-2 focus:ring-interactive"
        ></textarea>
        <p id="contact-message-hint" class="mt-1 text-sm text-text-annotation">
          Plain text is fine. Logs and config snippets help.
        </p>
      </div>

      <p class="text-xs text-text-annotation">
        We use what you send only to reply. See the
        <a href="/privacy/" class="text-interactive hover:text-interactive-hover underline"
          >privacy policy</a
        >.
      </p>

      <div class="flex flex-col gap-2">
        <button
          id="contact-submit"
          type="submit"
          class="btn-primary"
          aria-describedby="contact-form-hint"
        >
          Send message
        </button>
        <p id="contact-form-hint" class="text-xs text-text-annotation">
          We reply within one business day (CET). Prefer email? Reach us at
          <a
            href={`mailto:${COMMERCIAL_EMAIL}`}
            class="text-interactive hover:text-interactive-hover underline">{COMMERCIAL_EMAIL}</a
          ><button
            type="button"
            id="contact-copy-email"
            data-copy={COMMERCIAL_EMAIL}
            class="ml-1 text-interactive hover:text-interactive-hover underline">(copy)</button
          >.
        </p>
        <p id="contact-status" role="status" aria-live="polite" class="hidden text-sm"></p>
      </div>
    </form>

    <script>
      // Topic routing. The form carries its topic table (hints, which topics
      // are commercial, and the aliases older links still use) as JSON in
      // data-topic-config, rendered from the frontmatter, so this script holds
      // no copy of it.
      type TopicConfig = {
        hints: Record<string, string>;
        commercial: string[];
        aliases: Record<string, string>;
      };
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const config: TopicConfig = JSON.parse(form?.dataset.topicConfig ?? '{}');
      const topicEl = document.getElementById('contact-topic') as HTMLSelectElement | null;
      const hintEl = form?.querySelector<HTMLElement>('[data-topic-hint]') ?? null;
      const qualifiers = form?.querySelector<HTMLFieldSetElement>('[data-qualifiers]') ?? null;
      const messageEl = document.getElementById('contact-message') as HTMLTextAreaElement | null;
      const serversEl = document.getElementById('contact-servers') as HTMLSelectElement | null;

      // Show the optional company / role / server-band fields only for the
      // commercial topics. Hidden fields are disabled so they never post.
      function syncTopic() {
        if (!topicEl) return;
        const topic = topicEl.value;
        if (hintEl) hintEl.textContent = config.hints?.[topic] ?? '';
        const commercial = (config.commercial ?? []).includes(topic);
        if (qualifiers) {
          qualifiers.hidden = !commercial;
          qualifiers.disabled = !commercial;
        }
      }

      // Pre-fill from the query string: ?topic= (old values mapped to the
      // current ones), and the hosting-partner qualifiers (?hosts=, ?panel=,
      // ?distros=) the partner page sends, folded into the message.
      const params = new URLSearchParams(window.location.search);
      const rawTopic = (params.get('topic') ?? '').trim().toLowerCase();
      const wanted = config.aliases?.[rawTopic] ?? rawTopic;
      if (topicEl && wanted && Array.from(topicEl.options).some((o) => o.value === wanted)) {
        topicEl.value = wanted;
      }
      const prefill = [
        ['hosts', 'Hosts'],
        ['panel', 'Control panel'],
        ['distros', 'Distributions'],
      ]
        .map(([key, label]) => {
          const v = (params.get(key) ?? '').trim().slice(0, 200);
          return v ? `${label}: ${v}` : '';
        })
        .filter(Boolean);
      if (messageEl && prefill.length && !messageEl.value) {
        messageEl.value = `${prefill.join('\n')}\n\n`;
      }
      const serversParam = (params.get('servers') ?? '').trim();
      if (serversEl && serversParam) {
        const match = Array.from(serversEl.options).find((o) => o.value === serversParam);
        if (match) serversEl.value = match.value;
      }
      topicEl?.addEventListener('change', syncTopic);
      syncTopic();

      // Copy-to-clipboard for the contact address, so a visitor whose mail client
      // doesn't open can grab the address without selecting it by hand.
      const copyBtn = document.getElementById('contact-copy-email') as HTMLButtonElement | null;
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const addr = copyBtn.dataset.copy ?? '';
          try {
            await navigator.clipboard.writeText(addr);
            const prev = copyBtn.textContent;
            copyBtn.textContent = '(copied)';
            window.setTimeout(() => {
              copyBtn.textContent = prev;
            }, 1500);
          } catch {
            // Clipboard API unavailable (e.g. non-secure context) — the address
            // stays visible and selectable next to this button, so this is a no-op.
          }
        });
      }

      // Intercept submit and POST to the capture endpoint; fall back to a mailto:
      // to the commercial address if the POST fails, and to the form's native
      // mailto action if JS is off entirely.
      const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
      const statusEl = document.getElementById('contact-status');
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;

      function setStatus(kind: 'success' | 'error' | null, msg: string) {
        if (!statusEl) return;
        statusEl.textContent = msg;
        statusEl.classList.remove('hidden', 'text-interactive', 'text-accent');
        if (kind === null) {
          statusEl.classList.add('hidden');
          return;
        }
        if (kind === 'success') {
          statusEl.classList.add('text-interactive');
        } else {
          statusEl.classList.add('text-accent');
        }
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const name = String(data.get('name') ?? '').trim();
        const email = String(data.get('email') ?? '').trim();
        const topic = String(data.get('topic') ?? 'setup');
        const body = String(data.get('message') ?? '').trim();

        // Client-side validation. Lean on the browser first, then add our own
        // checks so the failure is a clear message rather than a silent no-op.
        if (!form.checkValidity()) {
          form.reportValidity();
          setStatus('error', 'Please fill in name, email and message before sending.');
          return;
        }
        if (!name || !email || !body) {
          setStatus('error', 'Please fill in name, email and message before sending.');
          return;
        }
        const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        if (!emailOk) {
          setStatus('error', 'That email address does not look right. Check it and try again.');
          // Flag the email field invalid (triggers the visible accent cue), move
          // focus to it, and point its aria-errormessage at the status message so
          // assistive tech announces the error against the field.
          if (emailInput) {
            emailInput.setAttribute('aria-invalid', 'true');
            emailInput.setAttribute('aria-errormessage', 'contact-status');
            emailInput.focus();
          }
          return;
        }
        // Email passed: clear any prior invalid state from an earlier submit.
        if (emailInput) {
          emailInput.setAttribute('aria-invalid', 'false');
          emailInput.removeAttribute('aria-errormessage');
        }

        // Qualifiers ride inside the message: the endpoint treats a `company`
        // key as a bot honeypot, so the company never posts as its own field.
        // Disabled (hidden) qualifier fields are absent from FormData.
        const qualifierLines = [
          ['org', 'Company'],
          ['role', 'Role'],
          ['servers', 'Production servers'],
        ]
          .map(([key, label]) => {
            const v = String(data.get(key) ?? '').trim();
            return v ? `${label}: ${v}` : '';
          })
          .filter(Boolean);
        const message = qualifierLines.length ? `${qualifierLines.join('\n')}\n\n${body}` : body;

        // mailto: fallback (used only if the POST fails) — preserves the
        // never-lose-a-lead property the mailto-only flow had.
        const recipient = form.dataset.fallbackEmail ?? '';
        const label = topicEl?.selectedOptions[0]?.textContent?.trim() ?? topic;
        const subject = `[${label}] ${name || email || 'website inquiry'}`;
        const mailtoBody =
          `From: ${name} <${email}>\n` + `Topic: ${topic}\n` + `\n` + `${message}\n`;
        const mailtoHref =
          `mailto:${recipient}` +
          `?subject=${encodeURIComponent(subject)}` +
          `&body=${encodeURIComponent(mailtoBody)}`;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.setAttribute('aria-busy', 'true');
        }
        setStatus('success', 'Sending…');
        try {
          const res = await fetch('/ai-readability/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, name, topic, message }),
          });
          if (!res.ok) throw new Error(`status ${res.status}`);
          form.reset();
          syncTopic();
          // Fire on a successful POST only (not on click) so validation-blocked
          // or failed submits don't inflate the contact-conversion count.
          const umami = (window as any).umami;
          umami?.track('contact_submit', { topic });
          // lead_submit — one event per successful form submit, alongside the
          // form's own event. Properties: channel (contact | quote | quick | newsletter |
          // hosting; a contact-form submit on the hosting topic reports hosting), topic
          // (the topic posted to the capture endpoint), wedge (the scanner wedge, empty
          // when none) and source_path (the page path, never the query string).
          umami?.track('lead_submit', {
            channel: topic === 'hosting' ? 'hosting' : 'contact',
            topic,
            wedge: '',
            source_path: window.location.pathname,
          });
          setStatus(
            'success',
            'Thanks, your message is in. An engineer replies within one business day (CET).',
          );
        } catch {
          // Backend unreachable — open the mail client so the message is never lost.
          setStatus(
            'success',
            `Opening your mail client, addressed to ${recipient}. If nothing happens, copy ${recipient} and email us directly.`,
          );
          window.location.href = mailtoHref;
        } finally {
          window.setTimeout(() => {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.removeAttribute('aria-busy');
            }
          }, 2000);
        }
      });
    </script>

    <!-- Security disclosure (separate channel) -->
    <div class="mt-12 rounded-lg border border-border bg-bg-secondary p-6">
      <h2 class="text-lg font-semibold text-text-body">Security disclosure</h2>
      <p class="mt-2 text-sm text-text-muted">
        Found a vulnerability? Email
        <a
          href="mailto:security@modpagespeed.com"
          class="text-interactive hover:text-interactive-hover underline"
          >security@modpagespeed.com</a
        >. See the
        <a href="/security/" class="text-interactive hover:text-interactive-hover underline"
          >security policy</a
        > for safe-harbor terms and what to include in a report.
      </p>
    </div>

    <!-- Manage subscription -->
    <div class="mt-8 rounded-lg border border-border bg-bg-secondary p-6 text-center">
      <p class="text-sm font-medium text-text-body">Existing IISpeed or 1.x subscription?</p>
      <p class="mt-2 text-sm text-text-muted">
        Invoices stay in the
        <a
          href="https://mpspro.onfastspring.com/account"
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="outbound_fastspring_portal"
          class="text-interactive hover:text-interactive-hover underline transition-colors"
          >FastSpring customer portal</a
        >.
      </p>
    </div>

    <div class="mt-8 text-center">
      <p class="text-sm text-text-annotation">
        <a
          href="https://www.we-amp.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-text-muted transition-colors">We-Amp B.V.</a
        >, The Netherlands
      </p>
    </div>
  </section>
</BaseLayout>
