---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { faqShared, stripHtml } from '../../data/faq-shared';
import { faq11 } from '../../data/faq-1-1';
import { LICENSE_CLAUSE } from '../../data/product-facts.mjs';

// Same FAQ surface as /1.1/ marketing — keeps the discovery-intent reader
// inside the consistent reassurance tier without duplicating answers.
const faqEntries = [...faqShared, ...faq11];

const platforms = [
  { name: 'Apache', status: 'GA', detail: '.deb / .rpm — amd64 + arm64' },
  {
    name: 'nginx',
    status: 'GA',
    detail:
      'apt/dnf — Debian 11/12/13, Ubuntu 22.04/24.04 (amd64 + arm64), AlmaLinux/RHEL/Rocky 9 (x86_64 + aarch64) and 10 (x86_64)',
  },
  { name: 'IIS', status: 'GA', detail: '.msi — Windows Server 2019 / 2022 / 2025' },
  { name: 'Envoy', status: 'Experimental', detail: 'HTTP filter' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqEntries.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: stripHtml(faq.a),
        },
      })),
    },
  ],
};
---

<BaseLayout
  title="mod_pagespeed maintained: drop-in for Apache, nginx, IIS"
description="Google open-sourced mod_pagespeed; the last open-source release was 2020, archived 2025. We-Amp maintains it now as 1.15, a drop-in replacement."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-bg-secondary border-b border-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <p class="eyebrow">Project status</p>
        <h1 class="h1-hero mt-3 text-text-body">
          Google open-sourced mod_pagespeed. We maintain it now.
        </h1>
        <p class="lede mt-6">
          Its last open-source release shipped in 2020 under the Apache incubator, and Google archived the
          repository in 2025. We picked it up. <strong>mod_pagespeed 1.15</strong> is
          <a href="/blog/mod-pagespeed-1-1-release/" class="text-interactive hover:text-interactive-hover underline">the maintained continuation</a>
          — a drop-in replacement with the same configuration, a modernized, secured filter stack with new optimizers, and ongoing security patches.
          Apache, nginx, and IIS ship today; Envoy is experimental.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/download/" class="btn-primary" data-umami-event="cta_1_1_migrate_hero_install">
            Install mod_pagespeed 1.15
          </a>
          <a href="/1.1/docs/upgrading-from-open-source/" class="btn-secondary">
            Read the upgrade guide
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick facts -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20">
    <h2 class="h2-section text-text-body text-center">What's shipping today</h2>
    <p class="mt-4 text-center text-text-muted max-w-2xl mx-auto">
      Pre-built binaries for the platforms most teams are running. No build from source required.
    </p>
    <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6">
      {
        platforms.map((platform) => (
          <div class="rounded-lg border border-border p-6 text-center">
            <p class="font-semibold text-text-body">{platform.name}</p>
            <p
              class:list={[
                'mt-2 inline-block rounded-chip px-2 py-0.5 text-xs font-semibold',
                platform.status === 'GA'
                  ? 'bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-200'
                  : 'bg-bg-elevated text-text-muted',
              ]}
            >
              {platform.status}
            </p>
            <p class="mt-2 text-sm text-text-annotation">{platform.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- What you keep / what changes -->
  <section class="bg-bg-secondary border-y border-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20">
      <h2 class="h2-section text-text-body text-center">
        Drop-in. Your config keeps working.
      </h2>
      <p class="mt-4 text-center text-text-muted max-w-2xl mx-auto">
        The upgrade is three steps: stop the server, swap the binary, restart. The same
        <code class="rounded bg-bg-elevated px-1 py-0.5 text-xs">pagespeed</code>
        directives, the same <a href="/features/" class="text-interactive hover:text-interactive-hover underline">filters</a>, the same admin endpoints.
      </p>
      <div class="mt-12 grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div>
          <h3 class="font-semibold text-text-body">What stays the same</h3>
          <ul class="mt-4 space-y-2 text-sm text-text-body">
            <li>
              Every <code class="rounded bg-bg-elevated px-1 py-0.5 text-xs"
                >pagespeed</code
              > directive
            </li>
            <li>Every filter (image, CSS, JS, HTML)</li>
            <li>
              The admin console at <code
                class="rounded bg-bg-elevated px-1 py-0.5 text-xs"
                >/pagespeed_global_admin</code
              >
            </li>
            <li>The in-process module deployment model</li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-text-body">What's new</h3>
          <ul class="mt-4 space-y-2 text-sm text-text-body">
            <li>CVE patches against the archived upstream</li>
            <li>Cyclone shared-memory cache (replaces the legacy file cache)</li>
            <li>Native IIS module for Windows Server 2019 / 2022 / 2025</li>
            <li>Bazel build, pre-built binaries (amd64 + arm64)</li>
            <li>Direct email support from the maintainer</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ — rendered from src/data/faq-shared.ts + faq-1-1.ts -->
  <section id="faq" class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-20">
    <h2 class="h2-section text-text-body text-center">Frequently asked</h2>
    <p class="mt-4 text-center text-text-muted max-w-2xl mx-auto">
      The questions people ask when they land here from a search. For the full 1.15 product page,
      <a href="/1.1/" class="text-interactive hover:text-interactive-hover underline"
        >see mod_pagespeed 1.15 →</a
      >
    </p>

    <div class="mt-12 space-y-3">
      {
        faqEntries.map((faq) => (
          <details class="group rounded-lg border border-border bg-bg-elevated open:shadow-sm transition-shadow">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 text-base font-semibold text-text-body">
              <span>{faq.q}</span>
              <Icon
                name="chevron-down"
                class="h-5 w-5 shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <div
              class="px-5 pb-5 -mt-1 text-sm text-text-muted"
              set:html={faq.a}
            />
          </details>
        ))
      }
    </div>
  </section>

  <!-- IISpeed callout -->
  <section class="bg-bg-secondary border-y border-border">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
      <p class="eyebrow">Running IISpeed?</p>
      <h2 class="mt-3 text-xl font-bold text-text-body">
        Your existing license transfers at no cost.
      </h2>
      <p class="mt-3 text-sm text-text-muted leading-relaxed">
        IISpeed is folded into mod_pagespeed 1.15 (IIS). Existing IISpeed license holders can
        transfer to a current license at no charge. The new module ships as a native IIS component
        for Windows Server 2019 / 2022 / 2025 and accepts both <code
          class="rounded bg-bg-elevated px-1 py-0.5 text-xs">pagespeed.config</code
        > and <code class="rounded bg-bg-elevated px-1 py-0.5 text-xs"
          >iiswebspeed.config</code
        > for compatibility with legacy installs.
        <a href="/contact/" class="text-interactive hover:text-interactive-hover underline">Contact us</a> to
        arrange the transfer.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-stone-900">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="h2-section text-white">Same config. Different binary.</h2>
      <p class="mt-4 text-stone-400 max-w-xl mx-auto">
        Install and run it — it optimizes immediately, and it is free in development and in
        production: the maintained continuation is {LICENSE_CLAUSE}. What
        We-Amp sells is <a href="/pricing/" class="text-stone-200 underline hover:text-white"
          >support — and hardened builds</a
        >.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/download/" class="btn-primary" data-umami-event="cta_1_1_migrate_bottom_install">
          Download &amp; run
        </a>
        <a href="/pricing/" class="btn-secondary" data-umami-event="cta_1_1_migrate_bottom_buy">
          Support plans
        </a>
        <a
          href="/1.1/docs/upgrading-from-open-source/"
          class="rounded-md border border-stone-600 px-6 py-3 text-sm font-semibold text-stone-300 hover:bg-stone-800 transition-colors"
        >
          Upgrade guide
        </a>
        <a
          href="/contact/"
          class="rounded-md border border-stone-600 px-6 py-3 text-sm font-semibold text-stone-300 hover:bg-stone-800 transition-colors"
        >
          Email the maintainer
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
