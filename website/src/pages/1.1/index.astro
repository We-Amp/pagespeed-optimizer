---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { faqShared, stripHtml } from '../../data/faq-shared';
import { faq11 } from '../../data/faq-1-1';
import { offerJsonLd } from '../../data/offer-jsonld';
import { LICENSE_CLAUSE } from '../../data/product-facts.mjs';

// 1.1 marketing FAQ = shared commercial entries + 1.1-specific entries.
const faqEntries = [...faqShared, ...faq11];

// Platform availability. Apache, nginx, IIS, and the ASP.NET Core sidecar ship
// as GA today; Envoy and Apache Traffic Server are experimental. Order GA-first
// so the "what's ready now" story reads top-left.
type PlatformStatus = 'GA' | 'Experimental';
const platforms: Array<{
  name: string;
  status: PlatformStatus;
  description: string;
  logo: string;
  // Colored brand marks (e.g. the ATS traffic-light) opt out of the grid's
  // dark:invert so their colors survive on the dark cards. Default = invert.
  invert?: boolean;
}> = [
  {
    name: 'Apache',
    status: 'GA',
    description: 'Drop-in replacement for the Google/Apache module',
    logo: '/images/logo-apache.svg',
  },
  {
    name: 'nginx',
    status: 'GA',
    description:
      'Dynamic module — prebuilt apt/dnf package for Debian 11/12/13, Ubuntu 22.04/24.04, AlmaLinux/RHEL/Rocky 9 (x86_64 + aarch64) and 10 (x86_64)',
    logo: '/images/logo-nginx.svg',
  },
  {
    name: 'IIS',
    status: 'GA',
    description: 'Native Windows Server support',
    logo: '/images/logo-iis.svg',
  },
  {
    name: 'ASP.NET Core',
    status: 'GA',
    description: 'Middleware for .NET apps — the bundled-nginx Sidecar (NuGet)',
    logo: '/images/logo-dotnet.svg',
  },
  {
    name: 'Envoy',
    status: 'Experimental',
    description: 'HTTP filter for Envoy proxy',
    logo: '/images/logo-envoy.svg',
  },
  {
    name: 'Apache Traffic Server',
    status: 'Experimental',
    description: 'Plugin for the Apache Traffic Server proxy cache',
    // ?v=2 cache-busts the prior (relay-glyph) SVG that shipped briefly at this
    // immutable URL, so returning visitors get the new traffic-light mark.
    logo: '/images/logo-trafficserver.svg?v=2',
    invert: false,
  },
];

const platformStatusStyles: Record<PlatformStatus, string> = {
  GA: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300',
  Experimental: 'bg-stone-200 text-stone-700 dark:bg-stone-700 dark:text-stone-300',
};

const features = [
  {
    title: 'Maintained and supported',
    description:
      'Regular updates, security patches, and direct support from the team that knows the codebase best.',
  },
  {
    title: 'Drop-in replacement',
    description:
      "Same configuration directives, same behavior — a modernized, secured filter stack with new optimizers. Swap the binary and you're done.",
  },
  {
    title: 'Cyclone Cache',
    description:
      'New cache backend shared with ModPageSpeed 2.0. Fixed-size file, lock-free reads, memory-mapped I/O.',
  },
  {
    title: 'Bazel build system',
    description:
      'Rebuilt with Bazel for reproducible builds. Prebuilt, signed packages for Apache and nginx across Debian, Ubuntu, and AlmaLinux — no more recompiling the nginx module against each upstream release.',
  },
  {
    title: 'Security fixes',
    description:
      'All known CVEs from the open-source project patched. Ongoing security maintenance included.',
  },
  {
    title: 'Multi-platform',
    description:
      'One source tree, five ports. Apache, nginx, and IIS ship today; Envoy and Apache Traffic Server are experimental. ASP.NET Core gets the bundled-nginx Sidecar.',
  },
];

// Two top-level JSON-LD scripts (not wrapped in @graph) so the Product
// schema is the first <script> tag — matches /download/'s shape and lets
// seo.spec.ts's Merchant Listing check assert data['@type'] === 'Product'
// directly. Both schemas are valid for Google Search; merchant-listing
// parsing just needs the Product to be a first-class document.
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'mod_pagespeed 1.15',
    description:
      "The maintained, commercially supported continuation of Google's mod_pagespeed. Drop-in compatible with the open-source release.",
    image: 'https://modpagespeed.com/og-default.png?v=2',
    brand: { '@type': 'Brand', name: 'ModPageSpeed' },
    offers: offerJsonLd({ url: 'https://modpagespeed.com/1.1/' }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqEntries.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(faq.a),
      },
    })),
  },
];
---

<BaseLayout
  title="mod_pagespeed 1.15 — Maintained for Apache, nginx & IIS"
  description="Maintained mod_pagespeed for Apache, nginx, and IIS. Drop-in compatible with the open-source release — same config, modernized, secured filter stack with new optimizers — with ongoing security patches and the new Cyclone Cache."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-bg-secondary border-b border-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <p class="eyebrow">mod_pagespeed 1.15</p>
        <h1 class="h1-hero mt-3 text-text-body">
          mod_pagespeed, maintained again.
        </h1>
        <p class="lede mt-6">
          Google open-sourced mod_pagespeed; its last open-source release shipped in 2020. We picked it up. mod_pagespeed
          1.15 is a <strong>drop-in replacement</strong> — same config, same behavior, and a modernized, secured filter stack with new optimizers —
          with ongoing security patches, the new Cyclone Cache, and support from the people who know the
          codebase best.
        </p>
        <p class="mt-6 text-sm text-text-muted">
          <span class="font-semibold text-text-body">New:</span> the ASP.NET Core
          sidecar is now GA — one
          <code class="text-xs bg-bg-elevated px-1 rounded"
            >dotnet add package WeAmp.PageSpeed.Sidecar</code
          >.
          <a
            href="/1.1/docs/aspnet-sidecar/"
            class="text-interactive hover:underline"
            data-umami-event="cta_1_1_sidecar_ga">See the guide →</a
          >
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/1.1/docs/getting-started/" class="btn-primary" data-umami-event="cta_1_1_hero">
            Install mod_pagespeed 1.15
          </a>
          <a href="/1.1/docs/upgrading-from-open-source/" class="btn-secondary"> Upgrade Guide </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform Support -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20">
    <h2 class="h2-section text-text-body text-center">
      Five web servers and ASP.NET Core. One optimized codebase.
    </h2>
    <p class="mt-4 text-center text-text-muted max-w-2xl mx-auto">
      mod_pagespeed 1.15 runs as a native in-process module on <a
        href="/1.1/apache/"
        class="text-interactive hover:underline">Apache</a
      >, nginx, and IIS, and ships an ASP.NET Core sidecar for .NET apps. Envoy and Apache Traffic
      Server are experimental.
    </p>
    <div class="mt-12 grid grid-cols-2 md:grid-cols-3 gap-6">
      {
        platforms.map((platform) => (
          <div class="rounded-lg border border-border p-6 text-center">
            <img
              src={platform.logo}
              alt={platform.name}
              width="40"
              height="40"
              loading="lazy"
              class:list={['h-10 w-10 mx-auto', platform.invert !== false && 'dark:invert']}
            />
            <p class="mt-3 font-semibold text-text-body">{platform.name}</p>
            <span
              class:list={[
                'mt-2 inline-block rounded-md px-2 py-0.5 text-[11px] font-semibold',
                platformStatusStyles[platform.status],
              ]}
            >
              {platform.status}
            </span>
            <p class="mt-2 text-sm text-text-annotation">{platform.description}</p>
          </div>
        ))
      }
    </div>

    <!-- GA install one-liner -->
    <div class="mt-12 max-w-3xl mx-auto">
      <p class="text-center text-sm font-semibold text-text-body">
        Install on Debian, Ubuntu, or AlmaLinux/RHEL/Rocky 9 or 10
      </p>
      <pre
        class="mt-3 overflow-x-auto rounded-lg bg-stone-900 dark:bg-stone-950 p-4 text-sm text-stone-100"><code data-umami-event="cta_1_1_apt_install">curl -fsSL https://packages.modpagespeed.com/install.sh | sudo sh

# nginx
sudo apt install nginx-module-pagespeed   # Debian / Ubuntu
sudo dnf install nginx-module-pagespeed   # AlmaLinux/RHEL/Rocky 9 or 10

# Apache
sudo apt install mod-pagespeed            # Debian / Ubuntu
sudo dnf install mod-pagespeed            # AlmaLinux/RHEL/Rocky 9 or 10</code></pre>
      <p class="mt-3 text-center text-xs text-text-annotation">
        Prebuilt and signed for Debian 11/12/13 and Ubuntu 22.04/24.04 (amd64 + arm64), plus
        AlmaLinux/RHEL/Rocky 9 (x86_64 + aarch64) and 10 (x86_64) — no compiling. Each nginx module is pinned to its distro's stock nginx, so if
        you run a different nginx version, <a
          href="/contact/"
          class="text-interactive hover:underline">contact us</a
        > for a matching build.
      </p>
      <p class="mt-4 text-center text-xs text-text-annotation">
        Related reading: <a
          href="/blog/ngx-pagespeed-wont-build-modern-nginx/"
          class="text-interactive hover:text-interactive-hover underline"
          >ngx_pagespeed won't build on modern nginx?</a
        > and <a
          href="/blog/nginx-image-optimization-module/"
          class="text-interactive hover:text-interactive-hover underline"
          >the nginx image optimization module</a
        >.
      </p>
    </div>

    <!-- ASP.NET Core (sidecar) — distinct integration model; it IS a sidecar,
         so it sits outside the in-process module grid above. -->
    <div
      class="mt-12 max-w-3xl mx-auto rounded-lg border border-interactive/40 bg-interactive/10 p-6"
    >
      <p class="eyebrow">ASP.NET Core</p>
      <h3 class="mt-2 text-lg font-semibold text-text-body">
        Add it with one NuGet package.
      </h3>
      <p class="mt-3 text-sm text-text-muted leading-relaxed">
        <code class="text-xs bg-bg-elevated px-1 rounded"
          >WeAmp.PageSpeed.Sidecar</code
        > adds mod_pagespeed 1.15 to your ASP.NET Core app as middleware, with a bundled nginx optimizer
        on loopback behind it — no separate nginx to install or configure. Linux, and now GA.
      </p>
      <pre
        class="mt-4 overflow-x-auto rounded-lg bg-stone-900 dark:bg-stone-950 p-4 text-sm text-stone-100"><code data-umami-event="cta_1_1_sidecar_install">dotnet add package WeAmp.PageSpeed.Sidecar</code></pre>
      <p class="mt-4 text-sm">
        <a
          href="/1.1/docs/aspnet-sidecar/"
          class="text-interactive hover:underline"
          data-umami-event="cta_1_1_sidecar_guide">Read the ASP.NET Core guide &rarr;</a
        >
      </p>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-bg-secondary border-y border-border">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20">
      <h2 class="h2-section text-text-body text-center">
        What's changed since the last upstream release
      </h2>
      <p class="mt-4 text-center text-text-muted max-w-2xl mx-auto">
        We picked up where Google left off. Everything below ships in 1.15 — see how it stacks up
        against <a
          href="/alternatives/mod-pagespeed/"
          class="text-interactive hover:underline">the original open-source mod_pagespeed</a
        >.
      </p>
      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          features.map((feature) => (
            <div>
              <h3 class="font-semibold text-text-body">{feature.title}</h3>
              <p class="mt-2 text-sm text-text-muted leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 1.1 vs 2.0 -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20">
    <h2 class="h2-section text-text-body text-center">
      Two products. Both maintained.
    </h2>
    <p class="mt-4 text-center text-text-muted max-w-2xl mx-auto">
      Chosen by deployment fit, not recency. Pick the one that matches how you serve your site.
    </p>
    <div class="mt-12 grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <div class="rounded-lg border-2 border-interactive/40 bg-interactive/10 p-8">
        <p class="text-sm font-medium text-interactive">In-process module</p>
        <h3 class="mt-2 text-xl font-bold text-text-body">
          mod_pagespeed 1.15
        </h3>
        <p class="mt-3 text-sm text-text-muted leading-relaxed">
          Best for teams already running mod_pagespeed who want a supported, maintained release
          without changing their setup.
        </p>
        <ul class="mt-6 space-y-2 text-sm text-text-body">
          <li class="flex items-start gap-2">
            <span class="text-interactive mt-0.5">✓</span>
            Drop-in compatible with open-source config
          </li>
          <li class="flex items-start gap-2">
            <span class="text-interactive mt-0.5">✓</span>
            Apache, nginx &amp; IIS today; Envoy &amp; Apache Traffic Server experimental
          </li>
          <li class="flex items-start gap-2">
            <span class="text-interactive mt-0.5">✓</span>
            In-process — no sidecar needed
          </li>
          <li class="flex items-start gap-2">
            <span class="text-interactive mt-0.5">✓</span>
            WebP and AVIF image pipeline
          </li>
        </ul>
        <a
          href="/1.1/docs/getting-started/"
          class="btn-primary mt-6"
          data-umami-event="cta_1_1_comparison"
        >
          Install mod_pagespeed 1.15
        </a>
        <p class="mt-4 text-sm">
          <a
            href="https://demo-httpd-1.1.modpagespeed.com/pagespeed_global_admin/#/console"
            class="text-interactive hover:underline"
            data-umami-event="live_1_1_console">See the live admin console →</a
          >
        </p>
      </div>

      <div class="rounded-lg border-2 border-interactive/40 bg-interactive/10 p-8">
        <p class="text-sm font-medium text-interactive">Out-of-process worker</p>
        <h3 class="mt-2 text-xl font-bold text-text-body">ModPageSpeed 2.0</h3>
        <p class="mt-3 text-sm text-text-muted leading-relaxed">
          Ground-up rewrite in C++23. An async worker behind an nginx reverse proxy. Best for new
          deployments and teams that want the reverse-proxy or middleware model.
        </p>
        <ul class="mt-6 space-y-2 text-sm text-text-body">
          <li class="flex items-start gap-2">
            <span class="text-interactive mt-0.5">✓</span>
            SVG auto-vectorization and Jpegli image pipeline
          </li>
          <li class="flex items-start gap-2">
            <span class="text-interactive mt-0.5">✓</span>
            ASP.NET Core middleware + Docker / nginx reverse proxy
          </li>
          <li class="flex items-start gap-2">
            <span class="text-interactive mt-0.5">✓</span>
            Worker process + web console
          </li>
          <li class="flex items-start gap-2">
            <span class="text-interactive mt-0.5">✓</span>
            Viewport- and density-aware proactive variants
          </li>
        </ul>
        <a
          href="/docs/getting-started/"
          class="mt-6 inline-block rounded-md border border-border-strong bg-bg-elevated px-5 py-2 text-sm font-medium text-text-body hover:bg-bg-secondary transition-colors"
        >
          Explore 2.0
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ — rendered from src/data/faq-shared.ts + faq-1-1.ts -->
  <section
    id="faq"
    class="bg-bg-secondary border-y border-border py-20 scroll-mt-20"
  >
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="h2-section text-text-body text-center">
        Frequently asked questions
      </h2>
      <p class="mt-4 text-center text-text-muted max-w-2xl mx-auto">
        1.15-specific questions below. For the 2.0 architecture and integrations, see the <a
          href="/pricing/#faq"
          class="text-interactive hover:text-interactive-hover underline">2.0 FAQ →</a
        >
      </p>

      <div class="mt-12 space-y-3">
        {
          faqEntries.map((faq) => (
            <details class="group rounded-lg border border-border bg-bg-elevated open:shadow-sm transition-shadow">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 text-base font-semibold text-text-body">
                <span>{faq.q}</span>
                <Icon
                  name="chevron-down"
                  class="h-5 w-5 shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-180"
                />
              </summary>
              <div
                class="px-5 pb-5 -mt-1 text-sm text-text-muted"
                set:html={faq.a}
              />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-stone-900">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="h2-section text-white">Your mod_pagespeed. Maintained again.</h2>
      <p class="mt-4 text-stone-400 max-w-xl mx-auto">
        Install and run it — free in development and in production, {LICENSE_CLAUSE}. Same config, plus a modernized, secured filter stack with new optimizers —
        swap the binary and you're optimizing again. What We-Amp sells is support — and hardened
        builds.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/download/" class="btn-primary" data-umami-event="cta_1_1_bottom">
          Install mod_pagespeed 1.15
        </a>
        <a
          href="/contact/"
          class="rounded-md border border-stone-600 px-6 py-3 text-sm font-semibold text-stone-300 hover:bg-stone-800 transition-colors"
        >
          Email the maintainer
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
