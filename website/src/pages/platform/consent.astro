// /platform/consent/ — the zero-leak consent direction: what pre-consent
// leakage is, why tag managers get it wrong, what origin-side enforcement
// does differently, and one interest form (wedge consent-enforcement).
// No URL checker here on purpose: a scanner lens is built separately.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/instrument/SectionHeader.astro';
import PlatformInterestForm from '../../components/PlatformInterestForm.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Zero-leak consent for mod_pagespeed 2.1',
  url: 'https://modpagespeed.com/platform/consent/',
  description:
    'Third-party tags rewritten inert at the origin until the consent cookie grants their category, with an inventory of what actually fires.',
};
---

<BaseLayout
  title="Zero-leak consent for mod_pagespeed 2.1"
  description="Third-party tags rewritten inert at the origin until the consent cookie grants their category, with Consent Mode defaults set before any script runs."
  ogImage="/og-cards/platform-consent.png?v=1"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16" aria-labelledby="consent-title">
    <SectionHeader
      id="consent-title"
      eyebrow="Early access · zero-leak consent"
      title="Does your site leak before consent?"
      as="h1"
    >
      Most sites do, and most of them have a consent banner. The gap is between what the banner
      promises and what the browser sends.
    </SectionHeader>

    <div class="mt-10 space-y-6 text-text-muted">
      <div>
        <h2 class="text-lg font-semibold text-text-body">What pre-consent leakage is</h2>
        <p class="mt-2">
          Pre-consent leakage is every request a page sends to a third party before the visitor has
          agreed to it. The analytics beacon that fires on load, the pixel in the footer, the font
          or widget fetched from a vendor's CDN: each carries the visitor's IP address and often a
          cookie, and each is a transfer the banner has not yet authorized. Regulators and the
          consent-checking tools they rely on measure exactly this: what left the browser before the
          click.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-semibold text-text-body">Why tag managers get it wrong</h2>
        <p class="mt-2">
          Tag managers were built to fire tags, and gating them on consent is a configuration
          layered on top. One trigger with the wrong condition, one vendor script that loads its own
          dependencies, one template updated upstream, and a tag fires before consent again. The tag
          manager also reports what it is configured to do rather than what the browser observed, so
          the audit trail describes intent, not behavior.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-semibold text-text-body">
          What origin-side enforcement does differently
        </h2>
        <p class="mt-2">
          It works on the HTML before the browser sees it. The interceptor rewrites third-party tags
          inert at the server, so they cannot execute until the consent cookie grants their
          category. Consent Mode defaults are injected ahead of every script, so nothing runs in the
          gap. And the inventory lists the third parties as observed in the responses your server
          actually sent, not as configured in a dashboard.
        </p>
      </div>
    </div>

    <p class="readout-plate mt-10 px-4 py-3 text-sm text-text-muted">
      <span class="font-mono text-xs text-interactive">Status</span><br />
      This pack does not ship today. The interceptor that would run it does. Early access means you get
      the first build and shape its evidence export.
    </p>

    <div class="mt-10 rounded-lg border border-border bg-bg-elevated p-6 sm:p-8">
      <h2 class="text-lg font-semibold text-text-body">Tell us you need this</h2>
      <p class="mt-2 text-sm text-text-muted">
        Leave an email and, if you like, the site. We write when there is a build to try.
      </p>
      <PlatformInterestForm wedge="consent-enforcement" pack="Zero-leak consent" />
    </div>

    <p class="mt-8 text-sm text-text-annotation">
      All early-access directions are on the
      <a href="/platform/" class="text-interactive hover:text-interactive-hover underline"
        >transform packs page</a
      >.
    </p>
  </section>
</BaseLayout>
