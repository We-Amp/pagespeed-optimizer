---
// SPDX-License-Identifier: Apache-2.0
// Copyright (c) 2024-2026 We-Amp B.V.
//
// /platform/edge-seo/ — the edge-SEO-at-the-origin direction: what the pack
// fixes, who it is for, how it works, and one interest form
// (edge-seo) with an optional "sites you manage" count. The pack is free and
// arrives with the next release, as /packs/ says.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/instrument/SectionHeader.astro';
import PlatformInterestForm from '../../components/PlatformInterestForm.astro';

const fixes = [
  { what: 'Canonical tags', how: 'set where missing, by rule.' },
  { what: 'hreflang', how: 'clusters completed and made reciprocal across the language variants.' },
  {
    what: 'Titles and meta descriptions',
    how: 'repaired per URL pattern, from a rule, not a CMS edit.',
  },
  { what: 'Structured data', how: 'injected as JSON-LD from your rules.' },
];

const description =
  'The free edge-SEO pack for canonicals, hreflang, titles and structured data in the HTML stream on your server, with the next release of mod_pagespeed.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Edge SEO at the origin for mod_pagespeed 2.1',
  url: 'https://modpagespeed.com/platform/edge-seo/',
  description,
};
---

<BaseLayout
  title="Edge SEO at the origin for mod_pagespeed 2.1"
  description={description}
  ogImage="/og-cards/platform-edge-seo.png?v=2"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16" aria-labelledby="edge-seo-title">
    <SectionHeader
      id="edge-seo-title"
      eyebrow="Early access · edge SEO at the origin"
      title="Technical SEO fixes at serve time, for sites that are not on a CDN"
      as="h1"
    >
      Edge workers can turn technical SEO into a deploy instead of a CMS ticket, for sites behind a
      CDN. With the next release of mod_pagespeed, this pack does the same work at the origin, in
      the HTML stream the interceptor already rewrites.
    </SectionHeader>

    <div class="mt-10">
      <h2 class="text-lg font-semibold text-text-body">What it fixes (with the next release)</h2>
      <ul class="mt-3 space-y-2 text-sm text-text-muted">
        {fixes.map((f) => (
          <li class="flex gap-2">
            <span class="mt-2 h-1 w-1 flex-none rounded-full bg-interactive" aria-hidden="true" />
            <span>
              <span class="font-semibold text-text-body">{f.what}</span> {f.how}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="text-lg font-semibold text-text-body">Who it is for</h2>
      <p class="mt-2 text-text-muted">
        Agencies and in-house SEO teams whose sites are not behind a CDN with edge workers, and
        whose CMS releases take weeks. Once the pack ships, the fix is a rule you deploy on the
        server, applied to every matching page it serves.
      </p>
    </div>

    <div class="mt-10">
      <h2 class="text-lg font-semibold text-text-body">How it works</h2>
      <p class="mt-2 text-text-muted">
        The interceptor parses HTML responses as a stream on your server. A pack adds rules to that
        pass (the edge-SEO pack from the next release; the others are planned): match a URL pattern
        or an element, then set, rewrite or inject. The CMS is untouched; the rule changes what is
        served.
      </p>
    </div>

    <p class="readout-plate mt-10 px-4 py-3 text-sm text-text-muted">
      <span class="font-mono text-xs text-interactive">Status</span>
      <br />
      The edge-SEO pack is free and arrives with the next release of mod_pagespeed; it does not ship
      today. The other packs are planned. Leave your details to hear when the release is out, and to
      shape the planned packs.
      <a href="/packs/" class="text-interactive hover:text-interactive-hover underline">
        See the pack catalogue.
      </a>
    </p>

    <div class="mt-10 rounded-lg border border-border bg-bg-elevated p-6 sm:p-8">
      <h2 class="text-lg font-semibold text-text-body">Tell us you need this</h2>
      <p class="mt-2 text-sm text-text-muted">
        Leave an email, and roughly how many sites you would run it on. We email you if there is a
        build to try.
      </p>
      <PlatformInterestForm wedge="edge-seo" pack="Edge SEO at the origin" sites={true} />
    </div>

    <p class="mt-8 text-sm text-text-annotation">
      All early-access directions are on the
      <a href="/platform/" class="text-interactive hover:text-interactive-hover underline">
        transform packs page
      </a>
      .
    </p>
  </section>
</BaseLayout>
