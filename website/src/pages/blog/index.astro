---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    // Pinned posts come first, ordered by ascending `pinned` value
    // (1 sorts above 2). Unpinned posts fall through to date-desc sort.
    const aPin = a.data.pinned;
    const bPin = b.data.pinned;
    if (aPin !== undefined && bPin !== undefined) return aPin - bPin;
    if (aPin !== undefined) return -1;
    if (bPin !== undefined) return 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

// Blog collection JSON-LD: gives crawlers a single typed index of every post
// (headline, date, per-post canonical URL) so the blog hub is understood as a
// collection rather than a bare page. Mirrors the per-post BlogPosting in
// [slug].astro.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': 'https://modpagespeed.com/blog/',
  name: 'mod_pagespeed Blog',
  description:
    'Technical insights on web performance, automatic optimization, and the engineering behind mod_pagespeed 2.1 — the module and the optimizer worker.',
  url: 'https://modpagespeed.com/blog/',
  publisher: {
    '@type': 'Organization',
    name: 'We-Amp B.V.',
    logo: {
      '@type': 'ImageObject',
      url: 'https://modpagespeed.com/logo.svg',
    },
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    ...(post.data.lastUpdated && {
      dateModified: post.data.lastUpdated.toISOString(),
    }),
    author: {
      '@type': 'Person',
      name: post.data.author,
    },
    url: `https://modpagespeed.com/blog/${post.id}/`,
  })),
};
---

<BaseLayout
  title="Blog — web performance & PageSpeed engineering"
  description="Technical insights on web performance, automatic optimization, and the engineering behind mod_pagespeed 2.1 — the module and the optimizer worker."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-text-body">Blog</h1>
    <p class="mt-4 text-lg text-text-muted">
      Technical insights on web performance, automatic optimization, and the engineering behind
      mod_pagespeed 2.1 — the module and the optimizer worker.
    </p>

    {
      posts.length === 0 ? (
        <p class="mt-12 text-text-annotation">No posts yet. Check back soon.</p>
      ) : (
        <div class="mt-12 space-y-10">
          {posts.map((post) => (
            <article class="border-b border-border pb-10">
              <div class="flex items-center gap-3">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-sm text-text-annotation"
                >
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                {post.data.pinned !== undefined && (
                  <span class="inline-flex items-center rounded-full bg-interactive/10 px-2 py-0.5 text-xs font-medium text-interactive ring-1 ring-inset ring-interactive/40">
                    Featured
                  </span>
                )}
              </div>
              <h2 class="mt-2 text-2xl font-bold text-text-body">
                <a
                  href={`/blog/${post.id}/`}
                  class="hover:text-interactive transition-colors"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-text-muted">{post.data.description}</p>
              <a
                href={`/blog/${post.id}/`}
                class="mt-3 inline-block text-sm font-medium text-interactive hover:text-interactive-hover"
              >
                Read post &rarr;
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
