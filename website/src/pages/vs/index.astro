---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FREE_TO_RUN_LINE, LICENSE_CLAUSE } from '../../data/product-facts.mjs';

const comparisons = [
  {
    slug: 'imgproxy',
    title: 'ModPageSpeed vs imgproxy',
    summary:
      'Both self-hosted. imgproxy is image-only; ModPageSpeed is a full HTML pipeline that includes image work.',
    kind: 'Self-hosted, image-focused',
  },
  {
    slug: 'thumbor',
    title: 'ModPageSpeed vs Thumbor',
    summary:
      'Thumbor is a Python image server with face-aware smart cropping. ModPageSpeed handles images plus CSS, JS, and HTML.',
    kind: 'Self-hosted, image-focused',
  },
  {
    slug: 'cloudflare-apo',
    title: 'ModPageSpeed vs Cloudflare APO',
    summary:
      'APO caches WordPress HTML at the edge; ModPageSpeed optimizes at the origin and works on any stack.',
    kind: 'Managed edge / WordPress',
  },
  {
    slug: 'nitropack',
    title: 'ModPageSpeed vs NitroPack',
    summary:
      'NitroPack is managed SaaS for WordPress; ModPageSpeed runs on your server and licenses per site, with no traffic tiers.',
    kind: 'Managed SaaS / WordPress',
  },
  {
    slug: 'wp-rocket',
    title: 'ModPageSpeed vs WP Rocket',
    summary:
      'WP Rocket is the established WordPress optimization plugin. ModPageSpeed runs at the server layer and is CMS-independent.',
    kind: 'Self-hosted plugin / WordPress',
  },
  {
    slug: 'cloudinary',
    title: 'ModPageSpeed vs Cloudinary',
    summary:
      'Cloudinary is a managed media CDN with video. ModPageSpeed is self-hosted image optimization inside a broader HTML pipeline.',
    kind: 'Managed SaaS / media',
  },
  {
    slug: 'shortpixel',
    title: 'ModPageSpeed vs ShortPixel',
    summary:
      'ShortPixel optimizes WordPress images via a plugin and its Adaptive Images CDN. ModPageSpeed is self-hosted and optimizes images plus CSS, JS, and HTML at your origin.',
    kind: 'WordPress plugin / image CDN',
  },
  {
    slug: 'imgix',
    title: 'ModPageSpeed vs imgix',
    summary:
      'imgix is a managed real-time image CDN; your images egress to its edge. ModPageSpeed is a self-hosted full HTML pipeline — images never leave your origin.',
    kind: 'Managed SaaS / image CDN',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ModPageSpeed comparisons',
  description:
    'Side-by-side comparisons of ModPageSpeed against image, edge, SaaS, and WordPress optimization tools — written by We-Amp, the team behind ngx_pagespeed.',
  url: 'https://modpagespeed.com/vs/',
  hasPart: comparisons.map((c) => ({
    '@type': 'WebPage',
    name: c.title,
    url: `https://modpagespeed.com/vs/${c.slug}/`,
    description: c.summary,
  })),
};
---

<BaseLayout
  title="ModPageSpeed vs WP Rocket, NitroPack, Cloudinary & more"
  description="Side-by-side ModPageSpeed comparisons against image, edge, and WordPress optimization tools — written by We-Amp, the team behind ngx_pagespeed."
  jsonLd={jsonLd}
>
  <!-- Header -->
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-interactive">
      Comparisons
    </p>
    <h1 class="mt-3 h1-hero text-text-body">
      ModPageSpeed vs the alternatives
    </h1>
    <p class="mt-6 text-lg text-text-muted">
      {comparisons.length} side-by-side write-ups: where ModPageSpeed overlaps with adjacent tools, and where it
      doesn't. A self-hosted nginx pipeline behaves nothing like a SaaS CDN or a WordPress plugin,
      so each write-up says where ModPageSpeed wins and where the other tool does.
    </p>
    <p class="mt-4 text-sm text-text-muted">
      The optimization core these tools are weighed against powers <span
        class="font-semibold text-text-body">230,000+ live sites</span
      > today (<a
        href="https://trends.builtwith.com/Server/mod_pagespeed"
        target="_blank"
        rel="noopener noreferrer"
        class="text-interactive hover:text-interactive-hover underline"
        >BuiltWith, May 2026</a
      >) &mdash; not We-Amp customers, but proof it works at scale.
    </p>
    <p class="mt-4 text-sm text-text-annotation">
      Looking for the open-source predecessor instead? See <a
        href="/alternatives/mod-pagespeed/"
        class="text-interactive hover:text-interactive-hover underline"
        >alternatives to mod_pagespeed</a
      >.
    </p>
  </section>

  <!-- Comparison cards -->
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pb-20">
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        comparisons.map((c) => (
          <li>
            <a
              href={`/vs/${c.slug}/`}
              class="block h-full rounded-lg border border-border bg-bg-elevated p-5 hover:border-interactive/40 transition-colors"
            >
              <p class="text-xs font-semibold uppercase tracking-wide text-text-annotation">
                {c.kind}
              </p>
              <h2 class="mt-2 text-lg font-semibold text-text-body">
                {c.title}
              </h2>
              <p class="mt-2 text-sm text-text-muted">{c.summary}</p>
              <p class="mt-3 text-sm font-medium text-interactive">
                Read the comparison &rarr;
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- At-a-glance comparison -->
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="h2-section text-text-body">Where each tool fits</h2>
    <p class="mt-3 text-text-muted">
      ModPageSpeed optimizes at your origin: one self-hosted pipeline for images, CSS, JS, and HTML.
      The tools below each solve part of that, or solve it somewhere else &mdash; at the edge, in a
      SaaS dashboard, or inside WordPress.
    </p>
    <div class="mt-6 overflow-x-auto rounded-xl border border-border">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="bg-bg-elevated/80">
            <th
              scope="col"
              class="sticky top-0 z-10 bg-bg-elevated py-3 pl-4 pr-4 font-semibold text-text-body"
              >Tool</th
            >
            <th
              scope="col"
              class="sticky top-0 z-10 bg-bg-elevated py-3 pr-4 font-semibold text-text-body"
              >Type</th
            >
            <th
              scope="col"
              class="sticky top-0 z-10 bg-bg-elevated py-3 pr-4 font-semibold text-text-body"
              >Best at</th
            >
            <th
              scope="col"
              class="sticky top-0 z-10 border-l-2 border-interactive/40 bg-interactive/10 py-3 px-4 font-semibold text-text-body"
            >
              Where ModPageSpeed fits
            </th>
          </tr>
        </thead>
        <tbody class="text-text-muted">
          {
            [
              {
                tool: 'imgproxy',
                type: 'Self-hosted image proxy',
                best: 'On-demand image transforms by URL',
                fits: 'Images plus CSS, JS, and HTML in one pipeline',
              },
              {
                tool: 'Thumbor',
                type: 'Self-hosted Python image server',
                best: 'Face-aware smart cropping',
                fits: 'Images plus CSS, JS, and HTML',
              },
              {
                tool: 'Cloudflare APO',
                type: 'Managed edge cache',
                best: 'Edge HTML caching for WordPress',
                fits: 'Origin-side optimization on any stack',
              },
              {
                tool: 'NitroPack',
                type: 'Managed SaaS (WordPress)',
                best: 'Turnkey, hosted setup',
                fits: 'Runs on your server, licensed per site with no traffic tiers',
              },
              {
                tool: 'WP Rocket',
                type: 'WordPress plugin',
                best: 'Deep WordPress integration',
                fits: 'Server-layer, CMS-independent',
              },
              {
                tool: 'Cloudinary',
                type: 'Managed media CDN',
                best: 'Video and digital-asset management',
                fits: 'Self-hosted image optimization in a broader pipeline',
              },
              {
                tool: 'ShortPixel',
                type: 'WordPress plugin / image CDN',
                best: 'WordPress image compression + CDN delivery',
                fits: 'Full origin pipeline (images, CSS, JS, HTML), any CMS',
              },
              {
                tool: 'imgix',
                type: 'Managed image CDN',
                best: 'Real-time image transforms by URL',
                fits: 'Self-hosted; images stay at your origin, plus CSS/JS/HTML',
              },
            ].map((r) => (
              <tr class="border-t border-border">
                <th
                  scope="row"
                  class="py-3 pl-4 pr-4 text-left align-top font-medium text-text-body"
                >
                  {r.tool}
                </th>
                <td class="py-3 pr-4 align-top">{r.type}</td>
                <td class="py-3 pr-4 align-top">{r.best}</td>
                <td class="border-l-2 border-interactive/40 bg-interactive/10 py-3 px-4 align-top">
                  {r.fits}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- Footer note: framing -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pb-20">
    <div
      class="rounded-lg border border-border bg-bg-secondary px-6 py-5 text-sm text-text-muted"
    >
      <p>
        Written by We-Amp, which develops ModPageSpeed, so the framing isn't neutral. Where a competitor is
        the better fit for your stack, the comparison says so.
      </p>
      <p class="mt-3">
        Still deciding between editions? See <a
          href="/pricing/"
          class="text-interactive hover:text-interactive-hover underline"
          >pricing</a
        > or the <a
          href="/1.1/"
          class="text-interactive hover:text-interactive-hover underline"
          >mod_pagespeed 1.15</a
        > drop-in module page.
      </p>
      <p class="mt-4 text-xs text-text-annotation">
        imgproxy, Thumbor, Cloudflare, NitroPack, WP Rocket, Cloudinary, ShortPixel, imgix, and
        other product names are trademarks of their respective owners. Comparisons reflect publicly
        available information as of 2026 and are provided for evaluation; We-Amp B.V. is not
        affiliated with or endorsed by them.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pb-20">
    <div
      class="rounded-2xl border border-border bg-bg-elevated p-6 md:p-8"
    >
      <h2 class="h2-section text-text-body">Try ModPageSpeed</h2>
      <p class="mt-3 text-text-body">
        Install and run it &mdash; mod_pagespeed 2.1 is {LICENSE_CLAUSE}, free in development and
        in production. Support &mdash; and hardened builds &mdash;
        from the people who build it are what's for sale.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/docs/getting-started/" class="btn-primary" data-umami-event="cta_vs_hub_install"
          >Download &amp; run</a
        >
        <a
          href="/pricing/"
          class="rounded-md border border-border-strong px-4 py-2 text-sm font-medium text-text-body hover:border-border-strong"
          data-umami-event="cta_vs_hub_buy">Support plans</a
        >
      </div>
      <p class="mt-3 text-xs text-text-annotation">
        {FREE_TO_RUN_LINE}
      </p>
    </div>
  </section>
</BaseLayout>
