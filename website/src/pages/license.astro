---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SOURCE_PUBLICATION as SP,
  SOURCE_IS_PUBLISHED,
  LICENSE_CLAUSE,
  PRODUCT_NAME,
  CURRENT_LINE,
  V2_LINE,
  V1_LINE,
} from '../data/product-facts.mjs';

// The license facts (full name, SPDX id, status) come from product-facts.mjs;
// the drift guard in test/sync/source-publication-sync.test.ts fails if this
// page re-states any of them as a literal. Whether the software is described
// as licensed under the license or as published source derives from the
// publication status (LICENSE_CLAUSE) — never hard-code either form.
const product = `${PRODUCT_NAME} ${CURRENT_LINE}`;
---

<BaseLayout
  title={`Software license — ${product}`}
  description={`${product} is ${LICENSE_CLAUSE}: free to install and run, in development and in production. What We-Amp sells is support — and hardened, attested builds.`}
>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="h1-hero text-text-body">Software license</h1>
    <p class="mt-6 text-lg text-text-muted">
      {product} is {LICENSE_CLAUSE} ({SP.licenseId}) &mdash; the same license the original
      mod_pagespeed codebase carried. Every feature is available to everyone, in development and in
      production. The commercial terms for a support subscription live in the <a
        href="/terms/"
        class="text-interactive hover:text-interactive-hover underline"
        >Terms of Service</a
      >.
    </p>

    <div class="mt-12 space-y-12">
      <!-- The license -->
      <div>
        <h2 class="h2-section text-text-body">The license</h2>
        <p class="mt-4 text-text-muted">
          The web-server module and the optimizer worker are licensed under the {SP.license};
          bundled third-party components are listed in <code
            class="rounded bg-bg-elevated px-1 py-0.5 text-xs">THIRD-PARTY-NOTICES</code
          > under their own licenses. The <code class="rounded bg-bg-elevated px-1 py-0.5 text-xs"
            >LICENSE</code
          >, <code class="rounded bg-bg-elevated px-1 py-0.5 text-xs">NOTICE</code> and <code
            class="rounded bg-bg-elevated px-1 py-0.5 text-xs">THIRD-PARTY-NOTICES</code
          > files ship with every distribution &mdash; the signed .deb and .rpm packages, the Docker
          images, and the NuGet packages.
          {
            SOURCE_IS_PUBLISHED &&
              ' The source is published; you are free to build, modify, and redistribute it under the same terms.'
          }
        </p>
      </div>

      <!-- What We-Amp sells -->
      <div>
        <h2 class="h2-section text-text-body">What We-Amp sells</h2>
        <p class="mt-4 text-text-muted">
          Support &mdash; and hardened builds. The software is the same for everyone and the standard
          signed packages are free; <a
            href="/pricing/"
            class="text-interactive hover:text-interactive-hover underline"
            >support plans and hardened, attested builds</a
          > from the people who build it are what&rsquo;s for sale. Support subscriptions are governed
          by the <a href="/terms/" class="text-interactive hover:text-interactive-hover underline"
            >Terms of Service</a
          >; the support terms live at <a
            href="https://we-amp.com/licensing/"
            class="text-interactive hover:text-interactive-hover underline">we-amp.com/licensing/</a
          >.
        </p>
      </div>

      <!-- Predecessor lines -->
      <div>
        <h2 class="h2-section text-text-body">Predecessor lines</h2>
        <p class="mt-4 text-text-muted">
          The predecessor lines carry the {SP.license} as well. Running ModPageSpeed {V2_LINE}?
          See the <a
            href="/docs/migrating-to-2-1/"
            class="text-interactive hover:text-interactive-hover underline">migration guide</a
          >. Running mod_pagespeed {V1_LINE}? See the guide to
          <a
            href="/1.1/docs/upgrading-to-2-1/"
            class="text-interactive hover:text-interactive-hover underline"
            >upgrading to {product}</a
          >.
        </p>
      </div>

      <!-- Continuity -->
      <div>
        <h2 class="h2-section text-text-body">Continuity</h2>
        <div class="mt-4 rounded-lg border border-interactive/40 bg-interactive/10 p-4">
          <p class="text-text-body">
            The {SP.license} is a perpetual grant that does not depend on We-Amp B.V.&rsquo;s
            corporate status. If the company is acquired, merged, reorganized, or wound down, the
            license you hold stays in force, and support subscriptions remain governed by the same
            Terms of Service.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
