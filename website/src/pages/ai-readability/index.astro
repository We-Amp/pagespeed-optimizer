    }
    .ar-cta-link:hover {
      text-decoration: underline;
    }
    /* The ONE consolidated next-step form (replaces the old per-wedge + email-capture
       forms). At most one visible type=email; one outline submit (the only FILLED
       button in the card is the /download/ primary CTA). */
    .ar-field {
      display: block;
      margin-top: 0.6rem;
    }
    .ar-field-label {
      display: block;
      font-size: 0.8rem;
