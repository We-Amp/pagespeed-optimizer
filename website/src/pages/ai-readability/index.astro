    .ar-next-form input[type='email'],
    .ar-next-form input[type='text'] {
      width: 100%;
      border: 1px solid var(--color-stone-300);
      background: var(--color-white);
      color: var(--color-stone-900);
      border-radius: var(--radius-control);
      padding: 0.6rem 0.8rem;
