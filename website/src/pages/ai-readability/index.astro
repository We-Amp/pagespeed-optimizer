---
import BaseLayout from '././layouts/BaseLayout.astro';
import Icon from '././components/Icon.astro';

// Public front end for the AI-readability scanner. The render backend
// runs on a separate box; nginx proxies /ai-readability/api/* to it (see corp deploy).
// Local dev: append ?api=http://localhost:8787 to point at a local render service.
const title = 'AI Readability Checker — see what AI crawlers read on your page';
const description =
  'Free scanner: see what AI crawlers actually read on your page — most skip your JavaScript, so client-rendered content is invisible to them. Then optimize the HTML you serve with self-hosted mod_pagespeed, on your own servers.';
const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'RenderPeek',
  alternateName: 'AI Readability Checker',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  url: 'https://modpagespeed.com/ai-readability/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

// FAQPage answering the "can AI read my website" / "do AI crawlers render
// JavaScript" queries already earning impressions in GSC. Rendered visibly
// below from this same mainEntity array (single source of truth) so the
// structured data and on-page content can never drift, per Google's FAQ policy.
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can AI crawlers read JavaScript-rendered content?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most cannot. GPTBot (ChatGPT), ClaudeBot, and PerplexityBot fetch raw HTML and do not execute JavaScript, so content that only appears after your scripts run is invisible to them. Google’s Gemini is the exception — it reuses Googlebot’s rendering.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which AI crawlers render JavaScript?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'As a rule, only Google’s stack (Gemini via Googlebot) renders JavaScript. GPTBot, ChatGPT-User, ClaudeBot, and PerplexityBot read static HTML only. If your content is client-rendered, those agents see a near-empty page.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I check what an AI crawler sees on my page?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Disable JavaScript and reload — what remains is roughly what a non-rendering crawler reads. Or paste your URL into the scanner above: it shows the raw-HTML vs rendered token counts side by side.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I make my site readable to AI agents?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Serve the meaningful content in the initial HTML response (server-side rendering or pre-rendering). A self-hosted optimizer like mod_pagespeed reduces page weight and cleans markup, which helps both browsers and machine readers.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does llms.txt make my site AI-readable?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. llms.txt is an optional hint file; it does not fix content that is invisible because it requires JavaScript to render. Readability still depends on the content existing in the HTML the agent fetches.',
      },
    },
  ],
};

// Per-bot rendering matrix mirrored in the visible table and the FAQ above.
const botRendering = [
  { bot: 'GPTBot', agent: 'ChatGPT', rendersJs: false },
  { bot: 'ClaudeBot', agent: 'Claude', rendersJs: false },
  { bot: 'PerplexityBot', agent: 'Perplexity', rendersJs: false },
  { bot: 'Googlebot', agent: 'Google / Gemini', rendersJs: true },
];

const jsonLd = [webApp, faqPage];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <p class="eyebrow">RenderPeek &middot; a free tool from ModPageSpeed</p>
    <h1 class="h1-hero text-text-body mt-2">
      See what AI crawlers miss. Optimize the HTML you serve, on your own servers.
    </h1>
    <p class="lede mt-4 max-w-2xl">
      Most AI crawlers read your raw HTML and never run your JavaScript, so anything your scripts
      render is invisible to them. Paste a URL to see the gap. The same self-hosted mod_pagespeed
      worker that powers this site then optimizes and cleans that HTML inline, on your own servers
      rather than behind a CDN. ModPageSpeed 2.0 can also serve AI agents a clean, rendered copy of
      the page at the same URL &mdash; an
      <a href="/blog/serve-markdown-to-ai-agents/" class="text-interactive underline underline-offset-2"
        >experimental feature</a
      >, off by default, that we dogfood here.
    </p>

    <!-- novalidate: the input is type=url for the mobile URL keyboard, but we accept a
         bare host (e.g. "example.com") and prepend https:// in normalizeUrl(), so we
         let the JS validator govern rather than the browser's scheme-required check. -->
    <form id="ar-form" class="mt-8 flex flex-col sm:flex-row gap-3" autocomplete="off" novalidate>
      <input
        id="ar-url"
        type="url"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        autocapitalize="off"
        placeholder="example.com"
        aria-label="URL to scan"
        class="flex-1 rounded-lg border border-border-strong bg-bg-elevated px-4 py-3 text-base text-text-body placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:ring-2 focus:ring-interactive/40 focus:border-interactive/40 focus:outline-none"
      />
      <button
        id="ar-go"
        type="submit"
        class="btn-primary px-8 w-full sm:w-auto disabled:opacity-50 disabled:cursor-wait"
      >
        Scan
      </button>
    </form>
    <p class="mt-3 text-sm text-text-annotation">
      Free &middot; no signup &middot; one page at a time &middot; renders your page in a headless
      browser (~5&ndash;10s).
    </p>

    <p class="mt-3 text-xs text-text-annotation leading-relaxed max-w-2xl">
      Only scan sites you own or are authorized to test. Scanned content is used only to produce
      this readability result and is not retained or shared beyond that. Your IP address is logged
      and rate-limited to 20 requests per minute per visitor to prevent abuse. See our
      <a href="/privacy/" class="text-interactive hover:text-interactive-hover underline"
        >Privacy policy</a
      >.
    </p>

    <p class="mt-4 text-sm text-text-annotation">
      From
      <a href="/about/" class="text-interactive underline underline-offset-2">We-Amp</a>
      &mdash; the team behind ngx_pagespeed.
    </p>

    <div id="ar-out" aria-live="polite"></div>

    <!-- No-JS fallback (UX-9). The live scan is interactive, but the page should not
         be blank for crawlers and no-JS visitors. This is a static, illustrative sample
         result (not a live measurement) so the page is self-explanatory without scripts. -->
    <noscript>
      <div
        class="mt-6 rounded-2xl border border-border bg-bg-elevated p-6"
      >
        <p class="text-sm font-semibold text-text-body">
          Live scanning needs JavaScript
        </p>
        <p class="mt-1 text-sm text-text-annotation leading-relaxed">
          Enable JavaScript to scan a URL. Here is an example of the kind of result RenderPeek
          produces &mdash; an illustrative sample, not a live measurement:
        </p>
        <div class="mt-5 flex items-center gap-4">
          <div
            class="flex h-16 w-16 items-center justify-center rounded-xl border-2 border-amber-600 text-3xl font-bold text-amber-600"
          >
            C
          </div>
          <div>
            <div class="text-xl font-bold text-text-body">68/100</div>
            <div class="text-xs text-text-annotation">example.com</div>
          </div>
        </div>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex justify-between font-medium text-text-body">
            <dt>
              Content fidelity
              <span
                class="ml-1 rounded bg-red-100 px-1.5 py-0.5 text-[11px] font-semibold text-red-700 dark:bg-red-900/40 dark:text-red-300"
                >invisible without JS</span
              >
            </dt>
            <dd class="tabular-nums">12/40</dd>
          </div>
          <div class="flex justify-between font-medium text-text-body">
            <dt>Markup efficiency</dt>
            <dd class="tabular-nums">22/30</dd>
          </div>
          <div class="flex justify-between font-medium text-text-body">
            <dt>Machine description</dt>
            <dd class="tabular-nums">24/30</dd>
          </div>
        </dl>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div
            class="rounded-lg border border-border bg-bg-secondary p-3"
          >
            <h2 class="text-xs font-semibold text-text-body">
              Raw HTML &mdash; most AI crawlers
            </h2>
            <p class="mt-1 text-xs text-text-annotation">
              ~80 tokens an agent can read &mdash; almost nothing survives before JavaScript runs.
            </p>
          </div>
          <div
            class="rounded-lg border border-border bg-bg-secondary p-3"
          >
            <h2 class="text-xs font-semibold text-text-body">
              After rendering JavaScript
            </h2>
            <p class="mt-1 text-xs text-text-annotation">
              ~1,400 tokens an agent can read &mdash; the real content only appears once the browser
              runs your scripts.
            </p>
          </div>
        </div>
      </div>
    </noscript>

    <!-- Per-bot rendering matrix. Factual: as of 2026 only Google's stack renders
         JavaScript; the major AI crawlers read static HTML only. Mirrored in the
         FAQ below and in the FAQPage JSON-LD. -->
    <div class="mt-14 max-w-2xl">
      <h2 class="text-xl font-semibold text-text-body">
        Which AI crawlers render JavaScript?
      </h2>
      <p class="mt-2 text-sm text-text-annotation leading-relaxed">
        The major AI crawlers fetch your raw HTML and do not run your scripts. Only Google’s stack
        renders JavaScript today. This reflects crawler behavior in 2026 and can change, so re-scan
        to confirm what an agent sees now. We measured the same rendering gap across the top 1,000
        sites &mdash; see
        <a href="/blog/can-ai-read-your-website/" class="text-interactive underline underline-offset-2"
          >what we found</a
        >.
      </p>
      <div class="mt-5 overflow-hidden rounded-2xl border border-border">
        <table class="w-full text-left text-sm">
          <thead class="bg-bg-secondary">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold text-text-body">
                Crawler
              </th>
              <th scope="col" class="px-4 py-3 font-semibold text-text-body">
                Used by
              </th>
              <th scope="col" class="px-4 py-3 font-semibold text-text-body">
                Renders JavaScript?
              </th>
            </tr>
          </thead>
          <tbody>
            {
              botRendering.map((row) => (
                <tr class="border-t border-border">
                  <td class="px-4 py-3 font-medium text-text-body">
                    {row.bot}
                  </td>
                  <td class="px-4 py-3 text-text-muted">{row.agent}</td>
                  <td class="px-4 py-3">
                    {row.rendersJs ? (
                      <span class="font-medium text-emerald-700 dark:text-emerald-400">
                        Renders JS
                      </span>
                   ) : (
                      <span class="font-medium text-text-annotation">
                        No — static HTML only
                      </span>
                   )}
                  </td>
                </tr>
             ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Visible FAQ rendering the same faqPage.mainEntity array emitted as
         FAQPage JSON-LD (single source of truth). Native <details>/<summary>
         accordion; the disclosure marker is hidden via the scoped <style> below. -->
    <div class="mt-14 max-w-2xl">
      <h2 class="text-xl font-semibold text-text-body">
        Frequently asked questions
      </h2>
      <div class="mt-6 space-y-3">
        {
          faqPage.mainEntity.map((item) => (
            <details class="group rounded-2xl border border-border bg-bg-elevated">
              <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-text-body">
                {item.name}
                <Icon
                  name="chevron-down"
                  class="h-5 w-5 shrink-0 text-stone-400 transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="px-5 pb-5 text-sm text-text-annotation leading-relaxed">
                {item.acceptedAnswer.text}
              </p>
            </details>
         ))
        }
      </div>
    </div>
  </section>

  <!-- Scoped: hide the native disclosure marker on the FAQ <details> so the
       custom chevron (rotated via group-open) is the only affordance. -->
  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
  </style>

  <!-- is:global — the scan result is injected via innerHTML at runtime, so it lacks
       Astro's scoped-style attribute; scoped CSS would not reach it. All selectors are
       .ar-* namespaced, so global scope does not affect the rest of the site. The
       runtime-injected card also can't rely on Tailwind utility classes (the build would
       purge any class string that only ever appears inside a JS string literal), so the
       result UI is styled here against the site's brand tokens (--color-stone-*,
       --color-blue-*) so it adapts to light/dark and reads as a first-class property. -->
  <style is:global>
    #ar-form {
      scroll-margin-top: 5rem;
    }
    .ar-card {
      /* Theme-aware tokens for the lens evidence list + Ghost-Layer block. Previously
         referenced via var(--ar-border)/var(--dim) with NO definition, so they fell back
         to dark-only hardcodes and rendered near-black borders in light mode. */
      --ar-border: var(--color-stone-200);
      --dim: var(--color-stone-500);
      border: 1px solid var(--color-stone-200);
      border-radius: var(--radius-card);
      background: var(--color-white);
      padding: 1.4rem;
      margin-top: 1.4rem;
      color: var(--color-stone-900);
      scroll-margin-top: 5rem;
      box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.04),
        0 8px 24px rgba(0, 0, 0, 0.04);
    }
    .ar-card:focus {
      outline: none;
    }
    .dark .ar-card {
      --ar-border: var(--color-stone-600);
      --dim: var(--color-stone-400);
      border-color: var(--color-stone-600);
      background: var(--color-stone-900);
      color: var(--color-stone-100);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.05);
    }
    /* Section primitive — one divider rhythm replaces the old dashed/solid mix.
       1px section-top = "new section"; rows within a section use hairline/none. */
    .ar-sec {
      margin-top: 1.4rem;
      padding-top: 1.3rem;
      border-top: 1px solid var(--color-stone-200);
    }
    .dark .ar-sec {
      border-top-color: var(--color-stone-700);
    }
    .ar-h2 {
      margin: 0 0 0.2rem;
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .ar-h4 {
      margin: 0 0 0.2rem;
      font-size: 0.92rem;
      font-weight: 700;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
    }
    .ar-h4-l {
      display: inline-flex;
      align-items: baseline;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .ar-h4-r {
      color: var(--color-stone-500);
      font-size: 0.78rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .dark .ar-h4-r {
      color: var(--color-stone-400);
    }
    .ar-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
    /* Impact pills — text label + contrast, never color alone (A11y). */
    .ar-impacts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin: 0.5rem 0 0.1rem;
    }
    .ar-pill {
      display: inline-block;
      border-radius: 0.35rem;
      padding: 0.05rem 0.45rem;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      line-height: 1.4;
    }
    .ar-pill-critical {
      background: rgba(220, 38, 38, 0.12);
      color: #b91c1c;
    }
    .ar-pill-serious {
      background: rgba(234, 88, 12, 0.12);
      color: #9a3412;
    }
    .ar-pill-moderate {
      background: rgba(217, 119, 6, 0.12);
      color: #854d0e;
    }
    .ar-pill-minor {
      background: var(--color-stone-100);
      color: #44403c;
    }
    .dark .ar-pill-critical {
      background: rgba(220, 38, 38, 0.18);
      color: #fca5a5;
    }
    .dark .ar-pill-serious {
      background: rgba(234, 88, 12, 0.18);
      color: #fdba74;
    }
    .dark .ar-pill-moderate {
      background: rgba(217, 119, 6, 0.18);
      color: #fcd34d;
    }
    .dark .ar-pill-minor {
      background: var(--color-stone-700);
      color: var(--color-stone-300);
    }
    /* "addressable inline" tag — NON-completion (never green;). */
    .ar-fix {
      display: inline-block;
      font-size: 0.66rem;
      font-weight: 600;
      border-radius: 0.3rem;
      padding: 0.02rem 0.4rem;
      color: var(--color-interactive);
      background: color-mix(in srgb, var(--color-interactive) 8%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-interactive) 40%, transparent);
    }
    /* Itemized accessibility issue list. */
    .ar-issues {
      list-style: none;
      margin: 0.5rem 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .ar-issue {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.4rem 0.55rem;
      font-size: 0.85rem;
    }
    .ar-issue-help {
      color: var(--color-stone-700);
      flex: 1 1 14rem;
    }
    .dark .ar-issue-help {
      color: var(--color-stone-300);
    }
    .ar-issue-n {
      color: var(--color-stone-600);
      font-size: 0.72rem;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .ar-issue-id {
      font:
        0.7rem ui-monospace,
        Menlo,
        monospace;
      color: var(--color-stone-600);
    }
    .dark .ar-issue-n,
    .dark .ar-issue-id {
      color: var(--color-stone-400);
    }
    /* Crawler chips + raw-HTML exposure meter. */
    .ar-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin: 0.5rem 0 0.3rem;
    }
    .ar-chip {
      font-size: 0.72rem;
      border-radius: 0.35rem;
      padding: 0.05rem 0.5rem;
      background: var(--color-stone-100);
      color: var(--color-stone-700);
      border: 1px solid var(--color-stone-200);
    }
    .dark .ar-chip {
      background: var(--color-stone-700);
      color: var(--color-stone-200);
      border-color: var(--color-stone-600);
    }
    .ar-chip-block {
      background: rgba(220, 38, 38, 0.1);
      color: #b91c1c;
      border-color: rgba(220, 38, 38, 0.25);
    }
    .dark .ar-chip-block {
      background: rgba(220, 38, 38, 0.18);
      color: #fca5a5;
      border-color: rgba(248, 113, 113, 0.3);
    }
    .ar-chip-none {
      font-size: 0.72rem;
      color: var(--color-stone-600);
    }
    .dark .ar-chip-none {
      color: var(--color-stone-400);
    }
    .ar-chip-label {
      font-size: 0.78rem;
      color: var(--color-stone-600);
    }
    .dark .ar-chip-label {
      color: var(--color-stone-400);
    }
    .ar-meter {
      height: 0.5rem;
      background: var(--color-stone-200);
      border-radius: var(--radius-pill);
      overflow: hidden;
      margin: 0.5rem 0 0.25rem;
    }
    .dark .ar-meter {
      background: var(--color-stone-700);
    }
    .ar-meter > i {
      display: block;
      height: 100%;
      background: var(--color-interactive);
    }
    .dark .ar-meter > i {
      background: var(--color-interactive);
    }
    .ar-meter-cap,
    .ar-legend {
      font-size: 0.72rem;
      color: var(--color-stone-600);
      margin-top: 0.3rem;
    }
    .dark .ar-meter-cap,
    .dark .ar-legend {
      color: var(--color-stone-400);
    }
    .ar-def {
      font-size: 0.78rem;
      color: var(--color-stone-600);
      margin: 0.1rem 0 0.4rem;
      line-height: 1.5;
    }
    .dark .ar-def {
      color: var(--color-stone-400);
    }
    .ar-lens {
      margin-top: 1.1rem;
    }
    /* A non-scored lens that actually FOUND something (sovereignty endpoint exposed,
       provenance stripped on serve, or ghost content) gets a restrained amber rail so
       it stands out from the neutral clean/none lenses. Amber only — never red (no
       alarm) and never green (no pass certificate). Reuses the page's amber vocabulary
       (#d97706 = amber-600, the grade badge; #fbbf24 = amber-400 for dark). The negative
       margin cancels the padding so finding + clean lenses keep the same text baseline. */
    .ar-lens.ar-finding {
      border-left: 3px solid #d97706;
      padding-left: 0.7rem;
      margin-left: -0.7rem;
    }
    .dark .ar-lens.ar-finding {
      border-left-color: #fbbf24;
    }
    .ar-finding .ar-h4-r {
      color: #d97706;
      font-weight: 700;
    }
    .dark .ar-finding .ar-h4-r {
      color: #fbbf24;
    }
    /* Tighten the doubled margin where the section explainer meets the first lens
       (beyondExplain's bottom margin .ar-lens top margin would otherwise stack ~2rem). */
    .ar-explain .ar-lens {
      margin-top: 0.4rem;
    }
    /* WebMCP one-liner spacing (kept in CSS, not an inline style attribute). */
    .ar-aa-line {
      margin-top: 1rem;
    }
    /* Ghost-Layer per-node evidence list (lens). Neutral, no pass/fail colour. */
    .ar-glist {
      margin-top: 0.6rem;
      display: grid;
      gap: 0.5rem;
    }
    .ar-gnode {
      border: 1px solid var(--ar-border, #2a2a2a);
      border-radius: 8px;
      padding: 0.5rem 0.65rem;
      font-size: 13px;
    }
    .ar-gnode b {
      font-size: 13px;
    }
    .ar-gsel {
      margin-top: 0.25rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      color: var(--dim, #9aa);
      word-break: break-all;
    }
    /* Ghost-Layer full-page screenshot with overlay boxes over each flagged node.
       The box colour stays a fixed high-contrast amber so it reads against an arbitrary
       page render (which may itself be light or dark); only the wrapper follows the
       page palette. Observation for the owner — it asserts no "safe/screened" status. */
    .ar-shotwrap {
      position: relative;
      margin-top: 0.6rem;
      border: 1px solid var(--ar-border, #2a2a2a);
      border-radius: 8px;
      overflow-y: auto;
      overflow-x: hidden;
      max-height: 520px;
      scrollbar-gutter: stable;
      background: var(--color-stone-100);
    }
    .dark .ar-shotwrap {
      background: var(--color-stone-900);
    }
    .ar-shotwrap img {
      display: block;
      width: 100%;
      height: auto;
    }
    .ar-gbox {
      position: absolute;
