    }
    .ar-cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.6rem;
      margin-top: 0.9rem;
    }
    .ar-cta-link {
      color: var(--color-interactive);
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
    }
    .dark .ar-cta-link {
