    }
    @media (prefers-reduced-motion: no-preference) {
      .ar-loading {
        animation: ar-pulse 1.4s ease-in-out infinite;
      }
      @keyframes ar-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.55;
        }
      }
    }
    @media (max-width: 680px) {
      .ar-diff {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script is:inline>
    (function () {
      const API = new URLSearchParams(location.search).get('api') || '/ai-readability/api';
      const $ = (s) => document.querySelector(s);
      const out = $('#ar-out');
      const esc = (s) =>
        (s || '').replace(
          /[&<>"]/g,
          (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c],
       );

      // Inlined (not imported) because in production this is the Astro-built
      // modpagespeed.com/ai-readability/ page and only /ai-readability/api/* is proxied to the
      // render service — there is no /src/ route to import from.
      // VERBATIM inline copy of the scanner repo's src/demand.mjs (the canonical, unit-tested
      // source). KEEP IN SYNC with agent-readability-scanner:src/demand.mjs.
      function tollboothCtaApplies(agentVerifiability) {
        const d = agentVerifiability && agentVerifiability.detail;
        if (!d) return false;
        return (
          d.verifiable === false &&
          d.renderOk === true &&
          Array.isArray(d.aiCrawlersAllowed) &&
          d.aiCrawlersAllowed.length > 0 &&
          d.exposurePct >= 30
       );
      }
      function agentPassCtaApplies(signedAgentVerification) {
        const s = signedAgentVerification;
        return !!(
          s &&
          s.status === 'ok' &&
          (s.classification === 'verifying' || s.classification === 'signature-aware')
       );
      }
      function complianceFixCtaApplies(accessibility) {
        const a = accessibility;
        return !!(a && a.available && a.detail && a.detail.fixableInline > 0);
      }
      function buildLeadPayload(opts) {
        const wedge = opts.wedge,
          email = opts.email,
          name = opts.name,
          note = opts.note,
          report = opts.report;
        const url = (report && report.url) || '';
        let lensSignal;
        if (wedge === 'tollbooth') {
          const d = report.agentVerifiability.detail;
          lensSignal = {
            verifiable: d.verifiable,
            exposurePct: d.exposurePct,
            aiCrawlersAllowed: d.aiCrawlersAllowed,
            aiCrawlersBlocked: d.aiCrawlersBlocked,
            botAuthHeaders: d.botAuthHeaders,
            renderOk: d.renderOk,
          };
        } else if (wedge === 'agentpass') {
          const s = report.signedAgentVerification;
          lensSignal = {
            classification: s.classification,
            evidence: s.evidence,
            probes: s.probes,
          };
        } else {
          const d = report.accessibility.detail;
          lensSignal = {
            total: d.total,
            fixableInline: d.fixableInline,
            byImpact: d.byImpact,
            topRules: d.topRules,
          };
        }
        const message = [
          '[' + wedge + '] lead from RenderPeek result',
          'Scanned: ' + url,
          note ? 'Operator note / crawl volume: ' + note : null,
          'Signal: ' + JSON.stringify(lensSignal),
        ]
          .filter(Boolean)
          .join('\n');
        return {
          topic: wedge,
          email: email,
          name: name || '',
          url: url,
          wedge: wedge,
          lensSignal: lensSignal,
          message: message,
        };
      }

      // Normalize + validate the URL the same way /analyze does: accept a bare
      // host (prepend https://), then require a parseable http/https URL with a
      // real public hostname. Returns the canonical URL string, or null on error
      // (with the message shown in the result slot).
      function normalizeUrl(raw) {
        let trimmed = (raw || '').trim();
        if (!trimmed) return null;
        if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(trimmed)) trimmed = 'https://' + trimmed;
        let parsed;
        try {
          parsed = new URL(trimmed);
        } catch (_) {
          out.innerHTML =
            '<div class="ar-card ar-err">That does not look like a valid URL (try https://example.com).</div>';
          return null;
        }
        if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
          out.innerHTML =
            '<div class="ar-card ar-err">Only http:// and https:// URLs are supported.</div>';
          return null;
        }
        if (!parsed.hostname || parsed.hostname === 'localhost') {
          out.innerHTML =
            '<div class="ar-card ar-err">RenderPeek needs a publicly reachable hostname. Localhost won’t work.</div>';
          return null;
        }
        return parsed.toString();
      }
      $('#ar-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const url = normalizeUrl($('#ar-url').value);
        if (!url) return;
        $('#ar-go').disabled = true;
        $('#ar-go').textContent = 'Scanning…';
        out.setAttribute('aria-busy', 'true');
        // Re-arm polite announcements for the loading/error strings (render() sets it to
        // 'off' so the full result card isn't announced as one giant live update).
        out.setAttribute('aria-live', 'polite');
        out.innerHTML =
          '<div class="ar-card ar-loading">Rendering and grading your page in a headless browser — about 5–10 seconds.</div>';
        try {
          const res = await fetch(API + '/scan?url=' + encodeURIComponent(url));
          const data = await res.json();
          if (data.error) {
            out.innerHTML =
              '<div class="ar-card ar-err" role="alert"><strong>Couldn’t scan that.</strong> ' +
              esc(data.error) +
              '</div>';
            return;
          }
          render(data);
        } catch (err) {
          out.innerHTML =
            '<div class="ar-card ar-err" role="alert"><strong>Couldn’t scan that.</strong> Could not reach the scanner service. Check the URL and try again.</div>';
        } finally {
          $('#ar-go').disabled = false;
          $('#ar-go').textContent = 'Scan';
          out.setAttribute('aria-busy', 'false');
        }
      });
      // Rule ids a self-hosted optimizer can ADDRESS inline, server-side.
      // Mirrors the marker set in the build spec; never asserts a delivered/guaranteed fix.
      const ADDRESSABLE_INLINE = new Set([
        'html-has-lang',
        'html-lang-valid',
        'image-alt',
        'input-image-alt',
        'label',
        'button-name',
        'link-name',
        'color-contrast',
        'landmark-one-main',
        'region',
        'aria-required-attr',
        'aria-roles',
      ]);
      // Severity order for the byImpact summary line (highest first).
      const IMPACT_ORDER = ['critical', 'serious', 'moderate', 'minor'];
      const NS_BADGE = '<span class="ar-ns">not part of the grade</span>';

      // --- Explained-findings builders (section 3). Each returns '' when its data is
      // absent (graceful degradation). All report-derived FREE TEXT goes through esc();
      // numbers / array lengths are interpolated raw (F4). ---

      // Verifiability lens — who can read this page, how much is exposed, can the origin verify.
      function avDetail(av) {
        if (!av || !av.detail) return '';
        const d = av.detail;
        const pct = d.exposurePct;
        const allowed = Array.isArray(d.aiCrawlersAllowed) ? d.aiCrawlersAllowed : [];
        const blocked = Array.isArray(d.aiCrawlersBlocked) ? d.aiCrawlersBlocked : [];
        const allowedChips = allowed
          .map((b) => '<span class="ar-chip">' + esc(b) + '</span>')
          .join('');
        const blockedChips = blocked.length
          ? blocked.map((b) => '<span class="ar-chip ar-chip-block">' + esc(b) + '</span>').join('')
          : '<span class="ar-chip-none">none blocked</span>';
        const verifyLine = d.verifiable
          ? 'Your origin can verify signed agents.'
          : 'No bot-auth headers seen — your origin can’t tell a signed agent from an impostor.';
        const meter =
          typeof pct === 'number'
            ? '<div class="ar-meter" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="' +
              pct +
              '" aria-label="Raw-HTML exposure: ' +
              pct +
              ' percent"><i style="width:' +
              pct +
              '%"></i></div>' +
              '<div class="ar-meter-cap">' +
              pct +
              '% of your rendered content is in the raw HTML these crawlers read</div>'
            : '';
        return (
          '<div class="ar-lens">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">Who can read this page ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          (av.verifiable ? 'verifiable' : 'unverifiable') +
          '</span></h4>' +
          '<p class="ar-def">“Verifiable” means your origin can cryptographically tell a real signed AI agent from an impostor. We detect this from bot-auth headers on the response.</p>' +
          '<div class="ar-v">' +
          esc(av.verdict) +
          '</div>' +
          meter +
          '<div class="ar-chip-label">AI crawlers allowed by robots policy:</div>' +
          '<div class="ar-chips">' +
          allowedChips +
          '</div>' +
          '<div class="ar-chips">' +
          blockedChips +
          '</div>' +
          '<div class="ar-v">' +
          esc(verifyLine) +
          '</div>' +
          '</div>'
       );
      }

      // Accessibility lens — ITEMIZED. Shows the byImpact summary + the topRules list with
      // human-readable help text, impact, affected counts, and the addressable-inline marker.
      function axDetail(ax) {
        if (!ax || !ax.available || !ax.detail) return '';
        const d = ax.detail;
        const total = d.total;
        const countLabel = total === 0 ? 'no issues' : total === 1 ? '1 issue' : total + ' issues';
        // UI-authored lead, consistent with the per-item "addressable inline" wording (we do
        // NOT echo the backend verdict's "deterministically fixable inline, server-side, with
        // zero app changes" phrasing — the itemized list + legend now carry that, in one voice).
        const lead =
          total === 0
            ? 'No WCAG violations from automated checks.'
            : 'Automated checks flagged ' +
              countLabel +
              ' on this page' +
              (d.fixableInline > 0 ? ', ' + d.fixableInline + ' addressable inline' : '') +
              '.';
        const impacts = (d.byImpact && typeof d.byImpact === 'object' ? d.byImpact : {}) || {};
        const impactPills = IMPACT_ORDER.filter((k) => impacts[k] > 0)
          .map((k) => '<span class="ar-pill ar-pill-' + k + '">' + impacts[k] + ' ' + k + '</span>')
          .join('');
        const rules = Array.isArray(d.topRules) ? d.topRules : [];
        const items = rules
          .map(function (rule) {
            const impact = IMPACT_ORDER.indexOf(rule.impact) === -1 ? 'minor' : rule.impact;
            const fixTag = ADDRESSABLE_INLINE.has(rule.id)
              ? '<span class="ar-fix">addressable inline</span>'
              : '';
            const n = rule.nodes;
            const nLabel = n + ' element' + (n === 1 ? '' : 's');
            return (
              '<li class="ar-issue">' +
              '<span class="ar-pill ar-pill-' +
              impact +
              '">' +
              esc(impact) +
              '</span>' +
              '<span class="ar-issue-help">' +
              esc(rule.help) +
              '</span>' +
              '<span class="ar-issue-n">' +
              nLabel +
              '</span>' +
              fixTag +
              '<span class="ar-issue-id">' +
              esc(rule.id) +
              '</span>' +
              '</li>'
           );
          })
          .join('');
        const legend =
          d.fixableInline > 0
            ? '<p class="ar-legend">“addressable inline” marks the kind of issue a self-hosted optimizer can handle server-side, with no app changes. We don’t issue compliance certificates.</p>'
            : '';
        return (
          '<div class="ar-lens">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">Accessibility (WCAG / EAA) ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          countLabel +
          '</span></h4>' +
          '<div class="ar-v">' +
          lead +
          '</div>' +
          '<p class="ar-def">Automated checks only — a subset of WCAG. A clean result here is not an accessibility audit and does not mean a page is conformant.</p>' +
          (impactPills ? '<div class="ar-impacts">' + impactPills + '</div>' : '') +
          (items
            ? '<ul class="ar-issues">' + items + '</ul>'
            : total > 0
              ? '<p class="ar-legend">Per-issue details aren’t available for this scan.</p>'
              : '') +
          legend +
          '</div>'
       );
      }

      // WebMCP agent-actionability — demoted to one muted line (no badge row, ~0% adoption).
      function aaLine(r) {
        if (!r.agentActionability) return '';
        return (
          '<div class="ar-v ar-aa-line">Agent actionability (WebMCP): ' +
          esc(r.agentActionability.label) +
          ' — ' +
          esc(r.agentActionability.verdict) +
          '</div>'
       );
      }

      // ---- Four FREE, NON-SCORED lenses. Each is an
      // owner-facing observation that NEVER touches the 0-100 grade. The verdict
      // strings (incl. their mandatory honesty/heuristic disclaimers) mirror the
      // scanner's index.html builders verbatim — KEEP IN SYNC. Rendered as compact
      // .ar-lens blocks; all states are neutral (no pass/fail colouring).
      function avpVerdict(avp) {
        if (!avp || avp.status !== 'ok')
          return 'Agent-verification posture unavailable for this page.';
        const bits = [];
        if (avp.emitsSignatureHeaders)
          bits.push('your origin emits RFC-9421 signature headers on our fetch');
        if (avp.botUaProbe && avp.botUaProbe.returns402)
          bits.push('it returns HTTP 402 to a bot user-agent');
        else if (avp.botUaProbe && avp.botUaProbe.status === 401 && avp.botUaProbe.wwwAuthenticate)
          bits.push('it returns 401 + WWW-Authenticate to a bot user-agent');
        return (
          (bits.length
            ? bits.join(', and ') + '. '
            : 'We saw no bot-auth signature headers and no agent toll on our own fetch. ') +
          'This is observed from the scanner’s own HTTP exchange only — not a measure of inbound agent verification.'
       );
      }
      function avpBlock(avp) {
        if (!avp) return '';
        return (
          '<div class="ar-lens">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">Agent-verification posture ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          esc(avp.status === 'ok' ? avp.posture : 'unavailable') +
          '</span></h4>' +
          '<div class="ar-v">' +
          esc(avpVerdict(avp)) +
          '</div></div>'
       );
      }
      function saVerdict(sa) {
        if (!sa || sa.status !== 'ok')
          return 'Signed-agent verification probe unavailable for this page.';
        let lead;
        if (sa.classification === 'verifying')
          lead =
            'Your origin responded differently to our validly-signed probe than to one with a corrupted signature — behaviour consistent with cryptographically verifying agent signatures.';
        else if (sa.classification === 'signature-aware')
          lead =
            'Your origin treats requests carrying signature material differently from unsigned ones, but our exchange showed no proof it fully verified the signature.';
        else
          lead =
            'All three of our probes — validly signed, corrupted signature, unsigned — drew indistinguishable responses. That does not mean your origin runs no verifier: observe-only verifiers are externally invisible, and an origin can only fully verify our probe if it trusts our key directory.';
        return lead + ' We only report what our own three probe exchanges showed.';
      }
      function signedAgentBlock(sa) {
        if (!sa) return '';
        return (
          '<div class="ar-lens' +
          (sa.status === 'ok' && sa.classification !== 'no-signal' ? ' ar-finding' : '') +
          '">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">Signed-agent verification (RFC 9421) ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          esc(sa.status === 'ok' ? sa.classification : 'unavailable') +
          '</span></h4>' +
          '<p class="ar-def">We sent your page three requests: one with a valid RFC 9421 Web Bot Auth signature (Ed25519, key published in our key directory), one with a deliberately corrupted signature, and one unsigned — then compared the responses.</p>' +
          '<div class="ar-v">' +
          esc(saVerdict(sa)) +
          '</div></div>'
       );
      }
      function psVerdict(ps) {
        if (!ps || ps.status !== 'ok') return 'Provenance scan unavailable for this page.';
        if (ps.imagesScanned === 0)
          return 'No images found to scan for C2PA / Content-Credentials manifests.';
        const base =
          ps.withManifestServed +
          ' of ' +
          ps.imagesScanned +
          ' scanned image(s) carry a C2PA / Content-Credentials manifest on the served file. ';
        return (
          base +
          (ps.strippedOnServe > 0
            ? ps.strippedOnServe +
              ' image(s) had a manifest upstream that your pipeline strips on serve. Detection only — nothing is validated, re-signed, or authored.'
            : 'No stripped manifests detected. Detection only — nothing is validated, re-signed, or authored.')
       );
      }
      function psBlock(ps) {
        if (!ps) return '';
        return (
          '<div class="ar-lens' +
          (ps.status === 'ok' && ps.strippedOnServe > 0 ? ' ar-finding' : '') +
          '">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">Provenance survival (C2PA) ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          (ps.status === 'ok' ? ps.withManifestServed + '/' + ps.imagesScanned : 'unavailable') +
          '</span></h4>' +
          '<div class="ar-v">' +
          esc(psVerdict(ps)) +
          '</div></div>'
       );
      }
      function seVerdict(se) {
        if (!se || se.status !== 'ok')
          return 'Sovereignty-exposure scan unavailable for this page.';
        if (se.exposedFeatureCount === 0)
          return 'No AI / translation / optimization features observed phoning home to US-jurisdiction endpoints. Heuristic, passive observation — not legal advice or a compliance certificate.';
        const ex = se.findings
          .slice(0, 5)
          .map((f) => f.host + ' (' + f.category + ')')
          .join(', ');
        return (
          se.exposedFeatureCount +
          ' feature(s) on this page send data to US-jurisdiction (CLOUD-Act-exposed) endpoints: ' +
          ex +
          (se.findings.length > 5 ? ', …' : '') +
          '. Heuristic, passive observation — not legal advice or a compliance certificate.'
       );
      }
      function seBlock(se) {
        if (!se) return '';
        return (
          '<div class="ar-lens' +
          (se.status === 'ok' && se.exposedFeatureCount > 0 ? ' ar-finding' : '') +
          '">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">Sovereignty exposure ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          (se.status === 'ok' ? se.exposedFeatureCount + ' exposed' : 'unavailable') +
          '</span></h4>' +
          '<div class="ar-v">' +
          esc(seVerdict(se)) +
          '</div></div>'
       );
      }

      // Hidden-layer lens (NON-SCORED): human-invisible-but-agent-readable
      // content found on the owner's OWN page. Reports observations to the owner; it
      // never asserts a "safe/screened" status. Technique chips + per-node evidence
      // list + the full-page screenshot with overlay boxes (emitted only when actually
      // detected, see wireGhostOverlay). KEEP IN SYNC with the scanner.
      function ghostBlock(gl) {
        if (!gl) return '';
        const techs = Object.entries(gl.byTechnique || {})
          .map((entry) => {
            const t = entry[0],
              n = entry[1];
            const node = (gl.nodes || []).find((x) => x.technique === t) || {};
            return '<span class="ar-chip">' + esc(node.label || t) + ' ×' + n + '</span>';
          })
          .join('');
        const list = (gl.nodes || [])
          .slice(0, 40)
          .map(
            (nd) =>
              '<div class="ar-gnode"><b>' +
              esc(nd.label) +
              '</b>' +
              (nd.gloss ? '<div class="ar-v">' + esc(nd.gloss) + '</div>' : '') +
              (nd.selector ? '<div class="ar-gsel">' + esc(nd.selector) + '</div>' : '') +
              '</div>',
         )
          .join('');
        // Nodes with a real on-screen rectangle can be boxed on the screenshot; some
        // findings live only in the text/accessibility layer and have no box.
        const boxed = (gl.nodes || []).filter(
          (nd) => nd.rect && nd.rect.width > 0 && nd.rect.height > 0,
       );
        // Only emit the (large, base64) screenshot when something was actually detected —
        // the clean/none state stays light.
        const shot = gl.screenshot
          ? '<div class="ar-shotwrap" id="ar-ghostshot-wrap"><img id="ar-ghostshot" src="' +
            esc(gl.screenshot) +
            '" alt="full-page render of the scanned page" /></div>'
          : '';
        return (
          '<div class="ar-lens' +
          (gl.detected ? ' ar-finding' : '') +
          '">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">Ghost Layer — hidden-but-agent-readable content ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          (gl.detected ? gl.count + ' found' : 'none') +
          '</span></h4>' +
          '<div class="ar-v">' +
          esc(gl.verdict) +
          '</div>' +
          (techs ? '<div class="ar-chips">' + techs + '</div>' : '') +
          (gl.detected ? shot : '') +
          (gl.detected && gl.screenshot && boxed.length
            ? '<p class="ar-shotnote">Full-page render — scroll within the frame to see every highlighted node.</p>'
            : '') +
          (gl.detected && !boxed.length
            ? '<p class="ar-shotnote">These findings live in the text or accessibility layer and have no on-screen box to highlight.</p>'
            : '') +
          (gl.detected ? '<div class="ar-glist">' + list + '</div>' : '') +
          '</div>'
       );
      }

      // After the ghost panel is in the DOM, position the overlay boxes once the screenshot
      // <img> has loaded and we know its rendered size (to scale page coords → displayed px).
      // No-ops unless the report actually detected ghost nodes and carries a screenshot, so the
      // clean/none state pays nothing. rect coords are CSS px; the screenshot is device px, hence
      // the dpr factor before the display scale.
      function wireGhostOverlay(gl) {
        // Drop any prior scan's resize handler first — render() is SPA-like (each scan
        // replaces out.innerHTML without a reload), so without this a stale closure per
        // scan would leak, pinning the previous scan's detached screenshot in memory.
        if (window.__arGhostDraw) {
          window.removeEventListener('resize', window.__arGhostDraw);
          window.__arGhostDraw = null;
        }
        if (!gl || !gl.detected || !gl.screenshot) return;
        const img = document.getElementById('ar-ghostshot');
        const wrap = document.getElementById('ar-ghostshot-wrap');
        if (!img || !wrap) return;
        const draw = () => {
          wrap.querySelectorAll('.ar-gbox').forEach((b) => b.remove());
          const natW = img.naturalWidth || 1;
          const scale = img.clientWidth / natW; // displayed px per natural (device) px
          const dpr = (gl.viewport && gl.viewport.dpr) || 1; // page CSS px → device px
          for (const nd of gl.nodes || []) {
            const rr = nd.rect;
            if (!rr || !rr.width || !rr.height) continue;
            const box = document.createElement('div');
            box.className = 'ar-gbox';
            box.style.left = rr.x * dpr * scale + 'px';
            box.style.top = rr.y * dpr * scale + 'px';
            box.style.width = Math.max(3, rr.width * dpr * scale) + 'px';
            box.style.height = Math.max(3, rr.height * dpr * scale) + 'px';
            box.title = nd.gloss ? nd.label + ' — ' + nd.gloss : nd.label;
            wrap.appendChild(box);
          }
        };
        if (img.complete && img.naturalWidth) draw();
        else img.addEventListener('load', draw, { once: true });
        // Exactly one live resize handler at a time (see the cleanup at the top).
        window.__arGhostDraw = draw;
        window.addEventListener('resize', window.__arGhostDraw);
      }

      // Section 4 — product paragraph + the ONE filled primary CTA + the two text links,
      // the wedge CONTEXT block(s) (copy only, no form), the ONE consolidated contact form
      // (single email + optional note [+ topic radios when both wedges fire]), the secondary
      // "email me this result" text-button, and the legal disclosure. wireNext() runs after.
      function nextStep(r, primaryWedge, firedWedges) {
        const av = r.agentVerifiability;
        const ax = r.accessibility;
        const sa = r.signedAgentVerification;
        const bothWedges = firedWedges.length >= 2;
        const product =
          '<p class="ar-v">mod_pagespeed optimizes your pages and cuts page weight on your own servers, off any CDN — lighter markup is faster for people and easier for machines to parse.</p>' +
          '<a class="ar-cta-primary" href="/download/" data-umami-event="airead-cta-optimize">Download &amp; run — optimize your HTML on your own servers →</a>' +
          '<p class="ar-v">Free to install and run, in development and in production.</p>' +
          '<div class="ar-cta-row">' +
          '<a class="ar-cta-link" href="/pricing/" data-umami-event="airead-cta-buy">Support plans →</a>' +
          '<a class="ar-cta-link" href="/contact/?topic=agent-optimize" data-umami-event="airead-cta-agentoptimize">Serving a clean copy to AI agents automatically is on our roadmap. Tell us if you need it →</a>' +
          '<a class="ar-cta-link" href="/blog/can-ai-read-your-website/" data-umami-event="airead-cta-blog">See how the top 1,000 sites scored &rarr;</a>' +
          '</div>';
        // Wedge CONTEXT — copy only, restates the earned reason above the single form.
        // When ≥2 wedges fire (the worst case for card height), the per-wedge reason
        // sentences collapse into ONE paragraph instead of stacking full ar-wedge-ctx
        // blocks (D.9). Each fired wedge contributes one factual sentence.
        const reasons = [];
        if (firedWedges.indexOf('tollbooth') !== -1) {
          reasons.push(
            'About ' +
              av.detail.exposurePct +
              '% of your content is already in the raw HTML ' +
              av.detail.aiCrawlersAllowed.length +
              ' AI crawler(s) can read — but your origin can’t tell a real signed agent from an impostor.',
         );
        }
        if (firedWedges.indexOf('agentpass') !== -1) {
          reasons.push(
            sa.classification === 'verifying'
              ? 'Your origin responded differently to our validly-signed probe than to a corrupted signature — behaviour consistent with cryptographic verification.'
              : 'Your origin already treats signed-agent requests differently from unsigned ones.',
         );
        }
        if (firedWedges.indexOf('compliancefix') !== -1) {
          reasons.push(
            (ax.detail.fixableInline === 1
              ? '1 of these issues looks'
              : ax.detail.fixableInline + ' of these issues look') +
              ' like the kind a self-hosted optimizer can address server-side, on your own servers, with no app changes.',
         );
        }
        let ctx = '';
        if (bothWedges) {
          ctx =
            '<p class="ar-wedge-ctx">' +
            reasons.join(' ') +
            ' These are things we’re building and can’t sell yet; tell us which one you need.</p>';
        } else if (primaryWedge === 'tollbooth') {
          ctx =
            '<p class="ar-wedge-ctx">' +
            reasons[0] +
            ' We’re building origin-side controls and want operator input.</p>';
        } else if (primaryWedge === 'agentpass') {
          ctx =
            '<p class="ar-wedge-ctx">' +
            reasons[0] +
            ' Verifying signed AI agents at the origin is something we’re building — we want operator input.</p>';
        } else if (primaryWedge === 'compliancefix') {
          ctx =
            '<p class="ar-wedge-ctx">' +
            reasons[0] +
            ' Inline remediation isn’t something you can buy yet — we’re building it.</p>';
        }
        const wedgeActive = primaryWedge !== '';
        // Topic chooser only when ≥2 wedges fire. Default = the first fired wedge
        // (priority order: tollbooth > agentpass > compliancefix).
        const WEDGE_LABELS = {
          tollbooth: 'Origin controls (who reads / verifies)',
          agentpass: 'Signed-agent verification (prove which agent is which)',
          compliancefix: 'Accessibility remediation',
        };
        const chooser = bothWedges
          ? '<fieldset class="ar-radiogroup" role="radiogroup" aria-label="What’s most relevant?">' +
            '<legend>What’s most relevant?</legend>' +
            firedWedges
              .map(function (w, i) {
                return (
                  '<label><input type="radio" name="ar-topic" value="' +
                  w +
                  '"' +
                  (i === 0 ? ' checked' : '') +
                  ' /> ' +
                  WEDGE_LABELS[w] +
                  '</label>'
               );
              })
              .join('') +
            '<label><input type="radio" name="ar-topic" value="notify" /> Just email me this result</label>' +
            '</fieldset>'
          : '';
        // Optional note is collapsed by default (saves vertical space in the worst case);
        // wireNext() reveals it on first email focus. The [hidden] attribute keeps it out
        // of the layout AND the a11y tree until the visitor engages the form.
        const noteField = wedgeActive
          ? '<label id="ar-next-note-field" class="ar-field" hidden><span class="ar-field-label">Anything we should know? (crawl volume, EAA deadline, page count) — optional</span>' +
            '<input id="ar-next-note" type="text" autocomplete="off" /></label>'
          : '';
        const submitLabel = wedgeActive ? 'Talk to us' : 'Get in touch';
        const umamiEvent = wedgeActive ? 'airead-next-' + primaryWedge : 'airead-next-notify';
        const form =
          '<form id="ar-next-form" class="ar-next-form" data-wedge="' +
          (wedgeActive && !bothWedges ? primaryWedge : '') +
          '">' +
          chooser +
          '<label class="ar-field"><span class="ar-field-label">Your email</span>' +
          '<input id="ar-next-email" type="email" autocomplete="email" required /></label>' +
          noteField +
          '<button type="submit" data-umami-event="' +
          umamiEvent +
          '">' +
          submitLabel +
          '</button>' +
          '</form>' +
          // #ar-next-msg keeps its OWN explicit aria-live="polite": it is nested inside #ar-out
          // (which render() flips to aria-live="off" so the whole card isn't announced at once),
          // and per the ARIA live-region algorithm the nearest explicit setting governs — so the
          // confirmation still announces. The tabindex=-1 .focus() in wireNext is belt-and-braces.
          '<div id="ar-next-msg" class="ar-next-msg" role="status" aria-live="polite" tabindex="-1"></div>';
        // Secondary "email me this result" text-button → /notify. Shown only when EXACTLY ONE
        // wedge fires: when BOTH fire the chooser already offers a "just email me this result"
        // radio (a separate button would duplicate it), and when NONE fire the single form
        // already IS the /notify path. Carries its own narrow notify promise.
        const notifyBtn =
          wedgeActive && !bothWedges
            ? '<button type="button" id="ar-notify-btn" data-umami-event="airead-capture">Email me this result instead</button>' +
              '<p class="ar-disclosure">That just emails you this result — we won’t add you to a mailing list.</p>'
            : '';
        // Per-path consent scoping (Legal H5): the broad follow-up disclosure applies only when
        // the form submits a wedge lead to /contact. When no wedge fires the form IS the /notify
        // result-email path, so it carries the narrow "used only to send you this result" promise.
        const disclosure = wedgeActive
          ? '<p class="ar-disclosure">Submitting this sends us your email and a summary of this scan’s findings so we can follow up. ' +
            'See our <a href="/privacy/">Privacy policy</a>.</p>'
          : '<p class="ar-disclosure">Used only to send you this result. We won’t add you to a mailing list. ' +
            'See our <a href="/privacy/">Privacy policy</a>.</p>';
        return (
          '<h3 id="ar-h-next" class="ar-h3">What mod_pagespeed can do about it</h3>' +
          product +
          ctx +
          form +
          notifyBtn +
          disclosure
       );
      }

      function render(data) {
        // Silence the giant single-shot announcement of the full result; the loading/
        // error branches re-set aria-live to polite (A11y).
        out.setAttribute('aria-live', 'off');
        const r = data.report;
        // Track which sites get analyzed (domain + grade) in Umami — privacy-first,
        // no PII (the scanned URL is a public site the user chose).
        try {
          if (window.umami) {
            let domain = r.url;
            try {
              domain = new URL(r.url).hostname;
            } catch (_) {}
            window.umami.track('ai-scan', {
              domain: domain,
              grade: r.grade,
              score: r.score,
              csr_gap: (r.categories['Content fidelity'] || {}).flag === 'csr-gap',
            });
          }
        } catch (_) {}
        const av = r.agentVerifiability;
        const ax = r.accessibility;
        // Which wedges fire, in priority order (tollbooth = highest commercial intent).
        // The first fired wedge leads (single-fire path); ≥2 fired → the chooser path.
        const firedWedges = [];
        if (tollboothCtaApplies(av)) firedWedges.push('tollbooth');
        if (agentPassCtaApplies(r.signedAgentVerification)) firedWedges.push('agentpass');
        if (complianceFixCtaApplies(ax)) firedWedges.push('compliancefix');
        const primaryWedge = firedWedges[0] || '';
        const multiWedge = firedWedges.length >= 2;

        // SECTION 1 — verdict: grade badge + 5 category bars (grading byte-identical; F3).
        const grade =
          '<div class="ar-grade"><div class="ar-badge ar-' +
          r.grade +
          '" role="img" aria-label="Grade ' +
          r.grade +
          ', ' +
          r.score +
          ' out of 100">' +
          r.grade +
          '</div>' +
          '<div><div class="ar-score">' +
          r.score +
          '/100</div><div class="ar-u">' +
          esc(r.url) +
          '</div><div class="ar-u">Grade ' +
          r.grade +
          ' — ' +
          ({ A: 'strong', B: 'strong', C: 'mixed', D: 'weak', F: 'poor' }[r.grade] || '') +
          '</div></div></div>';
        const cats = Object.entries(r.categories)
          .map(function (entry) {
            const name = entry[0],
              c = entry[1];
            const pct = Math.round((c.score / c.max) * 100);
            const flag =
              c.flag === 'csr-gap'
                ? '<span class="ar-flag">invisible without JS</span>'
                : c.flag === 'thin'
                  ? '<span class="ar-flag">no content found</span>'
                  : '';
            return (
              '<div class="ar-cat"><div class="ar-top"><span>' +
              esc(name) +
              flag +
              '</span><span>' +
              c.score +
              '/' +
              c.max +
              '</span></div>' +
              '<div class="ar-bar"><i style="width:' +
              pct +
              '%"></i></div><div class="ar-v">' +
              esc(c.verdict) +
              '</div></div>'
           );
          })
          .join('');

        // SECTION 2 — what an AI agent sees: the two diff panels FIRST, caption below.
        const d = r.diff;
        const panel = (t, tok, md) =>
          '<div class="ar-panel"><h4>' +
          t +
          '</h4><div class="ar-tok"><b>~' +
          tok.toLocaleString() +
          '</b> tokens an agent can read</div>' +
          (md && md.trim()
            ? '<pre>' + esc(md) + '</pre>'
            : '<p class="ar-empty">— almost nothing —</p>') +
          '</div>';
        const explain =
          '<p class="ar-explain">Left: the readable words in your raw HTML — what most AI crawlers get. ' +
          'Right: after a browser runs your JavaScript. A big shortfall on the left means your content ' +
          'barely exists until your scripts run.</p>';

        // SECTION 3 — beyond the grade: one explainer, then the explained lenses.
        const beyondExplain =
          '<p class="ar-explain">These don’t change the grade above. They’re extra signals on how ' +
          'machines read, verify, and parse your page.</p>';
        const avBlock = avDetail(av);
        const axBlock = axDetail(ax);
        const aaBlock = aaLine(r);
        // Four free non-scored lenses + the hidden-layer lens.
        // Each renders only when present in the report; all neutral.
        const avpBlk = avpBlock(r.agentVerificationPosture);
        const saBlk = signedAgentBlock(r.signedAgentVerification);
        const psBlk = psBlock(r.provenanceSurvival);
        const seBlk = seBlock(r.sovereigntyExposure);
        const ghostBlk = ghostBlock(r.ghostLayer);

        // SECTION 5 — share.
        const share = data.permalink
          ? '<div class="ar-share">Shareable link: <a href="' +
            esc(data.permalink) +
            '">' +
            esc(data.permalink) +
            '</a></div>'
          : '';

        out.innerHTML =
          '<div class="ar-card" role="region" aria-labelledby="ar-card-title" tabindex="-1">' +
          '<h2 id="ar-card-title" class="ar-h2">Readability result</h2>' +
          '<section aria-labelledby="ar-h-verdict">' +
          '<h3 id="ar-h-verdict" class="ar-sr-only">Grade</h3>' +
          grade +
          cats +
          '</section>' +
          '<section class="ar-sec" aria-labelledby="ar-h-diff">' +
          '<h3 id="ar-h-diff" class="ar-h3">What an AI agent actually sees</h3>' +
          '<div class="ar-diff">' +
          panel('Raw HTML — most AI crawlers', d.staticCleanTokens, d.staticMarkdown) +
          panel('After rendering JavaScript', d.renderedCleanTokens, d.renderedMarkdown) +
          '</div>' +
          explain +
          '</section>' +
          '<section class="ar-sec" aria-labelledby="ar-h-found">' +
          '<h3 id="ar-h-found" class="ar-h3">Beyond the grade</h3>' +
          beyondExplain +
          avBlock +
          avpBlk +
          saBlk +
          axBlock +
          psBlk +
          seBlk +
          aaBlock +
          ghostBlk +
          '</section>' +
          '<section class="ar-sec" aria-labelledby="ar-h-next">' +
          nextStep(r, primaryWedge, firedWedges) +
          '</section>' +
          (share ? '<section class="ar-sec" aria-label="Share">' + share + '</section>' : '') +
          '</div>';
        wireNext(r, primaryWedge, multiWedge);
        // Position the hidden-layer overlay boxes over the screenshot (no-op if not detected).
        wireGhostOverlay(r.ghostLayer);
        // Scroll the freshly rendered result into view and move keyboard/SR focus to the
        // region card. On mobile the verdict otherwise lands off-screen below the intro.
        const card = out.querySelector('.ar-card');
        if (card) {
          const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          card.scrollIntoView({ behavior: rm ? 'auto' : 'smooth', block: 'start' });
          card.focus({ preventScroll: true });
        }
      }

      // POST the result to /notify (emails it) with a prefilled mailto fallback so a
      // notify lead is never dropped. Body byte-identical to the old wireCapture (F2).
      async function sendNotify(r, email, btn, msg) {
        const subject = encodeURIComponent('RenderPeek report — ' + (r.url || ''));
        const body = encodeURIComponent(
          'Please send me the full RenderPeek report.\n\n' +
            'My email: ' +
            email +
            '\n' +
            'Scanned URL: ' +
            (r.url || '') +
            '\n' +
            'Grade: ' +
            (r.grade || '') +
            ' (' +
            (r.score || '') +
            '/100)\n',
       );
        const mailto = 'mailto:info@we-amp.com?subject=' + subject + '&body=' + body;
        try {
          const res = await fetch(API + '/notify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              email,
              url: r.url || '',
              grade: (r.grade || '') + ' ' + (r.score || '') + '/100',
            }),
          });
          if (!res.ok) throw new Error('status ' + res.status);
          if (msg) {
            msg.textContent =
              'Thanks — we’ll send the full report to ' + email.replace(/[<>&]/g, '') + '.';
            msg.focus && msg.focus();
          }
          return true;
        } catch {
          if (btn) btn.disabled = false;
          window.location.href = mailto;
          return false;
        }
      }

      // Wire the ONE consolidated next-step form (replaces wireCapture + wireWedges).
      // Wedge submissions still build buildLeadPayload(wedge,…) → POST /contact; the
      // notify path (no-wedge form, the chooser's "notify" radio, and the secondary
      // text-button) → POST /notify via sendNotify. NO secret in client JS (F1/F2).
      function wireNext(r, primaryWedge, bothWedges) {
        const form = $('#ar-next-form');
        if (!form) return;
        const msg = $('#ar-next-msg');
        const emailEl = $('#ar-next-email');
        // Reveal the collapsed optional note once the visitor engages the email field.
        const noteFieldEl = $('#ar-next-note-field');
        if (noteFieldEl && emailEl) {
          emailEl.addEventListener(
            'focus',
            function () {
              noteFieldEl.removeAttribute('hidden');
            },
            { once: true },
         );
        }
        // When ≥2 wedges fire, the chooser drives data-wedge for analytics parity.
        // Seed it from the default-checked radio so the attribute matches the active
        // default (the highest-priority fired wedge) before any interaction, then
        // keep it in sync on change.
        if (bothWedges) {
          const checkedDefault = form.querySelector('input[name="ar-topic"]:checked');
          form.setAttribute(
            'data-wedge',
            checkedDefault && checkedDefault.value !== 'notify' ? checkedDefault.value : '',
         );
          form.querySelectorAll('input[name="ar-topic"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
              form.setAttribute('data-wedge', radio.value === 'notify' ? '' : radio.value);
            });
          });
        }
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = ((emailEl && emailEl.value) || '').trim();
          if (!email) {
            if (emailEl) emailEl.focus();
            return;
          }
          const noteEl = $('#ar-next-note');
          const note = ((noteEl && noteEl.value) || '').trim();
          const btn = form.querySelector('button[type="submit"]');
          // Resolve the topic: chooser radio (≥2 fire) → fixed wedge (one fires) → notify.
          let topic = primaryWedge;
          if (bothWedges) {
            const checked = form.querySelector('input[name="ar-topic"]:checked');
            topic = checked ? checked.value : primaryWedge;
          }
          if (btn) btn.disabled = true;
          if (topic === 'tollbooth' || topic === 'agentpass' || topic === 'compliancefix') {
            try {
              const payload = buildLeadPayload({
                wedge: topic,
                email: email,
                name: '',
                note: note,
                report: r,
              });
              const res = await fetch(API + '/contact', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(payload),
              });
              const j = await res.json().catch(() => ({}));
              if (res.ok) {
                if (msg) {
                  msg.textContent = 'Thanks — we’ll be in touch.';
                  msg.focus && msg.focus();
                }
                form.remove();
              } else {
                if (msg) msg.textContent = j && j.error ? j.error : 'Something went wrong.';
                if (btn) btn.disabled = false;
              }
            } catch (err) {
              if (msg) msg.textContent = 'Could not reach us. ' + esc(String(err));
              if (btn) btn.disabled = false;
            }
          } else {
            // notify path (no wedge, or the chooser's "Just email me this result")
            const ok = await sendNotify(r, email, btn, msg);
            if (ok) form.remove();
          }
        });
        // Secondary "email me this result" text-button → /notify (present only when a wedge fires).
        const notifyBtn = $('#ar-notify-btn');
        if (notifyBtn) {
          notifyBtn.addEventListener('click', async () => {
            const email = ((emailEl && emailEl.value) || '').trim();
            if (!email) {
              if (emailEl) emailEl.focus();
              return;
            }
            notifyBtn.disabled = true;
            const ok = await sendNotify(r, email, notifyBtn, msg);
            if (ok) {
              notifyBtn.disabled = true;
              notifyBtn.textContent = 'Sent';
            } else {
              notifyBtn.disabled = false;
            }
          });
        }
      }
    })();
  </script>
</BaseLayout>
