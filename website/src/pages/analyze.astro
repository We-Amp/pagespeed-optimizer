  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 border-t border-border">
    <h2 class="h2-section text-center text-text-body">What mod_pagespeed fixes automatically</h2>
    <p class="lede mt-3 text-center max-w-2xl mx-auto">
      These are the PageSpeed Insights findings mod_pagespeed addresses on every request, with no
      code changes on the origin. Most filters below have been production-tested in the upstream
      <code class="text-sm">mod_pagespeed</code> codebase since 2010. A few are still marked
      &ldquo;test first&rdquo;; the analyzer flags those per-page in the live results.
    </p>

    {/* Inline edition toggle for the highlights cards. Always visible (the
        toggle inside the results panel is only surfaced after analysis).
        Both toggles read+write the same JS state via syncEditionUi(). */}
    <div id="psi-highlights-toggle" class="mt-8 flex flex-col items-center gap-2">
      <span class="text-xs font-medium uppercase tracking-wide text-text-annotation">
        Showing cards for
      </span>
      <div
        class="inline-flex gap-1 rounded-lg bg-bg-elevated p-1"
        role="group"
        aria-label="Which part you configure"
      >
        <button
          type="button"
          data-edition="2.0"
          aria-pressed="true"
          class="product-tab rounded-md px-3 py-1.5 text-xs font-medium transition-colors"
          data-umami-event="psi-highlights-edition-toggle"
          data-umami-event-edition="2.0"
        >
          Optimizer worker
        </button>
        <button
          type="button"
          data-edition="1.1"
          aria-pressed="false"
          class="product-tab rounded-md px-3 py-1.5 text-xs font-medium transition-colors"
          data-umami-event="psi-highlights-edition-toggle"
          data-umami-event-edition="1.1"
        >
          Module
        </button>
      </div>
    </div>

    <ul id="psi-highlights-list" class="mt-10 grid gap-4 sm:grid-cols-2">
      {fixedHighlights.map((item) => {
        // Worker-side audits get a "Worker" coverage marker; module-side
        // audits get a "Module" marker. Both parts ship in mod_pagespeed
        // 2.1; the marker says where the fix runs, not which product you
        // need. Cards toggle their hidden state client-side based on the
        // chosen part.
        const isTwoOnly = item.availableIn.includes('2.0') && !item.availableIn.includes('1.1');
        const isOneOnly = item.availableIn.includes('1.1') && !item.availableIn.includes('2.0');
        // Title overrides — keep the brand-honest framing for cards
        // whose audit ID is generic (e.g. "Document request latency")
        // but whose worker-only behaviour is the HTML cache.
        const displayTitle =
          isTwoOnly && item.auditId === 'document-latency-insight'
            ? 'Mask slow origin TTFB with HTML caching'
            : item.auditTitle;
        return (
          <li
            data-highlight-id={item.auditId}
            data-available-in={item.availableIn.join(',')}
            class="rounded-xl border border-border bg-bg-elevated p-5"
          >
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-base font-semibold text-text-body">{displayTitle}</h3>
              {isTwoOnly && <Chip tone="neutral" label="Worker" />}
              {isOneOnly && <Chip tone="neutral" label="Module" />}
            </div>
            <p class="mt-2 text-sm text-text-muted leading-relaxed">{item.explanation}</p>
            {item.filters.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-1.5 list-none">
                {item.filters.map((f) => (
                  <li>
                    <code class="inline-flex items-center rounded-md border border-border-strong bg-bg-secondary px-2 py-0.5 text-xs font-mono text-text-body">
                      {f}
                    </code>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
    </ul>

    <div class="mt-10 rounded-xl border border-border bg-bg-secondary p-6">
      <h3 class="text-base font-semibold text-text-body">What mod_pagespeed will not fix</h3>
      <p class="mt-2 text-sm text-text-muted leading-relaxed">
        Trust matters more than coverage claims. mod_pagespeed runs byte-level rewrites on what
        leaves your server; it does not edit application code. These stay out of reach: excessive
        DOM size, unused JavaScript and tree-shaking, legacy-JS polyfills served to modern browsers,
        third-party script impact (analytics, tag managers, ads), Interaction to Next Paint (INP),
        forced reflows in handler code, and font-display behavior. Origin TTFB on the first request
        is also out of reach. The optimizer worker can mask it on repeat visits by caching HTML when
        the origin allows it, but the first hit always reaches the origin. The analyzer above labels
        every one of these in your report.
      </p>
    </div>
