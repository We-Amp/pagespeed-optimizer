  <!-- ============================================================ -->
  <!-- Client-side analyzer                                          -->
  <!-- ============================================================ -->
  <script>
    import type { Coverage, Edition } from '../data/psi-mps-mapping';
    import {
      BUCKET_BADGE_CLASS,
      BUCKET_LABEL,
      CONFIG_DESC,
      DOCS_HREF,
      EDITION_BLURB,
      FILTER_TO_2_0_ANCHOR,
      aggregate,
      buildConfigSnippet,
      classifyError,
      collectFlaggedAuditIds,
      coverageSentence,
      fetchPsi,
      formatBytes,
      formatMs,
      getMapping,
      isMappingFailed,
      loadMapping,
      markMappingFailed,
      reloadError,
      savingsSentence,
      scoreBucket,
      toPercent,
      type AggregatedAudit,
      type PsiResult,
    } from '../lib/scan/psi';

    // ---- Which part the reader is configuring ----
    // The '2.0' key selects the optimizer worker, '1.1' the module; the
    // keys are the stored state, not a product name. Defaults to the
    // worker. The toggle changes the config snippet, the per-fix badge
    // text, the docs CTA, and which "what gets fixed" cards are visible.
    let edition: Edition = '2.0';

    // ---- Element refs ----
    const form = document.getElementById('psi-form') as HTMLFormElement | null;
    const urlInput = document.getElementById('psi-url') as HTMLInputElement | null;
    const submitBtn = document.getElementById('psi-submit') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('psi-submit-label');
    const submitSpinner = document.getElementById('psi-submit-spinner');
    const formError = document.getElementById('psi-form-error');

    const resultsEl = document.getElementById('psi-results');
    const headlineUrlEl = document.getElementById('psi-headline-url');
    const headlineTextEl = document.getElementById('psi-headline-text');
    const headlineSavingsEl = document.getElementById('psi-headline-savings');
    const scoreMobileEl = document.getElementById('psi-score-mobile');
    const scoreDesktopEl = document.getElementById('psi-score-desktop');
    const scoreMobileBarEl = document.getElementById('psi-score-mobile-bar');
    const scoreDesktopBarEl = document.getElementById('psi-score-desktop-bar');

    const fixableEl = document.getElementById('psi-fixable');
    const fixableListEl = document.getElementById('psi-fixable-list');
    const unfixableEl = document.getElementById('psi-unfixable');
    const unfixableListEl = document.getElementById('psi-unfixable-list');
    const emptyEl = document.getElementById('psi-empty');
    const ctasEl = document.getElementById('psi-ctas');
    const topCtaEl = document.getElementById('psi-top-cta');

    const configCard = document.getElementById('psi-config-card');
    const configSnippet = document.getElementById('psi-config-snippet');
    const configCopyBtn = document.getElementById('psi-config-copy');
    const configCopyLabel = document.getElementById('psi-config-copy-label');

    const errorBox = document.getElementById('psi-error');
    const errorTitle = document.getElementById('psi-error-title');
    const errorBody = document.getElementById('psi-error-body');
    const errorRetryBtn = document.getElementById('psi-error-retry');

    const allCleanEl = document.getElementById('psi-all-clean');
    const loadingEl = document.getElementById('psi-loading');
    const loadingStepEl = document.getElementById('psi-loading-step');
    const statusEl = document.getElementById('psi-status');
    const scoreMobileLabelEl = document.getElementById('psi-score-mobile-label');
    const scoreDesktopLabelEl = document.getElementById('psi-score-desktop-label');

    // Report-download card, revealed with the result.
    const reportEl = document.getElementById('psi-report');
    const reportDownloadBtn = document.getElementById(
      'psi-report-download',
    ) as HTMLButtonElement | null;
    const reportMsgEl = document.getElementById('psi-report-msg');
    // The analyzed URL, headline scores and failing audits of the latest
    // successful run; the download button folds them into a Markdown file at
    // click time.
    let reportContext: {
      url: string;
      mobile: number | null;
      desktop: number | null;
      totalFlagged: number;
      audits: Array<{ title: string; coverage: Coverage }>;
    } | null = null;

    // Edition toggle, edition-aware blurb/desc, docs CTA, and the build-time
    // rendered "what gets fixed" cards.
    const editionToggleEl = document.getElementById('psi-edition-toggle');
    const editionBlurbEl = document.getElementById('psi-edition-blurb');
    const configDescEl = document.getElementById('psi-config-desc');
    const docsCtaEl = document.getElementById('psi-docs-cta') as HTMLAnchorElement | null;
    const highlightsListEl = document.getElementById('psi-highlights-list');

    // ---- Helpers ----
    function show(el: HTMLElement | null) {
      if (el) el.classList.remove('hidden');
    }
    function hide(el: HTMLElement | null) {
      if (el) el.classList.add('hidden');
    }

    function setLoading(loading: boolean) {
      if (!submitBtn) return;
      submitBtn.disabled = loading;
      submitBtn.setAttribute('aria-busy', loading ? 'true' : 'false');
      if (submitLabel) submitLabel.textContent = loading ? 'Analyzing…' : 'Analyze';
      if (submitSpinner) submitSpinner.classList.toggle('hidden', !loading);
      if (loading) {
        if (loadingStepEl) loadingStepEl.textContent = 'Step 1 of 2: requesting mobile profile…';
        show(loadingEl);
        // Hide stale results while a new run is in flight.
        hide(resultsEl);
        if (statusEl) statusEl.textContent = 'Running PageSpeed Insights analysis, please wait.';
      } else {
        hide(loadingEl);
      }
    }

    function setLoadingStep(text: string) {
      if (loadingStepEl) loadingStepEl.textContent = text;
    }

    function setFormError(msg: string | null) {
      if (!formError || !urlInput) return;
      if (msg) {
        formError.textContent = msg;
        formError.classList.remove('hidden');
        urlInput.setAttribute('aria-invalid', 'true');
      } else {
        formError.textContent = '';
        formError.classList.add('hidden');
        urlInput.setAttribute('aria-invalid', 'false');
      }
    }

    function validateUrl(raw: string): { ok: true; url: string } | { ok: false; reason: string } {
      const trimmed = raw.trim();
      if (!trimmed) return { ok: false, reason: 'Enter a URL to analyze.' };
      let parsed: URL;
      try {
        parsed = new URL(trimmed);
      } catch {
        return {
          ok: false,
          reason: 'That does not look like a valid URL (try https://example.com).',
        };
      }
      if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
        return { ok: false, reason: 'Only http:// and https:// URLs are supported.' };
      }
      if (!parsed.hostname || parsed.hostname === 'localhost') {
        return {
          ok: false,
          reason: 'PSI needs a publicly reachable hostname. Localhost won’t work.',
        };
      }
      return { ok: true, url: parsed.toString() };
    }

    function scoreColorClasses(score: number): string {
      // Lighthouse's three buckets mapped onto the state tokens: success for
      // good (>=90), plain text for the neutral mid-range (50–89), accent
      // (the reserved caution hue) for poor (<50).
      const bucket = scoreBucket(score);
      if (bucket === 'good') return 'text-success';
      if (bucket === 'needs-work') return 'text-text-body';
      return 'text-accent';
    }

    const SCORE_CLASSES_TO_RESET = ['text-success', 'text-text-body', 'text-accent'];

    /**
     * The score bucket as a squared state chip: the word plus the chip's
     * leading block carry the state, so it reads without colour vision
     * (WCAG 1.4.1). No score → no chip.
     */
    function renderScoreBucket(labelEl: HTMLElement | null, score0to1: number | null | undefined) {
      if (!labelEl) return;
      labelEl.textContent = '';
      labelEl.classList.remove('badge-success', 'badge-neutral', 'badge-accent');
      if (score0to1 == null) return;
      const bucket = scoreBucket(Math.round(score0to1 * 100));
      labelEl.classList.add(BUCKET_BADGE_CLASS[bucket]);
      labelEl.textContent = BUCKET_LABEL[bucket];
    }

    function setScore(
      el: HTMLElement | null,
      labelEl: HTMLElement | null,
      barEl: HTMLElement | null,
      score0to1: number | null | undefined,
    ) {
      if (!el) return;
      if (score0to1 == null) {
        el.textContent = '—';
        SCORE_CLASSES_TO_RESET.forEach((c) => el.classList.remove(c));
        el.classList.add('text-text-body');
        renderScoreBucket(labelEl, null);
        if (barEl) {
          barEl.style.inlineSize = '0%';
          barEl.classList.remove('after-improved', 'after-accent');
          barEl.classList.add('after-neutral');
        }
        return;
      }
      const n = Math.round(score0to1 * 100);
      el.textContent = String(n);
      SCORE_CLASSES_TO_RESET.forEach((c) => el.classList.remove(c));
      el.classList.add(scoreColorClasses(n));
      renderScoreBucket(labelEl, score0to1);
      if (barEl) {
        const bucket = scoreBucket(n);
        barEl.style.inlineSize = `${n}%`;
        barEl.classList.toggle('after-improved', bucket === 'good');
        barEl.classList.toggle('after-accent', bucket === 'poor');
        barEl.classList.toggle('after-neutral', bucket === 'needs-work');
      }
    }

    // ---- Rendering ----
    function clearChildren(el: HTMLElement | null) {
      if (!el) return;
      while (el.firstChild) el.removeChild(el.firstChild);
    }

    function renderFilterChips(filters: readonly string[]): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'mt-3 flex flex-wrap gap-1.5';
      for (const f of filters) {
        const chip = document.createElement('button');
        chip.type = 'button';
        // Focus ring: the global :focus-visible rule (2px --color-focus-ring,
        // 2px offset) applies.
        chip.className =
          'inline-flex items-center rounded-md border border-border-strong bg-bg-secondary px-2 py-1 text-xs font-mono text-text-body hover:bg-bg-elevated transition-colors';
        chip.textContent = f;
        chip.setAttribute('data-umami-event', 'psi-result-filter-click');
        chip.setAttribute('data-umami-event-filter', f);
        // Edition-aware deep link:
        // - 1.1: always the per-filter row on the /docs/filters/ table.
        // - 2.0: the per-transform anchor on /docs/worker-configuration/ when the
        //   1.1 filter maps to a 2.0 transform; otherwise (1.1-only filter,
        //   e.g. convert_to_webp_animated) fall back to the 1.1 page; there
        //   is no 2.0 equivalent.
        // The aria-label and href are computed at click time so they always
        // reflect the live edition toggle state without re-rendering chips.
        const twoZeroAnchor: string | undefined = FILTER_TO_2_0_ANCHOR[f];
        // When the toggle is on 2.0 and we have a mapped transform, the
        // chip points at the named transform — surface that to screen
        // readers rather than the 1.1 filter name. Chips are re-rendered
        // by render() whenever setEdition() flips state, so this stays in
        // sync with the live href below.
        if (edition === '2.0' && twoZeroAnchor !== undefined) {
          const transformName = twoZeroAnchor.replace(/-/g, ' ');
          chip.setAttribute(
            'aria-label',
            `Open ${transformName} transform documentation in a new tab`,
          );
        } else {
          chip.setAttribute('aria-label', `Open ${f} filter documentation in a new tab`);
        }
        chip.addEventListener('click', () => {
          if (edition === '2.0' && twoZeroAnchor !== undefined) {
            window.open(`/docs/worker-configuration/#${twoZeroAnchor}`, '_blank', 'noopener');
          } else {
            window.open(`/docs/filters/#${f}`, '_blank', 'noopener');
          }
        });
        wrap.appendChild(chip);
      }
      return wrap;
    }

    function renderFixableItem(item: AggregatedAudit): HTMLLIElement {
      const li = document.createElement('li');
      li.className = 'rounded-xl border border-border bg-bg-elevated p-5';

      const headerRow = document.createElement('div');
      headerRow.className = 'flex items-start justify-between gap-3 flex-wrap';

      const titleWrap = document.createElement('div');
      const title = document.createElement('h4');
      title.className = 'text-base font-semibold text-text-body';
      title.textContent = item.mapping.auditTitle;
      titleWrap.appendChild(title);

      // Coverage + confidence chips + edition badge — the squared chip
      // vocabulary: success for full coverage, accent for partial, neutral
      // for confidence notes and part markers.
      const chipsRow = document.createElement('div');
      chipsRow.className = 'mt-1 flex flex-wrap items-center gap-2';
      const covChip = document.createElement('span');
      covChip.className = item.mapping.coverage === 'full' ? 'badge-success' : 'badge-accent';
      covChip.textContent = item.mapping.coverage === 'full' ? 'Fully addressed' : 'Partial fix';
      chipsRow.appendChild(covChip);

      if (item.mapping.confidence !== 'high') {
        const confChip = document.createElement('span');
        confChip.className = 'badge-neutral';
        confChip.textContent = item.mapping.confidence === 'medium' ? 'Test first' : 'Experimental';
        chipsRow.appendChild(confChip);
      }

      // Part badge — surfaces audits the *other* part doesn't cover. With
      // the toggle on the worker, a module-only audit (e.g. animated GIF →
      // WebP) gets a "Module" pill; with the toggle on the module, a
      // worker-only audit (HTML caching) gets a "Worker" pill. Both markers
      // use the same neutral styling — both parts ship in mod_pagespeed 2.1
      // and the marker says where the fix runs.
      const isTwoOnly =
        item.mapping.availableIn.includes('2.0') && !item.mapping.availableIn.includes('1.1');
      const isOneOnly =
        item.mapping.availableIn.includes('1.1') && !item.mapping.availableIn.includes('2.0');
      if (isTwoOnly && edition === '1.1') {
        const editionChip = document.createElement('span');
        editionChip.className = 'badge-neutral';
        editionChip.textContent = 'Worker';
        editionChip.title =
          'This audit is addressed by the optimizer worker. Switch the toggle above to see its configuration.';
        chipsRow.appendChild(editionChip);
      } else if (isOneOnly && edition === '2.0') {
        const editionChip = document.createElement('span');
        editionChip.className = 'badge-neutral';
        editionChip.textContent = 'Module';
        editionChip.title =
          'This audit is addressed by the module. Switch the toggle above to see its configuration.';
        chipsRow.appendChild(editionChip);
      }
      titleWrap.appendChild(chipsRow);
      headerRow.appendChild(titleWrap);

      // Savings badge (only when PSI reported one)
      if (item.overallSavingsMs > 0 || item.overallSavingsBytes > 0) {
        const savings = document.createElement('div');
        savings.className = 'text-right text-xs text-text-annotation leading-tight';
        const parts: string[] = [];
        if (item.overallSavingsMs > 0) parts.push(formatMs(item.overallSavingsMs));
        if (item.overallSavingsBytes > 0) parts.push(formatBytes(item.overallSavingsBytes));
        savings.innerHTML =
          '<span class="block text-text-annotation">est. savings</span>' +
          `<span class="block font-semibold text-text-body">${parts.join(' · ')}</span>`;
        headerRow.appendChild(savings);
      }
      li.appendChild(headerRow);

      const explanation = document.createElement('p');
      explanation.className = 'mt-3 text-sm text-text-muted leading-relaxed';
      explanation.textContent = item.mapping.explanation;
      li.appendChild(explanation);

      if (item.mapping.caveats) {
        const cav = document.createElement('p');
        cav.className = 'mt-2 text-xs text-text-annotation italic leading-relaxed';
        cav.textContent = `Caveat: ${item.mapping.caveats}`;
        li.appendChild(cav);
      }

      if (item.mapping.filters.length > 0) {
        li.appendChild(renderFilterChips(item.mapping.filters));
      }
      return li;
    }

    function renderUnfixableItem(item: AggregatedAudit): HTMLLIElement {
      const li = document.createElement('li');
      li.className = 'rounded-lg border border-border bg-bg-secondary p-4';
      const title = document.createElement('p');
      title.className = 'text-sm font-semibold text-text-body';
      title.textContent = item.mapping.auditTitle;
      li.appendChild(title);
      const why = document.createElement('p');
      why.className = 'mt-1 text-xs text-text-muted leading-relaxed';
      why.textContent = item.mapping.explanation;
      li.appendChild(why);
      return li;
    }

    // ---- Edition-aware re-render of already-fetched results ----
    // The toggle changes the recommended config, the per-audit badges, and
    // the docs CTA. Cache the last PSI response pair so flipping the toggle
    // doesn't re-hit Google PSI.
    let lastMobileResult: PsiResult | null = null;
    let lastDesktopResult: PsiResult | null = null;
    let lastTargetUrl: string | null = null;

    // Both edition toggles (the one in the results panel and the one above
    // the build-time highlights cards) use `[data-edition]` buttons grouped
    // under their respective roots — query both together so syncEditionUi
    // keeps them in lockstep regardless of which one the visitor clicked.
    function getEditionButtons(): NodeListOf<HTMLButtonElement> {
      return document.querySelectorAll<HTMLButtonElement>(
        '#psi-edition-toggle [data-edition], #psi-highlights-toggle [data-edition]',
      );
    }

    function syncEditionUi() {
      // Toggle the aria-pressed state on every edition button on the page.
      const buttons = getEditionButtons();
      for (const btn of buttons) {
        btn.setAttribute('aria-pressed', btn.dataset.edition === edition ? 'true' : 'false');
      }
      if (editionBlurbEl) editionBlurbEl.textContent = EDITION_BLURB[edition];
      if (configDescEl) configDescEl.textContent = CONFIG_DESC[edition];
      if (docsCtaEl) {
        docsCtaEl.href = DOCS_HREF[edition].href;
        docsCtaEl.textContent = DOCS_HREF[edition].label;
      }
      // "What gets fixed" highlight cards — hide cards that the chosen
      // edition doesn't cover at all. (Cards that are available in both
      // stay visible.)
      if (highlightsListEl) {
        const cards = highlightsListEl.querySelectorAll<HTMLLIElement>('[data-available-in]');
        for (const card of cards) {
          const editions = (card.dataset.availableIn ?? '').split(',');
          card.classList.toggle('hidden', !editions.includes(edition));
        }
      }
    }

    function setEdition(next: Edition) {
      if (edition === next) return;
      edition = next;
      syncEditionUi();
      // Re-render whatever the last PSI run produced so the recommended
      // config + per-audit badges reflect the new edition. No network call.
      if (lastTargetUrl && lastMobileResult && lastDesktopResult) {
        render(lastTargetUrl, lastMobileResult, lastDesktopResult, /*scroll*/ false);
      }
    }

    // Wire the toggle buttons up at script start so they work even before
    // the first analysis. The toggle still defaults to the optimizer
    // worker, which does the heavy optimization.
    {
      for (const btn of getEditionButtons()) {
        btn.addEventListener('click', () => {
          const next = btn.dataset.edition as Edition | undefined;
          if (next === '1.1' || next === '2.0') setEdition(next);
        });
      }
      // Initial paint so the blurb/desc/CTAs/highlight cards have correct
      // content on first load (before any PSI run).
      syncEditionUi();
    }

    // ---- Main render ----
    function render(
      targetUrl: string,
      mobile: PsiResult,
      desktop: PsiResult,
      scroll: boolean = true,
    ) {
      // Cache for edition-toggle re-render.
      lastTargetUrl = targetUrl;
      lastMobileResult = mobile;
      lastDesktopResult = desktop;
      const mobileScore = mobile.lighthouseResult?.categories?.performance?.score ?? null;
      const desktopScore = desktop.lighthouseResult?.categories?.performance?.score ?? null;
      setScore(scoreMobileEl, scoreMobileLabelEl, scoreMobileBarEl, mobileScore);
      setScore(scoreDesktopEl, scoreDesktopLabelEl, scoreDesktopBarEl, desktopScore);

      if (headlineUrlEl) headlineUrlEl.textContent = targetUrl;

      // mappingCache is set by the time render() runs: runAnalysis awaits
      // loadMapping() first, and the edition toggle only re-renders after a
      // completed run.
      const mappingTable = getMapping();
      const items = mappingTable ? aggregate(mobile, desktop, mappingTable) : [];
      const fixable = items.filter((i) => i.mapping.coverage !== 'none');
      const unfixable = items.filter((i) => i.mapping.coverage === 'none');

      // Denominator: every PSI audit flagged on either strategy, including
      // ones our mapping table doesn't (yet) know about. This keeps the
      // headline honest as Lighthouse adds new performance audits.
      const flaggedAuditIds = collectFlaggedAuditIds(mobile, desktop);
      const totalFlagged = flaggedAuditIds.size;
      const addressed = fixable.length;

      const headline = coverageSentence(totalFlagged, addressed, items.length);
      if (headlineTextEl) headlineTextEl.textContent = headline;
      // Tight one-line summary for screen readers — scoped narrowly so AT
      // doesn't announce the entire results subtree.
      if (statusEl) statusEl.textContent = `Analysis complete. ${headline}`;

      // Cumulative savings — only count audits MPS actually addresses.
      const totalMs = fixable.reduce((s, i) => s + i.overallSavingsMs, 0);
      const totalBytes = fixable.reduce((s, i) => s + i.overallSavingsBytes, 0);
      if (headlineSavingsEl) headlineSavingsEl.textContent = savingsSentence(totalMs, totalBytes);

      // Fixable list
      clearChildren(fixableListEl);
      if (fixable.length > 0) {
        for (const item of fixable) {
          fixableListEl?.appendChild(renderFixableItem(item));
        }
        show(fixableEl);
      } else {
        hide(fixableEl);
      }

      // Unfixable list
      clearChildren(unfixableListEl);
      if (unfixable.length > 0) {
        for (const item of unfixable) {
          unfixableListEl?.appendChild(renderUnfixableItem(item));
        }
        show(unfixableEl);
      } else {
        hide(unfixableEl);
      }

      // Config snippet
      const snippet = buildConfigSnippet(fixable, edition);
      if (snippet && configSnippet) {
        configSnippet.textContent = snippet;
        show(configCard);
      } else {
        hide(configCard);
      }

      // Empty / all-clean branching:
      //   totalFlagged === 0  → "Your site is already fast" hero (distinctive)
      //   addressed === 0 && unfixable.length === 0 → generic empty-state copy
      //   anything else       → neither (the fixable/unfixable lists carry it)
      if (totalFlagged === 0) {
        show(allCleanEl);
        hide(emptyEl);
      } else if (fixable.length === 0 && unfixable.length === 0) {
        hide(allCleanEl);
        show(emptyEl);
      } else {
        hide(allCleanEl);
        hide(emptyEl);
      }

      show(ctasEl);
      show(topCtaEl);
      show(editionToggleEl);
      hide(errorBox);
      show(resultsEl);

      // Arm the report-download card with this run's URL, headline scores and
      // the failing audits the result shows (fixable and unfixable alike).
      reportContext = {
        url: targetUrl,
        mobile: toPercent(mobile?.lighthouseResult?.categories?.performance?.score),
        desktop: toPercent(desktop?.lighthouseResult?.categories?.performance?.score),
        totalFlagged,
        audits: items.map((i) => ({
          title: i.mapping.auditTitle,
          coverage: i.mapping.coverage,
        })),
      };
      show(reportEl);

      if (!scroll) return;

      // Smooth-scroll to the results section so mobile users see the outcome
      // immediately. Defer one rAF so the layout settles after `hidden` is
      // removed — otherwise scrollIntoView measures the section as 0px tall.
      // Honour prefers-reduced-motion (instant scroll, no easing).
      const prefersReducedMotion =
        typeof window.matchMedia === 'function' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      requestAnimationFrame(() => {
        resultsEl?.scrollIntoView({
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
          block: 'start',
        });
      });
    }

    // ---- Error rendering ----
    function renderError(title: string, body: string) {
      if (errorTitle) errorTitle.textContent = title;
      if (errorBody) errorBody.textContent = body;
      show(resultsEl);
      show(errorBox);
      hide(fixableEl);
      hide(unfixableEl);
      hide(configCard);
      hide(emptyEl);
      hide(ctasEl);
      hide(topCtaEl);
      hide(editionToggleEl);
      hide(reportEl);
      reportContext = null;
      // Headline area: clear scores; leave the URL visible if we have one.
      if (headlineTextEl) headlineTextEl.textContent = 'We couldn’t complete the analysis.';
      if (headlineSavingsEl) headlineSavingsEl.textContent = '';
      setScore(scoreMobileEl, scoreMobileLabelEl, scoreMobileBarEl, null);
      setScore(scoreDesktopEl, scoreDesktopLabelEl, scoreDesktopBarEl, null);
      hide(allCleanEl);
      if (statusEl && title) statusEl.textContent = title;
    }

    // ---- Submit handler ----
    let lastUrl: string | null = null;

    async function runAnalysis(targetUrl: string) {
      setLoading(true);
      hide(errorBox);
      lastUrl = targetUrl;
      // Every analysis run flows through here — button click, Enter-key submit,
      // ?url= deep-link auto-run, and retry. Fire the submit event programmatically
      // so keyboard/auto-run paths (which never "click" the button) are counted.
      // The button no longer carries `data-umami-event` to avoid double-counting.
      try {
        (window as any).umami?.track('psi-analyze-submit');
      } catch {
        /* analytics must never break the run */
      }
      try {
        // A failed chunk fetch is cached by the browser, so once the mapping
        // table is known to be unloadable a retry can never succeed — stop
        // before firing the PSI requests and ask for a page reload instead.
        if (isMappingFailed()) {
          throw reloadError();
        }
        // We fire both fetches in parallel for speed but report progress
        // sequentially so the user sees a deterministic two-step indicator
        // instead of a vague "loading…". Whichever returns first flips the
        // label to step 2. The mapping table loads alongside — it is split
        // out of the initial bundle and only fetched on first use.
        const mappingP = loadMapping();
        // Awaited below; attaching a no-op handler now keeps a rejection
        // that lands while the PSI fetches are still in flight from being
        // reported as an unhandled rejection.
        mappingP.catch(() => {});
        let stepTwoShown = false;
        const advance = () => {
          if (!stepTwoShown) {
            stepTwoShown = true;
            setLoadingStep('Step 2 of 2: requesting desktop profile…');
          }
        };
        const mobileP = fetchPsi(targetUrl, 'mobile').then((r) => {
          advance();
          return r;
        });
        const desktopP = fetchPsi(targetUrl, 'desktop').then((r) => {
          advance();
          return r;
        });
        // allSettled (not all) so a one-sided PSI failure (rate-limit/5xx/timeout
        // on a single strategy) still yields telemetry instead of dropping the
        // whole run.
        const [mobileRes, desktopRes] = await Promise.allSettled([mobileP, desktopP]);
        const mobile = mobileRes.status === 'fulfilled' ? mobileRes.value : null;
        const desktop = desktopRes.status === 'fulfilled' ? desktopRes.value : null;

        // Durable capture of which page was analyzed + its scores. Fired BEFORE
        // render() so a render() exception can't drop the telemetry, and whenever
        // at least one strategy returned (partial runs were previously lost to the
        // all-or-nothing Promise.all). `hostname` is recorded alongside the full
        // url for clean per-host aggregation. Operator traffic is excluded
        // server-side, so this stays clean automatically.
        const toScore = (s: number | null | undefined): number | null =>
          typeof s === 'number' ? Math.round(s * 100) : null;
        if (mobile || desktop) {
          let hostname = '';
          try {
            hostname = new URL(targetUrl).hostname;
          } catch {
            /* targetUrl is pre-validated */
          }
          try {
            (window as any).umami?.track('psi-analyze-result', {
              url: targetUrl,
              hostname,
              mobile_score: toScore(mobile?.lighthouseResult?.categories?.performance?.score),
              desktop_score: toScore(desktop?.lighthouseResult?.categories?.performance?.score),
            });
          } catch {
            /* analytics must never break the run */
          }
        }

        // The side-by-side comparison needs both profiles; if either failed,
        // surface the error (same UX as before) — telemetry above already
        // captured the run.
        if (!mobile || !desktop) {
          if (mobileRes.status === 'rejected') throw mobileRes.reason;
          if (desktopRes.status === 'rejected') throw desktopRes.reason;
          throw new Error('PageSpeed Insights returned no usable result for this URL.');
        }
        // Surfaced before render() so a failed chunk load takes the error
        // path instead of rendering an empty report. The error is a
        // reload-only condition: retrying reuses the browser's cached
        // failure, so the run is blocked above until the page is reloaded.
        try {
          await mappingP;
        } catch {
          markMappingFailed();
          throw reloadError();
        }
        render(targetUrl, mobile, desktop);
      } catch (err) {
        const { title, body } = classifyError(err);
        renderError(title, body);
      } finally {
        setLoading(false);
      }
    }

    form?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      if (!urlInput) return;
      const result = validateUrl(urlInput.value);
      if (!result.ok) {
        setFormError(result.reason);
        urlInput.focus();
        return;
      }
      setFormError(null);
      void runAnalysis(result.url);
    });

    errorRetryBtn?.addEventListener('click', () => {
      if (lastUrl) void runAnalysis(lastUrl);
    });

    // Copy-to-clipboard for the config snippet.
    configCopyBtn?.addEventListener('click', () => {
      const text = configSnippet?.textContent ?? '';
      if (!text) return;
      if (!navigator.clipboard?.writeText) return;
      void navigator.clipboard.writeText(text).then(() => {
        if (configCopyLabel) {
          configCopyLabel.textContent = 'Copied';
          setTimeout(() => {
            if (configCopyLabel) configCopyLabel.textContent = 'Copy';
          }, 1500);
        }
      });
    });

    // Report download: builds a small Markdown file from the current result and
    // saves it through a Blob URL. Entirely client-side — no network call, so
    // the copy promises nothing a human would have to send.
    reportDownloadBtn?.addEventListener('click', () => {
      const ctx = reportContext;
      if (!ctx) return;
      try {
        (window as any).umami?.track('analyze_report_download');
      } catch {
        /* analytics must never break the download */
      }
      const scoreText = (n: number | null) => (n === null ? 'n/a' : `${n}/100`);
      // Match the result page's own chips ("Fully addressed" / "Partial fix"):
      // the downloaded file must not claim more than the page does.
      const coverageText = (c: Coverage) =>
        c === 'full'
          ? 'fully addressed by mod_pagespeed'
          : c === 'partial'
            ? 'partly fixable by mod_pagespeed'
            : 'not addressed by mod_pagespeed';
      const lines = [
        '# PageSpeed report',
        '',
        `Analyzed: ${ctx.url}`,
        `When: ${new Date().toISOString()}`,
        `Scores: mobile ${scoreText(ctx.mobile)}, desktop ${scoreText(ctx.desktop)}`,
        '',
        '## Failing audits',
        '',
        ...(ctx.audits.length
          ? ctx.audits.map((a) => `- ${a.title} — ${coverageText(a.coverage)}`)
          : [ctx.totalFlagged > 0 ? '- No mapped audits flagged' : '- None flagged']),
        '',
      ];
      let host = 'site';
      try {
        host = new URL(ctx.url).hostname.replace(/[^a-z0-9.-]+/gi, '-');
      } catch {
        /* ctx.url is pre-validated */
      }
      const blob = new Blob([lines.join('\n')], { type: 'text/markdown' });
      const objectUrl = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = objectUrl;
      link.download = `pagespeed-report-${host}.md`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      // Defer revocation: revoking synchronously right after click() can
      // cancel the download in Safari.
      setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
      if (reportMsgEl) reportMsgEl.textContent = `Saved as ${link.download}.`;
    });

    // Allow ?url= deep links (e.g. shared from a blog post).
    (function autoRunFromQueryParam() {
      // The shared scan interface runs its own deep-link request; running
      // this one too would call PSI twice.
      if (document.documentElement.dataset.scanUi === 'v2') return;
      const params = new URLSearchParams(window.location.search);
      const presetUrl = params.get('url');
      if (!presetUrl || !urlInput) return;
      urlInput.value = presetUrl;
      const result = validateUrl(presetUrl);
      if (result.ok) void runAnalysis(result.url);
    })();
  </script>
  <style>
    /* Score readouts in the Readout idiom (display numeral over a tick-scale
       gauge on a recessed plate), label above the value: the page's text
       order is fixed, so the component's value-first row does not apply here.
       Mirrors the component's gauge CSS, plus an accent bar for the poor
       bucket. */
    .readout-value {
      font-size: 1.375rem;
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }
    @media (min-width: 640px) {
      .readout-value {
        font-size: 1.625rem;
      }
    }
    .readout-gauge {
      position: relative;
      height: 8px;
      margin-top: 0.625rem;
      border-bottom: 1px solid var(--color-border-strong);
    }
    .readout-gauge .track {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(90deg, var(--color-tick) 0 1px, transparent 1px 10%);
    }
    .readout-gauge .after {
      position: absolute;
      bottom: 0;
      left: 0;
      height: 4px;
      border-radius: 1px;
    }
    .readout-gauge .after-improved {
      background-color: var(--color-success);
    }
    .readout-gauge .after-neutral {
      background-color: var(--color-interactive);
    }
    .readout-gauge .after-accent {
      background-color: var(--color-accent);
    }
  </style>
</BaseLayout>
