---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PSI_MPS_MAPPING } from '../data/psi-mps-mapping';
import { FREE_TO_RUN_LINE } from '../data/product-facts.mjs';

const title = 'Free PageSpeed Insights Test — See What ModPageSpeed Fixes';
const description =
  'Free PageSpeed Insights test, no signup. Every failing Lighthouse audit mapped to the ModPageSpeed filter that fixes it — LCP, CLS, render-blocking, images.';

// "What gets fixed" — highest-impact audits, built at build-time from the
// same mapping table the JS analyzer uses. Render order: image/asset wins
// first (largest user-visible impact), then markup wins, then the
// 2.0-specific HTML-caching card. The card visibility is toggled
// client-side based on which edition the visitor selects.
const FIXED_HIGHLIGHT_IDS = [
  'image-delivery-insight',
  'render-blocking-insight',
  'cache-insight',
  'unminified-css',
  'unminified-javascript',
  'unsized-images',
  'modern-image-formats',
  'uses-responsive-images',
  'offscreen-images',
  'uses-optimized-images',
  // 2.0-only: HTML response caching in Cyclone — the load-bearing
  // difference for slow-origin sites.
  'document-latency-insight',
];
const fixedHighlights = FIXED_HIGHLIGHT_IDS.map((id) =>
  PSI_MPS_MAPPING.find(
    (m) => m.auditId === id && (m.coverage === 'full' || m.coverage === 'partial'),
  ),
).filter((m): m is NonNullable<typeof m> => Boolean(m));

// FAQ entries — visible HTML and JSON-LD must match (Google penalizes drift).
// Targeting "pagespeed test", "core web vitals", "lcp", "cls",
// "lighthouse score", and "pagespeed insights alternative" queries.
const faqEntries: { q: string; a: string }[] = [
  {
    q: 'What is a good PageSpeed Insights score?',
    a: 'Google grades PageSpeed Insights scores in three buckets: 90–100 is good (green), 50–89 needs improvement (orange), and 0–49 is poor (red). Aim for 90+ on mobile; desktop scores are easier and less correlated with real user experience.',
  },
  {
    q: 'What are Core Web Vitals?',
    a: 'Core Web Vitals are three field metrics Google uses for ranking signals: Largest Contentful Paint (LCP) for loading, Interaction to Next Paint (INP) for responsiveness, and Cumulative Layout Shift (CLS) for visual stability. A page passes when 75% of real visits hit the "good" threshold on each metric.',
  },
  {
    q: 'How do I improve Largest Contentful Paint (LCP)?',
    a: 'LCP is usually a hero image or above-the-fold text block. The two highest-impact moves are shrinking the LCP image (WebP or AVIF, resized to its rendered size) and removing render-blocking CSS so the browser can paint sooner. ModPageSpeed does both without markup or build changes (transcoding, resizing, inlining critical CSS). Origin TTFB on the first request and JavaScript-injected backgrounds stay out of reach, though 2.0 can mask TTFB on repeat visits by caching HTML in shared memory when the origin allows it.',
  },
  {
    q: 'How do I fix Cumulative Layout Shift (CLS)?',
    a: 'Most CLS comes from images without width/height attributes: the browser cannot reserve space, so content jumps when the image arrives. ModPageSpeed measures each image and writes the dimensions back into the markup. CLS caused by late-loading fonts, injected ads, or dynamic banners needs application-level fixes.',
  },
  {
    q: 'Is PageSpeed Insights free?',
    a: 'Yes. PageSpeed Insights is a free Google tool that runs Lighthouse against any public URL and combines it with field data from the Chrome User Experience Report. This page calls the same PSI v5 API and adds a mapping layer so you can see which findings ModPageSpeed will fix on your server.',
  },
  {
    q: "What's the difference between Lighthouse and PageSpeed Insights?",
    a: 'Lighthouse is the open-source auditing engine. PageSpeed Insights is the public web app that runs Lighthouse in a cloud environment and combines it with Chrome User Experience Report (CrUX) field data. Same audits underneath; PSI adds field metrics and a public API.',
  },
  {
    q: 'How is ModPageSpeed different from PageSpeed Insights?',
    a: 'PageSpeed Insights diagnoses. ModPageSpeed fixes. Insights tells you "serve images in next-gen formats" and "eliminate render-blocking resources"; ModPageSpeed is the nginx/Apache/IIS module that does the transcoding, inlining, and cache-extension on every request. They are designed to work together.',
  },
  {
    q: 'Can ModPageSpeed fix every PageSpeed Insights issue?',
    a: 'No. ModPageSpeed handles byte-level work: image transcoding, CSS/JS minification, critical-CSS inlining, cache extension, dimension inference. It cannot reduce DOM size, tree-shake legacy JavaScript bundles, or rewrite third-party scripts. Origin TTFB on the first request stays out of reach too. 2.0 caches HTML in shared memory when the origin allows it, so repeat visits skip the origin; the first hit always reaches it. The analyzer above labels each audit accordingly.',
  },
  {
    q: 'Is this a PageSpeed Insights API alternative?',
    a: 'It is a wrapper, not a replacement. We call the official PageSpeed Insights v5 API server-side, cache results per (URL, strategy) for an hour, and overlay a mapping from Lighthouse audit IDs to the ModPageSpeed filters that address them. No account, no upload.',
  },
  {
    q: 'How often should I run a website speed test?',
    a: 'After anything that changes the page: a deploy, a new CMS theme, a marketing campaign that injects scripts, a CDN swap. Lab scores fluctuate run-to-run by a few points; treat anything inside a 10-point band as noise. For ongoing monitoring, the Chrome User Experience Report (CrUX) gives 28-day rolling field data.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ModPageSpeed Analyze',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any (web browser)',
    url: 'https://modpagespeed.com/analyze/',
    description,
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    publisher: {
      '@type': 'Organization',
      name: 'We-Amp B.V.',
      url: 'https://www.we-amp.com/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqEntries.map((entry) => ({
      '@type': 'Question',
      name: entry.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: entry.a,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- ============================================================ -->
  <!-- Hero + URL input                                              -->
  <!-- ============================================================ -->
  <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-20 text-center">
    <p class="eyebrow">Free · no account · no upload</p>
    <h1 class="h1-hero mt-3 text-text-body">
      PageSpeed Insights, with the fix attached.
    </h1>
    <p class="lede mt-5 max-w-2xl mx-auto">
      Run Google's official PageSpeed Insights against any URL. We score the page on mobile and
      desktop, then map every failing Lighthouse audit to the ModPageSpeed filter that fixes it on
      your server. Audits no optimizer can touch get labeled.
    </p>
    <p class="mt-3 text-xs text-text-annotation max-w-2xl mx-auto">
      This tool calls Google's public PageSpeed Insights API. ModPageSpeed is built by We-Amp B.V.
      and is not affiliated with or endorsed by Google. PageSpeed Insights is a trademark of Google
      LLC.
    </p>

    <form
      id="psi-form"
      class="mt-10 mx-auto max-w-2xl text-left"
      novalidate
      aria-describedby="psi-form-error"
    >
      <label for="psi-url" class="block text-sm font-medium text-text-body">
        Page URL
      </label>
      <div class="mt-2 flex flex-col sm:flex-row gap-3">
        <input
          id="psi-url"
          name="url"
          type="url"
          inputmode="url"
          autocomplete="url"
          required
          spellcheck="false"
          autocapitalize="off"
          placeholder="https://example.com"
          aria-invalid="false"
          aria-describedby="psi-form-error"
          class="flex-1 rounded-md border border-control-border px-4 py-3 text-text-body bg-bg-elevated shadow-sm focus:border-interactive focus:ring-2 focus:ring-interactive aria-[invalid=true]:border-amber-600 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-amber-600 dark:aria-[invalid=true]:border-amber-500 dark:aria-[invalid=true]:ring-amber-500 sm:text-sm"
        />
        <button id="psi-submit" type="submit" class="btn-primary whitespace-nowrap">
          <span id="psi-submit-label">Analyze</span>
          <svg
            id="psi-submit-spinner"
            class="hidden h-4 w-4 animate-spin"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="3"
              stroke-opacity="0.25"></circle>
            <path
              d="M22 12a10 10 0 0 0-10-10"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <p
        id="psi-form-error"
        role="alert"
        class="mt-2 hidden text-sm text-amber-700 dark:text-amber-400"
      >
      </p>
      <p class="mt-3 text-xs text-text-annotation">
        The URL you submit is sent to Google's PageSpeed Insights API (in the US) through a small
        proxy on this site that holds the API key and caches results. Your IP address is logged and
        rate-limited to 30 requests per minute per visitor to prevent abuse. See our
        <a
          href="/privacy/"
          class="text-interactive hover:text-interactive-hover underline"
          >Privacy policy</a
        >.
      </p>
    </form>
  </section>

  <!-- ============================================================ -->
  <!-- Results panel — hidden until first analysis                   -->
  <!-- ============================================================ -->
  <!--
    Dedicated, off-screen status line for screen readers. Lives OUTSIDE the
    results section so it stays visible to assistive tech even while the
    results panel is `display:none` during loading. Scoped narrowly so AT
    announces a one-sentence summary instead of the entire results subtree.
  -->
  <p id="psi-status" role="status" aria-live="polite" class="sr-only"></p>

  <!-- ============================================================ -->
  <!-- Loading skeleton — shown during PSI calls                     -->
  <!-- ============================================================ -->
  <section
    id="psi-loading"
    class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-16 hidden"
    aria-hidden="true"
  >
    <div
      class="rounded-2xl border border-border bg-bg-elevated p-6 sm:p-8 shadow-sm"
    >
      <div class="flex items-center gap-3">
        <svg
          class="h-5 w-5 animate-spin text-interactive"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="3"
            stroke-opacity="0.25"></circle>
          <path
            d="M22 12a10 10 0 0 0-10-10"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
        <p class="text-sm font-medium text-text-body">
          Running PageSpeed Insights for mobile and desktop. Usually 10–20 seconds.
        </p>
      </div>
      <p
        id="psi-loading-step"
        class="mt-2 ml-8 text-xs text-text-annotation tabular-nums"
      >
        Step 1 of 2: requesting mobile profile…
      </p>

      <!-- Two skeleton score chips -->
      <div class="mt-6 grid grid-cols-2 gap-4 max-w-md">
        <div class="rounded-lg bg-bg-elevated p-4">
          <div class="h-3 w-12 rounded bg-bg-secondary animate-pulse"></div>
          <div class="mt-2 h-8 w-16 rounded bg-bg-secondary animate-pulse"></div>
          <div class="mt-2 h-3 w-20 rounded bg-bg-secondary animate-pulse"></div>
        </div>
        <div class="rounded-lg bg-bg-elevated p-4">
          <div class="h-3 w-12 rounded bg-bg-secondary animate-pulse"></div>
          <div class="mt-2 h-8 w-16 rounded bg-bg-secondary animate-pulse"></div>
          <div class="mt-2 h-3 w-20 rounded bg-bg-secondary animate-pulse"></div>
        </div>
      </div>
    </div>

    <!-- Skeleton fixable-list items -->
    <div class="mt-8 space-y-4">
      <div
        class="rounded-xl border border-border bg-bg-elevated p-5"
      >
        <div class="h-4 w-2/3 rounded bg-bg-secondary animate-pulse"></div>
        <div class="mt-3 h-3 w-full rounded bg-bg-elevated animate-pulse"></div>
        <div class="mt-2 h-3 w-5/6 rounded bg-bg-elevated animate-pulse"></div>
      </div>
      <div
        class="rounded-xl border border-border bg-bg-elevated p-5"
      >
        <div class="h-4 w-1/2 rounded bg-bg-secondary animate-pulse"></div>
        <div class="mt-3 h-3 w-full rounded bg-bg-elevated animate-pulse"></div>
        <div class="mt-2 h-3 w-4/6 rounded bg-bg-elevated animate-pulse"></div>
      </div>
    </div>
  </section>

  <section id="psi-results" class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-16 hidden">
    <!-- Headline coverage banner -->
    <div
      id="psi-headline"
      class="rounded-2xl border border-border bg-bg-elevated p-6 sm:p-8 shadow-sm"
    >
      <p class="eyebrow" id="psi-headline-url">—</p>
      <h2
        id="psi-headline-text"
        class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-text-body"
      >
        —
      </h2>
      <p id="psi-headline-savings" class="mt-3 text-sm text-text-muted"></p>

      <!-- Mobile + Desktop score chips. Numeric + icon + text label so the
           bucket is legible without colour vision (WCAG 1.4.1). -->
      <div class="mt-6 grid grid-cols-2 gap-4 max-w-md">
        <div class="rounded-lg bg-bg-secondary p-4">
          <p class="text-xs uppercase tracking-wide text-text-annotation">Mobile</p>
          <p
            id="psi-score-mobile"
            class="display-num mt-1 text-3xl font-bold text-text-body"
          >
            —
          </p>
          <p
            id="psi-score-mobile-label"
            class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-text-annotation"
          >
          </p>
        </div>
        <div class="rounded-lg bg-bg-secondary p-4">
          <p class="text-xs uppercase tracking-wide text-text-annotation">Desktop</p>
          <p
            id="psi-score-desktop"
            class="display-num mt-1 text-3xl font-bold text-text-body"
          >
            —
          </p>
          <p
            id="psi-score-desktop-label"
            class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-text-annotation"
          >
          </p>
        </div>
      </div>
    </div>

    <!-- Edition toggle — applies to the config snippet, fixable list, and
         "what gets fixed" cards below. Default to 2.0 (the reverse-proxy /
         middleware line). The chosen edition is held in JS state only;
         reloading the page resets to 2.0. Surfaced once the first analysis
         completes — before
         that, the build-time "what gets fixed" cards already default to the
         2.0 view via syncEditionUi() on script load. -->
    <div
      id="psi-edition-toggle"
      class="mt-8 rounded-2xl border border-border bg-bg-elevated p-5 sm:p-6 hidden"
    >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h3 class="text-sm font-semibold text-text-body">
            ModPageSpeed edition
          </h3>
          <p id="psi-edition-blurb" class="mt-1 text-xs text-text-muted">
            <!-- Populated at runtime from EDITION_BLURB. -->
          </p>
        </div>
        <div
          class="inline-flex shrink-0 self-start sm:self-auto gap-1 rounded-lg bg-bg-elevated p-1"
          role="group"
          aria-label="ModPageSpeed edition"
        >
          <button
            type="button"
            data-edition="2.0"
            aria-pressed="true"
            class="product-tab rounded-md px-3 py-1.5 text-xs font-medium transition-colors"
            data-umami-event="psi-edition-toggle"
            data-umami-event-edition="2.0"
          >
            ModPageSpeed 2.0
          </button>
          <button
            type="button"
            data-edition="1.1"
            aria-pressed="false"
            class="product-tab rounded-md px-3 py-1.5 text-xs font-medium transition-colors"
            data-umami-event="psi-edition-toggle"
            data-umami-event-edition="1.1"
          >
            mod_pagespeed 1.15
          </button>
        </div>
      </div>
    </div>

    <!-- Recommended pagespeed config — lead magnet -->
    <div
      id="psi-config-card"
      class="mt-8 rounded-2xl border border-interactive/40 bg-interactive/10 p-6 sm:p-8 hidden"
    >
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h3 class="text-lg font-semibold text-text-body">
            Drop-in pagespeed configuration
          </h3>
          <p id="psi-config-desc" class="mt-1 text-sm text-text-muted">
            <!-- Populated at runtime — varies by edition. -->
          </p>
        </div>
        <button
          id="psi-config-copy"
          type="button"
          class="btn-secondary text-xs"
          data-umami-event="psi-result-config-copy"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="psi-config-copy-label">Copy</span>
        </button>
      </div>
      <pre
        class="mt-4 overflow-x-auto rounded-md bg-stone-900 dark:bg-black p-4 text-xs sm:text-sm"><code id="psi-config-snippet" class="text-stone-100">pagespeed on;</code></pre>
    </div>

    <!-- Result-moment CTA: surfaced right after the config (the lead magnet
         visitors copy) so the next step is in view without scrolling past the
         audit lists to the CTA band at the bottom. Distinct event from the
         bottom band so the placement lift is measurable. -->
    <div id="psi-top-cta" class="mt-6 text-center hidden">
      <a href="/download/" class="btn-primary" data-umami-event="psi-result-install-cta-top">
        Download &amp; run &rarr;
      </a>
    </div>

    <!-- Fixable audits -->
    <div id="psi-fixable" class="mt-8 hidden">
      <h3 class="h2-section text-xl sm:text-2xl text-text-body">
        ModPageSpeed will fix this
      </h3>
      <p class="mt-1 text-sm text-text-muted">
        Ordered by potential savings on this page.
      </p>
      <ul id="psi-fixable-list" class="mt-4 space-y-4"></ul>
    </div>

    <!-- Unfixable audits -->
    <div id="psi-unfixable" class="mt-12 hidden">
      <h3 class="h2-section text-xl sm:text-2xl text-text-body">
        We won't pretend we can fix this
      </h3>
      <p class="mt-1 text-sm text-text-muted">
        These audits sit at the application or infrastructure layer. ModPageSpeed runs byte-level
        rewrites. Reshaping a bundler, an origin, or event handlers is engineering work no optimizer
        can do for you.
      </p>
      <ul id="psi-unfixable-list" class="mt-4 space-y-3"></ul>
    </div>

    <!-- All-clean hero — PSI flagged nothing. Shown ONLY when totalFlagged === 0. -->
    <div
      id="psi-all-clean"
      class="mt-8 rounded-2xl border-2 border-interactive/40 bg-bg-elevated p-6 sm:p-8 hidden"
    >
      <div class="flex items-start gap-4">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-interactive text-on-accent shadow-md"
          aria-hidden="true"
        >
          <svg
            class="h-7 w-7"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-xl font-bold text-text-body">
            Nothing for us to do here.
          </h3>
          <p class="mt-2 text-sm text-text-body leading-relaxed">
            PSI flagged no failing performance audits on this page. Your delivery pipeline is
            already doing the work ModPageSpeed would do.
          </p>
          <p class="mt-2 text-sm text-text-muted leading-relaxed">
            ModPageSpeed keeps assets minified, images transcoded, and caches warm as the site
            evolves — whether it runs as a reverse proxy in front of your origin, as ASP.NET Core
            middleware, or as the in-server module for Apache, nginx, IIS, or Envoy. The next
            deploy won't quietly undo this.
          </p>
        </div>
      </div>
    </div>

    <!-- Empty / mixed-empty state (only application-level audits surfaced). -->
    <div
      id="psi-empty"
      class="mt-8 rounded-2xl border border-border bg-bg-elevated p-6 sm:p-8 hidden"
    >
      <h3 class="text-lg font-semibold text-text-body">
        No fixable audits surfaced.
      </h3>
      <p class="mt-2 text-sm text-text-muted">
        Either your page is already in good shape, or PSI flagged only application-level concerns
        that need code changes. ModPageSpeed isn't your bottleneck here. If you want it as a safety
        net for image transcoding, caching, and minification on future pages, install it and run it
        — it optimizes immediately, free to run.
      </p>
    </div>

    <!-- CTAs — second button text + link updates with the edition toggle. -->
    <div id="psi-ctas" class="mt-10 flex flex-col items-center gap-3 hidden">
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/download/" class="btn-primary" data-umami-event="psi-result-install-cta">
          Download &amp; run &rarr;
        </a>
        <a href="/buy/" class="btn-secondary" data-umami-event="psi-result-trial-cta">
          Support plans &rarr;
        </a>
        <a
          id="psi-docs-cta"
          href="/docs/configuration/"
          class="btn-secondary"
          data-umami-event="psi-result-docs-cta"
        >
          Read the configuration docs &rarr;
        </a>
      </div>
      <p class="text-xs text-text-annotation">
        {FREE_TO_RUN_LINE}
      </p>
    </div>

    <!-- Error state -->
    <div
      id="psi-error"
      class="mt-8 rounded-2xl border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/40 p-6 hidden"
      role="alert"
    >
      <h3 class="text-base font-semibold text-amber-900 dark:text-amber-100">
        <span id="psi-error-title">PSI returned an error.</span>
      </h3>
      <p id="psi-error-body" class="mt-2 text-sm text-amber-900/90 dark:text-amber-100/90"></p>
      <button id="psi-error-retry" type="button" class="mt-4 btn-secondary text-xs">
        Try again
      </button>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- How it works — always visible, indexable                      -->
  <!-- ============================================================ -->
  <section
    class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 border-t border-border"
  >
    <h2 class="h2-section text-center text-text-body">
      From PageSpeed report to nginx config in three steps
    </h2>
    <p class="lede mt-3 text-center max-w-2xl mx-auto">
      No account, no upload. Paste a URL, get the fixes.
    </p>

    <ol class="mt-10 grid gap-6 sm:grid-cols-3">
      <li
        class="rounded-xl border border-border bg-bg-elevated p-6"
      >
        <div
          class="flex h-8 w-8 items-center justify-center rounded-full bg-interactive text-on-accent text-sm font-semibold"
        >
          1
        </div>
        <h3 class="mt-4 text-base font-semibold text-text-body">
          Score your page on mobile and desktop
        </h3>
        <p class="mt-2 text-sm text-text-muted">
          We call Google's official PageSpeed Insights v5 API for both form factors. Same engine
          Search Console uses, same Lighthouse audits, same Core Web Vitals. Shown inline instead of
          in a separate tab.
        </p>
      </li>
      <li
        class="rounded-xl border border-border bg-bg-elevated p-6"
      >
        <div
          class="flex h-8 w-8 items-center justify-center rounded-full bg-interactive text-on-accent text-sm font-semibold"
        >
          2
        </div>
        <h3 class="mt-4 text-base font-semibold text-text-body">
          See which audits ModPageSpeed will fix
