---
/**
 * Icon.astro — the single source of truth for line icons on modpagespeed.com.
 *
 * One vocabulary: Lucide (https://lucide.dev, ISC). The CALIBER identity already
 * standardizes its callout glyphs on Lucide (see global.css), so every in-content
 * icon uses the same instrument-grade stroke language: 2px stroke, round caps and
 * joins, 24x24 grid, `fill="none"`. Brand §4.7 + . Heroicons/Feather are
 * being retired in favor of this set — do NOT inline raw SVG paths in pages any
 * more; add the glyph here and reference it by name so the set can never drift.
 *
 * Color is driven by `currentColor`: pass a text color via `class` (e.g.
 * `text-interactive`, `text-text-muted`). Per the ONE-accent discipline, default
 * decorative icons to muted/body and reserve cyan for genuinely interactive /
 * live / optimized signals. Never bake a hex into a glyph here.
 *
 * Usage:
 *   <Icon name="server" class="h-5 w-5 text-interactive" />
 *   <Icon name="shield-check" class="h-4 w-4" title="Signed packages" />
 *
 * Icons are decorative by default (`aria-hidden`); pass `title` only when the
 * glyph carries meaning not already in adjacent text (then it becomes
 * `role="img"` with an accessible name).
 *
 * Geometry below is copied verbatim from lucide-static v0.469.0 so the paths are
 * byte-correct, not hand-approximated. Keep this registry small and intentional.
 */
export interface Props {
  name: keyof typeof ICONS;
  class?: string;
  title?: string;
  /** Stroke weight. Leave at 2 (the Lucide + CALIBER default); brand rule: do not vary per icon. */
  strokeWidth?: number;
}

const ICONS = {
  // ---- Semantic / content glyphs ----
  server:
    '<rect width="20" height="8" x="2" y="2" rx="2" ry="2" /><rect width="20" height="8" x="2" y="14" rx="2" ry="2" /><line x1="6" x2="6.01" y1="6" y2="6" /><line x1="6" x2="6.01" y1="18" y2="18" />',
  'badge-check':
    '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" /><path d="m9 12 2 2 4-4" />',
  image:
    '<rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />',
  paintbrush:
    '<path d="m14.622 17.897-10.68-2.913" /><path d="M18.376 2.622a1 1 0 1 1 3.002 3.002L17.36 9.643a.5.5 0 0 0 0 .707l.944.944a2.41 2.41 0 0 1 0 3.408l-.944.944a.5.5 0 0 1-.707 0L8.354 7.348a.5.5 0 0 1 0-.707l.944-.944a2.41 2.41 0 0 1 3.408 0l.944.944a.5.5 0 0 0 .707 0z" /><path d="M9 8c-1.804 2.71-3.97 3.46-6.583 3.948a.507.507 0 0 0-.302.819l7.32 8.883a1 1 0 0 0 1.185.204C12.735 20.405 16 16.792 16 15" />',
  braces:
    '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1" /><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1" />',
  'code-xml': '<path d="m18 16 4-4-4-4" /><path d="m6 8-4 4 4 4" /><path d="m14.5 4-5 16" />',
  gauge: '<path d="m12 14 4-4" /><path d="M3.34 19a10 10 0 1 1 17.32 0" />',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />',
  'shield-check':
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" />',
  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5V19A9 3 0 0 0 21 19V5" /><path d="M3 12A9 3 0 0 0 21 12" />',
  route:
    '<circle cx="6" cy="19" r="3" /><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" /><circle cx="18" cy="5" r="3" />',
  cpu: '<rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2" /><path d="M15 20v2" /><path d="M2 15h2" /><path d="M2 9h2" /><path d="M20 15h2" /><path d="M20 9h2" /><path d="M9 2v2" /><path d="M9 20v2" />',
  split:
    '<path d="M16 3h5v5" /><path d="M8 3H3v5" /><path d="M12 22v-8.3a4 4 0 0 0-1.172-2.872L3 3" /><path d="m15 9 6-6" />',
  bot: '<path d="M12 8V4H8" /><rect width="16" height="12" x="4" y="8" rx="2" /><path d="M2 14h2" /><path d="M20 14h2" /><path d="M15 13v2" /><path d="M9 13v2" />',
  'message-square': '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />',
  tag: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" /><circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />',
  'circle-play': '<circle cx="12" cy="12" r="10" /><polygon points="10 8 16 12 10 16 10 8" />',
  'key-round':
    '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" /><circle cx="16.5" cy="7.5" r=".5" fill="currentColor" />',

  // ---- Functional chrome ----
  'chevron-down': '<path d="m6 9 6 6 6-6" />',
  'arrow-right': '<path d="M5 12h14" /><path d="m12 5 7 7-7 7" />',
  x: '<path d="M18 6 6 18" /><path d="m6 6 12 12" />',
  check: '<path d="M20 6 9 17l-5-5" />',
} as const;

const { name, class: className = '', title, strokeWidth = 2 } = Astro.props;

const inner = ICONS[name];
if (!inner) {
  // Fail the build on a typo'd / missing name — this is the drift guard that
  // keeps the icon set closed and consistent.
  throw new Error(
    `Icon "${String(name)}" is not in the registry (src/components/Icon.astro). Add the Lucide glyph there or fix the name.`,
  );
}
const a11y = title
  ? { role: 'img' as const, 'aria-label': title }
  : { 'aria-hidden': 'true' as const };
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {title && <title>{title}</title>}
  <Fragment set:html={inner} />
</svg>
