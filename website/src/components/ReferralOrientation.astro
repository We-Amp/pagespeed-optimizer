//
// Orientation for visitors who arrive from the archived PageSpeed Module
// documentation on developers.google.com (its old /doc/* pages redirect to the
// install and configuration docs here). Progressive enhancement: the aside
// ships with the `hidden` attribute, so it takes no space and no visitor
// without that referrer ever sees it; the script below reveals it only when
// document.referrer starts with https://developers.google.com/ and records
// one `referral_orientation_shown` event per page view.
import { LICENSE_CLAUSE } from '../data/product-facts.mjs';
---

<aside
  id="referral-orientation"
  class="mb-6 rounded-lg border border-interactive/40 bg-interactive/10 px-4 py-3 text-sm text-text-body"
  aria-label="About this site"
  data-pagefind-ignore
  hidden
>
  <p>
    <strong>Arriving from Google&rsquo;s PageSpeed Module docs?</strong> Those pages describe the archived
    project. This is its maintained continuation, mod_pagespeed 2.1, {LICENSE_CLAUSE}.
    <a
      href="/docs/getting-started/"
      class="text-interactive hover:text-interactive-hover underline underline-offset-2"
      data-umami-event="referral_orientation_install">Install, configure and verify it here</a
    >, or read <a
      href="/alternatives/google-pagespeed-module/"
      class="text-interactive hover:text-interactive-hover underline underline-offset-2"
      data-umami-event="referral_orientation_explainer"
      >what the PageSpeed module was and what replaced it</a
    >.
  </p>
</aside>

<script>
  const REFERRER_PREFIX = 'https://developers.google.com/';
  const aside = document.getElementById('referral-orientation');
  if (aside && document.referrer.startsWith(REFERRER_PREFIX)) {
    aside.hidden = false;
    type Umami = { track?: (event: string) => void };
    let sent = false;
    const track = () => {
      const umami = (globalThis as { umami?: Umami }).umami;
      if (sent || !umami?.track) return;
      sent = true;
      umami.track('referral_orientation_shown');
    };
    // The analytics script loads deferred from another host; if it is not
    // there yet, try once more after the page has loaded.
    track();
    if (!sent) window.addEventListener('load', track, { once: true });
  }
</script>
