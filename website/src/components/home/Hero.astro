---
// SPDX-License-Identifier: Apache-2.0
// Copyright (c) 2024-2026 We-Amp B.V.
//
// Home hero: the message on the left, the measured readout panel on the right
// at >=1024px; stacked with the panel right after the CTA block on narrow
// screens.
//
// The markup keeps the indentation it has inside the page layout: the build
// does not compress HTML, so this indentation is the whitespace of the page.
// The class names are styled by the page's global style block in
// src/pages/index.astro. Keep the component imports below in this order: it
// decides the order of the inline style blocks in <head> (see the note in
// src/pages/index.astro).

import Readout from '../instrument/Readout.astro';
import ReadoutPanel from '../instrument/ReadoutPanel.astro';
import Icon from '../Icon.astro';
import { formatPct, monthYear, pctDelta } from '../../lib/instrument';
import demoMetrics from '../../data/demo-metrics.json';
import { BUILTWITH_AS_OF, LICENSE_CLAUSE_CAP } from '../../data/product-facts.mjs';

interface Props {
  // The live-site count as a rounded-down lower bound, e.g. "230,000+".
  liveSites: string;
}

const { liveSites: builtwithLiveRounded } = Astro.props;


// Hero readout panel: the e-commerce case from src/data/demo-metrics.json
// (measured on the demo store; the label date comes from generated_at).
const demoStore = demoMetrics.sites.find((site) => site.id === 'ecommerce');
if (!demoStore) throw new Error('demo-metrics.json: the ecommerce site entry is missing');
const demoLighthouse = demoStore.lighthouse;
const demoLoad = demoStore.loadTime;
const demoImageJpeg = demoStore.resources.images.totalJpeg;
const demoImageAvif = demoStore.resources.images.totalAvif;
const demoImageDelta = formatPct(pctDelta(demoImageJpeg, demoImageAvif));
const demoMeasured = `Measured on our demo store, ${monthYear(demoMetrics.generated_at)}.`;
---

  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-16 pb-14">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">open source &middot; Apache-2.0</p>
        <h1 class="h1-hero mt-4 text-text-body">
          <span class="block">mod_pagespeed, the PageSpeed module for nginx and Apache</span>
          <span class="hero-sub mt-4 block text-interactive">
            Lighthouse <span class="text-text-body">56</span> to{' '}
            <span class="text-text-body">90</span>. On your own servers.
          </span>
        </h1>
        <p class="lede mt-6 max-w-xl">
          mod_pagespeed transcodes images to AVIF, minifies CSS and JS, and injects critical CSS
          &mdash; optimized off the request path, served from cache by your own nginx or Apache.{' '}
          {LICENSE_CLAUSE_CAP}. No proxy, no CDN, nothing third-party in your request path.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/download/" class="btn-primary" data-umami-event="cta_primary_home_hero">
            Download &amp; run
          </a>
          <a href="/demo/" class="btn-secondary" data-umami-event="cta_home_hero_demo">
            See the demo
          </a>
          <a href="/docs/" class="btn-secondary" data-umami-event="cta_home_hero_docs">
            Read the docs
          </a>
        </div>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
          <a
            href="/examples/"
            class="text-text-muted hover:text-interactive transition-colors underline-offset-4 hover:underline"
          >
            Browse the examples
          </a>
          <a
            href="https://github.com/We-Amp/mod_pagespeed"
            rel="noopener noreferrer"
            class="text-text-muted hover:text-interactive transition-colors underline-offset-4 hover:underline"
          >
            Source on GitHub
          </a>
        </div>
        <p class="mt-4 text-sm text-text-muted">
          Running IIS or ASP.NET Core?{' '}
          <a
            href="/download/"
            data-umami-event="cta_home_hero_iis_aspnet"
            class="font-medium text-interactive hover:underline"
          >
            see the IIS and ASP.NET Core packages &rarr;
          </a>
        </p>
        <p class="mt-2 text-sm text-text-muted">
          Already running mod_pagespeed 1.x or ngx_pagespeed? Your pagespeed directives carry over.{' '}
          <a
            href="/docs/upgrade/"
            data-umami-event="cta_home_hero_upgrade"
            class="font-medium text-interactive hover:underline"
          >
            Upgrade guide &rarr;
          </a>
        </p>
        <p class="mt-4 text-sm text-text-annotation">
          The optimization core behind{' '}
          <span class="font-semibold text-text-body">{builtwithLiveRounded} live sites</span>{' '}
          <a
            href="https://trends.builtwith.com/Server/mod_pagespeed"
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-stone-300 dark:decoration-stone-600 underline-offset-2 hover:text-text-body"
          >
            (BuiltWith, {BUILTWITH_AS_OF})
          </a>{' '}
          &mdash; maintained by We-Amp.
        </p>
        <p class="mt-4 text-xs text-text-annotation">
          Free to install and run, in development and in production.
        </p>
        <p class="mt-2 text-xs text-text-annotation">
          No per-image or per-request metering like a CDN. Support from the people who build it is
          what&rsquo;s for sale.{' '}
          <a
            href="/pricing/"
            data-umami-event="cta_home_hero_pricing"
            class="font-medium text-interactive hover:underline"
          >
            See support plans &rarr;
          </a>
        </p>
      </div>

      {/* Measured readout panel: the e-commerce demo store numbers from
          src/data/demo-metrics.json (source + date in the caption). */}
      <div class="mt-10 lg:mt-0">
        <ReadoutPanel
          id="home-readout"
          title="Readout · demo store"
          source={demoMeasured}
          href="/demo/"
          hrefLabel="see it live"
        >
          <Readout
            label="Lighthouse performance score"
            before={String(demoLighthouse.before)}
            after={String(demoLighthouse.after)}
            gauge={{ min: 0, max: 100, before: demoLighthouse.before, after: demoLighthouse.after }}
          />
          <Readout
            label="page load, cut in half (simulated 3G)"
            before={`${demoLoad.before}s`}
            after={`${demoLoad.after}s`}
            gauge={{ min: 0, max: 2, before: demoLoad.before, after: demoLoad.after }}
          />
          <Readout
            label="product image, JPEG → AVIF"
            after={demoImageDelta}
            gauge={{ min: 0, max: demoImageJpeg, before: demoImageJpeg, after: demoImageAvif }}
          />
          <Readout label="third parties in the request path" after="0" tone="neutral" />
        </ReadoutPanel>
      </div>
    </div>

    {/* Founder authority — a distinct credibility line, not buried in the
        small print. Brand-compliant phrasing: never names the founder in
        marketing prose. */}
    <p class="mt-8 inline-flex items-center gap-2 rounded-chip border border-border bg-bg-elevated px-4 py-1.5 text-sm text-text-body">
      <Icon name="badge-check" class="h-4 w-4 text-interactive shrink-0" />
      Built by We-Amp — the team that helped build ngx_pagespeed and maintains mod_pagespeed today.
    </p>

    <p class="mt-6 text-xs text-text-annotation max-w-lg">
      mod_pagespeed is developed by{' '}
      <a
        href="https://we-amp.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-text-muted transition-colors"
      >
        We-Amp B.V.
      </a>{' '}
      and is not affiliated with or endorsed by Google. mod_pagespeed is an open-source project
      originally developed at Google.
    </p>

    {/* AI-traffic hook — one line plus its source, the last hero row. */}
    <div class="mt-10">
      <a
        href="/ai-readability/"
        data-umami-event="cta_home_hero_ai_readability"
        class="group inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-lg border border-border bg-bg-secondary px-4 py-2.5 text-sm text-text-body hover:border-interactive/40 transition-colors"
      >
        <span class="display-num font-semibold text-text-body">≈40%</span>
        <span>
          of the top 1,000 sites render almost nothing for AI assistants. Check yours with
          RenderPeek
        </span>
        <span class="font-medium text-interactive group-hover:underline" aria-hidden="true">
          &rarr;
        </span>
      </a>
      <p class="mt-2 text-xs text-text-annotation">
        <a
          href="/blog/can-ai-read-your-website/"
          class="underline decoration-stone-300 dark:decoration-stone-600 underline-offset-2 hover:text-text-body"
        >
          (our scan, May 2026 &rarr;)
        </a>
      </p>
    </div>
  </section>
