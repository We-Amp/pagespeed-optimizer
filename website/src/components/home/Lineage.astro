---
// SPDX-License-Identifier: Apache-2.0
// Copyright (c) 2024-2026 We-Amp B.V.
//
// Home section 06: the lineage. Heritage stats as engraved readout plates,
// beside the heading from 1024px.
//
// The markup keeps the indentation it has inside the page layout: the build
// does not compress HTML, so this indentation is the whitespace of the page.
// The class names are styled by the page's global style block in
// src/pages/index.astro. Keep the component imports below in this order: it
// decides the order of the inline style blocks in <head> (see the note in
// src/pages/index.astro).

import SectionHeader from '../instrument/SectionHeader.astro';
import {
  BUILTWITH_AS_OF,
  BUILTWITH_HISTORICAL,
  BUILTWITH_SITES,
} from '../../data/product-facts.mjs';

interface Props {
  // The live-site count as a rounded-down lower bound (roundDownDisplay).
  liveSites: string;
}

const { liveSites: builtwithLiveRounded } = Astro.props;

// Heritage stats: the live-site count arrives rounded down from the page; the
// historical figures derive from BUILTWITH_HISTORICAL ("1.9 million+").
const builtwithHistoricalShort = BUILTWITH_HISTORICAL.replace(/\+$/, '');
const builtwithHistoricalCount = `${(parseFloat(BUILTWITH_HISTORICAL) * 1_000_000).toLocaleString('en-US')}+`;
---

  <section class="py-13 sm:py-18">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid grid-cols-1 home-lineage-grid">
      <SectionHeader
        id="s-lineage"
        index="06"
        eyebrow="The lineage"
        title={`The optimization core behind ${builtwithLiveRounded} live sites — now maintained by We-Amp.`}
      >
        We-Amp's products are the maintained continuation of the open-source mod_pagespeed
        optimization core. These are not our customers &mdash; they are the proof the optimization
        core works at scale.
      </SectionHeader>

      {/* Heritage stats — rounded display numbers per BuiltWith. Exact
          figures live in the BuiltWith caption below. We do NOT claim these as
          We-Amp customers (honest framing per the brand guide). */}
      <div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="readout-plate px-6 py-5">
            <p class="display-num text-4xl home-lineage-num font-bold whitespace-nowrap text-text-body">{builtwithLiveRounded}</p>
            <p class="mt-2 text-small text-text-muted">live sites run mod_pagespeed today</p>
          </div>
          <div class="readout-plate px-6 py-5">
            <p class="display-num text-4xl home-lineage-num font-bold whitespace-nowrap text-text-body">{builtwithHistoricalShort}</p>
            <p class="mt-2 text-small text-text-muted">sites across its history</p>
          </div>
        </div>
        <p class="mt-4 text-xs text-text-annotation">
          Usage data:{' '}
          <a
            href="https://trends.builtwith.com/Server/mod_pagespeed"
            rel="noopener noreferrer"
            class="underline-offset-4 hover:underline hover:text-text-body transition-colors"
          >
            BuiltWith
          </a>
          , {BUILTWITH_AS_OF} ({BUILTWITH_SITES} live; {builtwithHistoricalCount} historical).
        </p>
      </div>
    </div>
  </section>
