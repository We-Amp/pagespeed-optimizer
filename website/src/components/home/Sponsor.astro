---
// SPDX-License-Identifier: Apache-2.0
// Copyright (c) 2024-2026 We-Amp B.V.
//
// Home sponsor section.
//
// The markup keeps the indentation it has inside the page layout: the build
// does not compress HTML, so this indentation is the whitespace of the page.
// The class names are styled by the page's global style block in
// src/pages/index.astro. Keep the component imports below in this order: it
// decides the order of the inline style blocks in <head> (see the note in
// src/pages/index.astro).

import Icon from '../Icon.astro';
---

  <section class="py-13 sm:py-18" aria-labelledby="s-sponsor">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 id="s-sponsor" class="h2-section text-text-body">
        Sponsor the maintenance
      </h2>
      <p class="mt-4 text-text-muted">
        mod_pagespeed and the optimizer worker are free to run in production. Sponsorship on GitHub
        funds the ongoing work: builds for current platforms, security fixes, and answering issues.
      </p>
      <div class="mt-6">
        <a
          href="https://github.com/sponsors/We-Amp"
          rel="noopener"
          data-umami-event="cta_sponsor_home"
          class="btn-secondary inline-flex items-center gap-2"
        >
          <Icon name="heart" class="h-4 w-4" />
          Sponsor on GitHub
        </a>
      </div>
    </div>
  </section>
