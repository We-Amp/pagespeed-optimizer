---
// Sitewide floating "Share this page" widget — a sibling of QuickMessage.astro.
// Fixed bottom-right, stacked directly ABOVE the Message launcher (same right
// edge, same recessed plate), so the two read as one instrument cluster while
// staying unmistakably distinct (share-nodes glyph vs the transmit glyph).
//
// Desktop: click opens a popup with the same six brand chips + Copy link as the
// inline ShareButtons panel (shared source: src/data/share-targets.ts), so the
// surfaces can't drift. Mobile (coarse pointer / narrow viewport): the launcher
// invokes the native share sheet (navigator.share) and skips the popup entirely.
//
// Single-popup law: opening this closes QuickMessage and vice-versa, via a
// shared `weamp:fab-open` window event — two stacked corner popups never coexist.
import { buildShareTargets } from '../data/share-targets';

interface Props {
  /** Page title used for the share text; defaults to the document title client-side. */
  title?: string;
}

const { title = '' } = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const targets = buildShareTargets(shareUrl, title);
---

<div class="share-fab-root" data-share-fab data-share-url={shareUrl} data-share-title={title}>
  <button
    type="button"
    data-share-fab-launcher
    class="share-fab-launcher"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="share-fab-panel"
    aria-label="Share this page"
    title="Share this page"
  >
    {/* share-nodes glyph: three nodes, the originating (left) node lit cyan —
        mirrors the Message glyph's single-cyan-accent discipline. */}
    <svg class="share-fab-ico" viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
      <line x1="8" y1="12" x2="16.2" y2="6.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line>
      <line x1="8" y1="12" x2="16.2" y2="17.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line>
      <circle cx="17.2" cy="6" r="2.7" fill="currentColor"></circle>
      <circle cx="17.2" cy="18" r="2.7" fill="currentColor"></circle>
      <circle class="share-fab-ico-lit" cx="6" cy="12" r="2.7"></circle>
    </svg>
  </button>

  <div
    id="share-fab-panel"
    data-share-fab-panel
    class="share-fab-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="share-fab-title"
    hidden
  >
    <div class="share-fab-tickrule" aria-hidden="true"></div>
    <div class="share-fab-head">
      <p id="share-fab-title" class="share-fab-eyebrow">// Share this page</p>
      <button type="button" data-share-fab-close class="share-fab-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      {
        targets.map((target) => (
          <a
            href={target.href}
            target={target.name === 'Email' ? undefined : '_blank'}
            rel={target.name === 'Email' ? undefined : 'noopener noreferrer'}
            aria-label={`Share on ${target.name}`}
            title={`Share on ${target.name}`}
            data-umami-event="share"
            data-umami-event-network={target.slug}
            data-umami-event-surface="float"
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-interactive/10 text-text-body transition-[color,background-color,border-color,transform] hover:-translate-y-0.5 hover:border-interactive/40 hover:bg-interactive/20 hover:text-interactive focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
          >
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={target.icon} />
            </svg>
          </a>
        ))
      }
    </div>

    <div class="share-fab-divider" aria-hidden="true"></div>

    <button
      type="button"
      data-share-float-copy
      data-share-url={shareUrl}
      aria-label="Copy link"
      title="Copy link"
      data-umami-event="share"
      data-umami-event-network="copy"
      data-umami-event-surface="float"
      class="inline-flex h-10 w-full items-center justify-center gap-2 rounded-lg border border-interactive/30 bg-interactive/10 px-4 text-sm font-medium text-interactive transition-colors hover:border-interactive/50 hover:bg-interactive/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      <span data-share-float-copy-label>Copy link</span>
    </button>

    <p class="share-fab-foot" aria-live="polite" data-share-fab-status></p>
  </div>
</div>

<script>
  import { nativeShare } from '../data/share-track';

  const root = document.querySelector<HTMLElement>('[data-share-fab]');
  if (root) {
    const launcher = root.querySelector<HTMLButtonElement>('[data-share-fab-launcher]')!;
    const panel = root.querySelector<HTMLElement>('[data-share-fab-panel]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-share-fab-close]')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-share-float-copy]')!;
    const copyLabel = root.querySelector<HTMLElement>('[data-share-float-copy-label]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const shareUrl = root.dataset.shareUrl ?? window.location.href;
    const shareTitle = root.dataset.shareTitle || document.title;

    function focusables(): HTMLElement[] {
      return Array.from(
        panel.querySelectorAll<HTMLElement>('button, [href], [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => !el.hasAttribute('hidden') && el.offsetParent !== null);
    }
    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
    function onPointerDown(e: PointerEvent) {
      if (!root!.contains(e.target as Node)) close();
    }

    function open() {
      if (root!.dataset.state === 'open') return;
      root!.dataset.state = 'open';
      // Single-popup law: tell the sibling Message widget to close.
      window.dispatchEvent(new CustomEvent('weamp:fab-open', { detail: { source: 'share' } }));
      panel.hidden = false;
      launcher.setAttribute('aria-expanded', 'true');
      const focusFirst = () => focusables()[0]?.focus();
      if (reduceMotion) {
        panel.classList.add('is-open');
        focusFirst();
      } else {
        requestAnimationFrame(() => {
          panel.classList.add('is-open');
          focusFirst();
        });
      }
      document.addEventListener('keydown', onKeydown, true);
      setTimeout(() => document.addEventListener('pointerdown', onPointerDown, true), 0);
    }
    function close() {
      if (root!.dataset.state !== 'open') return;
      root!.dataset.state = 'idle';
      panel.classList.remove('is-open');
      launcher.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKeydown, true);
      document.removeEventListener('pointerdown', onPointerDown, true);
      if (reduceMotion) panel.hidden = true;
      else setTimeout(() => (panel.hidden = true), 160);
      launcher.focus();
    }

    // Mobile / coarse-pointer: native share sheet instead of the stacked popup.
    function preferNative() {
      return (
        typeof navigator !== 'undefined' &&
        typeof navigator.share === 'function' &&
        window.matchMedia('(max-width: 639px)').matches
      );
    }

    launcher.addEventListener('click', () => {
      if (preferNative()) {
        // The native share sheet bypasses the popup's tracked buttons, so the
        // shared helper records the umami event before handing off — otherwise
        // mobile shares are invisible to analytics. Single source of truth in
        // share-track.ts so this can't drift back to untracked.
        nativeShare('float', { url: shareUrl, title: shareTitle });
        return;
      }
      root!.dataset.state === 'open' ? close() : open();
    });
    closeBtn.addEventListener('click', close);

    // Single-popup law: close when the sibling Message widget opens.
    window.addEventListener('weamp:fab-open', (e) => {
      if ((e as CustomEvent).detail?.source !== 'share') close();
    });

    // Copy link — async clipboard with textarea/execCommand fallback. Scoped to
    // this widget via [data-share-float-copy] so it never collides with the
    // inline ShareButtons copy handler on blog/docs pages.
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.dataset.shareUrl ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      if (copyLabel) {
        const prev = copyLabel.textContent;
        copyLabel.textContent = 'Copied';
        window.setTimeout(() => {
          copyLabel.textContent = prev;
        }, 1600);
      }
    });
  }
</script>

<style>
  /* ── Root + launcher: a sibling of .qm-launcher, stacked above it ──────── */
  .share-fab-root {
    position: fixed;
    right: 1.5rem;
    /* sit one slot above the Message launcher (1.5rem base + 3rem height + gap) */
    bottom: calc(1.5rem + 3rem + 0.75rem);
    z-index: 60;
    font-family: var(--font-sans);
  }
  @supports (bottom: env(safe-area-inset-bottom)) {
    .share-fab-root {
      bottom: calc(1.5rem + 3rem + 0.75rem + env(safe-area-inset-bottom));
    }
  }
  /* Mirror .qm-root's mobile inset reduction (QuickMessage @media max-width:420px)
     so the two stacked launchers keep the same right edge and a 0.75rem gap.
     Without this, the share FAB stays at the 1.5rem desktop inset while the
     Message launcher drops to 0.75rem → the two visibly misalign on phones. */
  @media (max-width: 420px) {
    .share-fab-root {
      right: 0.75rem;
      bottom: calc(0.75rem + 3rem + 0.75rem);
    }
    @supports (bottom: env(safe-area-inset-bottom)) {
      .share-fab-root {
        bottom: calc(0.75rem + 3rem + 0.75rem + env(safe-area-inset-bottom));
      }
    }
  }

  .share-fab-launcher {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-control);
    background-color: var(--color-bg-recessed);
    color: var(--color-text-body);
    border: 1px solid var(--color-control-border);
    box-shadow:
      inset 0 0 0 1px var(--color-border),
      inset 0 1px 0 0 var(--color-specular),
      0 2px 10px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition:
      color 120ms ease,
      border-color 120ms ease,
      transform 120ms ease;
  }
  .share-fab-launcher:hover {
    border-color: var(--color-interactive);
    transform: translateY(-1px);
  }
  .share-fab-launcher:focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: 2px;
  }
  .share-fab-root[data-state='open'] .share-fab-launcher {
    border-color: var(--color-interactive);
    color: var(--color-interactive);
  }
  .share-fab-ico-lit {
    fill: var(--color-interactive);
  }
  .share-fab-launcher:hover .share-fab-ico-lit {
    fill: var(--color-interactive-hover);
  }

  /* ── Panel: mirrors .qm-panel ─────────────────────────────────────────── */
  .share-fab-panel {
    position: absolute;
    right: 0;
    bottom: calc(3rem + 0.75rem);
    width: min(340px, calc(100vw - 2rem));
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    box-shadow:
      inset 0 1px 0 0 var(--color-specular),
      0 16px 48px rgba(0, 0, 0, 0.5);
    padding: 1rem 1rem 0.875rem;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }
  .share-fab-panel.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .share-fab-tickrule {
    position: absolute;
    top: 0;
    left: 0.75rem;
    right: 0.75rem;
    height: 1px;
    background-image: repeating-linear-gradient(
      to right,
      var(--color-tick) 0,
      var(--color-tick) 1px,
      transparent 1px,
      transparent 6px
    );
  }

  .share-fab-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .share-fab-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }
  .share-fab-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin: -0.25rem -0.25rem -0.25rem 0;
    border-radius: var(--radius-chip);
    color: var(--color-text-annotation);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }
  .share-fab-close:hover {
    color: var(--color-text-body);
    border-color: var(--color-border);
  }
  .share-fab-close:focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: 2px;
  }

  .share-fab-divider {
    height: 1px;
    background-color: var(--color-border);
    margin: 0.875rem 0;
  }
  .share-fab-foot {
    margin: 0.5rem 0 0;
    min-height: 1rem;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }
</style>
