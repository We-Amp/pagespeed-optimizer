//
// Runs before first paint, ahead of both interface variants: resolves which
// one this visitor gets and records it on <html data-scan-ui>. A rule in
// BaseLayout's critical CSS shows exactly one variant from that attribute, so
// there is no flash and no layout shift. The script source lives in one plain
// file, src/scripts/scan/boot.js, which is also what the unit test runs; the
// default and storage key reach it as data attributes on the script element.
import boot from '../../scripts/scan/boot.js?raw';
import { SCAN_UI_DEFAULT, SCAN_UI_STORAGE_KEY } from '../../lib/scan/flag';

// The file's leading comment is for readers of the source, not for every page.
const source = boot.replace(/^(\/\/.*\n)+/, '');
---

<script
  is:inline
  set:html={source}
  data-default={SCAN_UI_DEFAULT}
  data-key={SCAN_UI_STORAGE_KEY}
></script>
