---
// Interactive bitmask visualizer — demonstrates the 32-bit capability mask
// Used as a client:visible island on the features page
---

<div
  class="rounded-lg border border-border bg-bg-elevated p-4"
  id="bitmask-viz"
>
  <p class="text-xs font-medium text-text-body mb-4">
    Interactive: build a capability mask
  </p>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
    {/* Format */}
    <div>
      <p class="font-medium text-text-annotation mb-1.5 font-mono">
        Bits 0-1: Format
      </p>
      <div class="space-y-1" id="bitmask-format">
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="radio" name="bm-format" value="0" class="accent-interactive" />
          <span class="text-text-body">Original</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="radio" name="bm-format" value="1" checked class="accent-interactive" />
          <span class="text-text-body">WebP</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="radio" name="bm-format" value="2" class="accent-interactive" />
          <span class="text-text-body">AVIF</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="radio" name="bm-format" value="3" class="accent-interactive" />
          <span class="text-text-body">SVG</span>
        </label>
      </div>
    </div>

    {/* Viewport */}
    <div>
      <p class="font-medium text-text-annotation mb-1.5 font-mono">
        Bits 2-3: Viewport
      </p>
      <div class="space-y-1" id="bitmask-viewport">
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="radio" name="bm-viewport" value="0" class="accent-interactive" />
          <span class="text-text-body">Mobile</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="radio" name="bm-viewport" value="1" class="accent-interactive" />
          <span class="text-text-body">Tablet</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="radio" name="bm-viewport" value="2" checked class="accent-interactive" />
          <span class="text-text-body">Desktop</span>
        </label>
      </div>
    </div>

    {/* Density + Save-Data + Encoding */}
    <div>
      <p class="font-medium text-text-annotation mb-1.5 font-mono">Bits 4-7</p>
      <div class="space-y-1.5">
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="checkbox" id="bm-density" class="accent-interactive" />
          <span class="text-text-body">2x density</span>
        </label>
        <label class="flex items-center gap-1.5 cursor-pointer">
          <input type="checkbox" id="bm-savedata" class="accent-interactive" />
          <span class="text-text-body">Save-Data</span>
        </label>
        <div class="mt-1">
          <p class="font-medium text-text-annotation mb-1 font-mono">Encoding</p>
          <select
            id="bm-encoding"
            aria-label="Transfer encoding"
            class="w-full rounded border border-border-strong bg-bg-elevated text-text-body text-xs px-1.5 py-1"
          >
            <option value="0">Identity</option>
            <option value="1">Gzip</option>
            <option value="2" selected>Brotli</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  {/* Bit visualization */}
  <div class="mt-4 pt-3 border-t border-border">
    <div class="flex items-center gap-2 flex-wrap">
      <div class="flex items-center gap-[3px]" id="bm-bits">
        {
          [0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
            <div
              class="h-5 w-5 rounded-sm border border-border-strong transition-colors duration-150"
              data-bit={i}
            />
          ))
        }
      </div>
      <span
        class="text-sm font-mono font-bold text-text-body ml-1"
        id="bm-hex"
        aria-live="polite"
        >0x00</span
      >
    </div>
    <p
      class="mt-1.5 text-[10px] text-text-annotation font-mono"
      id="bm-desc"
      aria-live="polite"
    >
      Original · Mobile · 1x · no Save-Data · Identity
    </p>
  </div>
</div>

<script is:inline>
  (function () {
    var viz = document.getElementById('bitmask-viz');
    if (!viz) return;

    var bits = viz.querySelectorAll('[data-bit]');
    var hexEl = document.getElementById('bm-hex');
    var descEl = document.getElementById('bm-desc');

    var formatNames = ['Original', 'WebP', 'AVIF', 'SVG'];
    var viewportNames = ['Mobile', 'Tablet', 'Desktop', 'Reserved'];
    var encodingNames = ['Identity', 'Gzip', 'Brotli', 'Reserved'];

    function update() {
      var format = parseInt(viz.querySelector('input[name="bm-format"]:checked').value);
      var viewport = parseInt(viz.querySelector('input[name="bm-viewport"]:checked').value);
      var density = document.getElementById('bm-density').checked ? 1 : 0;
      var savedata = document.getElementById('bm-savedata').checked ? 1 : 0;
      var encoding = parseInt(document.getElementById('bm-encoding').value);

      var mask =
        (format & 3) |
        ((viewport & 3) << 2) |
        (density << 4) |
        (savedata << 5) |
        ((encoding & 3) << 6);

      for (var i = 0; i < 8; i++) {
        var on = (mask >> i) & 1;
        var el = bits[i];
        if (on) {
          el.style.backgroundColor = '';
          el.classList.remove('bg-stone-100', 'dark:bg-stone-800');
          el.classList.add('bg-interactive', 'dark:bg-interactive');
          el.style.borderColor = 'transparent';
        } else {
          el.classList.remove('bg-interactive', 'dark:bg-interactive');
          el.classList.add('bg-stone-100', 'dark:bg-stone-800');
          el.style.borderColor = '';
        }
      }

      var hex = '0x' + mask.toString(16).toUpperCase().padStart(2, '0');
      hexEl.textContent = hex;

      var parts = [
        formatNames[format],
        viewportNames[viewport],
        density ? '2x' : '1x',
        savedata ? 'Save-Data' : 'no Save-Data',
        encodingNames[encoding],
      ];
      descEl.textContent = parts.join(' \u00b7 ');
    }

    viz.addEventListener('change', update);
    update();
  })();
</script>
