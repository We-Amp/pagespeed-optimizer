//
// The directive finder on the configuration reference: typing in the field
// narrows the reference to the directives whose name contains the text.
//
// The field, its label and its status line are part of the rendered reference
// (src/lib/rehype-directive-blocks.mjs puts them above the first area and
// marks every directive heading and every area heading). This component
// carries the behaviour and the styles; docs/[slug].astro renders it on the
// configuration page only, so the script loads there alone (the few style
// rules below travel with the docs page template).
//
// Rules the script keeps:
//   - Escape in the field clears the filter.
//   - A link or a location hash that points into something the filter hides
//     clears the filter first, then the page scrolls to the target with the
//     layout of the full reference, not the shorter filtered one.
//   - A location hash that points at something the filter still shows keeps
//     the filter, and the page scrolls to the target.
//   - A hidden directive is its heading and every element after it up to the
//     next heading, each with the hidden attribute, so it leaves the page and
//     the accessibility tree. An area with no match hides its heading and
//     list the same way.
//   - The status line is a live region: it reports the number of matches, or
//     that nothing matches, and is empty while the field is empty.
// Without JavaScript the field is not shown and the reference reads as before.
---

<script>
  import { parseDirectiveQuery, matchesDirective } from '../lib/directive-match';

  const reference = document.querySelector<HTMLElement>('[data-directive-reference]');
  const field = reference?.querySelector<HTMLInputElement>('#directive-filter');
  const status = reference?.querySelector<HTMLElement>('#directive-filter-status');

  if (reference && field && status) {
    type Run = { name: string; parts: HTMLElement[] };
    type Area = { parts: HTMLElement[]; directives: Run[] };
    // The reference is one flat run of elements; the headings start each
    // directive's and each area's share of it. Read once, on first use.
    let areas: Area[] | null = null;
    const read = () => {
      const found: Area[] = [];
      let area: Area | null = null;
      let run: Run | null = null;
      for (const el of Array.from(reference.children) as HTMLElement[]) {
        if (el.hasAttribute('data-directive-area')) {
          run = null;
          area = { parts: [el], directives: [] };
          found.push(area);
        } else if (area && el.hasAttribute('data-directive')) {
          run = { name: el.dataset.directive ?? '', parts: [el] };
          area.directives.push(run);
        } else if (run) {
          run.parts.push(el);
        } else if (area) {
          area.parts.push(el);
        }
      }
      return found;
    };
    const show = (parts: HTMLElement[], shown: boolean) => {
      for (const el of parts) if (el.hidden === shown) el.hidden = !shown;
    };
    let reported = false;
    // The fragment of a link whose click just cleared the filter.
    let cleared = '';

    const apply = () => {
      // How typed text becomes a name to look for: src/lib/directive-match.ts.
      const query = parseDirectiveQuery(field.value);
      if (query.kind === 'none') {
        for (const area of areas ?? []) {
          show(area.parts, true);
          for (const run of area.directives) show(run.parts, true);
        }
        delete reference.dataset.filtering;
        status.textContent = '';
        return;
      }
      areas ??= read();
      let count = 0;
      for (const area of areas) {
        let any = false;
        for (const run of area.directives) {
          const match = matchesDirective(run.name, query);
          show(run.parts, match);
          if (match) {
            any = true;
            count += 1;
          }
        }
        show(area.parts, any);
      }
      reference.dataset.filtering = '';
      status.textContent =
        count === 0
          ? 'No directive matches. Clear the filter to see all.'
          : count === 1
            ? '1 directive matches'
            : `${count} directives match`;
      if (!reported) {
        reported = true;
        const umami = (window as { umami?: { track?: (_name: string) => void } }).umami;
        if (typeof umami?.track === 'function') umami.track('docs_directive_filter');
      }
    };

    const clear = () => {
      if (!field.value) return;
      field.value = '';
      apply();
    };

    /** True when `id` names something the filter currently hides. */
    const hides = (id: string) => {
      if (!id || !reference.hasAttribute('data-filtering')) return false;
      const target = document.getElementById(id);
      return Boolean(target && reference.contains(target) && target.closest('[hidden]'));
    };
    const fragment = (hash: string) => {
      try {
        return decodeURIComponent(hash.replace(/^#/, ''));
      } catch {
        return '';
      }
    };

    field.addEventListener('input', apply);
    field.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !field.value) return;
      event.preventDefault();
      clear();
    });

    // An in-page link: clear before the browser follows it.
    document.addEventListener(
      'click',
      (event) => {
        const link = (event.target as Element | null)?.closest?.('a[href]');
        if (!(link instanceof HTMLAnchorElement)) return;
        if (link.origin !== location.origin || link.pathname !== location.pathname) return;
        const id = fragment(link.hash);
        if (!hides(id)) return;
        clear();
        // Lay the page out again now, so the browser's own scroll to the
        // fragment sees the target where it is once shown.
        void reference.offsetHeight;
        cleared = id;
      },
      true,
    );
    /** Scroll to `id` once the page has its new layout. */
    const land = (id: string) => {
      const target = document.getElementById(id);
      if (!target) return;
      // Without a fresh layout some engines scroll against the old, shorter
      // page or not at all: read the position first, scroll, and check again
      // after the next two frames.
      target.getBoundingClientRect();
      target.scrollIntoView();
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          if (fragment(location.hash) === id) target.scrollIntoView();
        }),
      );
    };
    // Back, forward, an edited address or a followed link: the browser has
    // already tried to scroll to a hidden target, so clear and scroll to it.
    // While a filter is on, a target that stays shown gets the same scroll:
    // some engines otherwise leave the page where it was.
    window.addEventListener('hashchange', () => {
      const id = fragment(location.hash);
      const fromLink = id !== '' && id === cleared;
      cleared = '';
      if (fromLink || hides(id)) {
        clear();
        land(id);
      } else if (reference.hasAttribute('data-filtering')) {
        land(id);
      }
    });

    // A reload or a history restore can bring the field back with its text.
    window.addEventListener('pageshow', apply);
    apply();
  }
</script>

<style is:global>
  .directive-finder {
    margin-block: 1.5rem;
    max-width: 32rem;
  }
  .directive-finder label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-body);
  }
  .directive-finder input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-control);
    background-color: var(--color-bg-recessed);
    color: var(--color-text-body);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.5;
  }
  /* One line is always reserved, so the reference does not move when the
     status appears. */
  .prose .directive-finder p[role='status'] {
    min-height: 1.5rem;
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5rem;
    color: var(--color-text-muted);
  }
  /* While a filter is on, the per-area lists of every directive would mostly
     point at hidden entries; the matching blocks are the list. */
  [data-directive-reference][data-filtering] [data-directive-index] {
    display: none;
  }
  /* The field does nothing without its script. */
  @media (scripting: none) {
    .directive-finder {
      display: none;
    }
  }
  @media print {
    .directive-finder {
      display: none;
    }
  }
</style>
