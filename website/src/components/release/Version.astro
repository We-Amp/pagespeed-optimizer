//
// Renders a release version string sourced from the corp release manifest
//. Use inside .mdx pages to keep version-coupled content in sync
// with `corp/releases/{1.1,2.0}.yaml`.
//
// Examples in MDX:
//   <Version line="1.1" style="semver" />   → 1.1.0
//   <Version line="1.1" style="badge" />    → v1.1.0
//   <Version line="1.1" style="tag" />      → v1.1.0+r9
//   <Version line="2.0" style="semver" />   → 2.0.16
//
// `inline` (default true) renders without any wrapping element. Set
// `inline=false` to wrap in a <code> tag for emphasis in body copy.

import { getRelease } from '../../lib/release';

interface Props {
  line: '1.1' | '2.0';
  style?: 'semver' | 'badge' | 'tag';
  inline?: boolean;
}

const { line, style = 'semver', inline = true } = Astro.props;
const rel = await getRelease(line);

let value: string;
switch (style) {
  case 'badge':
    value = rel.display.badge_version;
    break;
  case 'tag':
    value = rel.release.tag;
    break;
  case 'semver':
  default:
    value = rel.display.header_version;
    break;
}
---

{inline ? <Fragment>{value}</Fragment> : <code>{value}</code>}
