//
// Renders a single shell command line that downloads (or installs) a
// release artifact, sourced from the corp release manifest.
//
// Examples in MDX (URLs/versions are resolved at build time from the
// release manifest — see src/content/releases-{1.1,2.0}/release.yaml):
//   <DownloadCmd line="1.1" channel="deb" arch="amd64" pkgmgr="curl" />
//     → curl -O <archive_base><deb_amd64 template>
//   <DownloadCmd line="1.1" channel="deb" arch="amd64" pkgmgr="dpkg" />
//     → sudo dpkg -i <deb_amd64 template>
//   <DownloadCmd line="1.1" channel="rpm" arch="x86_64" pkgmgr="dnf" />
//     → sudo dnf install -y <archive_base><rpm_x86_64 template>
//   <DownloadCmd line="1.1" filename="libmod_pagespeed-linux-x86_64.so" pkgmgr="curl" />
//     → curl -O <archive_base>libmod_pagespeed-linux-x86_64.so
//
// The component renders only the command text. Wrap it in a fenced code
// block in the .mdx source to get syntax highlighting.

import { getRelease, artifactUrl, archiveUrl } from '../../lib/release';

interface Props {
  line: '1.1' | '2.0';
  channel?: string;
  arch?: string;
  /** Override the rendered filename when `channel` is e.g. "so" with no per-arch templates. */
  filename?: string;
  /** "curl" downloads, "dpkg" / "dnf" install. Default: "curl". */
  pkgmgr?: 'curl' | 'dpkg' | 'dnf';
}

const { line, channel, arch, filename, pkgmgr = 'curl' } = Astro.props;
const rel = await getRelease(line);

let url: string;
let resolvedFilename: string;
if (filename) {
  url = archiveUrl(rel, filename);
  resolvedFilename = filename;
} else if (channel && arch) {
  url = artifactUrl(rel, channel, arch);
  resolvedFilename = url.slice(rel.urls.archive_base.length);
} else {
  throw new Error(
    `DownloadCmd requires either {channel, arch} or {filename}; got channel=${channel} arch=${arch} filename=${filename}`,
  );
}

let cmd: string;
switch (pkgmgr) {
  case 'dpkg':
    cmd = `sudo dpkg -i ${resolvedFilename}`;
    break;
  case 'dnf':
    cmd = `sudo dnf install -y ${url}`;
    break;
  case 'curl':
  default:
    cmd = `curl -O ${url}`;
    break;
}
---

<Fragment>{cmd}</Fragment>
