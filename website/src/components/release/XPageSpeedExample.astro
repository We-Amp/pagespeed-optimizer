//
// Renders an X-Page-Speed / X-Mod-Pagespeed / X-PageSpeed response-header
// example. Used by docs pages with "verify it works" sections that previously
// hard-coded the version string. The module's headers carry the version
// production sends, from the capture in src/data/telemetry-capture.json (the
// homepage quick-start's source); the middleware and 2.0 forms come from the
// release manifest.
//
// Examples in MDX:
//   <XPageSpeedExample line="2.1" surface="nginx" />
//     → X-Page-Speed: 1.17.0
//   <XPageSpeedExample line="2.1" surface="apache" />
//     → X-Mod-Pagespeed: 1.17.0
//   <XPageSpeedExample line="2.0" />
//     → X-PageSpeed: WeAmp.PageSpeed/2.0.7
//   <XPageSpeedExample line="2.1" surface="middleware" />
//     → X-PageSpeed: WeAmp.PageSpeed/2.1.0
//
// `surface="middleware"` asks for the ASP.NET Core middleware's header form
// on any line; without it, `line="2.1"` renders the module's header.

import { getRelease } from '../../lib/release';
import telemetryCapture from '../../data/telemetry-capture.json';

interface Props {
  line: '1.1' | '2.0' | '2.1';
  surface?: 'nginx' | 'apache' | 'iis' | 'middleware';
}

const { line, surface = 'nginx' } = Astro.props;
const rel = await getRelease(line);
const moduleVersion = telemetryCapture.paths['/'].headers['x-mod-pagespeed'];

let header: string;
if (surface === 'middleware' || line === '2.0') {
  header = `X-PageSpeed: WeAmp.PageSpeed/${rel.display.header_version}`;
} else if (surface === 'apache') {
  header = `X-Mod-Pagespeed: ${moduleVersion}`;
} else {
  header = `X-Page-Speed: ${moduleVersion}`;
}
---

<Fragment>{header}</Fragment>
