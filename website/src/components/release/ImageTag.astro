//
// Renders a Docker / Helm image tag for a release line, sourced from the
// corp release manifest (§3). The 2.0 line ships container images
// tagged by SemVer per `artifacts.docker.tag_template`.
//
// Examples in MDX:
//   <ImageTag line="2.0" />   → 2.0.7

import { getRelease } from '../../lib/release';

interface Props {
  line: '1.1' | '2.0';
}

const { line } = Astro.props;
const rel = await getRelease(line);
const tmpl = (rel.artifacts.docker?.tag_template as string) ?? '%V';
const tag = tmpl
  .replaceAll('%V', rel.release.semver)
  .replaceAll('%R', String(rel.release.revision ?? 0))
  .replaceAll('%T', rel.release.tag);
---

<Fragment>{tag}</Fragment>
