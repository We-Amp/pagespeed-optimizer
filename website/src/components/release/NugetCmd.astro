//
// Renders the `dotnet add package` command for the 2.0 NuGet middleware,
// sourced from the corp release manifest. The `--prerelease`
// flag toggles via `display.nuget_install_flags` in releases-2.0/release.yaml
// so the docs flip automatically when 2.0 GA stabilizes.
//
// Examples in MDX:
//   <NugetCmd />            → dotnet add package WeAmp.PageSpeed.AspNetCore [--prerelease]
//   <NugetCmd verb="restore" />  → dotnet restore --packages WeAmp.PageSpeed.AspNetCore

import { getRelease } from '../../lib/release';

interface Props {
  /** Default "add" → `dotnet add package …`. */
  verb?: 'add';
}

const rel = await getRelease('2.0');
const pkg = (rel.artifacts.nuget?.package as string) ?? 'WeAmp.PageSpeed.AspNetCore';
const flags = (rel.display.nuget_install_flags ?? '').trim();
const cmd = `dotnet add package ${pkg}${flags ? ` ${flags}` : ''}`;
---

<Fragment>{cmd}</Fragment>
