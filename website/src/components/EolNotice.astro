---
import { LICENSE_CLAUSE } from '../data/product-facts.mjs';

// Non-dismissible lifecycle notice for the /1.1/ section. BaseLayout renders
// it above <slot /> on every /1.1/* page (guarded by is11Section), so it sits
// above each page's H1 with zero per-page wiring. Static and server-rendered:
// no script, no dismissal state, no post-hydration insertion — the height is
// part of the initial layout, and a mandated notice a returning visitor
// can permanently hide is not a notice.
---

<aside
  role="note"
  aria-label="mod_pagespeed 1.15 upgrade notice"
  class="border-b border-amber-200 bg-amber-50/60 dark:border-amber-900/60 dark:bg-amber-950/30"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-3 text-sm text-text-body">
    <strong>The mod_pagespeed line continues as mod_pagespeed 2.1.</strong>
    1.15 now receives security fixes only, for a transition window that varies by platform. mod_pagespeed
    2.1 is {LICENSE_CLAUSE}, and the upgrade is drop-in — your existing directives carry over.
    <a
      href="/1.1/docs/upgrading-to-2-1/"
      class="font-medium text-interactive hover:text-interactive-hover underline underline-offset-4"
      >Read the upgrade guide <span aria-hidden="true">&rarr;</span></a
    >
  </div>
</aside>
