// Copyright (c) 2024-2026 We-Amp B.V.
//
// The three support tiers as cards, rendered from SUPPORT_TIERS in
// product-facts.mjs (the one source the agent files and /api/product.json also
// read). Used on /support/ and /pricing/. Priority is the emphasized tier.
// Each card shows the yearly price, what is included (the last entry is the
// tier's first-response target) and its own button: Standard and Priority go
// straight to the hosted checkout page, Enterprise to the contact form.
//
// Every card CTA is a paid CTA and carries the cta_commercial event with the
// tier's offer (buy-standard, buy-priority, enterprise), the page it sits on
// (surface) and the tier as its position.

import Icon from './Icon.astro';
import Chip from './instrument/Chip.astro';
import { SUPPORT_TIERS, formatEur } from '../data/product-facts.mjs';

interface Props {
  /** Page slug for the umami `surface` property (e.g. "pricing"). */
  surface: string;
}

const { surface } = Astro.props;
const EMPHASIZED = 'priority';
---

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3" data-tier-cards>
  {SUPPORT_TIERS.map((tier) => {
    const featured = tier.id === EMPHASIZED;
    return (
      <div
        class:list={[
          'flex flex-col',
          featured
            ? 'card-featured border-t-2 border-t-interactive'
            : 'card-product card-product-stone',
        ]}
        data-tier={tier.id}
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-lg font-semibold text-text-body">{tier.name}</h3>
          {featured && <Chip tone="interactive" label="Recommended" />}
        </div>
        <p class="mt-3 text-text-body" data-tier-price>
          {tier.prices.from && <span class="text-sm text-text-muted">From </span>}
          <span class="text-3xl font-semibold">{formatEur(tier.prices.annualEur)}</span>
          <span class="text-sm text-text-muted"> / year</span>
        </p>
        <p class="mt-2 font-mono text-xs uppercase tracking-wider text-text-annotation">
          {tier.servers}
        </p>
        <ul class="mt-5 flex-1 space-y-2 text-sm text-text-muted">
          {tier.includes.map((item) => (
            <li class="flex gap-2">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-interactive" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a
          href={tier.cta.href}
          rel={tier.cta.external ? 'noopener' : undefined}
          class:list={['mt-6', featured ? 'btn-primary' : 'btn-secondary']}
          data-umami-event="cta_commercial"
          data-umami-event-offer={tier.cta.offer}
          data-umami-event-surface={surface}
          data-umami-event-position={`tier_${tier.id}`}
        >
          {tier.cta.label} &rarr;
        </a>
      </div>
    );
  })}
</div>
