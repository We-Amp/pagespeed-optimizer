//
// Readout — one measured value on an instrument: before -> after, an optional
// tick-scale gauge underneath (aria-hidden; it carries nothing the text does
// not already state). Widths are computed server-side; no animation, so no
// reduced-motion fallback is needed.

import { gaugeWidth } from '../../lib/instrument';

interface Props {
  label: string;
  before?: string;
  after: string;
  tone?: 'improved' | 'neutral';
  gauge?: { min: number; max: number; before?: number; after: number };
}

const { label, before, after, tone = 'improved', gauge } = Astro.props;

const beforeWidth =
  gauge && gauge.before !== undefined ? gaugeWidth(gauge.before, gauge.min, gauge.max) : undefined;
const afterWidth = gauge ? gaugeWidth(gauge.after, gauge.min, gauge.max) : undefined;
const improved = tone === 'improved';
---

<div class="readout" data-ui="readout">
  <div class="readout-row">
    <p class="readout-value display-num">
      {
        before !== undefined && (
          <>
            <span class="text-text-annotation">{before}</span>
            <span aria-hidden="true"> → </span>
            <span class="sr-only"> to </span>
          </>
        )
      }
      <span class={improved ? 'text-success' : 'text-text-body'}>{after}</span>
    </p>
    <p class="readout-label text-sm text-text-muted">{label}</p>
  </div>
  {
    gauge && (
      <div class="readout-gauge" aria-hidden="true">
        <i class="track" />
        {beforeWidth !== undefined && <i class="before" style={`inline-size:${beforeWidth}%`} />}
        <i
          class:list={['after', improved ? 'after-improved' : 'after-neutral']}
          style={`inline-size:${afterWidth}%`}
        />
      </div>
    )
  }
</div>

<style>
  /* The row layout follows the readout's own width, not the window, so a
     readout in a narrow column keeps its value on one line. */
  .readout {
    container-type: inline-size;
  }
  .readout-value {
    font-size: 1.375rem; /* 22px mobile */
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .readout-label {
    margin-top: 0.375rem;
  }
  @media (min-width: 640px) {
    .readout-value {
      font-size: 1.625rem; /* 26px desktop */
    }
  }
  @container (min-width: 26rem) {
    /* Value and label share one baseline row, like the instrument mockup. */
    .readout-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .readout-label {
      margin-top: 0;
      text-align: right;
    }
  }
  .readout-gauge {
    position: relative;
    height: 8px;
    margin-top: 0.625rem;
    border-bottom: 1px solid var(--color-border-strong);
  }
  .readout-gauge .track {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--color-tick) 0 1px, transparent 1px 10%);
  }
  /* Two lanes, so the before marker stays visible when the value went up. */
  .readout-gauge .before,
  .readout-gauge .after {
    position: absolute;
    left: 0;
    border-radius: 1px;
  }
  .readout-gauge .before {
    bottom: 5px;
    height: 2px;
    background-color: var(--color-border-strong);
  }
  .readout-gauge .after {
    bottom: 0;
    height: 4px;
  }
  .readout-gauge .after-improved {
    background-color: var(--color-success);
  }
  .readout-gauge .after-neutral {
    background-color: var(--color-interactive);
  }
</style>
