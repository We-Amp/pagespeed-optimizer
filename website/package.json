{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-pricing.js && node scripts/generate-title-cards.mjs && node scripts/generate-llms.mjs",
    "build": "astro build",
    "postbuild": "node scripts/attach-link-punctuation.mjs && node scripts/build-search-index.mjs",
    "capture:telemetry": "node scripts/capture-telemetry.mjs",
    "check:content": "node scripts/check-built-content.mjs",
    "gen:llms": "node scripts/generate-llms.mjs",
    "gen:references": "node scripts/generate-references.mjs --module-src \"${MOD_PAGESPEED_SRC:-../../mod_pagespeed}\" && node scripts/render-references.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && astro check",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write 'src/**/*.{astro,ts,js,mjs,css}' 'tests/**/*.{ts,js,mjs}' 'test/**/*.{ts,js,mjs}' 'scripts/**/*.{js,mjs,mts,ts}' '*.config.{js,mjs,ts}'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,js,mjs,css}' 'tests/**/*.{ts,js,mjs}' 'test/**/*.{ts,js,mjs}' 'scripts/**/*.{js,mjs,mts,ts}' '*.config.{js,mjs,ts}'",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:gate": "vitest run test/sync/airead-gate-sync.test.ts",
    "test:anchors": "vitest run test/anchor-gate.test.ts",
    "lint:platforms": "bash scripts/lint-platforms.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/node": "^11.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "remark-custom-heading-id": "^2.0.0",
    "remark-directive": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "^2.9.0"
    },
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.1",
    "brace-expansion": "5.0.12",
    "devalue": "5.9.3",
    "lighthouse": "13.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/inter": "^5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "github-slugger": "^2.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wawoff2": "^2.0.1"
  }
}
