{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-pricing.js && node scripts/generate-title-cards.mjs && node scripts/generate-llms.mjs",
    "build": "astro build",
    "gen:llms": "node scripts/generate-llms.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && astro check",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write 'src/**/*.{astro,ts,js,css,md}'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,js,css,md}'",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:gate": "vitest run test/sync/airead-gate-sync.test.ts",
    "test:anchors": "vitest run test/anchor-gate.test.ts",
    "lint:platforms": "bash scripts/lint-platforms.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/node": "^11.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.3.3",
    "remark-custom-heading-id": "^2.0.0",
    "remark-directive": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "^2.9.0"
    },
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.1",
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.1",
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-js": "^2.6.2",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "github-slugger": "^2.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.26.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wawoff2": "^2.0.1"
  }
}
