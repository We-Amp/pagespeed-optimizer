# FastSpring API credentials for the pricing fetch script.
# Copy this file to ~/.weamp/credentials.env and fill in your values.
#
# Usage:
#   source ~/.weamp/credentials.env
#   node scripts/fetch-pricing.js
#
# These credentials use HTTP Basic Auth against api.fastspring.com.
# Find them in your FastSpring dashboard under Integrations > API Credentials.

export FASTSPRING_API_USER="your-api-username"
export FASTSPRING_API_PASS="your-api-password"
