{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "HOST=127.0.0.1 npx astro preview --port 4321",
      "startServerReadyPattern": "4321",
      "url": [
        "http://127.0.0.1:4321/",
        "http://127.0.0.1:4321/docs/",
        "http://127.0.0.1:4321/pricing/",
        "http://127.0.0.1:4321/analyze/",
        "http://127.0.0.1:4321/docs/filters/inline_javascript/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
