# nanosvg - Header-only SVG parser/rasterizer (zlib license)

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "nanosvg",
    hdrs = [
        "src/nanosvg.h",
        "src/nanosvgrast.h",
    ],
    includes = ["src"],
    visibility = ["//visibility:public"],
)
