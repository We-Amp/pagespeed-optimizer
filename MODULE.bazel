# Compile commands for clangd (dev dependency, not needed for builds)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    patch_cmds = [
        # Bazel 9 removed native.{py_binary,cc_binary}; load from rules_python/rules_cc.
        "echo 'bazel_dep(name = \"rules_python\", version = \"1.0.0\")' >> MODULE.bazel",
        "echo 'bazel_dep(name = \"rules_cc\", version = \"0.1.0\")' >> MODULE.bazel",
        """sed -i.bak 's|native.py_binary(|py_binary(|' refresh_compile_commands.bzl && rm refresh_compile_commands.bzl.bak""",
        """printf '%s\\n%s\\n' 'load("@rules_python//python:defs.bzl", "py_binary")' "$(cat refresh_compile_commands.bzl)" > refresh_compile_commands.bzl""",
