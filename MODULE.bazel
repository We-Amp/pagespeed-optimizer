register_toolchains("@rust_toolchains//:all")

# Rust crate dependencies (crate_universe via bzlmod, Cargo.lock-driven).
# from_cargo (not from_specs) so the COMMITTED lib/image/vtracer_ffi/Cargo.lock
# is the single source of truth: the Bazel build resolves from it, and the
# dependency scan (tools/sbom/dep-scan.sh) reads the same file — no drift
# between what ships and what is scanned.
crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//lib/image/vtracer_ffi:Cargo.lock",
    manifests = ["//lib/image/vtracer_ffi:Cargo.toml"],
)
use_repo(crate, "crates")

