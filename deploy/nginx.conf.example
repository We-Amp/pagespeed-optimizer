# mod_pagespeed 2.1 - Production Nginx Configuration
#
# Copy this file to nginx.conf and adjust for your environment.

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

load_module /usr/lib/nginx/modules/ngx_http_brotli_filter_module.so;
load_module /usr/lib/nginx/modules/ngx_pagespeed_module.so;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Logging
    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'ps=$upstream_http_x_pagespeed';

    access_log /var/log/nginx/access.log main;

    # Performance
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # Gzip compression — applied to both cached (HIT) and proxied (MISS)
    # responses that pass through ngx_http_output_filter.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 4;    # ~40% faster than level 6, ~2-3% larger output
    gzip_min_length 256;  # Skip compressing tiny responses
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               image/svg+xml;

    # Brotli compression — better ratio than gzip for text resources.
    # ngx_brotli sets r->gzip_vary internally, so gzip_vary on above
    # also covers brotli-compressed responses (adds Vary: Accept-Encoding).
    brotli on;
    brotli_comp_level 4;
    brotli_min_length 256;
    brotli_types text/plain text/css application/json application/javascript
                 text/xml application/xml application/xml+rss text/javascript
                 image/svg+xml;

    # Upstream backend
    upstream backend {
        server ${BACKEND_HOST}:${BACKEND_PORT};
        keepalive 32;
    }

    server {
        listen 80;
        server_name _;

        # --- SSL (uncomment and configure for HTTPS) ---
        # listen 443 ssl http2;
        # ssl_certificate     /etc/nginx/ssl/cert.pem;
        # ssl_certificate_key /etc/nginx/ssl/key.pem;
        # ssl_protocols       TLSv1.2 TLSv1.3;
        # ssl_ciphers         HIGH:!aNULL:!MD5;
        #
        # # Redirect HTTP to HTTPS
        # if ($scheme = http) {
        #     return 301 https://$host$request_uri;
        # }

        # PageSpeed configuration
        # Worker socket and HTML toggle auto-discovered from shared config
        pagespeed on;
        pagespeed_cache_path /data/cache.vol;
        # (mmap'd cross-process cache sharing is the worker's default — no nginx
        # directive needed; the module auto-discovers the volume via the socket.)

        # Exclude paths from optimization
        # pagespeed_disallow /api/;
        # pagespeed_disallow /admin/;
        # pagespeed_disallow *.woff2;

        # Main location - proxy to backend
        location / {
            proxy_pass http://backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Connection "";

            # Ensure origin sends uncompressed; PageSpeed caches raw bytes
            # and applies compression at serve time. Origin must be able
            # to serve uncompressed responses.
            proxy_set_header Accept-Encoding "";
        }

        # API - bypass PageSpeed
        location /api/ {
            pagespeed off;
            proxy_pass http://backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # Admin - bypass PageSpeed
        location /admin/ {
            pagespeed off;
            proxy_pass http://backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # Health check endpoint
        location /health {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }
    }
}
