# mod_pagespeed 2.1 - Docker Compose Environment
#
# Copy to .env and adjust for your environment:
#   cp deploy/.env.example deploy/.env

# Image version tag (default: the current release). The worker and nginx
# images publish version tags only; there is no `latest` tag for them.
# PAGESPEED_VERSION=2.5.0

# Backend origin server (host.docker.internal reaches the Docker host;
# use a hostname or IP when the backend runs elsewhere)
# BACKEND_HOST=host.docker.internal
# BACKEND_PORT=8081

# Cache size in bytes (default: 1GB)
# CACHE_SIZE=1073741824

# Exposed ports
# NGINX_PORT=80
# NGINX_SSL_PORT=443
